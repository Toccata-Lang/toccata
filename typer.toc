(extend-type ast/string-ast
  TypeChecker
  (set-global-var [ast]
    ast)

  (type-check [ast old-ast]
    (let [str-val (.string old-ast)]
      (-> ast
          (.constraint (.static c/strbuff-constraint str-val))
          (.var (b/global-var 'Str))
          se/state-error))))

(extend-type ast/integer-ast
  TypeChecker
  (set-global-var [ast]
    ast)

  (type-check [ast old-ast]
    (-> ast
        (.var (str "new_num_(new_i24_(" (.int ast) "))"))
        (.constraint (-> (.static c/int-constraint (.int old-ast))
                         (c/update-path (ast/location old-ast))))
        se/state-error)))

(deftype PushTypes [expr]
  Stringable
  (string-list [pt]
    (list (str "(PushTypes " expr ")")))

  TypeChecker
  (pre-check [_]
    (flat-map (b/push-types)
              (fn [_]
                (pre-check expr)))))

(deftype Binder [binding val]
  Stringable
  (string-list [_]
    (list "(Binder " (str binding) " " (str val) ")"))

  Container
  (map [x f]
    (.val x (f val)))

  (map [x f embed]
    (map (f val)
         (partial .val x)))

  ast/FileLoc
  (ast/location [_]
    (ast/location binding))

  TypeChecker
  (pre-check [ast]
    (se/state-error ast))

  (type-check [ast old-ast]
    (let [loc (ast/location val)
          binding (.var (.binding ast) (.var val))]
      (for [_ (b/push-types)
            arity-id (b/get-value b/curr-arity)
            _ (se/traverse (ast/all-syms binding)
                           (fn [sym]
                             (b/set-value sym (-> sym
                                                  (.arity-id arity-id)
                                                  (.constraint c/top-type)))))]
        val))))

(def pre-defed-types {'HashSet c/HashSetType
                      'ProtoDispatcher c/ProtoDispatcherType
                      'NoValues c/NoValuesType
                      'AllValues c/AllValuesType
                      'None c/NoneType
                      'Some c/SomeType
                      ;; TODO: remove ones no longer used
                      'ResultConstraint c/ResultConstraintType
                      'InferredInner c/InferredInnerType
                      'ContentsConstraint c/ContentsConstraintType
                      'SumConstraint c/SumConstraintType})

(defn new-type-number [type-symbol]
  (assert (instance? c/TaggedSymbol type-symbol))
  (either (get pre-defed-types type-symbol)
          (extract b/type-counter)))

(deftype DestructFields [type-info fields loc]
  (assert (instance? c/ReifiedConstraint type-info))
  (assert (instance? c/Location loc))
  (assert (instance? (vector-of c/TaggedSymbol) fields))

  Stringable
  (string-list [_]
    (list "(DestructFields " (to-str fields) " " (str loc) ")"))

  Container
  (map [x f] x)
  (map [x f embed] (embed x))

  TypeChecker
  (pre-check [ast]
    (se/state-error ast))

  (type-check [ast old-ast]
    (for [arity-id (b/get-value b/curr-arity)
          :let [param (c/param arity-id 0)]
          _ (append-value-type (.sym type-info) type-info loc)
          _ (se/traverse fields
                         (fn [fld]
                           (append-value-type fld
                                              (c/type-op c/get-from-op param
                                                         [(c/Field (c/tag (str "." fld) loc))])
                                              loc)))]
      (ast/block-comment-ast [] c/no-loc c/top-type))))

(def x* (c/tag "#x"))
(def y* (c/tag "#y"))
(def field* (c/tag "#field"))
(def ctxt* (c/tag "#ctxt"))

(defn constrain-first-param [ast type-info fields loc]
  (assert (instance? b/StaticArity ast))
  (assert (instance? c/ReifiedConstraint type-info))

  (either (let [arity (.arity ast)]
            (-> arity
                .params
                .fixed
                first
                (map (fn [first-param]
                       (ProtoArity (c/type-num type-info)
                                   (.arity ast
                                           (.body arity
                                                  (comp [(DestructFields (.sym type-info first-param)
                                                                         fields loc)]
                                                        (.body arity)))))))))

          (do
            ;; (b/compilation-error "Prototype implentation for "
            ;;                    (str "'" (.fn-sym c) "'")
            ;;                    "must have at least one parameter at"
            ;;                    (ast/location (.fn-sym c)))
            (print-err 'BOOOMMMM _LINE_ ast)
            (abort)
            ast)))

(defn check-ast [ast]
  (cond (instance? c/Constraints ast)
        (cond (instance? c/SymbolConstraints ast)
              (cond (instance? c/TypeOfConstraint ast)
                    (type-check ast ast)

                    (flat-map (map ast check-ast se/state-error)
                              (fn [r]
                                (type-check r ast))))

              (instance? c/ProtoImpls ast)
              (se/state-error ast)

              (se/state-error ast))

        (for [new-ast (pre-check ast)
              ;; :let [loc (ast/location ast)
              ;;       _ (and (= (.file loc) "assertion-tests/closure-param.toc")
              ;;              (do
              ;;                (b/status 'type-checking _LINE_ loc
              ;;                        lflf 'ast ast
              ;;                        lflf 'new-ast new-ast)
              ;;                nothing))]
              newer-ast (map new-ast check-ast se/state-error)
              ;; :let [loc (ast/location ast)
              ;;       _ (and ;; (instance? ast/either-ast ast)
              ;;          (> (.line loc) 3016)
              ;;          (do
              ;;            (b/status 'type-checking _LINE_ loc
              ;;                    lflf 'newer-ast newer-ast
              ;;                    lflf 'new-ast new-ast)
              ;;            (b/wait-for-err-out)
              ;;            nothing))]
              final-ast (type-check newer-ast new-ast)]
          (do
            ;; (let [loc (ast/location ast)]
            ;;   (and ;; (extract flag)
            ;;        (maybe (b/status 'final-ast _LINE_ loc
            ;;                          lflf final-ast))))
            final-ast))))

(deftype TypeSpec [sym fields impls]
  (assert (instance? c/TaggedSymbol sym))
  (assert (instance? (any-of c/NoFields ast/params-ast) fields))
  (assert (instance? Vector impls))

  Stringable
  (string-list [_]
    (list "(TypeSpec " (str sym) "\n"
          (str fields) "\n"
          (str impls) ")"))

  Container
  (map [x f embed]
    (for [new-fields (map fields f embed)
          new-impls (map impls f embed)]
      (-> x
          (.fields new-fields)
          (.impls new-impls))))

  TypeChecker
  (pre-check [ast]
    (let [loc (ast/location sym)]
      ;; (b/status 'ts _LINE_ ast)
      (let [fields (-> ast .fields .fixed)
            field-count (count fields)]
        (for [_ (b/push-types)
              ;; clear previous constraints for the fields
              _ (se/traverse fields (fn [sym]
                                      (b/set-value sym (.constraint sym c/top-type))))

              ;; then add all the explicit constraints for the fields
              ;; and collect them in 'field-cs'
              _ (-> (.impls ast)
                    (filter (partial instance? c/SymbolConstraints))
                    (se/traverse (fn [field-c]
                                   (cond (some fields (partial = (.sym field-c)))
                                         (check-ast field-c)

                                         (b/compilation-error
                                          (b/conf-ass
                                           _LINE_
                                           (c/NoValues
                                            [field-c
                                             (.type-symbol c/empty-reified
                                                           (c/tag (str "Field '" (.sym field-c)
                                                                       "' doesn't exist")))])
                                           loc))))))
              field-vals (se/traverse fields b/get-value)
              new-type-constraint (b/get-type-info sym)
              :let [field-cs (map field-vals .constraint)
                    type-num (.type-number new-type-constraint)
                    idxs (integer-gen 1)
                    field-pairs (map (zip-lists fields field-cs)
                                     (fn [[fld-name fld-c]]
                                       [(c/Field (c/tag (str "." fld-name)))
                                        fld-c
                                        (new-int idxs)]))
                    fields-map (reduce field-pairs {} conj)
                    new-type-constraint (-> new-type-constraint
                                            (.field-consts fields-map)
                                            (.fields (assoc fields-map
                                                            c/contents c/top-type))
                                            (c/update-path loc))

                    ctor-arity (c/arity
                                sym
                                (c/seq-c field-cs)
                                (-> c/empty-reified
                                    (.type-symbol sym)
                                    (.field-consts (reduce field-pairs {}
                                                           (fn [fields-map [fld fld-c idx]]
                                                             (assoc fields-map fld fld-c))))
                                    (.fields (reduce field-pairs {}
                                                     (fn [fields-map [fld fld-c idx]]
                                                       (assoc fields-map
                                                              fld
                                                              (c/intersect (c/param sym (dec idx))
                                                                           fld-c)))))
                                    (assoc-in [.fields c/contents] c/top-type)))]
              _ (b/set-type-info sym new-type-constraint)
              _ (b/set-value sym (.constraint sym ctor-arity))

              ;; _ (se/traverse (vec fields-map)
              ;;                (fn [[field fld-c]]
              ;;                  (let [fld-sym (.sym field)
              ;;                        getter-id (c/tag (str sym "-" fld-sym "-getter"))
              ;;                        getter-param (c/param getter-id 0)
              ;;                        setter-id (c/tag (str sym "-" fld-sym "-setter"))
              ;;                        setter-param-0 (c/param setter-id 0)
              ;;                        setter-param-1 (c/param setter-id 1)]
              ;;                    (b/add-getter-impls fld-sym type-num
              ;;                                        (c/arity
              ;;                                         getter-id
              ;;                                         (c/seq-c [(c/multi [new-type-constraint
              ;;                                                             getter-param])])
              ;;                                         (-> (c/type-op c/get-from-op getter-param
              ;;                                                        [field])
              ;;                                             (c/intersect fld-c)))
              ;;                                        (c/arity
              ;;                                         setter-id
              ;;                                         (c/seq-c [(c/multi [new-type-constraint
              ;;                                                             setter-param-0])
              ;;                                                   (c/multi [setter-param-1
              ;;                                                             fld-c])])
              ;;                                         (c/type-op c/set-to-op setter-param-0
              ;;                                                    [[field] setter-param-1]))
              ;;                                        loc))))
              ]
          (let [impls (-> (.impls ast)
                          (remove (fn [expr]
                                    (or (instance? ast/block-comment-ast expr)
                                        (instance? c/SymbolConstraints expr))))
                          (map (fn [ast]
                                 (constrain-first-param (set-global-var ast)
                                                        new-type-constraint fields loc))))
                ctor-fn (b/global-var sym 'CtorFn)
                ;; TODO: make sure the impls for 'get' and 'assoc' have constraints on their result
                ;; and parameter, respectively
                ]
            (comp impls
                  [(reify
                     Type
                     (type-name [_]
                       (str "reified at " (c/Location _FILE_ _LINE_)))

                     Container
                     (map [y f embed]
                       (embed y))

                     TypeChecker
                     (pre-check [x]
                       (se/state-error x))

                     (type-check [_ _]
                       (let [get-id (c/tag (str sym "_get") loc)
                             ;; getter-c (c/arity
                             ;;           get-id
                             ;;           (c/seq-c [(c/multi [new-type-constraint
                             ;;                               (c/param get-id 0)])
                             ;;                     (c/param get-id 1)])
                             ;;           (c/MaybeConstraint
                             ;;            (c/type-op c/get-from-op (c/param get-id 0)
                             ;;                       [(c/param get-id 1)])
                             ;;            empty-list c/no-symbol))
                             ;; getter-ast (b/StaticArity
                             ;;             (ast/fn-arity-ast b/apply-sym c/no-symbol
                             ;;                               (ast/params [(c/tag (symbol "#field") loc)
                             ;;                                            (c/tag (symbol "#x") loc)])
                             ;;                               "" [] (b/global-var b/apply-sym)
                             ;;                               getter-c)
                             ;;             "" "" getter-c)
                             ;; set-id (c/tag (str sym "_set") loc)
                             ;; setter-c (c/arity
                             ;;           set-id
                             ;;           (c/seq-c [(c/multi [new-type-constraint
                             ;;                               (c/param set-id 0)])
                             ;;                     (c/param set-id 1)
                             ;;                     (c/param set-id 2)])
                             ;;           (c/type-op c/set-to-op (c/param set-id 0)
                             ;;                      [[(c/param set-id 1)]
                             ;;                       (c/param set-id 2)]))
                             ;; setter-ast (b/StaticArity
                             ;;             (ast/fn-arity-ast b/apply-sym c/no-symbol
                             ;;                               (ast/params [(c/tag (symbol "#field") loc)
                             ;;                                            (c/tag (symbol "#x") loc)
                             ;;                                            (c/tag (symbol "#val") loc)])
                             ;;                               "" [] (b/global-var b/apply-sym)
                             ;;                               setter-c)
                             ;;             "" "" setter-c)
                             ]
                         (for [_ (b/pop-types)
                               ;; _ (comp (b/get-proto-impl (c/tag 'get) type-num 2)
                               ;;         (b/add-proto-impl type-num (c/tag 'get loc) 2
                               ;;                           getter-ast))
                               ;; _ (comp (b/get-proto-impl (c/tag 'assoc) type-num 3)
                               ;;         (b/add-proto-impl type-num (c/tag 'assoc loc) 3
                               ;;                           setter-ast))
                               _ (b/set-type-info sym new-type-constraint)]
                           (ast/block-comment-ast [] c/no-loc c/top-type)))))
                   (ast/inline-ast
                    c/top-type
                    (str "bool " ctor-fn "(Port ref, Port args) {\n"
                         "Pair pr = node_take(args);\n"
                         "Port resultVar = pr.fst;\n"
                         "Port callArgs = pr.snd;\n"
                         "callArgs = node_make(ARG, new_num(new_i24(" field-count ")), callArgs);\n"
                         "callArgs = node_make(ARG, new_num(new_i24(" type-num ")), callArgs);\n"
                         "callArgs = node_make(ARG, resultVar, callArgs);\n"
                         "link(construct, callArgs);\n"
                         "return TRUE;\n"
                         "}\n")
                    loc "")
                   (ast/definition sym
                     [(ast/inline-ast ctor-arity
                                      (str "new_port_(REF, (Port)" ctor-fn ")")
                                      loc "")])]

                  ;; (reify
                  ;;   Container
                  ;;   (map [y f embed]
                  ;;     (embed y))

                  ;;   TypeChecker
                  ;;   (pre-check [ast]
                  ;;  report-type-stack
                  ;;     (for [ft (se/get-val .value-types)
                  ;;           mby (get-value-type maybe-sym)]
                  ;;       (do
                  ;;         (b/status 'vts _LINE_ sym (count ft)
                  ;;                 lflf 'maybe mby)
                  ;;         (ast/block-comment-ast [] c/no-loc c/top-type)))))
                  )))))))

(defn create-type [type]
  (assert (instance? ast/type-ast type))

  (let [sym (.sym type)
        loc (ast/location sym)]
    (comp (flat-map (b/get-type-info (.sym type))
                    (fn [_]
                      (b/compilation-error "A type named" (str "'" sym "'")
                                           "was already defined. Re-defined at"
                                           loc)))
          (let [fields (reduce (.fixed (.fields type)) {}
                               (fn [m f]
                                 (assoc m f c/top-type)))]
            ;; (b/status 'ct _LINE_ sym fields (.fields type))
            (for [_ (b/set-type-info sym
                                     (-> (c/ReifiedConstraint (new-type-number sym)
                                                              sym fields
                                                              (assoc fields c/contents c/top-type)
                                                              empty-list c/no-symbol)
                                         (c/update-path loc)))]
              [(TypeSpec sym (.fields type) (.impls type))])))))

(extend-type ast/type-ast
  TypeChecker
  (pre-check [ast]
    (create-type ast)))

(extend-type ast/rec-type-ast
  TypeChecker
  (pre-check [ast]
    (let [loc (ast/location ast)]
      (for [_ (se/traverse (.types ast) create-type)]
        (comp [(ast/definition (.sym ast)
                 [(c/SumConstraint
                   (map (.types ast) (fn [type]
                                       (.type-symbol c/empty-reified
                                                     (.sym type))))
                   (list loc)
                   c/no-symbol)])]
              (map (.types ast)
                   (fn [type]
                     (TypeSpec (.sym type) (.fields type) (.impls type)))))))))

(extend-type ast/IsType
  TypeChecker
  (pre-check [ast]
    (for [_ (b/push-types)
          _ (either (map (= (.ast ast) '_)
                         (fn [_]
                           (b/status "Type at:" (ast/location (.ast ast))
                                   (.expected ast))
                           b/se-nop))
                    (flat-map (se/try
                                (check-ast (.ast ast))
                                (fn [err]
                                  (b/status (.val err))
                                  (se/state-error (.constraint (.ast ast) c/bottom-type))))
                              (fn [c]
                                (either (map (= (c/trim (.constraint c)) (.expected ast))
                                             se/state-error)
                                        (b/compilation-error "Type Error:" (ast/location (.ast ast))
                                                           lf 'ast (.ast ast)
                                                           lflf 'expected (.expected ast)
                                                           lflf 'actual (either (get c .constraint)
                                                                                  c))))))
          _ (b/pop-types)]
      (ast/block-comment-ast [] c/no-loc c/top-type))))

(extend-type ast/GetImpl
  TypeChecker
  (pre-check [ast]
    (se/state-error ast))

  (type-check [ast old-ast]
    (let [type-sym (.type-sym ast)]
      (cond (= c/no-symbol type-sym)
            (se/state-error (.constraint ast (-> ast .impl-sym .constraint)))

            (flat-map (comp (b/get-type-info type-sym)
                            (b/compilation-error "No type named" (str "'" type-sym "'")
                                                 "was found. Used at" (ast/location type-sym)))
                      (fn [c]
                        (let [type-num (c/type-num c)]
                          (either (map (get-in ast [.impl-sym .constraint .impl-fns type-num])
                                       (fn [impl-c]
                                         (se/state-error (.constraint ast impl-c))))
                                  (b/compilation-error "Could not find impl for"
                                                       (str "'" type-sym "' (" type-num ")")
                                                       "at" (ast/location (.type-sym ast)))))))))))

(extend-type b/StaticArity
  TypeChecker
  (pre-check [ast]
    (se/state-error ast))

  (type-check [ast old-ast]
    (se/state-error (.constraint ast (.constraint (.arity ast))))))
