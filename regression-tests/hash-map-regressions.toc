(add-ns rt (module "regression-tester.toc"))

(deftype ControlledHash [y eq]
  (str-vect [_] (str-vect y))
  (= [_ v]
    (and (= eq (.eq v))
         (Some _)))
  (sha1 [_] y))

(defn bar [x]
  ! x ArrayNode
  (dissoc x '_))

(defn foo [x]
  ! x HashMap
  !returns HashMap
  (bar x))

(defn test-collisions []
  (let [one-hash-map {(ControlledHash 0 (Some 0)) "a"}
        full-bmi (reduce (range 16) {} (fn [m n]
                                         (assoc m (ControlledHash n (Some n)) (inc n))))
        array-node (assoc full-bmi (ControlledHash 21 (Some 21)) "c")
        collided (-> {}
                     (assoc (ControlledHash 0 None) 1)
                     (assoc (ControlledHash 0 "a") "a")
                     (assoc (ControlledHash 0 None) 1))]
    (rt/test (= None (empty? one-hash-map))
             _FILE_ _LINE_)
    (rt/test (= 1 (count one-hash-map))
             _FILE_ _LINE_)
    (rt/test (= 2 (count (hash-vec one-hash-map [""])))
             _FILE_ _LINE_)
    (rt/test (= (Some "a") (get one-hash-map (ControlledHash 0 (Some 0))))
             _FILE_ _LINE_)
    (rt/test (= 100 (get* full-bmi (ControlledHash 2 None) 100
                          (sha1 (ControlledHash 2 (Some 1))) 0))
             _FILE_ _LINE_)
    (rt/test (= 1 (get* one-hash-map 10 1 (sha1 10) 0))
             _FILE_ _LINE_)
    (rt/test (= "a" (get* one-hash-map (ControlledHash 0 (Some 0))
                          1 (sha1 (ControlledHash 0 (Some 0)))
                          0))
             _FILE_ _LINE_)
    ;; Failed: leaks 246 nodes (remaining nodes: 246, Leaked pairs!! 246)
    ;; (rt/test (= (range 16)
    ;;             (let [ints-map (reduce (range 16) {} (fn [m n] (assoc m n n)))]
    ;;               (map (range 16) (fn [n]
    ;;                                 (-> n
    ;;                                     (= (get* ints-map n 1 (sha1 n) 0))
    ;;                                     (rt/test _FILE_ _LINE_)
    ;;                                     extract)))))
    ;;          _FILE_ _LINE_)
    (rt/test (= 1 (count (dissoc* one-hash-map 1 (sha1 1) 0)))
             _FILE_ _LINE_)
    (rt/test (= 0 (count (dissoc* one-hash-map (ControlledHash 0 (Some 0))
                                  (sha1 (ControlledHash 0 (Some 0))) 0)))
             _FILE_ _LINE_)
    (rt/test (= 15 (count (dissoc* full-bmi (ControlledHash 5 (Some 5))
                                   (sha1 (ControlledHash 5 (Some 5))) 0)))
             _FILE_ _LINE_)
    (rt/test (= 1 (get* array-node 4 1 (sha1 4) 0))
             _FILE_ _LINE_)
    (rt/test (= 2 (count (assoc {(ControlledHash 0 "a") "a"}
                                (ControlledHash 0 "b") "b")))
             _FILE_ _LINE_)
    (rt/test (= 1 (count (assoc one-hash-map (ControlledHash 0 (Some 0))
                                "b")))
             _FILE_ _LINE_)
    (rt/test (= 2 (count (assoc one-hash-map (ControlledHash 1 (Some 1))
                                "b")))
             _FILE_ _LINE_)
    (rt/test (= 17 (count (hash-vec full-bmi [""])))
             _FILE_ _LINE_)
    (rt/test (= 27 (count (reduce (range 27) {}
                                  (fn [m n] (assoc m (- n 1) (inc n))))))
             _FILE_ _LINE_)
    (rt/test (= 2001 (count (hash-vec (reduce (range 2000) {}
                                              (fn [m n] (assoc m (ControlledHash n (Some n)) (inc n))))
                                      [""])))
             _FILE_ _LINE_)
    (rt/test (= 16 (count (assoc full-bmi (ControlledHash 1 (Some 1)) "b")))
             _FILE_ _LINE_)
    (rt/test (= 17 (count (assoc full-bmi (ControlledHash 99 (Some 99)) "b")))
             _FILE_ _LINE_)
    (rt/test (= 17 (count array-node))
             _FILE_ _LINE_)
    (rt/test (= 18 (count (assoc array-node "a" 1)))
             _FILE_ _LINE_)
    (rt/test (= 18 (count (-> full-bmi
                              (assoc "b" 1)
                              (assoc "d" 2))))
             _FILE_ _LINE_)
    (rt/test (= 2 (count collided))
             _FILE_ _LINE_)
    (rt/test (= 3 (count (hash-vec collided [""])))
             _FILE_ _LINE_)
    (rt/test (= 1 (count (dissoc collided (ControlledHash 0 "a"))))
             _FILE_ _LINE_)
    (rt/test (= 100 (get* collided (ControlledHash 256 100) 100
                          (sha1 (ControlledHash 256 0)) 0))
             _FILE_ _LINE_)
    (let [key (ControlledHash 0 "a")]
      (rt/test (= "a" (get* collided key 100 (sha1 key) 0))
               _FILE_ _LINE_))

    ;; Failed
    ;; (rt/test (instance? HashMap one-hash-map)
    ;;          _FILE_ _LINE_)
    ;; Failed
    ;; (rt/test (instance? HashMap array-node)
    ;;          _FILE_ _LINE_)
    (rt/test (= array-node (dissoc array-node (ControlledHash 18 (Some 3))))
             _FILE_ _LINE_)))

(defn main [_]
  (println "Checking hash-map regressions")
  (rt/test (= 0 (count emptyBMI)
              _FILE_ _LINE_))
  (rt/test (empty? {})
           _FILE_ _LINE_)
  (rt/test (= [['a 1]] (vec {'a 1}))
           _FILE_ _LINE_)
  (rt/test (= {} {})
           _FILE_ _LINE_)

  (let [one-hash-map {1 "a"}]
    (rt/test (= None (empty? one-hash-map))
             _FILE_ _LINE_)
    (rt/test (= 1 (count one-hash-map))
             _FILE_ _LINE_)
    (rt/test (= 1 (count (assoc one-hash-map 1 "b")))
             _FILE_ _LINE_)
    (rt/test (= 2 (count (assoc one-hash-map 2 "b")))
             _FILE_ _LINE_))

  (test-collisions)
  
  (rt/test (= 3 (count (reduce (range 3) {}
                               (fn [m n]
                                 (assoc m (ControlledHash 0 (inc n)) (inc n))))))
           _FILE_ _LINE_)
  (rt/test (= 3 (count (-> {}
                           (assoc "a" 1)
                           (assoc "b" 2)
                           (assoc "c" 3))))
           _FILE_ _LINE_)
  ;; Failed
  ;; (rt/test (= 0 (count (reduce (range 16) (reduce (range 16) {} (fn [m n] (assoc m n n)))
  ;;                              (fn [m n]
  ;;                                (dissoc* m n (sha1 n) 0)))))
  ;;          _FILE_ _LINE_)
  ;; Failed
  ;; (let [size 25
  ;;       ints-map (reduce (range size) {} (fn [m n] (assoc m n n)))]
  ;;   ;; Codegen failure: this test's verdict depends on unrelated code.
  ;;   ;; It passed while the foo test below was active, but fails (map not
  ;;   ;; empty after dissoc* of all 25 keys) once that test is commented
  ;;   ;; out — the compiler emits different code for this expression
  ;;   ;; depending on the surrounding code.
  ;;   (rt/test (empty? (reduce (range size) ints-map
  ;;                            (fn [m n]
  ;;                              (dissoc* m n (sha1 n) 0))))
  ;;            _FILE_ _LINE_)
  ;;   (rt/test (= ints-map (foo ints-map))
  ;;            _FILE_ _LINE_))

  (let [bmi {(ControlledHash 3 4) 4, (ControlledHash 35 99) 99}]
    (rt/test (= bmi (dissoc bmi (ControlledHash 3 0)))
             _FILE_ _LINE_)
    (rt/test (-> bmi
                 (dissoc (ControlledHash 3 4))
                 (dissoc (ControlledHash 35 99))
                 empty?)
             _FILE_ _LINE_))

  (let [collided (-> {}
                     (assoc (ControlledHash 1 3) 3)
                     (assoc (ControlledHash 1 2) 2)
                     (assoc (ControlledHash 1 3) 10))]
    (dissoc collided (ControlledHash 1 2))) 

  (let [collided (-> {}
                     (assoc (ControlledHash 1 (Some 0)) 2)
                     (assoc (ControlledHash 1 None) 3)
                     (assoc (ControlledHash 1 None) 10))]
    (dissoc collided (ControlledHash 1 (Some 0)))) 

  (let [collided (-> {}
                     (assoc (ControlledHash 1 (Some 0)) 2)
                     (assoc (ControlledHash 1 (Some 1)) 3)
                     (assoc (ControlledHash 1 None) 10))]
    (-> collided
        (dissoc (ControlledHash 1 (Some 0)))
        (dissoc (ControlledHash 1 (Some 1))))) 

  (let [collided (-> {}
                     (assoc (ControlledHash 1 (Some 0)) 2)
                     (assoc (ControlledHash 1 None) 3)
                     (assoc (ControlledHash 1 None) 3)
                     (assoc (ControlledHash 1 None) 10))]
    (-> collided
        (dissoc (ControlledHash 1 (Some 0)))
        (dissoc (ControlledHash 1 (Some 0)))
        (dissoc (ControlledHash 1 (Some 1))))) 

  (let [collided (-> {}
                     (assoc (ControlledHash 1 (Some 0)) 2)
                     (assoc (ControlledHash 1 None) 3)
                     (assoc (ControlledHash 257 None) 10))]
    (dissoc collided (ControlledHash 1 (Some 0))))

  (rt/test (= 28 (count (hash-vec (reduce (range 27) {}
                                          (fn [m n] (assoc m (- n 1) (inc n))))
                                  [""])))
           _FILE_ _LINE_)

  (println "hash-maps are good"))
