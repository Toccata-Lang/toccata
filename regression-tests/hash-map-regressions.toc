(add-ns rt (module "regression-tester.toc"))

(deftype ControlledHash [y eq]
  (str-vect [_] (str-vect y))
  (= [_ v]
    (and eq
         (= y (.y v))
         (Some _)))
  (sha1 [_] y))

(defn bar [x]
  ! x ArrayNode
  (dissoc x '_))

(defn foo [x]
  ! x HashMap
  !returns HashMap
  (bar x))

