
(defn pr-num [v]
  (inline "
  printf(\"%ld\\n\", get_i60(v_1));\n"))

(deftype SeedList [head tail]
  (recurse [_ f]
    (Cons head (f tail) head)))

(defn simple [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple (- n 1))

        n))

(defn simple-sup1 [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple-sup1 (|0 (- n 1) 0|))
        0))

(defn simple-sup2 [n]
  ;; (pr-num n)
  (cond (int-< 0 n)
        (simple-sup2 (|(- n 1) 0|))
        0))

(defn simple-sup3 [n]
  ;; (pr-num n)
  (cond (int-< 0 n)
        (simple-sup3 (|0 (- n 1)|))
        n))

(defn simple-sup4 [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple-sup4 (|(- n 1) 0|))
        n))

(defn f [x]
  (pr-num x)
  (cond (int-< x 1)
        EndOfList
        (SeedList x (- x 1))))

(main [_]
  (simple 4)
  (simple (|0 0|))

  (simple-sup1 4)
  (simple-sup2 4)
  (simple-sup3 4)
  (simple-sup4 4)

  (pr-num (count EndOfList))

  (pr-num (count (cons 2 (cons 3 EndOfList))))

  (recurse (cons 1 (cons 2 (cons 3 EndOfList)))
           identity)

  (unfold 3 f)
  
  (recurse (SeedList 1 (SeedList 2 EndOfList)) identity)

  (unfold 0 (fn [n]
              (pr-num n)
              (cond (int-< 0 n)
                    (SeedList n (dec n))

                    EndOfList)))

  (let [new-list (unfold 1 (fn [n]
                             (pr-num (pr* (number-str n)))
                             (cond (int-< 0 n)
                                   (SeedList n (dec n))

                                   EndOfList)))]
    (pr* "Howdy recursive folks 14\n")))
