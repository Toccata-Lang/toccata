
(deftype SeedList [head tail]
  (recurse [_ f]
    (SeedList head (f tail))))

(defn add-newline [v]
  (inline "
  printf(\"\\n\");
  dec_and_free(v_1, 1);"))

(defn simple [n]
  (add-newline (pr* (number-str n)))
  (cond (int-< 0 n)
        (simple (- n 1))

        n))

(defn simple-sup [n]
  (add-newline (pr* (number-str n)))
  (cond (int-< 0 n)
        (simple-sup (|(- n 1) 0|))

        n))

(main [_]
  (simple 3)

  ;; (simple-sup 3)

  (add-newline (pr* (number-str (count eol))))

  (add-newline (pr* (number-str (count (cons 2 (cons 3 eol))))))

  (recurse (cons 1 (cons 2 (cons 3 eol)))
           identity)

  (unfold 0 (fn [n]
              eol))

  (recurse (SeedList 1 (SeedList 2 eol)) identity)

