
(deftype SeedList [head tail]
  (recurse [_ f]
    (SeedList head (f tail))))

(defn add-newline [v]
  (inline "
  printf(\"\\n\");
  dec_and_free(v_1, 1);"))

(defn simple [n]
  (add-newline (pr* (number-str n)))
  (cond (int-< 0 n)
        (simple (- n 1))

        n))

(defn simple-sup1 [n]
  (add-newline (pr* (number-str n)))
  (cond (int-< 0 n)
        (simple-sup1 (|0 (- n 1) 0|))
        0))

(defn simple-sup2 [n]
  ;; (add-newline (pr* (number-str n)))
  (cond (int-< 0 n)
        (simple-sup2 (|(- n 1) 0|))
        0))

(defn simple-sup3 [n]
  (cond (int-< 0 n)
        (simple-sup3 (|0 (- n 1)|))
        n))

(defn simple-sup4 [n]
  (cond (int-< 0 n)
        (simple-sup4 (|(- n 1) 0|))
        n))


