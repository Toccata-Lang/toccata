
(deftype SeedList [head tail]
  (recurse [_ f]
    (SeedList head (f tail))))

(defn pr-num [v]
  (inline "
  printf(\"%ld\\n\", get_i60(v_1));\n"))

(defn simple [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple (- n 1))

        n))

(defn simple-sup1 [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple-sup1 (|0 (- n 1) 0|))
        0))

(defn simple-sup2 [n]
  ;; (pr-num n)
  (cond (int-< 0 n)
        (simple-sup2 (|(- n 1) 0|))
        0))

(defn simple-sup3 [n]
  ;; (pr-num n)
  (cond (int-< 0 n)
        (simple-sup3 (|0 (- n 1)|))
        n))

(defn simple-sup4 [n]
  (pr-num n)
  (cond (int-< 0 n)
        (simple-sup4 (|(- n 1) 0|))
        n))


(main [_]
  (simple 4)
  (simple (|0 0|))

  (simple-sup1 4)
  (simple-sup2 4)
  (simple-sup3 4)
  (simple-sup4 4)

