
(deftype Tree
  (Leaf [x])
  (Branch [left right]
    (assert (instance? Tree left))
    (assert (instance? Tree right))))

(main [_]
  (Some 7)
  (let [x (Some 8)]
    x)
  (let [x (Some 8)]
    (pr* "woops\n")
    x)
  (let [x (Some 8)]
    x
    (pr* "woops\n"))
  (let [x AnotherNone]
    x
    (pr* "woops\n"))
  (let [x None]
    (pr* "woops\n")
    x)
  (let [x (let [y (Some 8)]
            (pr* "woopsy\n"))]
    x
    (pr* "woops\n"))
  (let [t (Branch
           (Leaf
            8)
           (Leaf
            9))]
    (pr* "wut\n"))
  (pr* (do
         (pr* "one\n")
         (pr* "two\n")
         "three\n")))
