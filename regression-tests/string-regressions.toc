
(add-ns rt (module "regression-tester.toc"))

(def sample-str (str "Str" "ing"))

(defn main [_]
  (pr* "Checking string regressions\n")

  ;; (rt/test (instance? String (char 66))
  ;;          _FILE_ _LINE_)
  ;; (rt/test (= None (instance? Maybe (char 66)))
  ;;          _FILE_ _LINE_)
  ;; (rt/test (instance? String (subs "bogus" 2))
  ;;          _FILE_ _LINE_)

  (rt/test (= "string" (escape-chars "string"))
           _FILE_ _LINE_)
  (rt/test (= "tring" (escape-chars (subs "string" 1 8)))
           _FILE_ _LINE_)
  (rt/test (= (char-code "B") 66)
           _FILE_ _LINE_)
  (rt/test (= "B" (char 66))
           _FILE_ _LINE_)
  (rt/test (= (char-code (subs "Bro" 0 1)) 66)
           _FILE_ _LINE_)
  (rt/test (= (char 66) (str "B" ""))
           _FILE_ _LINE_)
  (rt/test (= ["string"] (str-vect "string"))
           _FILE_ _LINE_)
  (rt/test (= (subs "string" 1 99) "tring")
           _FILE_ _LINE_)
  (rt/test (= (subs "string" 1 99) (subs "string" 1 99))
           _FILE_ _LINE_)
  (rt/test (= ["tring"] (str-vect (subs "string" 1 99)))
           _FILE_ _LINE_)
  (rt/test (= sample-str sample-str)
           _FILE_ _LINE_)
  (rt/test (= "" (subs 'a 1 1))
           _FILE_ _LINE_)
  (rt/test (= "String" (type-name "string"))
           _FILE_ _LINE_)
  (rt/test (= (subs sample-str 1 (count sample-str)) "tring")
           _FILE_ _LINE_)
  (rt/test (= "String" (type-name (subs "string" 1 4)))
           _FILE_ _LINE_)
  (rt/test (= "ring " (subs (subs (str sample-str " ") 1 8) 1 8))
           _FILE_ _LINE_)
  (rt/test (= "tr" (subs sample-str 1 2))
           _FILE_ _LINE_)
  (rt/test (= "ri" (subs (subs sample-str 1 5) 1 2))
           _FILE_ _LINE_)
  (rt/test (= None (= (subs (str sample-str " ") 4 7) "tring"))
           _FILE_ _LINE_)
  (rt/test (= None (= (subs (subs (str sample-str " ") 1 10) 4 7) "tring"))
           _FILE_ _LINE_)
  (rt/test (= None (= (subs (str sample-str " ") 2 10) (subs (str sample-str " ") 1 10)))
           _FILE_ _LINE_)
  (rt/test (= ["y" "z"] (vec (subs (str "xy" "z") 1 3)))
           _FILE_ _LINE_)

  (rt/test (= (count (subs "Bro" 0 1)) 1)
           _FILE_ _LINE_)
  (rt/test (= "abcd" (str "a" "" "bc" "d"))
           _FILE_ _LINE_)
  (rt/test (= (subs "bogus" 2 4) (subs "bogus" 2 9))
           _FILE_ _LINE_)
  (rt/test (= "" (empty "xy"))
           _FILE_ _LINE_)
  (rt/test (= "" (empty (subs "abc" 1 2)))
           _FILE_ _LINE_)
  (rt/test (= "" (empty (subs "abc" 1 2)))
           _FILE_ _LINE_)
  (rt/test (= None (empty? "abc"))
           _FILE_ _LINE_)
  (rt/test (= None (empty? (subs "abc" 1 3)))
           _FILE_ _LINE_)
  (rt/test (= None (first ""))
           _FILE_ _LINE_)
  (rt/test (= (Some "a") (first "abc"))
           _FILE_ _LINE_)
  (rt/test (= None (last ""))
           _FILE_ _LINE_)
  (rt/test (= (Some "c") (last "abc"))
           _FILE_ _LINE_)
  (rt/test (= "" (butlast ""))
           _FILE_ _LINE_)
  (rt/test (= "ab" (butlast "abc"))
           _FILE_ _LINE_)
  (rt/test (= "" (rest ""))
           _FILE_ _LINE_)
  (rt/test (= "" (rest (subs "aa" 1 1)))
           _FILE_ _LINE_)
  (rt/test (= "bc" (rest "abc"))
           _FILE_ _LINE_)
  (rt/test (= 0 (count ""))
           _FILE_ _LINE_)
  (rt/test (= 2 (count "ab"))
           _FILE_ _LINE_)
  (rt/test (= 0 (count (subs "a" 1 3)))
           _FILE_ _LINE_)
  (rt/test (= 2 (count (subs "abc" 1 3)))
           _FILE_ _LINE_)
  (rt/test (= empty-vector (vec (str "" "")))
           _FILE_ _LINE_)
  (rt/test (= ["x" "y" "z"] (vec (str "xy" "z")))
           _FILE_ _LINE_)
  (rt/test (= (Some "c") (nth "abc" 2))
           _FILE_ _LINE_)
  (rt/test (= None (= (Some "b") (nth "abc" 4)))
           _FILE_ _LINE_)

  (let [abc (str "abc" "")
        abcd (str "abcd" "")
        xyz (subs "wxyz" 1 4)
        wxyz (subs "vwxyz" 1 5)]
    (rt/test (< abc abcd)
             _FILE_ _LINE_)
    (rt/test (< abc xyz)
             _FILE_ _LINE_)
    (rt/test (< wxyz xyz)
             _FILE_ _LINE_)
    (rt/test (= None (< xyz abc))
             _FILE_ _LINE_))
  (let [s "string"]
    (sha1 s)
    (sha1 s))
  (let [s (subs (subs sample-str 1 4) 1 2)]
    (sha1 s)
    (sha1 s))
  (println "Strings are good"))
