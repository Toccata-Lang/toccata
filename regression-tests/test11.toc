(defn incer [a x]
  (pr* (number-str x))
  (inc a))

(defn add-newline [v]
  (inline "
  printf(\"\\n\");
  dec_and_free(v_1, 1);"))

(defn f [x]
  (-> x
      first
      .x
      number-str
      pr*))

(defn slow-add [x y]
  (inline String "
    printf(\"x: %p  y: %p\\n\", (void *)x_1, (void *)y_2);
    result = new_i60(get_i60(x_1) + get_i60(y_2));
"))

(main [_]
  (pr* "\nHowdy Test 11\n")
  [1 2 3]
  (let [v [1]]
    (conj v 3))
  (let [v [1]]
    (conj v 2)
    (conj v 3))
  [(|1 2|)]
  [(|1 2|) 5]
  [88 99 (|1 2|) 5]
  [(|8 4|) (|6 2|)]
  (vect-conj
   (vect-conj [] (|1 2|))
   3)
  (add-newline (f [(|9 8|) (|3 2|)]))
  (add-newline 
   (reduce [1 (|8 9 4|) 7 (|6 2|) 5 (|3|)]
           ;; [(|9 8|) (|3 2|)]
           0
           incer))

  (slow-add (|1 2|) (|3 4|))
  (vect-conj (|[1] [2]|) (|3 4|))

