
(def vect1 (vector 1 (+ 1 1) 3))
(def list1 (list (+ 1 3) 5 6 (+ 3 4)))
(def list2 list1)

(defn f1 [[x y z]]
  (pr* (number-str x))
  (pr* (number-str x))
  (pr* " ")
  (pr* (number-str y))
  (pr* (number-str y))
  (pr* " ")
  (pr* (number-str z))
  (pr* (number-str z))
  (pr* "\n"))

(main [_]
  (let [[a b c] list1]
    (pr* (number-str a))
    (pr* " ")
    (pr* (number-str b))
    (pr* " ")
    (pr* (number-str c))
    (pr* "\n"))
  ;; (let [[a] list1]
  ;;   (pr* (number-str a))
  ;;   (pr* "\n"))
  ;; (let [[a] list2]
  ;;   (pr* (number-str a))
  ;;   (pr* "\n"))
  ;; (let [[x y] vect1]
  (let [[x y z] vect1]
    (pr* (number-str x))
    (pr* " ")
    (pr* (number-str y))
    (pr* " "))
  (pr* "Now for the local call sites\n")
  (let [two (+ 1 1)
        [x y z] (vector 1 two 3)]
    (+ x y)
    (pr* (number-str x))
    (pr* " ")
    (pr* (number-str y))
    (pr* " ")
    (pr* (number-str z))
    (pr* " "))
  (let [a (+ 1 2)]
    (let [four (+ 1 3)
          [a b c & rst] (list four 5 6 (+ 1 9))]
      (pr* (number-str a))
      (pr* " ")
      (pr* (number-str b))
      (pr* " ")
      (pr* (number-str c))
      (pr* "\n"))
    (pr* (number-str a))
    (pr* "\n"))
  (pr* "Function destructuring\n")
  (f1 vect1)
  (f1 list1)
  (pr* "Vectors and Lists! Oh my!\n"))
