(add-ns rt (module "regression-tester.toc"))

;; Note: the elements in the result of `vec` are in implementation-dependent
;; order and may change. That is not an error — just update the affected tests.

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Key2 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn test-copy-assoc []
  ;; Test: add single entry to emptyBMI
  (rt/test (= 1 (count (copyAssoc emptyBMI (Key1 55) (Val 99) (sha1 (Key1 55)) 0)))
           _FILE_ _LINE_)

  ;; Test: replace entry in BMI
  (rt/test  (-> emptyBMI
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (count)
                (= 1))
            _FILE_ _LINE_)

  ;; Test: same key, different value → count 1, vec == [[k v2]] (bmiClone branch)
  (let [k (CHash 3 (Some 3))]
    (rt/test (and (= 1 (count (-> emptyBMI
                                  (copyAssoc k (Val 99) (sha1 k) 0)
                                  (copyAssoc k (Val 98) (sha1 k) 0))))
                  (= [[k (Val 98)]]
                     (vec (-> emptyBMI
                              (copyAssoc k (Val 99) (sha1 k) 0)
                              (copyAssoc k (Val 98) (sha1 k) 0)))))
             _FILE_ _LINE_))

  ;; Test: different key, different bit → count 2 (add branch)
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 4 (Some 4))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: different key, same bit, different hash at shift 5 (3 vs 35)
  ;; → count 2, sub-node (replace→createNode branch)
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: different key, identical hash (7/7 collision) → count 2,
  ;; collision node (replace→collision branch). bmiCopyAssoc checks
  ;; (= currKey k) with the existing key as the first arg, and CHash's `=`
  ;; gates on the first arg's `eq` field — so the existing (first-assoc'd)
  ;; key must carry eq=None to make the keys unequal and force the
  ;; collision branch; the new key carries eq=Some.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: recurse-into-child branch — keys 3+35 form a sub-node under bit 3;
  ;; assoc key 67 (bit 3 again) → bmiChild → copyAssoc into the child at
  ;; shift 5 (bit 2 there, empty slot) → bmiUpdate with changed child → count 3
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 67 (Some 67))]
    (rt/test (= 3 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0)
                             (copyAssoc k3 (Val 97) (sha1 k3) 0))))
             _FILE_ _LINE_))

  ;; Test: deep createNode — keys 3, 35, 67 build a 3-entry sub-node under bit 3
  ;; (created at shift 5 by the 35 replace); assoc key 195 (bit 3 again → bit 6
  ;; at shift 5) → recurse into the child, add at depth 1 → count 4
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 67 (Some 67))
        k4 (CHash 195 (Some 195))]
    (rt/test (= 4 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0)
                             (copyAssoc k3 (Val 97) (sha1 k3) 0)
                             (copyAssoc k4 (Val 96) (sha1 k4) 0))))
             _FILE_ _LINE_))

  ;; Test: same key, different value, key located inside a sub-node (depth 2)
  ;; → count unchanged, vec shows updated value (child-recurse + clone at
  ;; depth). Keys 3+35 form a sub-node under bit 3 (created at shift 5 by
  ;; the 35 replace, with k1 at bit 0 and k2 at bit 1 there); re-assoc'ing
  ;; key 3 recurses into the child and clones the sub-node with the new value.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))]
    (rt/test (and (= 2 (count (-> emptyBMI
                                  (copyAssoc k1 (Val 99) (sha1 k1) 0)
                                  (copyAssoc k2 (Val 98) (sha1 k2) 0)
                                  (copyAssoc k1 (Val 97) (sha1 k1) 0))))
                  (= [[k1 (Val 97)] [k2 (Val 98)]]
                     (vec (-> emptyBMI
                              (copyAssoc k1 (Val 99) (sha1 k1) 0)
                              (copyAssoc k2 (Val 98) (sha1 k2) 0)
                              (copyAssoc k1 (Val 97) (sha1 k1) 0)))))
             _FILE_ _LINE_))

  ;; Test: same key, same value, key located inside a sub-node (depth 2)
  ;; → child-recurse no-op: copyAssoc returns the child unchanged, so
  ;; bmiUpdate takes its same-child path (dec the child, return the node).
  ;; count and vec unchanged.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))]
    (rt/test (and (= 2 (count (-> emptyBMI
                                  (copyAssoc k1 (Val 99) (sha1 k1) 0)
                                  (copyAssoc k2 (Val 98) (sha1 k2) 0)
                                  (copyAssoc k1 (Val 99) (sha1 k1) 0))))
                  (= [[k1 (Val 99)] [k2 (Val 98)]]
                     (vec (-> emptyBMI
                              (copyAssoc k1 (Val 99) (sha1 k1) 0)
                              (copyAssoc k2 (Val 98) (sha1 k2) 0)
                              (copyAssoc k1 (Val 99) (sha1 k1) 0)))))
             _FILE_ _LINE_)))

(defn test-mutate-assoc []
  ;; --- bmiMutateAssoc (reached via assoc*, which routes to it when refs-count m == 3) ---

  ;; Same key, different value → bmiSetKV: the slot is updated in place.
  ;; count stays 1, vec shows the new value.
  (let [m (copyAssoc emptyBMI 55 (Val 99) (sha1 55) 0)
        m2 (assoc* m 55 (Val 98) (sha1 55) 0)]
    (rt/test (and (= 1 (count m2))
                  (= [[55 (Val 98)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Same key, same value → bmiSetKV still runs (the mutate path has no
  ;; no-op branch): the slot is reset to the equal key/val and the old
  ;; contents freed. count 1, vec unchanged.
  (let [m (copyAssoc emptyBMI 55 (Val 99) (sha1 55) 0)
        m2 (assoc* m 55 (Val 99) (sha1 55) 0)]
    (rt/test (and (= 1 (count m2))
                  (= [[55 (Val 99)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Different key, different bit → addCopiedBMI: a new 2-entry node.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 4 (Some 4))
        m (copyAssoc emptyBMI k1 (Val 99) (sha1 k1) 0)
        m2 (assoc* m k2 (Val 98) (sha1 k2) 0)]
    (rt/test (and (= 2 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Different key, same bit, different hash (3 vs 35) → bmiReplaceMutate
  ;; (createNode): a sub-node under bit 3. count 2, vec flattened in.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (copyAssoc emptyBMI k1 (Val 99) (sha1 k1) 0)
        m2 (assoc* m k2 (Val 98) (sha1 k2) 0)]
    (rt/test (and (= 2 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Different key, same bit at shift 0 and shift 5, different at shift 10
  ;; (3 vs 1027) → bmiReplaceMutate (createNode recursion): the sub-node
  ;; under bit 3 holds another sub-node with the two keys. count 2, vec
  ;; flattened.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 1027 (Some 1027))
        m (copyAssoc emptyBMI k1 (Val 99) (sha1 k1) 0)
        m2 (assoc* m k2 (Val 98) (sha1 k2) 0)]
    (rt/test (and (= 2 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Different key, identical hash (7/7) → bmiReplaceMutate (collision node).
  ;; The existing (first) key carries eq=None so (= currKey k) is false, forcing
  ;; the replace; the new key carries eq=Some. count 2. (vec not asserted:
  ;; bmiVec does not yet descend into collision-node sub-nodes.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (copyAssoc emptyBMI k1 (Val 99) (sha1 k1) 0)
        m2 (assoc* m k2 (Val 98) (sha1 k2) 0)]
    (rt/test (= 2 (count m2))
             _FILE_ _LINE_))

  ;; Recurse-into-child branch: keys 3+35 form a sub-node under bit 3 (created
  ;; by the 35 createNode, with k1 at bit 0 and k2 at bit 1 there). assoc* key
  ;; 67 (bit 3 again) → bmiMutateChild returns the sub-node (borrowed) →
  ;; assoc* on the child: k3's slot (bit 2 at shift 5) is empty, so the child
  ;; is rebuilt with k3 added → bmiSetChild points the slot at the new child.
  ;; count 3, vec flattened in bit order.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 67 (Some 67))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (assoc* m k3 (Val 97) (sha1 k3) 0)]
    (rt/test (and (= 3 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)] [k3 (Val 97)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Same key, different value, key located inside a sub-node (depth 2) →
  ;; child recurse where the child's assoc* hits the same-key branch
  ;; (bmiSetKV in the child, in place): count unchanged, vec shows the
  ;; updated value.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (assoc* m k1 (Val 97) (sha1 k1) 0)]
    (rt/test (and (= 2 (count m2))
                  (= [[k1 (Val 97)] [k2 (Val 98)]] (vec m2)))
             _FILE_ _LINE_))

  ;; Shared child → copy fallback: m1's sub-node under bit 3 (keys 3+35) is
  ;; shared with m2 (addCopiedBMI shares child slots when it clones).
  ;; assoc* on m1 with key 67 (bit 3 again) → the child carries a second
  ;; slot ref, so its refs-count is not 3 and assoc* copies the child
  ;; instead of mutating it; bmiSetChild points m1's slot at the new child.
  ;; m1 gains k4, m2 is untouched.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 4 (Some 4))
        k4 (CHash 67 (Some 67))
        m1 (-> emptyBMI
               (copyAssoc k1 (Val 99) (sha1 k1) 0)
               (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (copyAssoc m1 k3 (Val 97) (sha1 k3) 0)
        m3 (assoc* m1 k4 (Val 96) (sha1 k4) 0)]
    (rt/test (and (= 3 (count m3))
                  (= [[k1 (Val 99)] [k2 (Val 98)] [k4 (Val 96)]] (vec m3))
                  (= 3 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)] [k3 (Val 97)]] (vec m2)))
             _FILE_ _LINE_)))

(defn test-assoc-collision-child []
  ;; --- assoc* into a map whose child is a collision node (the 4.4 BOOM fix) ---
  ;; A BMI map whose slot at bit 7 (mask 128) holds a HashCollisionNode child:
  ;; assoc two keys with identical hash (7/7) into emptyBMI, the first with
  ;; eq=None so bmiCopyAssoc's (= currKey k) is false → the collision branch →
  ;; a BMI with a single slot (bit 7) holding [k1 v1, k2 v2].
  ;;
  ;; assoc* on the map (m is let-bound and used exactly once, so refs-count
  ;; m == 3 → the bmiMutateAssoc mutate path) with a key at bit 7 →
  ;; bmiMutateChild borrows the collision child (no incRef) → assoc* on it —
  ;; the dispatch that BOOMed before 4.4 (no method for the type) — routes to
  ;; HashCollisionNode's assoc*, which always copies (C has no
  ;; collisionMutateAssoc): collisionAssoc consumes the borrowed slot ref and
  ;; returns a fresh node, and bmiSetChild points the slot at it (the swap
  ;; balances — the copy consumed the old slot ref).

  ;; Append (hash match, no =-equal entry): the child holds two eq=None
  ;; entries, so collisionAssoc-find's entry-key-first `=` is false for both;
  ;; a third same-hash key (eq=Some) is appended (collisionAppend) → a
  ;; 3-entry collision child [k1 v1, k2 v2, k3 v3]. A flat sibling at bit 3
  ;; (k0) survives the in-place slot swap. count 4 (1 flat + 3 in the child),
  ;; bitmap 136; get hits the new key and the sibling.
  (let [k0 (CHash 3 (Some 3))
        k1 (CHash 7 None)
        k2 (CHash 7 None)
        k3 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k0 (Val 96) (sha1 k0) 0)
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (assoc* m k3 (Val 97) (sha1 k3) 0)
        child (either (map (bmiCopyChild m2 128) (fn [c] c)) emptyBMI)]
    (rt/test (and (= 4 (count m2))
                  (= 136 (bmiBitMap m2))
                  (= 13 (type-num child))
                  (= 3 (collisionCount child))
                  (= (Val 99) (collisionVal child 0))
                  (= (Val 98) (collisionVal child 1))
                  (= (Val 97) (collisionVal child 2))
                  (= (Some (Val 97)) (get m2 k3))
                  (= (Some (Val 96)) (get m2 k0)))
             _FILE_ _LINE_))

  ;; Update (hash match, entry =-equal): the child holds k1 (eq=None) and
  ;; k2 (eq=Some); a third same-hash key (eq=Some) =-equals entry 1
  ;; (collisionAssoc-find's entry-key-first `=` is false for entry 0 — k1's
  ;; eq=None gate — and true for entry 1) → collisionUpdate replaces entry 1
  ;; with (k3 v3), count unchanged → a 2-entry collision child [k1 v1, k3 v3].
  ;; count 2, bitmap 128; get hits the updated value.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        k3 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (assoc* m k3 (Val 97) (sha1 k3) 0)
        child (either (map (bmiCopyChild m2 128) (fn [c] c)) emptyBMI)]
    (rt/test (and (= 2 (count m2))
                  (= 128 (bmiBitMap m2))
                  (= 13 (type-num child))
                  (= 2 (collisionCount child))
                  (= (Val 99) (collisionVal child 0))
                  (= (Val 97) (collisionVal child 1))
                  (= (Some (Val 97)) (get m2 k3)))
             _FILE_ _LINE_)))

(defn test-get []
  ;; --- get (BitmapIndexedNode) ---

  ;; Hit (flat): a 1-entry flat node. get returns (Some val).
  (let [m (copyAssoc emptyBMI 55 (Val 99) (sha1 55) 0)]
    (rt/test (= (Some (Val 99)) (get m 55))
             _FILE_ _LINE_))

  ;; Miss (flat, bit not set): the key's bit is absent from the node's bitmap
  ;; (56 is bit 24, the node holds 55 at bit 23) → bmiGet's else branch
  ;; returns def; get maps the sentinel to None.
  (let [m (copyAssoc emptyBMI 55 (Val 99) (sha1 55) 0)
        k 56
        def (Val 123)]
    (rt/test (and (= def (get* m k def (sha1 k) 0))
                  (= None (get m k)))
             _FILE_ _LINE_))

  ;; Miss (flat, bit set but key mismatch): the bit is present but holds a
  ;; different key (55 and 87 share bit 23 at shift 0) → the key-compare
  ;; branch returns def; get returns None.
  (let [m (copyAssoc emptyBMI 55 (Val 99) (sha1 55) 0)
        k 87
        def (Val 123)]
    (rt/test (and (= def (get* m k def (sha1 k) 0))
                  (= None (get m k)))
             _FILE_ _LINE_))

  ;; Hit (sub-node, depth 2): keys 3+35 form a sub-node under bit 3 (created
  ;; by the 35 createNode, with k1 at bit 0 and k2 at bit 1 there). get
  ;; recurses through the sub-node slot (bmiCopyChild → get* at shift 5) and
  ;; hits the flat slot in the child. Both keys are asserted: they sit at
  ;; different bits inside the child.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))]
    (rt/test (and (= (Some (Val 99)) (get m k1))
                  (= (Some (Val 98)) (get m k2)))
             _FILE_ _LINE_))

  ;; Miss (sub-node, bit not set in child): keys 3+35 form a sub-node under
  ;; bit 3 (k1 at bit 0 and k2 at bit 1 at shift 5). Key 67 has bit 3 at
  ;; shift 0, so the parent recurses into the sub-node slot (bmiCopyChild →
  ;; get* at shift 5), but 67's bit 2 at shift 5 is absent from the child's
  ;; bitmap → the child returns def; get maps the sentinel to None.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        k (CHash 67 (Some 67))
        def (Val 123)]
    (rt/test (and (= def (get* m k def (sha1 k) 0))
                  (= None (get m k)))
             _FILE_ _LINE_))

  ;; Miss (sub-node, bit set in child but key mismatch): key 1027 has bit 3
  ;; at shift 0 (recurses into the sub-node) and bit 0 at shift 5, where the
  ;; child holds k1 (hash 3); the hashes differ, so the child's key-compare
  ;; branch returns def; get returns None.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        k (CHash 1027 (Some 1027))
        def (Val 123)]
    (rt/test (and (= def (get* m k def (sha1 k) 0))
                  (= None (get m k)))
             _FILE_ _LINE_))

  ;; Hit (collision node): keys k1+k2 with identical hash (7/7) form a
  ;; collision node under bit 7 (the 7/7 collision branch of copyAssoc,
  ;; Group A). get recurses through the sub-node slot (bmiCopyChild →
  ;; get* at shift 5) and HashCollisionNode's get* linear-scans its
  ;; entries. The scan compares entry-key-first via the `=` protocol
  ;; (the bmiCopyAssoc convention): (= k1 k2) is false (k1's eq=None
  ;; gate) and (= k2 k2) is true, so the lookup k2 (eq=Some) hits its
  ;; own entry — get* returns the value (not def), get returns (Some val).
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        def (Val 123)]
    (rt/test (and (= (Val 98) (get* m k2 def (sha1 k2) 0))
                  (= (Some (Val 98)) (get m k2)))
             _FILE_ _LINE_))
  )

(defn test-dissoc []
  ;; --- dissoc (BitmapIndexedNode) ---

  ;; Remove from a flat node: a 2-entry flat node (different bits, both flat
  ;; slots — no sub-node). dissoc the first key → the C bmiDissoc flat path
  ;; with popcount > 1 → bmiShrink: a new node with the slot removed and the
  ;; entries compacted. count 1, vec shows the surviving entry; the original
  ;; map is untouched (dissoc copies, it never mutates).
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 4 (Some 4))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (dissoc m k1)]
    (rt/test (and (= 1 (count m2))
                  (= [[k2 (Val 98)]] (vec m2))
                  (= 2 (count m)))
             _FILE_ _LINE_))

  ;; Remove the last entry → emptyBMI: a 1-entry flat node. dissoc its only
  ;; key → the C bmiDissoc last-entry path (key match, popcount == 1) frees
  ;; the node and returns the global emptyBMI: count 0, bitmap 0, vec [].
  ;; The original map is untouched (dissoc copies, it never mutates).
  (let [k (CHash 3 (Some 3))
        m (copyAssoc emptyBMI k (Val 99) (sha1 k) 0)
        m2 (dissoc m k)]
    (rt/test (and (= 0 (count m2))
                  (= 0 (bmiBitMap m2))
                  (= [] (vec m2))
                  (= 1 (count m)))
             _FILE_ _LINE_))

  ;; Remove a missing key (no-op, bit not set): a 2-entry flat node
  ;; (k1 hash 3 at bit 0, k2 hash 4 at bit 2). dissoc a key whose bit is
  ;; absent from the node's bitmap (67 is bit 6) → the C bmiDissoc
  ;; bit-not-set path returns the node unchanged: count and vec are the
  ;; same as before, the original map untouched.
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 4 (Some 4))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        k (CHash 67 (Some 67))
        m2 (dissoc m k)]
    (rt/test (and (= 2 (count m2))
                  (= [[k1 (Val 99)] [k2 (Val 98)]] (vec m2))
                  (= 2 (count m)))
             _FILE_ _LINE_))

  ;; Remove a missing key (no-op, bit set but key mismatch): a 1-entry
  ;; flat node holding k1 (hash 3, bit 0 at shift 0). dissoc key 35 (bit 0
  ;; at shift 0, different hash) → the bit is set but the slot holds a
  ;; different key; the `=` protocol (lookup key first) is false → the C
  ;; bmiDissoc key-mismatch path returns the node unchanged.
  (let [k1 (CHash 3 (Some 3))
        m (copyAssoc emptyBMI k1 (Val 99) (sha1 k1) 0)
        k (CHash 35 (Some 35))
        m2 (dissoc m k)]
    (rt/test (and (= 1 (count m2))
                  (= [[k1 (Val 99)]] (vec m2))
                  (= 1 (count m)))
             _FILE_ _LINE_))

  ;; Remove a key inside a sub-node (shrink): the parent holds a sub-node
  ;; under bit 3 (k1 hash 3 at bit 0, k2 hash 35 at bit 1, at shift 5) plus
  ;; a flat k3 (hash 4, bit 4) → parent popcount 2. dissoc k1 → the C
  ;; bmiDissoc sub-node path: recurse into the child (dissoc* at shift 5),
  ;; the child shrinks 2 → 1 entries (k2 survives, bmiShrink), and since the
  ;; child is not emptyBMI the parent is cloned with the shrunk child
  ;; (bmiUpdate → cloneBitmapIndexedNode). count 2, vec shows the survivor
  ;; pairs flattened in bit order; the original map is untouched (dissoc
  ;; copies, it never mutates).
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 4 (Some 4))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0)
              (copyAssoc k3 (Val 97) (sha1 k3) 0))
        m2 (dissoc m k1)]
    (rt/test (and (= 2 (count m2))
                  (= [[k2 (Val 98)] [k3 (Val 97)]] (vec m2))
                  (= 3 (count m)))
             _FILE_ _LINE_))

  ;; Remove so a sub-node becomes empty and is the parent's only entry:
  ;; the parent holds a single slot (bit 3) that is a sub-node (k1 hash 3
  ;; at bit 0, k2 hash 35 at bit 1, at shift 5). dissoc k1 → the child
  ;; shrinks 2 → 1 (k2 survives) and the parent is cloned with the shrunk
  ;; child (the 2.6 path); m2 is asserted to have that shape (the slot is a
  ;; sub-node, the child holds 1 entry). Then dissoc k2 from m2 → recurse
  ;; into the child: 1 entry, key match, popcount 1 → the child becomes
  ;; emptyBMI; the C bmiDissoc sub-node path sees n == emptyBMI and the
  ;; parent's popcount == 1 → frees the parent and returns the global
  ;; emptyBMI. count 0, bitmap 0, vec []; both intermediate maps are
  ;; untouched (dissoc copies, it never mutates).
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        m2 (dissoc m k1)
        m3 (dissoc m2 k2)]
    (rt/test (and (= 1 (count (either (map (bmiCopyChild m2 8) (fn [c] c)) emptyBMI)))
                  (= 0 (count m3))
                  (= 0 (bmiBitMap m3))
                  (= [] (vec m3))
                  (= 1 (count m2))
                  (= [[k2 (Val 98)]] (vec m2))
                  (= 2 (count m)))
             _FILE_ _LINE_)))

(defn test-promotion []
  ;; --- BMI → ArrayNode promotion (the 17th entry) ---
  ;; A BMI holds at most 16 flat entries at a level. Build a 16-entry flat BMI
  ;; (16 keys with 16 distinct bits at shift 0), then assoc a 17th key whose
  ;; bit is empty: bmiCopyAssoc's empty-bit branch calls addCopiedBMI, whose
  ;; n >= 16 promotion branch converts the node to an ArrayNode (each flat
  ;; entry wrapped in its own 1-entry BMI sub-node, the new key in a fresh
  ;; sub-node at its slot). count then dispatches to ArrayNode's count (C
  ;; arrayNodeCount, summing mapCount over the 17 non-empty slots) → 17.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))]
    (rt/test (= 16 (count full-bmi))
             _FILE_ _LINE_)
    (rt/test (= 17 (count (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)))
             _FILE_ _LINE_)))

(defn main [_]
  (println "Checking BMI regressions")

  ;; Test: emptyBMI bitmap is 0
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  (test-copy-assoc)
  (test-mutate-assoc)
  (test-assoc-collision-child)
  (test-get)
  (test-dissoc)
  (test-promotion)

  (println "BMI tests are good")
  )
