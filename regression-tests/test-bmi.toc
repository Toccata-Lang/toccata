(add-ns rt (module "regression-tester.toc"))

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Key2 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(defn main [_]
  (println "Checking BMI regressions")

  ;; Test: emptyBMI bitmap is 0
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  ;; Test: add single entry to emptyBMI
  (rt/test (= 1 (count (copyAssoc emptyBMI (Key1 55) (Val 99))))
           _FILE_ _LINE_)

  ;; Test: replace entry in BMI
  (rt/test  (-> emptyBMI
                (copyAssoc 55 (Val 99))
                (copyAssoc 55 (Val 99))
                (copyAssoc 55 (Val 99))
                (count)
                (= 1))
           _FILE_ _LINE_)

  (println "BMI tests are good")
  )
