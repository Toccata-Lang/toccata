(add-ns rt (module "regression-tester.toc"))

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Key2 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn main [_]
  (println "Checking BMI regressions")

  ;; Test: emptyBMI bitmap is 0
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  ;; Test: add single entry to emptyBMI
  (rt/test (= 1 (count (copyAssoc emptyBMI (Key1 55) (Val 99) (sha1 (Key1 55)) 0)))
           _FILE_ _LINE_)

  ;; Test: replace entry in BMI
  (rt/test  (-> emptyBMI
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (copyAssoc 55 (Val 99) (sha1 55) 0)
                (count)
                (= 1))
           _FILE_ _LINE_)

  ;; Test: same key, different value → count 1, vec == [[k v2]] (bmiClone branch)
  (let [k (CHash 3 (Some 3))]
    (rt/test (and (= 1 (count (-> emptyBMI
                                  (copyAssoc k (Val 99) (sha1 k) 0)
                                  (copyAssoc k (Val 98) (sha1 k) 0))))
                 (= [[k (Val 98)]]
                    (vec (-> emptyBMI
                             (copyAssoc k (Val 99) (sha1 k) 0)
                             (copyAssoc k (Val 98) (sha1 k) 0)))))
             _FILE_ _LINE_))

  ;; Test: different key, different bit → count 2 (add branch)
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 4 (Some 4))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: different key, same bit, different hash at shift 5 (3 vs 35)
  ;; → count 2, sub-node (replace→createNode branch)
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: different key, identical hash (7/7 collision) → count 2,
  ;; collision node (replace→collision branch). bmiCopyAssoc checks
  ;; (= currKey k) with the existing key as the first arg, and CHash's `=`
  ;; gates on the first arg's `eq` field — so the existing (first-assoc'd)
  ;; key must carry eq=None to make the keys unequal and force the
  ;; collision branch; the new key carries eq=Some.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))]
    (rt/test (= 2 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0))))
             _FILE_ _LINE_))

  ;; Test: recurse-into-child branch — keys 3+35 form a sub-node under bit 3;
  ;; assoc key 67 (bit 3 again) → bmiChild → copyAssoc into the child at
  ;; shift 5 (bit 2 there, empty slot) → bmiUpdate with changed child → count 3
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 67 (Some 67))]
    (rt/test (= 3 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0)
                             (copyAssoc k3 (Val 97) (sha1 k3) 0))))
             _FILE_ _LINE_))

  ;; Test: deep createNode — keys 3, 35, 67 build a 3-entry sub-node under bit 3
  ;; (created at shift 5 by the 35 replace); assoc key 195 (bit 3 again → bit 6
  ;; at shift 5) → recurse into the child, add at depth 1 → count 4
  (let [k1 (CHash 3 (Some 3))
        k2 (CHash 35 (Some 35))
        k3 (CHash 67 (Some 67))
        k4 (CHash 195 (Some 195))]
    (rt/test (= 4 (count (-> emptyBMI
                             (copyAssoc k1 (Val 99) (sha1 k1) 0)
                             (copyAssoc k2 (Val 98) (sha1 k2) 0)
                             (copyAssoc k3 (Val 97) (sha1 k3) 0)
                             (copyAssoc k4 (Val 96) (sha1 k4) 0))))
             _FILE_ _LINE_))

  (println "BMI tests are good")
  )
