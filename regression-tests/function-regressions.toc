(add-ns rt (module "regression-tester.toc"))

;; TODO: this causes the compiler to blow the stack
;; infinite recursion while inlining
;; (extend-type Integer
;;   Container
;;   (map [n f]
;;     (either (= 0 n)
;;             (map (dec n) f))))

(def one (+ (inc -2) (inc 1)))

(defn no-op-fixed [x y z]
  None)

(defn f2 []
  (let [x (inc 0)
        y x
        f (fn [] (+ x y))]
    (f)))

(defn f3 [y]
  (inc (let [_ (inc 99)]
         y)))

(defn main [_]
  (println "Checking function regressions")
  (identity one)
  (no-op-fixed one (inc 2) (inc 3))
  (let [new-str (str-malloc (inc 11))]
    (str-append new-str (str "file" "\n")))
  (let [new-str (str-malloc 12)
        _ (str-append new-str "bogus")
        _ (str-append new-str ".")]
    (str-append new-str "file\n"))
  (let [new-str (str-malloc 12)
        l [["1"] 2 ['three] 'four]
        _ (str-append new-str "bogus")
        _ (str-append new-str ".")]
    (str-append new-str "file\n"))
  (let [v [1]]
    (no-op-fixed v v v))
  (let [inc-val (inc 0)
        f2 (fn [x]
             (+ inc-val x))
        f3 (fn [x]
             (inc x))]
    (rt/test (= (f2 9) (f3 9))
             _FILE_ _LINE_))

  (let [x (inc 0)
        fx (fn [_]
             (inc x))]
    (fx (inc 1)))

  (f2)

  (let [x (inc 0)
        fx (fn fx []
             (inc (let [_ (inc 99)]
                    x)))
        fy (fn fy []
             [x]
             [x])]
    (fy))

  (f3 (inc 0))

  (let [l [22]
        f (fn [h]
            l
            h
            (Some l))]
    (f one))
  (let [l ["xy"]]
    ((fn [x] (Some l)) 0))

  (println "Functions are good"))
