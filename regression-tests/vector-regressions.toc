
(add-ns rt (module "regression-tester.toc"))

(def three-vect [(inc 0) (inc 1) (inc 2)])

(defn f [x]
  [(inc x)])

(defn double [x]
  (* 2 x))

(defn g [x]
  [(double x)])

(defn main [_]
  (println "Check vector regressions")
  ;; (rt/test (instance? Vector [(inc 0) (inc 1) (inc 2)])
  ;;          _FILE_ _LINE_)
  ;; (rt/test (= None (instance? Vector (char 66)))
  ;;          _FILE_ _LINE_)
  (rt/test (= "Vector" (type-name [1 2 3]))
           _FILE_ _LINE_)
  (rt/test (= 3 (count three-vect))
           _FILE_ _LINE_)
  (rt/test (= (Some 3) (get [(inc 2)] (dec 1)))
           _FILE_ _LINE_)
  (rt/test (= None (get [(inc 1)] (dec 2)))
           _FILE_ _LINE_)
  (rt/test (= (Some 2) (nth [1 (inc 1) 3] (dec 2)))
           _FILE_ _LINE_)
  (rt/test (= None (nth [1 2 3] (inc 2)))
           _FILE_ _LINE_)
  (rt/test (= [3] (vector 3))
           _FILE_ _LINE_)
  (rt/test (= [[3]] (vector [(inc 2)]))
           _FILE_ _LINE_)
  (rt/test (= [3] (conj [] (inc 2)))
           _FILE_ _LINE_)
  (rt/test (= 3 (count (conj (conj (conj [] (inc 2)) (inc 1)) (inc 0))))
           _FILE_ _LINE_)
  (rt/test (= [3 2 1] (conj (conj (conj [] 3) 2) 1))
           _FILE_ _LINE_)
  (rt/test (empty? [])
           _FILE_ _LINE_)
  (rt/test (= None (empty? [3]))
           _FILE_ _LINE_)
  (rt/test (empty? (rest []))
           _FILE_ _LINE_)
  (rt/test (= 4 (count (comp [1 2] [3 4])))
           _FILE_ _LINE_)
  (rt/test (empty? (empty [1 2]))
           _FILE_ _LINE_)
  (rt/test (= [1 2 4] (flat-map [0 (inc 0) 3]
                                (fn [x]
                                  [(+ 1 x)])))
           _FILE_ _LINE_)
  (rt/test (= [1 22 2 22 3] (let [sep 22]
                              (rest (flat-map [1 (inc 1) 3]
                                              (fn [x]
                                                [sep x])))))
           _FILE_ _LINE_)
  (rt/test (= [1 22 2 22 3] (interpose [1 (inc 1) 3] 22))
           _FILE_ _LINE_)
  (let [inc-val (inc 0)]
    (rt/test (= 4 (count (filter [(inc 0) 2 3 1 (inc 0) (inc 4) 1 6 (inc 6)]
                                 (fn [x] (= x inc-val)))))
             _FILE_ _LINE_))
  
  (let [inc-val (inc 0)]
    (rt/test (= [1 2 4] (flat-map [0 (inc 0) 3]
                                  (fn [x]
                                    [(+ inc-val x)])))
             _FILE_ _LINE_))
  (let [inc-val (inc 0)]
    (rt/test (= [2 3 4] (map [1 2 3] (fn [x] (+ inc-val x))))
             _FILE_ _LINE_))
  (rt/test (= [2] (wrap [1 2 3] (inc 1)))
           _FILE_ _LINE_)
  (rt/test (= (Some 3) (last [1 2 (inc 2)]))
           _FILE_ _LINE_)
  (rt/test (= None (last []))
           _FILE_ _LINE_)

  (rt/test (= 6 (reduce [(inc 2) (inc 1) 1] 0 +))
           _FILE_ _LINE_)
  (rt/test (= 6 (reduce [(inc 2) (inc 1) (inc 0)] 0 +))
           _FILE_ _LINE_)
  (rt/test (= 10 (count (range 10)))
           _FILE_ _LINE_)
  (rt/test (= "[]" (str []))
           _FILE_ _LINE_)

  (rt/test (= 6000 (count (range 6000)))
           _FILE_ _LINE_)
  (rt/test (= 2000 (count (reduce (range 2000) [] conj)))
           _FILE_ _LINE_)
  (let [big-v (range 65)]
    (rt/test (= 2080 (count (flat-map big-v (fn [x] (range x)))))
             _FILE_ _LINE_))

  (rt/test (= (map [12] (fn [x] x)) [12])
           _FILE_ _LINE_)
  (rt/test (= (map (map [2] inc) double)
              (map [2] (fn [x]
                        (double (inc x)))))
           _FILE_ _LINE_)
  (rt/test (= (flat-map (vector 4) f) (f 4))
           _FILE_ _LINE_)

  (rt/test (= (flat-map (vector 8) (fn [x] [x])) [8])
           _FILE_ _LINE_)
  (rt/test (= (flat-map (vector 4) (fn [x] [x])) [4])
           _FILE_ _LINE_)
  (rt/test (= empty-vector (reverse empty-vector))
           _FILE_ _LINE_)
  
  (rt/test (= [1 2 3] (reverse [3 (inc 1) 1]))
           _FILE_ _LINE_)
  (rt/test (= [1 2 3] (reverse [(inc 2) (inc 1) (inc 0)]))
           _FILE_ _LINE_)

  (rt/test (= [] (subvec [(inc 1) "01" (inc 2)] (inc 90) (inc 0)))
           _FILE_ _LINE_)
  (rt/test (= ["01"] (subvec [(inc 1) "01" (inc 2)] (inc 0) (inc 0)))
           _FILE_ _LINE_)
  (rt/test (= ["1" 3] (subvec [(inc 1) "1" (inc 2)] (inc 0) (inc 6)))
           _FILE_ _LINE_)

  (rt/test (= [95 96 97 98 99] (subvec (range 100) (inc 94) 10))
           _FILE_ _LINE_)
  (rt/test (= ["1" 3] (subvec [2 "1" 3] 1 3))
           _FILE_ _LINE_)
  (rt/test (= [30 31 2] (subvec (conj (range (inc 31)) (inc 1)) 30 5))
           _FILE_ _LINE_)
  (rt/test (= [31 32 2] (subvec (conj (range 33) (inc 1)) 31 4))
           _FILE_ _LINE_)

  (rt/test (and (= (vector 10)
                   (flat-map (flat-map [4] f) g))
                (= (vector 10)
                   (flat-map [4] (fn [x] (flat-map (f x) g)))))
           _FILE_ _LINE_)

  (rt/test (= (Some [55]) (vect-store [] (dec 1) (inc 54)))
           _FILE_ _LINE_)
  (rt/test (= (Some [55 2 3 4]) (store [(inc 0) 2 3 4] (dec 1) (inc 54)))
           _FILE_ _LINE_)
  (rt/test (= (Some [1 2 55 4]) (store [(inc 0) 2 (inc 2) 4] (inc 1) (inc 54)))
           _FILE_ _LINE_)
  (rt/test (= (Some [1 2 3 4 55]) (store [1 2 3 (inc 3)] (inc 3) (inc 54)))
           _FILE_ _LINE_)
  (rt/test (= None (store [(inc 0) 2 3 4] (inc 8) (inc 54)))
           _FILE_ _LINE_)
  (rt/test (= (Some [24 55 26])
              (map (store (range 40) 25 55) (fn [v]
                                                 (subvec v 24 3))))
           _FILE_ _LINE_)

  ;; Failing tests
  
  ;; (rt/test (= "[8 1]" (str [8 1]))
  ;;          _FILE_ _LINE_)

  ;; (let [m (vector "ring" (inc 4))]
  ;;   (sha1 m)
  ;;   (sha1 m))
  ;; (let [[x y] (drop-while ['a 'b 1 3] (partial instance? Symbol))]
  ;;   (rt/test (= 2 (inc x))
  ;;            _FILE_ _LINE_))

  ;; (println "Vectors are good")
  )
