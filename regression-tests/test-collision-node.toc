(add-ns rt (module "regression-tester.toc"))

;; Note: the elements in the result of `vec` are in implementation-dependent
;; order and may change. That is not an error — just update the affected tests.

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn test-assoc-add []
  ;; --- assoc: add a key to a collision node (collisionAssoc hash-match/append) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2] (C's
  ;; bmiReplaceCopied collision case, malloc_hashCollisionNode(2)). Extract it
  ;; with bmiCopyChild (owned ref; bit mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with the same hash (7) that is not =-equal
  ;; to either entry (both entries carry eq=None, so collisionAssoc-find's
  ;; entry-key-first `=` is false for both) → the hash-match/append branch:
  ;; collisionAppend clones the node with (k3 v3) appended as entry 2 → a
  ;; 3-entry collision node [k1 v1, k2 v2, k3 v3]. count 3; the old entries
  ;; are preserved in order (their values pin the order — the eq=None keys
  ;; are mutually indistinguishable under the `=` protocol); get* hits the
  ;; new key. (A fresh emptyCollisionNode is not a valid starting point —
  ;; collisionAssoc/collisionAppend do not NULL-guard, per 4.2 — so the
  ;; BMI-promoted node is the construction.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)]
    (rt/test (and (= 3 (collisionCount m2))
                  (= (Val 99) (collisionVal m2 0))
                  (= (Val 98) (collisionVal m2 1))
                  (= (Val 97) (collisionVal m2 2))
                  (= k3 (collisionKey m2 0))
                  (= k3 (collisionKey m2 1))
                  (= k3 (collisionKey m2 2))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0)))
             _FILE_ _LINE_)))

(defn test-assoc-update []
  ;; --- assoc: update an existing key in a collision node (collisionAssoc hash-match/update) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2]. The
  ;; second key carries eq=Some, so a later same-hash lookup key can =-equal
  ;; it: the eq gate is on the first arg, and collisionAssoc-find scans
  ;; entry-key-first. Extract the node with bmiCopyChild (owned ref; bit
  ;; mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with the same hash (7, eq=Some):
  ;; collisionAssoc-find's entry-key-first `=` is false for entry 0 (k1's
  ;; eq=None gate) and true for entry 1 (k2's eq=Some, same hash) → the
  ;; hash-match/update branch: collisionUpdate clones the node with entry 1
  ;; replaced by (k3 v3), count unchanged → a 2-entry collision node
  ;; [k1 v1, k3 v3]. count 2 (not 3 — this is the update, not the append,
  ;; branch); entry 0 is untouched; get* hits the updated value. (A fresh
  ;; emptyCollisionNode is not a valid starting point —
  ;; collisionAssoc/collisionAppend do not NULL-guard, per 4.2 — so the
  ;; BMI-promoted node is the construction.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)]
    (rt/test (and (= 2 (collisionCount m2))
                  (= (Val 99) (collisionVal m2 0))
                  (= (Val 97) (collisionVal m2 1))
                  (= k3 (collisionKey m2 0))
                  (= k3 (collisionKey m2 1))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0)))
             _FILE_ _LINE_)))

(defn test-assoc-promote []
  ;; --- assoc: promote to a BMI on hash mismatch (collisionAssoc hash-mismatch) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2].
  ;; Extract it with bmiCopyChild (owned ref; bit mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with a DIFFERENT hash (3) → the
  ;; hash-mismatch branch: the node is promoted to a BMI. k3 goes into a
  ;; fresh BMI at shift 0 (bit 3, flat), then the existing entries are
  ;; assoc*'d in with their own sha1: k1 (hash 7 → bit 7, a new empty bit →
  ;; flat) and k2 (hash 7 → bit 7 again; (= currKey k) is false — k1's
  ;; eq=None gate — so bmiReplaceMutate's collision case) → the slot at bit 7
  ;; becomes a collision node [k1 v1, k2 v2] (existing entry first, new entry
  ;; appended). The result is a BitmapIndexedNode (type 11), NOT a collision
  ;; node: bitmap 136 (8 | 128), count 3 (1 flat + 2 in the collision child),
  ;; get* hits k3 (flat, Val 97) and k2 (inside the collision child, Val 98 —
  ;; k1's entry is unreachable under get* because its eq=None gate sits on the
  ;; first arg and collisionGet scans entry-key-first), the flat slot at bit 3
  ;; holds k3/Val 97, and the child at bit 7 is a 2-entry collision node
  ;; (type 13) with the original entries preserved in order (Val 99, Val 98).
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 3 (Some 3))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)
        child (either (map (bmiCopyChild m2 128) (fn [c] c)) emptyBMI)]
    (rt/test (and (= 11 (type-num m2))
                  (= 136 (bmiBitMap m2))
                  (= 3 (count m2))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0))
                  (= (Val 98) (get* m2 k2 def (sha1 k2) 0))
                  (= k3 (bmiKey m2 8))
                  (= (Val 97) (bmiVal m2 8))
                  (= 13 (type-num child))
                  (= 2 (collisionCount child))
                  (= (Val 99) (collisionVal child 0))
                  (= (Val 98) (collisionVal child 1)))
             _FILE_ _LINE_)))

(defn main [_]
  (println "Checking CollisionNode regressions")

  ;; Seed test (trivially green): emptyBMI's bitmap is 0.
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  (test-assoc-add)

  (test-assoc-update)

  (test-assoc-promote)

  (println "CollisionNode tests are good")
  )
