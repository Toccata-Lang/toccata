(add-ns rt (module "regression-tester.toc"))

;; Note: the elements in the result of `vec` are in implementation-dependent
;; order and may change. That is not an error — just update the affected tests.

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn test-count []
  ;; --- count (HashCollisionNode) ---
  ;; HashCollisionNode has no `count` method (only the collisionCount
  ;; wrapper — a read-only defn, since the C collisionCount consumes its
  ;; arg), so the count is asserted via collisionCount directly.
  ;;
  ;; A fresh emptyCollisionNode reports 2, not 0: C's count field is
  ;; dual-use — malloc_hashCollisionNode sets count = 2 * capacity (4 for
  ;; the capacity-2 allocation) and collisionCount returns count / 2 (the
  ;; 4.2 note). This pins that documented quirk.
  (rt/test (= 2 (collisionCount (emptyCollisionNode)))
           _FILE_ _LINE_)

  ;; 2-entry collision node built the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI, the first with eq=None so
  ;; bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding [k1 v1, k2 v2]. Extract it with
  ;; bmiCopyChild (owned ref; bit mask 128 = 1 << 7) → count 2.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)]
    (rt/test (= 2 (collisionCount cn))
             _FILE_ _LINE_))

  ;; 3-entry node: append a third same-hash key k3 (eq=None, so
  ;; collisionAssoc-find's entry-key-first `=` is false for both eq=None
  ;; entries — the eq gate is on the first arg, the entry key) →
  ;; collisionAppend → count 3.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        k3 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        m3 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)]
    (rt/test (= 3 (collisionCount m3))
             _FILE_ _LINE_))

  ;; 4-entry node: append a fourth same-hash key k4 (eq=Some; still not
  ;; =-equal to any entry — all three carry eq=None, and the eq gate is on
  ;; the first arg, the entry key) → collisionAppend again → count 4.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        k3 (CHash 7 None)
        k4 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        m3 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        m4 (copyAssoc m3 k4 (Val 96) (sha1 k4) 0)]
    (rt/test (= 4 (collisionCount m4))
             _FILE_ _LINE_)))

(defn test-vec []
  ;; --- vec (HashCollisionNode) ---
  ;; The `vec` method routes to the collisionVec wrapper over the C
  ;; collisionVec (runtime3.c:2633): it conjs a (k v) pair for each
  ;; non-NULL entry onto the initial vec, in entry order. The C function is
  ;; alive and purely mechanical (no key equality), so it's called directly
  ;; (the arrayNodeCount pattern). The NULL guard skips the trailing slots
  ;; of a fresh emptyCollisionNode (count = 2 * capacity, entries NULL — the
  ;; 4.2 note), so a fresh node vecs to [].
  (rt/test (= [] (vec (emptyCollisionNode)))
           _FILE_ _LINE_)

  ;; 2-entry collision node built the way a map builds one: two 7/7 keys
  ;; (eq=None) into emptyBMI → bmiCopyAssoc's collision branch → a BMI with
  ;; a single slot (bit 7) holding [k1 v1, k2 v2]; extracted with
  ;; bmiCopyChild (owned ref, mask 128 = 1<<7). vec is the two pairs in
  ;; entry order. The expected keys carry eq=Some (same hash 7): the eq gate
  ;; is on the first arg, and vect-= compares the expected element first, so
  ;; the expected side must not be gated off.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)]
    (rt/test (= [[(CHash 7 (Some 7)) (Val 99)]
                 [(CHash 7 (Some 7)) (Val 98)]]
                (vec cn))
             _FILE_ _LINE_))

  ;; 3-entry node: append a third same-hash key k3 (eq=None, not =-equal to
  ;; either entry — the eq gate is on the entry key, the first arg) →
  ;; collisionAppend → vec is the three pairs in entry order, the appended
  ;; pair last.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        k3 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        m3 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)]
    (rt/test (= [[(CHash 7 (Some 7)) (Val 99)]
                 [(CHash 7 (Some 7)) (Val 98)]
                 [(CHash 7 (Some 7)) (Val 97)]]
                (vec m3))
             _FILE_ _LINE_)))

(defn test-assoc-add []
  ;; --- assoc: add a key to a collision node (collisionAssoc hash-match/append) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2] (C's
  ;; bmiReplaceCopied collision case, malloc_hashCollisionNode(2)). Extract it
  ;; with bmiCopyChild (owned ref; bit mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with the same hash (7) that is not =-equal
  ;; to either entry (both entries carry eq=None, so collisionAssoc-find's
  ;; entry-key-first `=` is false for both) → the hash-match/append branch:
  ;; collisionAppend clones the node with (k3 v3) appended as entry 2 → a
  ;; 3-entry collision node [k1 v1, k2 v2, k3 v3]. count 3; the old entries
  ;; are preserved in order (their values pin the order — the eq=None keys
  ;; are mutually indistinguishable under the `=` protocol); get* hits the
  ;; new key. (A fresh emptyCollisionNode is not a valid starting point —
  ;; collisionAssoc/collisionAppend do not NULL-guard, per 4.2 — so the
  ;; BMI-promoted node is the construction.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)]
    (rt/test (and (= 3 (collisionCount m2))
                  (= (Val 99) (collisionVal m2 0))
                  (= (Val 98) (collisionVal m2 1))
                  (= (Val 97) (collisionVal m2 2))
                  (= k3 (collisionKey m2 0))
                  (= k3 (collisionKey m2 1))
                  (= k3 (collisionKey m2 2))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0)))
             _FILE_ _LINE_)))

(defn test-assoc-update []
  ;; --- assoc: update an existing key in a collision node (collisionAssoc hash-match/update) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2]. The
  ;; second key carries eq=Some, so a later same-hash lookup key can =-equal
  ;; it: the eq gate is on the first arg, and collisionAssoc-find scans
  ;; entry-key-first. Extract the node with bmiCopyChild (owned ref; bit
  ;; mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with the same hash (7, eq=Some):
  ;; collisionAssoc-find's entry-key-first `=` is false for entry 0 (k1's
  ;; eq=None gate) and true for entry 1 (k2's eq=Some, same hash) → the
  ;; hash-match/update branch: collisionUpdate clones the node with entry 1
  ;; replaced by (k3 v3), count unchanged → a 2-entry collision node
  ;; [k1 v1, k3 v3]. count 2 (not 3 — this is the update, not the append,
  ;; branch); entry 0 is untouched; get* hits the updated value. (A fresh
  ;; emptyCollisionNode is not a valid starting point —
  ;; collisionAssoc/collisionAppend do not NULL-guard, per 4.2 — so the
  ;; BMI-promoted node is the construction.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)]
    (rt/test (and (= 2 (collisionCount m2))
                  (= (Val 99) (collisionVal m2 0))
                  (= (Val 97) (collisionVal m2 1))
                  (= k3 (collisionKey m2 0))
                  (= k3 (collisionKey m2 1))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0)))
             _FILE_ _LINE_)))

(defn test-assoc-promote []
  ;; --- assoc: promote to a BMI on hash mismatch (collisionAssoc hash-mismatch) ---
  ;; Build a 2-entry collision node the way a map builds one: assoc two keys
  ;; with identical hash (7/7) into emptyBMI. The first key carries eq=None,
  ;; so bmiCopyAssoc's (= currKey k) is false → the collision branch → a BMI
  ;; with a single slot (bit 7) holding a collision node [k1 v1, k2 v2].
  ;; Extract it with bmiCopyChild (owned ref; bit mask 128 = 1 << 7).
  ;;
  ;; Then copyAssoc a third key k3 with a DIFFERENT hash (3) → the
  ;; hash-mismatch branch: the node is promoted to a BMI. k3 goes into a
  ;; fresh BMI at shift 0 (bit 3, flat), then the existing entries are
  ;; assoc*'d in with their own sha1: k1 (hash 7 → bit 7, a new empty bit →
  ;; flat) and k2 (hash 7 → bit 7 again; (= currKey k) is false — k1's
  ;; eq=None gate — so bmiReplaceMutate's collision case) → the slot at bit 7
  ;; becomes a collision node [k1 v1, k2 v2] (existing entry first, new entry
  ;; appended). The result is a BitmapIndexedNode (type 11), NOT a collision
  ;; node: bitmap 136 (8 | 128), count 3 (1 flat + 2 in the collision child),
  ;; get* hits k3 (flat, Val 97) and k2 (inside the collision child, Val 98 —
  ;; k1's entry is unreachable under get* because its eq=None gate sits on the
  ;; first arg and collisionGet scans entry-key-first), the flat slot at bit 3
  ;; holds k3/Val 97, and the child at bit 7 is a 2-entry collision node
  ;; (type 13) with the original entries preserved in order (Val 99, Val 98).
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 3 (Some 3))
        m2 (copyAssoc cn k3 (Val 97) (sha1 k3) 0)
        def (Val 123)
        child (either (map (bmiCopyChild m2 128) (fn [c] c)) emptyBMI)]
    (rt/test (and (= 11 (type-num m2))
                  (= 136 (bmiBitMap m2))
                  (= 3 (count m2))
                  (= (Val 97) (get* m2 k3 def (sha1 k3) 0))
                  (= (Val 98) (get* m2 k2 def (sha1 k2) 0))
                  (= k3 (bmiKey m2 8))
                  (= (Val 97) (bmiVal m2 8))
                  (= 13 (type-num child))
                  (= 2 (collisionCount child))
                  (= (Val 99) (collisionVal child 0))
                  (= (Val 98) (collisionVal child 1)))
             _FILE_ _LINE_)))

(defn test-get []
  ;; --- get* (HashCollisionNode) ---
  ;; HashCollisionNode has no `get` method (only the `get*` protocol — the
  ;; `get` method is a BitmapIndexedNode-level convenience that computes the
  ;; sha1 and maps a sentinel to Some/None), so get* is called directly with
  ;; an explicit def/hash/shift, the get* convention. get* routes to the
  ;; Toccata collisionGet (hvm-core.toc): a linear scan over the entries
  ;; (collisionGet-i), the `=` protocol with the entry key first (the
  ;; bmiCopyAssoc convention — C's collisionGet, runtime3.c:2690, uses C's
  ;; `equal`, which can't reach the `=` protocol). hash/shift are unused: a
  ;; collision node holds only keys with one hash.

  ;; Hit: a 2-entry collision node built the way a map builds one (two 7/7
  ;; keys into emptyBMI, the first with eq=None so bmiCopyAssoc's
  ;; (= currKey k) is false → the collision branch → a BMI with a single
  ;; slot (bit 7) holding [k1 v1, k2 v2]), the second key carrying eq=Some
  ;; so a same-hash lookup key can =-equal it (the eq gate is on the first
  ;; arg, and the scan compares entry-key-first). Extract it with
  ;; bmiCopyChild (owned ref; bit mask 128 = 1 << 7). Lookup k2 (hash 7,
  ;; eq=Some): the scan compares entry 0 first — (= k1 k2) is false (k1's
  ;; eq=None gate) — then entry 1: (= k2 k2) is true → the value Val 98.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        def (Val 123)]
    (rt/test (= (Val 98) (get* cn k2 def (sha1 k2) 0))
             _FILE_ _LINE_))

  ;; Miss (same hash, key mismatch): a 2-entry node with BOTH entries
  ;; eq=None (two 7/7 eq=None keys into emptyBMI → the collision branch →
  ;; [k1 v1, k2 v2]). The eq gate is on the first arg (the entry key), so no
  ;; lookup key — whatever its own eq — can =-equal an eq=None entry: lookup
  ;; k3 (hash 7, eq=Some) scans both entries, (= ek k3) is false for both →
  ;; the scan reaches its base case → def.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        def (Val 123)]
    (rt/test (= def (get* cn k3 def (sha1 k3) 0))
             _FILE_ _LINE_))

  ;; Miss (different hash): the same 2-entry node as the hit case (entries
  ;; k1 eq=None, k2 eq=Some, both hash 7). Lookup k3 with a different hash
  ;; (3, eq=Some): (= ek k3) is false for both entries — CHash's `=` compares
  ;; the first arg's h against the second arg's h, and 7 ≠ 3 (the eq=None
  ;; entry is already gated off) → def. (A real map would never route a
  ;; hash-3 lookup to a hash-7 collision node — the parent's bitmap check
  ;; fails first — but the scan itself is hash-agnostic, mirroring the C
  ;; collisionGet, which never checks the hash; this pins that the `=`
  ;; protocol, not the hash, drives the comparison.)
  (let [k1 (CHash 7 None)
        k2 (CHash 7 (Some 7))
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 3 (Some 3))
        def (Val 123)]
    (rt/test (= def (get* cn k3 def (sha1 k3) 0))
             _FILE_ _LINE_)))

(defn test-dissoc []
  ;; --- dissoc* (HashCollisionNode) ---
  ;; HashCollisionNode has no `dissoc` method (only the `dissoc*` protocol —
  ;; the `dissoc` method is a BitmapIndexedNode-level convenience that computes
  ;; the sha1), so dissoc* is called directly with an explicit hash/shift, the
  ;; get* convention (the ArrayNode dissoc pattern, 3.15). dissoc* routes to the
  ;; Toccata collisionDissoc (hvm-core.toc), mirroring the C collisionDissoc
  ;; (runtime3.c:2649): the `=` protocol with the lookup key first (the C
  ;; collisionDissoc / bmiDissoc convention — an eq-gated lookup key that gates
  ;; off removes nothing), the mechanical shrink in collisionShrink. hash/shift
  ;; are unused: a collision node holds only keys with one hash. dissoc copies —
  ;; the source node is never mutated.

  ;; Remove an entry from a multi-entry node (n=2, hit) → a 1-entry node:
  ;; build a 2-entry collision node the way a map builds one (two 7/7 eq=None
  ;; keys into emptyBMI → bmiCopyAssoc's collision branch → a BMI with a single
  ;; slot (bit 7) holding [k1 v1, k2 v2]), extracted with bmiCopyChild (owned
  ;; ref, mask 128 = 1<<7). dissoc* a lookup key k3 (hash 7, eq=Some): the
  ;; scan's lookup-key-first `=` is true for entry 0 (k3's eq=Some gate, same
  ;; hash) → collisionShrink removes entry 0, compaction moves entry 1 (k2 v2)
  ;; to index 0 → a 1-entry node. count 1, the survivor is Val 98; the source
  ;; node is untouched (count 2).
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (dissoc* cn k3 (sha1 k3) 0)]
    (rt/test (and (= 1 (collisionCount m2))
                  (= (Val 98) (collisionVal m2 0))
                  (= 2 (collisionCount cn)))
             _FILE_ _LINE_))

  ;; Remove the last entry (n=1, hit) → emptyBMI: the 1-entry node from the
  ;; previous case ([k2 v2]). dissoc* a lookup key k4 (hash 7, eq=Some): the
  ;; n==1 path checks entry 0 — (= k4 k2) is true (k4's eq=Some gate, same
  ;; hash) → the C collisionDissoc last-entry path frees the node and returns
  ;; the global emptyBMI: count 0, bitmap 0, vec []. Both intermediate nodes
  ;; are untouched (dissoc copies, it never mutates).
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (dissoc* cn k3 (sha1 k3) 0)
        k4 (CHash 7 (Some 7))
        m3 (dissoc* m2 k4 (sha1 k4) 0)]
    (rt/test (and (= 1 (collisionCount m2))
                  (= 0 (count m3))
                  (= 0 (bmiBitMap m3))
                  (= [] (vec m3))
                  (= 2 (collisionCount cn)))
             _FILE_ _LINE_))

  ;; Remove a missing key (no-op, key mismatch — eq=None gate): a 2-entry node
  ;; (two 7/7 eq=None keys). dissoc* a lookup key k3 (hash 7, eq=None): the
  ;; lookup-key-first `=` is gated off by k3's own eq=None (the first arg), so
  ;; (= k3 ek) is false for both entries → the scan reaches its base case →
  ;; the node is returned unchanged: count 2, vec the two original pairs in
  ;; entry order; the source node is untouched.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 None)
        m2 (dissoc* cn k3 (sha1 k3) 0)]
    (rt/test (and (= 2 (collisionCount m2))
                  (= [[(CHash 7 (Some 7)) (Val 99)]
                      [(CHash 7 (Some 7)) (Val 98)]]
                     (vec m2))
                  (= 2 (collisionCount cn)))
             _FILE_ _LINE_))

  ;; Remove a missing key from a 1-entry node (no-op, different hash): the
  ;; 1-entry node from the last-entry case ([k2 v2], entry hash 7). dissoc* a
  ;; lookup key k4 with a different hash (3, eq=Some): the n==1 path checks
  ;; entry 0 — (= k4 k2) is false (CHash's `=` compares the first arg's h
  ;; against the second arg's h, 3 ≠ 7) → the node is returned unchanged:
  ;; count 1, the entry Val 98 intact; both the 1-entry node and the original
  ;; 2-entry node are untouched.
  (let [k1 (CHash 7 None)
        k2 (CHash 7 None)
        m (-> emptyBMI
              (copyAssoc k1 (Val 99) (sha1 k1) 0)
              (copyAssoc k2 (Val 98) (sha1 k2) 0))
        cn (either (map (bmiCopyChild m 128) (fn [c] c)) emptyBMI)
        k3 (CHash 7 (Some 7))
        m2 (dissoc* cn k3 (sha1 k3) 0)
        k4 (CHash 3 (Some 3))
        m3 (dissoc* m2 k4 (sha1 k4) 0)]
    (rt/test (and (= 1 (collisionCount m3))
                  (= (Val 98) (collisionVal m3 0))
                  (= 1 (collisionCount m2))
                  (= 2 (collisionCount cn)))
             _FILE_ _LINE_)))

(defn main [_]
  (println "Checking CollisionNode regressions")

  ;; Seed test (trivially green): emptyBMI's bitmap is 0.
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  (test-count)

  (test-vec)

  (test-assoc-add)

  (test-assoc-update)

  (test-assoc-promote)

  (test-get)

  (test-dissoc)

  (println "CollisionNode tests are good")
  )
