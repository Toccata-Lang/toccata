
(deftype Error [val state]
  Stringable
  (str-vect [_] 
    (vector "(Error " (str val) ")")))

(deftype new-se [invoke-fn]
  ! invoke-fn Fn

  Stringable
  (str-vect [x]
    (comp (vector "<new-se ")
          (str-vect (.invoke-fn x))
          (vector ">")))

  Function
  (invoke [ev s]
    (invoke-fn s))

  Container
  (map [ev f]
    (new-se (fn [s]
              (let [x (invoke-fn s)]
                (either (instance? Error x)
                        (let [[v new-s] x]
                          (println 'v)
                          (either (= (symbol "v") 'v)
                                  (abort))
                          [(f v) new-s])))))))

(main [_]
  (println ((map (new-se (fn [s]
                              [99 s]))
                    (fn [y]
                      'x
                      ))
              'state)))
