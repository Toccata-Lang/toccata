
(add-ns rt (module "regression-tester.toc"))

(def m-val (Some "poke"))

(defn main [_]
  (println "Check Some regressions")
  (rt/test (= "Some" (type-name None))
           _FILE_ _LINE_)
  ;; (rt/test (instance? Some None)
  ;;          _FILE_ _LINE_)
  (rt/test (= "Some" (type-name (Some (inc 1))))
           _FILE_ _LINE_)
  ;; (rt/test (instance? Some (Some (inc 8)))
  ;;          _FILE_ _LINE_)
  (rt/test (= 2 (extract (Some (inc 1))))
           _FILE_ _LINE_)
  (rt/test (= [2] (type-args (Some (inc 1))))
           _FILE_ _LINE_)
  (rt/test (= [] (type-args None))
           _FILE_ _LINE_)
  (rt/test m-val
           _FILE_ _LINE_)
  (rt/test (= (Some 'yep) (and m-val (Some 'yep)))
           _FILE_ _LINE_)
  (rt/test (= None (and None m-val))
           _FILE_ _LINE_)
  (rt/test (= None (and m-val None))
           _FILE_ _LINE_)
  (rt/test (or None m-val)
           _FILE_ _LINE_)
  (rt/test (or m-val None)
           _FILE_ _LINE_)
  (rt/test (= (Some (inc 2)) (Some (inc 2)))
           _FILE_ _LINE_)
  (let [x (inc 2)]
    (rt/test (= (Some x) (Some x))
             _FILE_ _LINE_))
  (rt/test (= None None)
           _FILE_ _LINE_)
  (rt/test (= (Some 2) (map (Some (inc 0)) inc))
           _FILE_ _LINE_)
  (rt/test (= (Some 8) (apply (Some +) (list (Some (inc 0))
                                             (Some (inc 2))
                                             (Some (inc 3)))))
           _FILE_ _LINE_)
  (rt/test (= (Some 8) (apply (Some (reify
                                      Container
                                      (apply [_ args]
                                        (apply + args))))
                              (list (Some (inc 0))
                                    (Some (inc 2))
                                    (Some (inc 3)))))
           _FILE_ _LINE_)
  (rt/test (= None (apply None (list (Some (inc 0)))))
           _FILE_ _LINE_)
  (rt/test (= None (apply None (list (Some (inc 0)) (Some (inc 1)))))
           _FILE_ _LINE_)
  (rt/test (= None (apply-to inc None))
           _FILE_ _LINE_)
  (rt/test (= None (= (Some 2) (apply-to inc (Some (inc 0)) None)))
           _FILE_ _LINE_)
  (rt/test (= None (apply None (list (Some (inc 0)))))
           _FILE_ _LINE_)
  (rt/test (= None (apply-to + (Some 8) None (Some 13)))
           _FILE_ _LINE_)
  (rt/test (= (Some 2) (apply (Some inc) (list (Some (inc 0)))))
           _FILE_ _LINE_)
  (rt/test (= (Some 2) (apply-to add-1-variadic (Some (inc 0))))
           _FILE_ _LINE_)
  (rt/test (= (Some 2) (apply (Some (fn [] 2)) empty-list))
           _FILE_ _LINE_)
  (rt/test (= (Some 3) (apply (Some +) (list (Some (inc 1)) (Some (inc 0)))))
           _FILE_ _LINE_)
  (let [inc-val (inc 0)]
    (rt/test (= None (flat-map None (fn [x]
                                      (Some (+ inc-val x)))))
             _FILE_ _LINE_))
  (let [inc-val (inc 0)]
    (rt/test (= (Some 2) (flat-map (Some (inc 0)) (fn [x]
                                                    (Some (+ inc-val x)))))
             _FILE_ _LINE_))
  (let [l (list 33)]
    (flat-map None
              (fn [h]
                (list l)
                (println "fail in!!" _FILE_ _LINE_)
                (abort))))

  (let [l (list 22)]
    (flat-map (Some (inc 0))
              (fn [h]
                l
                h
                (Some 8))))

  (let [double (fn [x]
                 (+ x x))
        check-int (fn [x]
                    (and (= 0 (mod x 2))
                         (Some x)))]
    ;; check the functor and applicative laws for Some
    (rt/test (= (map (Some 5) (fn [x] x)) (Some 5))
             _FILE_ _LINE_)
    (rt/test (= (map (map (Some 2) inc) double)
                (map (Some 2) (fn [x]
                                (double (inc x)))))
             _FILE_ _LINE_)
    (rt/test (= (map (Some 5) inc)
                (apply-to inc (Some 5)))
             _FILE_ _LINE_)
    (rt/test (= (Some 5) (apply-to (fn [x] x) (Some 5)))
             _FILE_ _LINE_)
    (let [v1 (Some "first ")
          v2 (Some "second ")
          v3 (Some "third")]
      (rt/test (= (apply-to comp (apply-to comp v1 v2) v3)
                  (apply-to comp v1 (apply-to comp v2 v3))
                  (apply-to comp v1 v2 v3))
               _FILE_ _LINE_))
    ;; check the functor and applicative laws for None
    (rt/test (= (map None (fn [x] x)) None)
             _FILE_ _LINE_)
    (rt/test (= (map (map None inc) double)
                (map None (fn [x]
                            (double (inc x)))))
             _FILE_ _LINE_)
    (rt/test (= (map None inc)
                (apply-to inc None))
             _FILE_ _LINE_)
    (rt/test (= (apply-to comp (apply-to comp None None) None)
                (apply-to comp None (apply-to comp None None))
                (apply-to comp None None None))
             _FILE_ _LINE_)

    ;; None in action
    (let [good-ints (map (list 8 10 2 4 14) check-int)
          None-ints (map (list 8 3 2 5 14) check-int)]
      (rt/test (apply (Some +) good-ints)
               _FILE_ _LINE_)
      (rt/test (= None (apply (Some +) None-ints))
               _FILE_ _LINE_)))

  (let [inc-val (inc 0)
        f (reify
            Function
            (invoke [_ x]
              (+ inc-val x 2)))]
    (rt/test (= None (map None (fn [x]
                                 (+ inc-val x))))
             _FILE_ _LINE_)
    (rt/test (= (Some 4) (map (Some (inc 0)) f))
             _FILE_ _LINE_)
    (rt/test (= (Some 2) (map (Some (inc 0)) (reify
                                               Function
                                               (invoke [_ x]
                                                 (+ inc-val x)))))
             _FILE_ _LINE_)
    (rt/test (= (Some 3) (flat-map (Some 1) (reify
                                              Function
                                              (invoke [_ x]
                                                (Some (+ inc-val x inc-val))))))
             _FILE_ _LINE_))
  (rt/test (= (Some 2) (flat-map (Some (inc 0)) (reify
                                                  Function
                                                  (invoke [_ x]
                                                    (Some (inc x))))))
           _FILE_ _LINE_)

  ;; check the monad laws for Some
  (let [f (fn [x]
            (Some (inc x)))
        double (fn [x]
                 (+ x x))
        g (fn [x]
            (Some (double x)))]
    (rt/test (= (flat-map (Some (inc 7)) Some) (Some (inc 7)))
             _FILE_ _LINE_)
    (rt/test (= (flat-map (Some 4) f) (f 4))
             _FILE_ _LINE_)
    (rt/test (= (Some 10)
                (flat-map (flat-map (Some 4) f) g)
                (flat-map (Some 4) (fn [x] (flat-map (f x) g))))
             _FILE_ _LINE_))
  (let [m (Some (subs "string" 2))]
    (sha1 m)
    (sha1 m))
  (println "Some is good"))
