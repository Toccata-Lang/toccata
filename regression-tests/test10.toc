
(def msg1 "Howdy Folks 10\n")
(def msg2 msg1)
(def int1 (let [x (+ 1 7)
                y (+ 4 5)]
            (+ x
               (+ 4 5))
            x))

(def int2 (let [x (+ 1 7)
                y (+ 4 5)]
            (+ x
               (+ 4 5))
            x
            (+
             (+ 1 7)
             y)))
(def int3 (pr* "for int3\n"))

(main [_]
  (let [x (+ 6 3)
        y (+ 8 2)
        z "yaba yaba"]
    (pr* (number-str (+ x y)))
    (pr* "\n")
    (pr* z)
    (pr* "\n"))
  (let [x (+ 6 3)
        y (+ 8 3)]
    (pr* (number-str (+ x y)))
    x
    (pr* "\n"))
  (let [x (+ 6 3)
        y (+ 8 4)]
    (pr* (number-str (+ x y)))
    (pr* "\n")
    y)
  (let [x (+ 6 3)
        y (+ 8 2)]
    (pr* (number-str (+ x y)))
    x
    (pr* "\n")
    y)
  (pr* (number-str (+ (pr* "one str ")
                      (pr* "two str\n"))))
  (pr* "\n")
  (pr* (number-str int1))
  (pr* "\n")
  (pr* msg2)
  (let [v (pr* "one str ")]
    (pr* (number-str (+ v
                         (pr* "two str\n"))))))
