
(defn f [q]
  (q))

(main [_]
  (f (fn boom1 []
       (let [max (Some 0)]
         (and (and max
                   (Some 9))
              max))
       (number-str 991)))
  (pr* "boom1\n")
  (f (fn boom2 []
       (let [max (Some 0)]
         (and (or max
                  (Some 9))
              max))))
  (pr* "boom2\n")
  (f (fn boom3 []
       (let [max (Some 0)]
         (or (and max
                  (Some 9))
             max))))
  (pr* "boom3\n")
  (f (fn boom4 []
       (let [max (Some 0)]
         (or (or max
                 (Some 9))
             max))))
  (pr* "boom4\n"))
