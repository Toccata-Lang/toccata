
(defn test-str []
  (inline String
          "    printf(\"making test string\\n\");
    result = termVal((Term)stringValue(\"Howdy, folks 2\\n\"));
"))

(defn pr1 [str x]
  ! str String
  (inline Integer "
    if (termTag(str_1) != VAL) {
      fprintf(stdout, \"\\ninvalid type for 'pr1': Integer or Float\\n\");
      abort();
    }
    Value *s = (Value *)((u64)str_1 & ~7);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*': %ld\\n\", s->type);
      abort();
    }
    pushRedex(ERA, str_1);
    pushRedex(ERA, x_2);
    result = newI60(0);"))

(defn pr2 [x str]
  ! str String
  (inline Integer "
    if (termTag(str_2) != VAL) {
      fprintf(stdout, \"\\ninvalid type for 'pr2': Integer or Float\\n\");
      abort();
    }
    Value *s = (Value *)((u64)str_2 & ~7);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*': %ld\\n\", s->type);
      abort();
    }
    pushRedex(ERA, str_2);
    pushRedex(ERA, x_1);
    result = newI60(0);"))

(main [argv]
  (test-str)
  (pr1 (test-str) 7)
  (pr2 7 (test-str))
  0)
