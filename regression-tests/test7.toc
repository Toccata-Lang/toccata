
(defn id [x] x)

(defn t [x y]
  x)

(defn f [x y]
  y)

(defn fail-f []
  (inline String
          " abort(); result = term_val((Term)stringValue(\"Fail f\\n\"));
"))

(defn fail-t []
  (inline String
          " result = term_val((Term)stringValue(\"Fail t\\n\"));
"))

(defn succ-f []
  (inline String
          " result = term_val((Term)stringValue(\"Success f\\n\"));
"))

(defn succ-t []
  (inline String
          " result = term_val((Term)stringValue(\"Success t\\n\"));
"))

(main [_]
  (pr* "Howdy Folks 7\n")

  (id
   (id
    (t
     (f
      (pr* (fail-t))
      (t
       (f
        (pr* (fail-t))
        (pr* (succ-t)))
       (pr* (fail-t))))
     (pr* (fail-t)))))

  (t (pr* "Success t\n") (abort))
  ;; (t (pr* "Success t\n") (pr* "Fail t\n"))
  (t (pr* (succ-t)) (pr* (fail-t)))
  (f (pr* (fail-f)) (pr* (succ-f)))

  ((fn [x y] y) (abort) (pr* "Success y\n"))
  ((fn [x y] x) (pr* "Success x\n") (abort))
  ;; ((fn [x y] y) (pr* "Fail y\n") (pr* "Success y\n"))
  ;; ((fn [x y] x) (pr* "Success x\n") (pr* "Fail x\n"))

  (pr* "done\n")
  )
