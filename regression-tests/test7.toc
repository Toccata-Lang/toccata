
(defn id [x] x)

(defn t [x y]
  x)

(defn f [x y]
  y)

(main [_]
  (pr* "Howdy Folks 7\n")

  (id
   (id
    (t
     (f
      (pr* "Fail t\n")
      (t
       (f
        (pr* "Fail t\n")
        (pr* "Success t\n"))
       (pr* "Fail t\n")))
     (pr* "Fail t\n"))))

  (f (pr* "Fail f\n") (pr* "Success f\n"))

  (pr* "done\n"))
