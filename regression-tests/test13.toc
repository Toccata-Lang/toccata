
(defn int-= [x y]
  ;; ! x Integer
  ;; ! y Integer
  (inline "
    result = new_port(VAL, integer_EQ(x_1, y_2));"))

(deftype Bogus [x])

(main [_]
  (and (int-= 0 0)
       ;; a comment
       (Some (pr* "first 'and' works\n"))
       (int-= (inc 0) (inc 0))
       (Some (pr* "second 'and' works\n")))
  (or (int-= 0 1)
      ;; a comment
      (Some (pr* "'or' works\n")))
  (or (and (int-= 0 0)
           (Some (pr* "'and' in 'or' works\n")))
      (Some (pr* "'and' in 'or' works\n")))
  (or (and (int-= 1 0)
           (Some (pr* "'and' in 'or' works\n")))
      (and (int-= 0 0)
           (Some (pr* "2 'and' in 'or' works\n"))))
  (and (or (int-= 0 0)
           (Some (pr* "'or' in 'and' works\n")))
       (Some (pr* "'or' in 'and' works\n")))
  (and (or (int-= 0 0)
           (Some (pr* "2 'or' in 'and' works\n")))
       (or (int-= 1 0)
           (Some (pr* "2 'or' in 'and' works\n"))))
  ;; (let [x (Some 8)]
  ;;   (and x (let [y (.x x)]
  ;;            (Some (inc y))))
  ;;   (or x (let [y (.x x)]
  ;;            (Some (inc y)))))
  (let [w (Some 99)]
    (or (let [_ w
              mv (inc 7)]
          (Some mv))
        (None)))
  (and (None)
       (abort "FAIL!!!\n"))
  (let [max (Some 0)]
    (and (Some 0)
         max))
  (let [max (Some 0)]
    (or (Some 0)
         max))
  (pr* "and/or works\n"))
