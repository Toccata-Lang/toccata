
(deftype AType [v]
  ;; ! v Vector
  ;; ! v (min-count 1)
  )

(defn lr1 [l result f]
  (either (Some l)
          (lr1 (rest l) (f [] 1) f))
  l)

(defn lr2 [l result f]
  (either (Some l)
          (lr2 (rest l) (f [] 1) f)))

(defn p1 [coll n]
  (lr1 coll ["a" "b"]
       (fn inner-p [q x]
         n
         (to-str q)))
  (lr2 coll ["a" "b"]
       (fn inner-p [q x]
         n
         (to-str q))))

(defn lr3 [l result f]
  (either (empty? l)
          (lr3 (rest l) (f result (extract (first l))) f)))

(defn p3 [coll n]
  (lr3 coll ["a" "b"]
       (fn inner-p [q x]
         n
         (to-str q)))
  (lr3 coll ["a" "b"]
       (fn other-inner-p [q x]
         (either (= n 2 2)
                 5))))

(defn p4 [coll n]
  (reduce coll ["a" "b"]
          (fn [q x]
            n)))

(defn p5 [v]
  (either (and (empty? v)
               (Some 'Nope))
          (AType v)))

(main [_]
  (p1 ['c 3] 2)
  (p3 ['c 3] 2)
  (p4 ['c 3] 2)
  (p5 [])
  0
  )
