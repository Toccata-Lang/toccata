(add-ns rt (module "regression-tester.toc"))

;; Note: the elements in the result of `vec` are in implementation-dependent
;; order and may change. That is not an error — just update the affected tests.

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn test-count []
  ;; --- count (ArrayNode) ---
  ;; count wraps the C arrayNodeCount (runtime3.c:2613), which sums mapCount
  ;; over the non-empty slots. An empty ArrayNode (all 32 slots 0) sums to 0.
  (rt/test (= 0 (count (emptyArrayNode)))
           _FILE_ _LINE_)

  ;; Promoted ArrayNode: build a 16-entry flat BMI (16 keys with 16 distinct
  ;; bits at shift 0), then assoc a 17th key whose bit is empty — bmiCopyAssoc's
  ;; empty-bit branch calls addCopiedBMI's n >= 16 promotion branch, converting
  ;; the node to an ArrayNode (17 one-entry BMI sub-nodes). count dispatches to
  ;; ArrayNode's count (C arrayNodeCount summing mapCount over the 17 non-empty
  ;; slots) → 17.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))]
    (rt/test (= 17 (count (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)))
             _FILE_ _LINE_)))

(defn test-get []
  ;; --- get (ArrayNode) ---
  ;; ArrayNode has no `get` method (only the `get*` protocol), so the hit is
  ;; asserted via `get*` with a `def` value (the bmiGet convention: the value
  ;; stored under `k`, or `def` on miss).
  ;;
  ;; Promoted ArrayNode: a 16-entry flat BMI (keys 0..15, values 1..16), then
  ;; a 17th key (hash 20 → empty bit) promotes it to an ArrayNode (17 one-entry
  ;; BMI sub-nodes, one per slot). arrayNodeGet routes by slot index
  ;; mask(hash, shift) and recurses into the occupied slot's child at shift+5
  ;; through the get* protocol. Two keys are asserted: key 5 (slot 5, from the
  ;; flat part) → Val 6, and key 20 (slot 20, the 17th) → Val 21.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (and (= (Val 6) (get* m k5 def (sha1 k5) 0))
                  (= (Val 21) (get* m k17 def (sha1 k17) 0)))
             _FILE_ _LINE_)))

(defn test-get-miss []
  ;; --- get (ArrayNode) — miss ---
  ;; arrayNodeGet routes by slot index mask(hash, shift): an empty slot is a
  ;; miss (def, the either else branch); an occupied slot recurses into the
  ;; child at shift+5 through the get* protocol, which returns def on a key
  ;; mismatch. Both branches are asserted against the same promoted
  ;; ArrayNode (17 one-entry BMI sub-nodes: slots 0..15 and 20 occupied).
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        def (Val 123)]
    ;; Miss (empty slot): key 21's slot is 21 = (21 >> 0) & 31, which is
    ;; empty (only slots 0..15 and 20 are occupied) → arrayNodeCopyChild
    ;; returns None → def.
    (let [k (CHash 21 (Some 21))]
      (rt/test (= def (get* m k def (sha1 k) 0))
               _FILE_ _LINE_))
    ;; Miss (occupied slot, key mismatch in child): key 69's slot is 5 =
    ;; (69 >> 0) & 31, occupied by key 5's one-entry BMI; at shift 5, 69 has
    ;; bit 0 ((69 >> 5) & 1 = 0), the same bit the child holds (key 5:
    ;; (5 >> 5) & 1 = 0), but the hashes differ (69 ≠ 5) → the child's
    ;; key-compare branch returns def.
    (let [k (CHash 69 (Some 69))]
      (rt/test (= def (get* m k def (sha1 k) 0))
               _FILE_ _LINE_))))

(defn test-vec []
  ;; --- vec (ArrayNode) ---
  ;; arrayNodeVec walks slots 0..31 in index order (arrayNodeVec-i), flattening
  ;; each occupied slot's child vec in (the `vec` protocol — type dispatch, the
  ;; Toccata counterpart of the dead hashVec dispatcher); an empty slot
  ;; contributes nothing. An empty ArrayNode (all 32 slots 0) therefore vecs to
  ;; [].
  (rt/test (= [] (vec (emptyArrayNode)))
           _FILE_ _LINE_)

  ;; Promoted ArrayNode: a 16-entry flat BMI (keys 0..15, values 1..16), then a
  ;; 17th key (hash 20 → empty bit) promotes it to an ArrayNode (17 one-entry
  ;; BMI sub-nodes: slots 0..15 and 20 occupied). vec flattens the children in
  ;; slot order → 17 pairs: keys 0..15 → values 1..16 (slots 0..15), then key
  ;; 20 → Val 21 (slot 20). Each child is a one-entry BMI, so its own vec is a
  ;; single pair and the overall order is the deterministic slot order.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        expected16 (reduce (range 16) []
                           (fn [vs n]
                             (conj vs [(CHash n (Some n)) (Val (inc n))])))
        expected (conj expected16 [(CHash 20 (Some 20)) (Val 21)])]
    (rt/test (= expected (vec m))
             _FILE_ _LINE_)))

(defn test-assoc []
  ;; --- assoc into an empty slot (ArrayNode) ---
  ;; ArrayNode slots hold only sub-nodes (never flat key/val pairs), so an
  ;; empty slot (slot index mask(hash, shift) == 0) means the slot is 0. assoc
  ;; into an empty slot installs a fresh 1-entry BMI child at that slot
  ;; (copyAssoc on emptyBMI at shift+5), mirroring the C arrayNodeCopyAssoc /
  ;; arrayNodeMutateAssoc empty-slot branches:
  ;;  - copyAssoc → arrayNodeCopyAssoc: arrayNodeCopyChild returns None →
  ;;    arrayNodeUpdate clones the node with the slot set to the fresh child
  ;;    (the other non-zero slots are incRef'd into the clone).
  ;;  - assoc* (refs-count == 3, mutate path) → arrayNodeMutateAssoc:
  ;;    arrayNodeMutateChild returns None → arrayNodeSetSlot points the slot
  ;;    in place at the fresh child (the other slots are untouched).

  ;; Copy path, empty ArrayNode (all 32 slots 0): assoc a key into an empty
  ;; slot → count 1, vec is the single pair.
  (let [m (emptyArrayNode)
        k (CHash 3 (Some 3))]
    (rt/test (let [m2 (copyAssoc m k (Val 99) (sha1 k) 0)]
               (and (= 1 (count m2))
                    (= [[k (Val 99)]] (vec m2))))
             _FILE_ _LINE_))

  ;; Mutate path, empty ArrayNode: assoc* a key into an empty slot (in place)
  ;; → count 1, vec is the single pair.
  (let [m (emptyArrayNode)
        k (CHash 3 (Some 3))]
    (rt/test (let [m2 (assoc* m k (Val 99) (sha1 k) 0)]
               (and (= 1 (count m2))
                    (= [[k (Val 99)]] (vec m2))))
             _FILE_ _LINE_))

  ;; Copy path, promoted ArrayNode (other slots occupied): the 17-entry
  ;; promoted ArrayNode (slots 0..15 and 20 occupied). assoc a key whose slot
  ;; is empty (hash 21 → slot 21) → arrayNodeCopyAssoc's empty-slot branch
  ;; clones the node with slot 21 set to a fresh 1-entry BMI child, the other
  ;; 17 slots preserved (incRef'd into the clone). count 18; get* hits both the
  ;; new key (slot 21) and an old key (slot 5).
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k21 (CHash 21 (Some 21))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (copyAssoc m k21 (Val 22) (sha1 k21) 0)]
               (and (= 18 (count m2))
                    (= (Val 22) (get* m2 k21 def (sha1 k21) 0))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))))
             _FILE_ _LINE_))

  ;; Mutate path, promoted ArrayNode: assoc* a key into an empty slot (in
  ;; place) → arrayNodeMutateAssoc's empty-slot branch sets slot 21 to a fresh
  ;; 1-entry BMI child, the other 17 slots untouched. count 18; get* hits both
  ;; the new key and an old key.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k21 (CHash 21 (Some 21))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (assoc* m k21 (Val 22) (sha1 k21) 0)]
               (and (= 18 (count m2))
                    (= (Val 22) (get* m2 k21 def (sha1 k21) 0))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))))
             _FILE_ _LINE_)))

(defn test-assoc-subnode []
  ;; --- assoc into a sub-node slot (ArrayNode) ---
  ;; The slot index mask(hash, shift) points at an occupied slot: the slot
  ;; holds a sub-node, so the assoc recurses into it at shift+5 (the
  ;; occupied-slot branch of arrayNodeCopyAssoc / arrayNodeMutateAssoc):
  ;;  - copyAssoc → arrayNodeCopyAssoc: arrayNodeCopyChild (owned ref) →
  ;;    copyAssoc on the child (the child's own copyAssoc does the key/val
  ;;    work) → arrayNodeUpdate clones the node with the slot pointed at the
  ;;    (re)built child.
  ;;  - assoc* (refs-count == 3, mutate path) → arrayNodeMutateAssoc:
  ;;    arrayNodeMutateChild (borrowed) → assoc* on the child, which mutates
  ;;    the exclusively-owned child in place → arrayNodeSetSlot points the
  ;;    slot at the (re)built child in place.
  ;;
  ;; The map is the 17-entry promoted ArrayNode (slots 0..15 and 20
  ;; occupied, each a 1-entry BMI child). The target slot is 5, holding key
  ;; 5's 1-entry BMI (bit 0 at shift 5).

  ;; Copy path, new key: key 37's slot is 5 = (37 >> 0) & 31 (occupied), and
  ;; at shift 5 its bit is 1 = (37 >> 5) & 1, empty in the child (which
  ;; holds bit 0 for key 5) → the child's addCopiedBMI branch → a 2-entry
  ;; child. arrayNodeUpdate clones the parent with slot 5 replaced. count
  ;; 18; get* hits the new key (Val 38), the old key in the same child
  ;; (Val 6), and a key in another slot (Val 21).
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k37 (CHash 37 (Some 37))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (copyAssoc m k37 (Val 38) (sha1 k37) 0)]
               (and (= 18 (count m2))
                    (= (Val 38) (get* m2 k37 def (sha1 k37) 0))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))))
             _FILE_ _LINE_))

  ;; Mutate path, new key: assoc* key 37 into slot 5 → arrayNodeMutateAssoc's
  ;; occupied-slot branch: the borrowed child (exclusively owned) is mutated
  ;; in place (the child's addCopiedBMI branch → 2-entry child), and
  ;; arrayNodeSetSlot points slot 5 at the rebuilt child. count 18; get*
  ;; hits the new key, the old key in the same child, and a key in another
  ;; slot.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k37 (CHash 37 (Some 37))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (assoc* m k37 (Val 38) (sha1 k37) 0)]
               (and (= 18 (count m2))
                    (= (Val 38) (get* m2 k37 def (sha1 k37) 0))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))))
             _FILE_ _LINE_))

  ;; Copy path, same key different value: re-assoc key 5 (slot 5) with a new
  ;; value → recurse into the child: bmiCopyAssoc's same-key branch (the
  ;; values differ) → bmiClone → a fresh 1-entry child with the new value.
  ;; arrayNodeUpdate clones the parent with slot 5 replaced. count unchanged
  ;; (17); get* shows the updated value and a key in another slot is intact.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (copyAssoc m k5 (Val 99) (sha1 k5) 0)]
               (and (= 17 (count m2))
                    (= (Val 99) (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))))
             _FILE_ _LINE_))

  ;; Mutate path, same key different value: assoc* key 5 with a new value →
  ;; the borrowed child is mutated in place (bmiSetKV — the mutate path has
  ;; no no-op branch) and arrayNodeSetSlot points slot 5 at the child. count
  ;; unchanged (17); get* shows the updated value and another slot intact.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (assoc* m k5 (Val 99) (sha1 k5) 0)]
               (and (= 17 (count m2))
                    (= (Val 99) (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))))
             _FILE_ _LINE_)))

(defn test-dissoc []
  ;; --- dissoc (ArrayNode) ---
  ;; ArrayNode has no `dissoc` method (only the `dissoc*` protocol), so the
  ;; cases call `dissoc*` with an explicit hash/shift (the get* convention).
  ;; arrayNodeDissoc (mirroring the C arrayNodeDissoc, runtime3.c:2733) routes
  ;; by slot index mask(hash, shift):
  ;;  - empty slot → arrayNodeCopyChild returns None → `m` unchanged;
  ;;  - occupied slot → recurse into the child at shift+5 through the dissoc*
  ;;    protocol (type dispatch); arrayNodeUpdate's same-child path returns
  ;;    `m` unchanged when the child is unchanged, otherwise the parent is
  ;;    cloned with the slot replaced.
  ;; Unlike a BMI, an ArrayNode never collapses to emptyBMI — an emptied
  ;; child leaves its slot pointing at emptyBMI. dissoc copies, it never
  ;; mutates: the source map is untouched in every case.

  ;; Miss (empty slot): the 17-entry promoted ArrayNode (slots 0..15 and 20
  ;; occupied). dissoc* key 21 (slot 21 = (21 >> 0) & 31, empty) →
  ;; arrayNodeCopyChild returns None → the node is unchanged: count 17,
  ;; get* still hits key 5 (Val 6) and key 20 (Val 21), the source untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k21 (CHash 21 (Some 21))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (dissoc* m k21 (sha1 k21) 0)]
               (and (= 17 (count m2))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))
                    (= 17 (count m))))
             _FILE_ _LINE_))

  ;; Miss (occupied slot, key mismatch in child): key 1029's slot is 5 =
  ;; (1029 >> 0) & 31 (occupied by key 5's 1-entry BMI); at shift 5 its
  ;; window bit is 0 = ((1029 >> 5) & 31), the same bit the child holds
  ;; (key 5: (5 >> 5) & 31 = 0), but the hashes differ (1029 ≠ 5) → the
  ;; child's bmiDissoc key-compare branch returns the child unchanged →
  ;; arrayNodeUpdate's same-child path → the node is unchanged: count 17,
  ;; get* still hits key 5 (Val 6), the source untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k1029 (CHash 1029 (Some 1029))
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (let [m2 (dissoc* m k1029 (sha1 k1029) 0)]
               (and (= 17 (count m2))
                    (= (Val 6) (get* m2 k5 def (sha1 k5) 0))
                    (= 17 (count m))))
             _FILE_ _LINE_))

  ;; Hit (child shrinks): the 17-entry promoted ArrayNode, then copyAssoc
  ;; key 37 (slot 5; bit 1 at shift 5, empty in the child) → the child's
  ;; addCopiedBMI branch → a 2-entry child (keys 5 and 37) → 18 entries.
  ;; dissoc* key 5 → the child's bmiDissoc: bit 0 at shift 5 set, flat slot,
  ;; key match, popcount 2 → bmiShrink → a 1-entry child (key 37 survives);
  ;; arrayNodeUpdate clones the parent with slot 5 replaced. count 17; get*
  ;; hits key 37 (Val 38) and key 20 (Val 21), misses key 5; vec shows the
  ;; surviving pairs in slot order (slot 5 now holds key 37's pair); the
  ;; 18-entry source is untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k37 (CHash 37 (Some 37))
        m18 (copyAssoc m k37 (Val 38) (sha1 k37) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)
        expected (conj (reduce (range 16) []
                               (fn [vs n]
                                 (cond (= 5 n)
                                       (conj vs [(CHash 37 (Some 37)) (Val 38)])
                                       (conj vs [(CHash n (Some n)) (Val (inc n))]))))
                       [(CHash 20 (Some 20)) (Val 21)])]
    (rt/test (let [m2 (dissoc* m18 k5 (sha1 k5) 0)]
               (and (= 17 (count m2))
                    (= (Val 38) (get* m2 k37 def (sha1 k37) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))
                    (= def (get* m2 k5 def (sha1 k5) 0))
                    (= expected (vec m2))
                    (= 18 (count m18))))
             _FILE_ _LINE_))

  ;; Hit (child becomes empty): the 17-entry promoted ArrayNode. dissoc*
  ;; key 5 (slot 5, a 1-entry child) → the child's bmiDissoc: key match,
  ;; popcount 1 → emptyBMI; arrayNodeUpdate clones the parent with slot 5
  ;; pointed at emptyBMI — an ArrayNode never collapses to emptyBMI itself.
  ;; count 16; get* misses key 5 and hits key 20 (Val 21); vec is the 16
  ;; flat pairs plus key 20's pair (slot 5's emptyBMI contributes nothing);
  ;; the source is untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)
        expected (conj (reduce (range 16) []
                               (fn [vs n]
                                 (cond (= 5 n)
                                       vs
                                       (conj vs [(CHash n (Some n)) (Val (inc n))]))))
                       [(CHash 20 (Some 20)) (Val 21)])]
    (rt/test (let [m2 (dissoc* m k5 (sha1 k5) 0)]
               (and (= 16 (count m2))
                    (= def (get* m2 k5 def (sha1 k5) 0))
                    (= (Val 21) (get* m2 k17 def (sha1 k17) 0))
                    (= expected (vec m2))
                    (= 17 (count m))))
             _FILE_ _LINE_)))

(defn test-hash-vec []
  ;; --- hash-vec / vals (ArrayNode) ---
  ;; hash-vec conjs the [k v] pairs of m onto the seed vector in slot order
  ;; (slots 0..31 in index order — the C arrayNodeSeq pattern — each
  ;; occupied slot's child pairs conjs'd in through the hash-vec protocol,
  ;; type dispatch, since a child may be a BMI, ArrayNode, or
  ;; HashCollisionNode; an empty slot contributes nothing). vals maps
  ;; pair-val over (hash-vec m []).

  ;; Empty ArrayNode (directly built, all 32 slots 0): arrayNodeHashSeq-i
  ;; walks every slot, each arrayNodeCopyChild returns None, and the seed
  ;; passes through untouched: (hash-vec m []) → []; (hash-vec m [""]) →
  ;; the seed alone (count 1); (vals m) → [].
  (let [m (emptyArrayNode)]
    (rt/test (and (= [] (hash-vec m []))
                  (= 1 (count (hash-vec m [""])))
                  (= [""] (hash-vec m [""]))
                  (= [] (vals m)))
             _FILE_ _LINE_))

  ;; Promoted 17-entry ArrayNode: a 16-entry flat BMI (keys 0..15, values
  ;; 1..16) plus a 17th key (hash 20 → empty bit) whose bmiCopyAssoc
  ;; empty-bit branch calls addCopiedBMI's n >= 16 promotion branch → an
  ;; ArrayNode of 17 one-entry BMI sub-nodes (slots 0..15 and 20 occupied).
  ;; arrayNodeHashSeq walks slots 0..31 in index order, dispatching each
  ;; occupied slot's child through the hash-vec protocol (each child is a
  ;; one-entry BMI here): (hash-vec m []) → the 17 pairs in slot order
  ;; (keys 0..15 → values 1..16, then key 20 → Val 21); (hash-vec m [""])
  ;; → the seed element first, then the 17 pairs (count 18 — the commented
  ;; integration tests' (hash-vec full-bmi [""]) shape); (vals m) → the 17
  ;; values in the same slot order. The source map is untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        expected16 (reduce (range 16) []
                           (fn [vs n]
                             (conj vs [(CHash n (Some n)) (Val (inc n))])))
        expected (conj expected16 [(CHash 20 (Some 20)) (Val 21)])
        expected-seeded16 (reduce (range 16) [""]
                                  (fn [vs n]
                                    (conj vs [(CHash n (Some n)) (Val (inc n))])))
        expected-seeded (conj expected-seeded16 [(CHash 20 (Some 20)) (Val 21)])
        vals16 (reduce (range 16) []
                       (fn [vs n]
                         (conj vs (Val (inc n)))))
        expected-vals (conj vals16 (Val 21))]
    (rt/test (and (= 17 (count m))
                  (= expected (hash-vec m []))
                  (= 18 (count (hash-vec m [""])))
                  (= expected-seeded (hash-vec m [""]))
                  (= expected-vals (vals m))
                  (= 17 (count m)))
             _FILE_ _LINE_))

  ;; Promoted ArrayNode with a 2-entry child: the 17-entry promoted
  ;; ArrayNode, then copyAssoc key 37 (slot 5; bit 1 at shift 5, empty in
  ;; the child) → the child's addCopiedBMI branch → a 2-entry child (key 5
  ;; at bit 0, key 37 at bit 1) → 18 entries. arrayNodeHashSeq flattens
  ;; the child's pairs into the slot's position in the child's bit order
  ;; (key 5 first, then key 37); the other slots each contribute their
  ;; single pair, slot 20 last: (hash-vec m []) → 18 pairs; (vals m) → 18
  ;; values. The 17-entry source is untouched.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k37 (CHash 37 (Some 37))
        m18 (copyAssoc m k37 (Val 38) (sha1 k37) 0)
        expected16 (reduce (range 16) []
                           (fn [vs n]
                             (cond (= 5 n)
                                   (conj (conj vs [(CHash 5 (Some 5)) (Val 6)])
                                         [(CHash 37 (Some 37)) (Val 38)])
                                   (conj vs [(CHash n (Some n)) (Val (inc n))]))))
        expected (conj expected16 [(CHash 20 (Some 20)) (Val 21)])
        vals16 (reduce (range 16) []
                       (fn [vs n]
                         (cond (= 5 n)
                               (conj (conj vs (Val 6)) (Val 38))
                               (conj vs (Val (inc n))))))
        expected-vals (conj vals16 (Val 21))]
    (rt/test (and (= 18 (count m18))
                  (= expected (hash-vec m18 []))
                  (= expected-vals (vals m18))
                  (= 17 (count m)))
             _FILE_ _LINE_)))

(defn test-stress-27 []
  ;; --- Stress: 27-entry map built by reduce over a range ---
  ;; Per the commented integration test's shape:
  ;;   (reduce (range 27) {} (fn [m n] (assoc m (- n 1) (inc n))))
  ;; The map-level `assoc` is not wired yet (roadmap 6.1), so each step is a
  ;; `copyAssoc` with an explicit hash/shift (this suite's convention). I60
  ;; keys hash via integerSha1. The 27 keys fill 16+ distinct slots at shift
  ;; 0, so the root BMI promotes to an ArrayNode (type 12) during the build;
  ;; count then dispatches to ArrayNode's count (C arrayNodeCount, summing
  ;; mapCount over the non-empty slots) → 27.
  (let [m (reduce (range 27) emptyBMI
                  (fn [m n]
                    (let [k (- n 1)]
                      (copyAssoc m k (inc n) (sha1 k) 0))))]
    (rt/test (and (= 27 (count m))
                  (= 12 (type-num m)))
             _FILE_ _LINE_)))

(defn test-stress-2001 []
  ;; --- Stress: 2001-entry map built by reduce over a range ---
  ;; Per the commented integration test's shape:
  ;;   (reduce (range 2000) {} (fn [m n] (assoc m (ControlledHash n (Some n)) (inc n))))
  ;; The map-level `assoc` is not wired yet (roadmap 6.1), so each step is a
  ;; `copyAssoc` with an explicit hash/shift (this suite's convention). The
  ;; 2001 CHash keys (hashes 0..2000, all distinct — no collision nodes) fill
  ;; 16+ distinct slots at shift 0, so the root BMI promotes to an ArrayNode
  ;; (type 12) during the build, and the per-slot children (~62 keys each)
  ;; promote again at shift 5 — a 3-level ArrayNode → ArrayNode → BMI
  ;; structure. count dispatches to ArrayNode's count (C arrayNodeCount,
  ;; summing mapCount over the non-empty slots; mapCount recurses through the
  ;; type dispatcher) → 2001.
  (let [m (reduce (range 2001) emptyBMI
                  (fn [m n]
                    (let [k (CHash n (Some n))]
                      (copyAssoc m k (inc n) (sha1 k) 0))))]
    (rt/test (and (= 2001 (count m))
                  (= 12 (type-num m)))
             _FILE_ _LINE_)))

(defn main [_]
  (println "Checking ArrayNode regressions")

  ;; Seed test (trivially green): emptyBMI's bitmap is 0.
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  (test-count)
  (test-get)
  (test-get-miss)
  (test-vec)
  (test-assoc)
  (test-assoc-subnode)
  (test-dissoc)
  (test-hash-vec)
  (test-stress-27)
  (test-stress-2001)

  (println "ArrayNode tests are good")
  )
