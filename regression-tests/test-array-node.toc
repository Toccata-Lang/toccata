(add-ns rt (module "regression-tester.toc"))

;; Note: the elements in the result of `vec` are in implementation-dependent
;; order and may change. That is not an error — just update the affected tests.

(deftype Key1 [n]
  (sha1 [_]
    (sha1 n))

  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

(deftype Val [n]
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= n (.n y)))))

;; Controlled-hash key type: pins exact bit positions via the hash value.
;; `=` is asymmetric by design (the `eq` gate is on the first arg): to make two
;; same-hash keys unequal, the `eq=None` key must be the *new* key in the assoc.
(deftype CHash [h eq]
  (= [x y] (and (= (type-num x) (type-num y)) eq (= h (.h y))))
  (sha1 [_] h))

(defn test-count []
  ;; --- count (ArrayNode) ---
  ;; count wraps the C arrayNodeCount (runtime3.c:2613), which sums mapCount
  ;; over the non-empty slots. An empty ArrayNode (all 32 slots 0) sums to 0.
  (rt/test (= 0 (count (emptyArrayNode)))
           _FILE_ _LINE_)

  ;; Promoted ArrayNode: build a 16-entry flat BMI (16 keys with 16 distinct
  ;; bits at shift 0), then assoc a 17th key whose bit is empty — bmiCopyAssoc's
  ;; empty-bit branch calls addCopiedBMI's n >= 16 promotion branch, converting
  ;; the node to an ArrayNode (17 one-entry BMI sub-nodes). count dispatches to
  ;; ArrayNode's count (C arrayNodeCount summing mapCount over the 17 non-empty
  ;; slots) → 17.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))]
    (rt/test (= 17 (count (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)))
             _FILE_ _LINE_)))

(defn test-get []
  ;; --- get (ArrayNode) ---
  ;; ArrayNode has no `get` method (only the `get*` protocol), so the hit is
  ;; asserted via `get*` with a `def` value (the bmiGet convention: the value
  ;; stored under `k`, or `def` on miss).
  ;;
  ;; Promoted ArrayNode: a 16-entry flat BMI (keys 0..15, values 1..16), then
  ;; a 17th key (hash 20 → empty bit) promotes it to an ArrayNode (17 one-entry
  ;; BMI sub-nodes, one per slot). arrayNodeGet routes by slot index
  ;; mask(hash, shift) and recurses into the occupied slot's child at shift+5
  ;; through the get* protocol. Two keys are asserted: key 5 (slot 5, from the
  ;; flat part) → Val 6, and key 20 (slot 20, the 17th) → Val 21.
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        k5 (CHash 5 (Some 5))
        def (Val 123)]
    (rt/test (and (= (Val 6) (get* m k5 def (sha1 k5) 0))
                  (= (Val 21) (get* m k17 def (sha1 k17) 0)))
             _FILE_ _LINE_)))

(defn test-get-miss []
  ;; --- get (ArrayNode) — miss ---
  ;; arrayNodeGet routes by slot index mask(hash, shift): an empty slot is a
  ;; miss (def, the either else branch); an occupied slot recurses into the
  ;; child at shift+5 through the get* protocol, which returns def on a key
  ;; mismatch. Both branches are asserted against the same promoted
  ;; ArrayNode (17 one-entry BMI sub-nodes: slots 0..15 and 20 occupied).
  (let [full-bmi (reduce (range 16) emptyBMI
                         (fn [m n]
                           (let [k (CHash n (Some n))]
                             (copyAssoc m k (Val (inc n)) (sha1 k) 0))))
        k17 (CHash 20 (Some 20))
        m (copyAssoc full-bmi k17 (Val 21) (sha1 k17) 0)
        def (Val 123)]
    ;; Miss (empty slot): key 21's slot is 21 = (21 >> 0) & 31, which is
    ;; empty (only slots 0..15 and 20 are occupied) → arrayNodeCopyChild
    ;; returns None → def.
    (let [k (CHash 21 (Some 21))]
      (rt/test (= def (get* m k def (sha1 k) 0))
               _FILE_ _LINE_))
    ;; Miss (occupied slot, key mismatch in child): key 69's slot is 5 =
    ;; (69 >> 0) & 31, occupied by key 5's one-entry BMI; at shift 5, 69 has
    ;; bit 0 ((69 >> 5) & 1 = 0), the same bit the child holds (key 5:
    ;; (5 >> 5) & 1 = 0), but the hashes differ (69 ≠ 5) → the child's
    ;; key-compare branch returns def.
    (let [k (CHash 69 (Some 69))]
      (rt/test (= def (get* m k def (sha1 k) 0))
               _FILE_ _LINE_))))

(defn main [_]
  (println "Checking ArrayNode regressions")

  ;; Seed test (trivially green): emptyBMI's bitmap is 0.
  (rt/test (= 0 (bmiBitMap emptyBMI))
           _FILE_ _LINE_)

  (test-count)
  (test-get)
  (test-get-miss)

  (println "ArrayNode tests are good")
  )
