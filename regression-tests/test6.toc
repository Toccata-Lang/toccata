
(defn test-str []
  (inline String
          "    // link(tm, erase, arg_1);
    result = new_port(VAL, (Port)stringValue(\"Howdy, folks 6\\n\"));
"))

(def _ (pr* "knitting\n"))

(defn f [s]
  (pr* s)
  (pr* "1\n")
  (pr* s)
  (pr* "2\n")
  (pr* s)
  (pr* "3\n"))

(def g ((fn [] pr*)))

(def h (g "test a\n"))
(def h (g "test b\n"))

(main [_]
  (test-str)

  ;; test freeing dynamic string
  (pr* (test-str))

  ;; test multiple copies
  (f (test-str))

  ;; test dynamic global fn
  (g (test-str))
  (g (test-str))

  ;; test no arguments closure
  (pr* ((fn [] "bogus str\n")))

  ;; test return static fn
  (((fn [] pr*)) (test-str))

  ;; test static fn arg
  ((fn [g]
     (g
      (test-str)))
   pr*)
  
  ;; test return fn
  ((fn [s] (pr* s))
   (test-str))

  ;; test multiple closure
  ((fn [s]
     (pr* s)
     (pr* s))
   (test-str))

  ;; test shadowing of _
  )

