
(defn lcl-pr* [str]
  ;; If a block comment appears first in the body, it serves
  ;; as the documentation for the function
  (inline Integer
   "    Value *s = (Value *)((u64)str_1 & ~TAG_MASK);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else if (s->type == SubStringType) {
      fprintf(stdout, \"%-.*s\", (int)((SubString *)s)->len, ((SubString *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*'\\n\");
      abort();
    }
    link(tm, erase, str_1);
    result = new_num(new_u24(0));")
  ;; But block comments that appear after are ignored
  )

(def _ (lcl-pr* "knitting\n"))

(defn test-str []
  (inline String
          "    // link(tm, erase, arg_1);
    result = new_port(VAL, (Port)stringValue(\"Howdy, folks 6\\n\"));
"))

(defn f [s]
  (lcl-pr* s)
  (lcl-pr* s)
  (lcl-pr* s))

(def g ((fn [] lcl-pr*)))

(main [_]
  (test-str)

  ;; test multiple copies
  (f (test-str))

  ;; test freeing dynamic string
  (lcl-pr* (test-str))

  ;; test dynamic global fn
  (g (test-str))
  (g (test-str))

  ;; test no arguments closure
  (lcl-pr* ((fn [] "bogus str\n")))

  ;; test return static fn
  (((fn [] lcl-pr*)) (test-str))

  ;; test static fn arg
  ((fn [g]
     (g
      (test-str)))
   lcl-pr*)
  
  ;; test return fn
  ((fn [s] (lcl-pr* s))
   (test-str))

  ;; test multiple closure
  ((fn [s]
     (lcl-pr* s)
     (lcl-pr* s))
   (test-str))

  ;; test shadowing of _
  )

