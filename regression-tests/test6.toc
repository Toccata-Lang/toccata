
(defn lcl-pr* [str]
  ;; If a block comment appears first in the body, it serves
  ;; as the documentation for the function
  (inline Integer
   "
    Value *s = (Value *)((u64)str_0 & ~TAG_MASK);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else if (s->type == SubStringType) {
      fprintf(stdout, \"%-.*s\", (int)((SubString *)s)->len, ((SubString *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*'\\n\");
      abort();
    }
    link(tm, erase, str_0);
    Port result = new_num(new_u24(82));")
  ;; But block comments that appear after are ignored
  )

(def _ (lcl-pr* "knitting\n"))

(main [_]
  (lcl-pr* "Howdy, folks 6\n"))

