
(defn test-str []
  (inline String
          "    // link(erase, arg_1);
    result = term_val((Term)stringValue(\"Howdy, folks 6\\n\"));
"))

(def _ (pr* "knitting\n"))

(defn f [s]
  (pr* s)
  (pr* "1\n")
  (pr* s)
  (pr* "2\n")
  (pr* s)
  (pr* "3\n")
  s)

(def const 72)

;; (defn g [s]
;;   (pr* s))

(def g ((fn [] pr*)))

;; this form of 'g' does weird things. It causes an DUP ~ LAM redex which
;; creates a SUP node with a label of 0. Which may or may not be a problem
;; (def g ((fn [] (fn [s] (pr* s)))))

(def h (g "test a\n"))
(def h (g "test b\n"))
(def _ (g (number-str const)))

(def s "global from test 6\n")
(def dyn-s (test-str))

(main [_]
  (test-str)
  (f s)
  (f "from test 6\n")
  (g (test-str))

  ;; test freeing dynamic string
  (pr* (test-str))

  ;; test multiple copies
  (f dyn-s)
  (f (test-str))

  ;; test no arguments closure
  (pr* ((fn [] "bogus str\n")))

  ;; test return static fn
  (((fn [] pr*)) (test-str))

  ;; test static fn arg
  ((fn [g]
     (g
      (test-str)))
   pr*)
  
  ;; test return fn
  ((fn [s] (pr* s))
   (test-str))

  ;; test multiple closure
  ((fn [s]
     (pr* s)
     (pr* s))
   (test-str))

  ;; test shadowing of _
  )

