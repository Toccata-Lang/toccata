
(main [_]
  (let [xx 10
        xs (list (integer-str xx))
        z "second msg\n"
        f1 (fn f1 [y]
             (pr* y)
             (pr* z)
             (let [x (either (first xs)
                             "1st FAIL!!")]
               (pr* x)
               (pr* " ")
               (pr* x)
               (pr* "\n")
               (pr* z)))
        x (either (first xs)
                  "2nd FAIL!!")]
    (pr* "x: ")
    (pr* x)
    (pr* "\n")
    (pr* "z: ")
    (pr* z)
    (f1 "Howdy\n")))
