
(defn f [q]
  (q))

(main [_]
  (f (fn []
       (let [max (Some 0)]
         (pr* "wut1\n")
         (and (and max
                   (Some 9))
              max))
       (number-str 991)))
  (pr* "boom1\n")
  (f (fn boom2 []
       (let [max (Some 0)]
         (pr* "wut2\n")
         (and (or max
                  (Some 9))
              max))))
  (pr* "boom2\n")
  (f (fn boom3 []
       (let [max (Some 0)]
         (pr* "wut3\n")
         (or (and max
                  (Some 9))
             max))))
  (pr* "boom3\n")
  (f (fn boom4 []
       (let [max (Some 0)]
         (pr* "wut4\n")
         (or (or max
                 (Some 9))
             max))))
  (pr* "boom4\n"))
