;; Codegen bug: a closure applied to the result of a call to the SAME
;; closure var -- (g (g x a) b) -- generates a malformed function body.
;;
;; new-toc emits the "link args to body" closure-construction block in the
;; MIDDLE of the function (right after the outer g call) instead of only at
;; the end. The outer g call is never pushRedex'ed, and its pending APP is
;; rewritten into a LAZ{apps, lams}. The function returns the closure
;; instead of the call result, and main's result location is left an
;; unforced SUB.
;;
;; Expected (buggy) output:
;;   Compiler screwed up. Incomplete result. at runtime3.c:3396
;;
;; Sibling calls to the same closure ((g x a) (g y b) as separate
;; expressions) do NOT trigger it; the inner call must feed the outer call
;; of the same var.

(deftype Box [v])

(defn f [V]
  (let [g (fn [acc isdot]
            (int-cond isdot
                      acc
                      (Box (+ (.v V) (.v acc)))))]
    (g (g (Box 0) 1) 0)))

(main [_]
      (f (Box 42)))
