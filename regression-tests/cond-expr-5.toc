
(defn new-nothing []
  (inline  "result = nothing();\n"))

(main [_]
  (println (cond (= 0 1) (str 'yeppers " " (inc 0))
                   (new-nothing) (str 'yeppers " " (inc 1))
                   (= 0 1) (str 'yeppers " " (inc 2))
                   (new-nothing) (str 'yeppers " " (inc 3))
                   (str 'nopenopenope " " (inc 4))))

  (println 'done))
