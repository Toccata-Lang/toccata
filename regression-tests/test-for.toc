
(add-ns rt (module "regression-tester.toc"))

(main [_]
      (rt/test (= (Some 9) (for [x (Some 8)]
                              (+ x 1)))
               _FILE_ _LINE_)
      (rt/test (= (Some 17) (for [x (Some 8)
                                   y (Some 9)]
                               (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   :let [z (+ 10 x)]
                                   y (Some 9)]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   y (Some 9)
                                   :let [z (+ 10 x)]]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 17) (for [x (Some 8)
                                   :when (Some 1)
                                   y (Some 9)]
                               (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 17) (for [x (Some 8)
                                   y (Some 9)
                                   :when (Some 1)]
                               (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                :when None
                                y (Some 9)]
                            (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :when None]
                            (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   y (Some 9)
                                   :when (Some 1)
                                   :let [z (+ x 10)]]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   y (Some 9)
                                   :let [z (+ x 10)]
                                   :when (Some 1)]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :when None
                                :let [z (+ x 10)]]
                            (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :let [z (+ x 10)]
                                :when None]
                            (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 17) (for [x (Some 8)
                                   :when-not None
                                   y (Some 9)]
                               (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 17) (for [x (Some 8)
                                   y (Some 9)
                                   :when-not None]
                               (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                :when-not (Some 1)
                                y (Some 9)]
                            (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :when-not (Some 1)]
                            (+ x y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   y (Some 9)
                                   :when-not None
                                   :let [z (+ x 10)]]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= (Some 27) (for [x (Some 8)
                                   y (Some 9)
                                   :let [z (+ x 10)]
                                   :when-not None]
                               (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :when-not (Some 1)
                                :let [z (+ x 10)]]
                            (+ z y)))
               _FILE_ _LINE_)
      (rt/test (= None (for [x (Some 8)
                                y (Some 9)
                                :let [z (+ x 10)]
                                :when-not (Some 1)]
                            (+ z y)))
               _FILE_ _LINE_)
      (println "'for' is good"))
