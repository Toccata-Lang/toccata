
(deftype Error [val state]
  Stringable
  (str-vect [_] 
    (vector "(Error " (str val) ")")))

(deftype new-se [invoke-fn]
  ! invoke-fn Fn

  Stringable
  (str-vect [x]
    (comp (vector "<new-se ")
          (str-vect (.invoke-fn x))
          (vector ">")))

  Function
  (invoke [ev s]
    (invoke-fn s))

  Container
  (map [ev f]
    (new-se (fn [st]
              (let [x (invoke-fn st)]
                (either (instance? Error x)
                        (let [[v new-s] x]
                          [(f v) new-s]))))))

  (wrap [_ v]
    (new-se (fn [s]
              [v s])))

  (flat-map [ev f]
    (new-se (fn [s]
              (let [x (invoke-fn s)]
                (either (instance? Error x)
                        (let [[v new-s] x]
                          ((f v) new-s))))))))

(defn state-error [v]
  (new-se (fn [s]
            [v s])))

(defn tc [sym]
  (let [s 'sumptin]
    (flat-map (state-error 'checking)
              (fn [_]
                (println 'test 2 s)
                (map (state-error 'again)
                     (fn [c]
                       (or (instance? Symbol s)
                           (abort))
                       c))))))

(main [_]
  (println ((tc 'some-sym)
              {'module (vector {'some-sym 'blewie})})))
