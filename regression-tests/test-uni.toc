(defn init [f]
  (inline "
universalProtoFn = (Value *)f_1;
result = nothing();
"))

(defp no-default [x y z]
  None)

(defp with-default [x y]
  'the-default-result)


(defn f [path fn-sym disp-arg args]
  (println 'uni path fn-sym disp-arg args)
  None)

(deftype Reified []
  Stringable
  (str-vect [_]
    (vector "Howdy"))

  no-default
  (no-default [x y z]
    (inc 91))
  with-default
  (with-default [x y]
    (str 'bippity)))

(main [_]
      (init f)
      (or (and (= "bippity" (with-default Reified (inc 8)))
               (= 92 (no-default Reified (inc 1) (str "a" "b"))))
          (Some (abort "boom"))))
