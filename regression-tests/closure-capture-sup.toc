;; closure-capture-sup.toc — regression test for a lazy-machine SUP bug.
;;
;; Bug: a closure-captured variable that is RESOLVED in some reduce
;; iterations and ERASED in others leaves a superposition (SUP) in the
;; result, which leaks nodes.
;;
;; Structure that triggers it (all three required):
;;   1. `V` is captured by the reduce lambda (a closure, not a plain param).
;;   2. `acc` is referenced in BOTH cond branches, so it is DUP'd.
;;   3. `V` is resolved in the dot-branch and erased in the plain-branch.
;;
;; The MIXED sequence [1 2] (resolve then erase) is what breaks it:
;;   [1 1] / [2 2] / [1] / [2]  ->  clean (remaining nodes: 0)
;;   [1 2] / [2 1]              ->  "bad result SUP pair" + node leak
;;
;; The value printed (42) is correct; the defect is the leak, visible in
;; the stats line as a non-zero "remaining nodes" count. When the bug is
;; fixed this test's .rslt should show "remaining nodes: 0".

(deftype Box [v])

(main [_]
  (let [V (Box 42)]
    (let [r (reduce [1 2] (Box 0)
                    (fn [acc isdot]
                      (cond (= isdot 1)
                            (Box (+ (.v V) (.v acc)))
                            (Box (.v acc)))))]
      (pr* (number-str (.v r))))))
