
(add-ns rt (module "regression-tester.toc"))

(defn make-f [x]
  (fn []
    ;; (fn [y]
    ;;   (pr* (str "x:" x "\n"))
    ;;   ;; (println "sum:" (+ x y))
    ;;   (inc x)
    ;;   )
    inc
    ))

(defn main [_]
  (println "Checking closure regressions")

  (let [y (+ 1 3)]
    (-> [1 2 3]
        (map (fn [x]
               (fn []
                 (+ x y))))
        (map (fn [f]
               (f)))
        (map (fn [x]
               (pr* (number-str x))))))
  ;; (((make-f 83)) 7)
  ;; (pr* (str (vect-map [1 2 3] ((make-f 47))) "\n"))

  (println "Closures are good"))
