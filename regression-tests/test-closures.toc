
(add-ns rt (module "regression-tester.toc"))

(defn p [x]
  (= 1 x))

(def v [1 2])

(defn make-f [x]
  (fn []
    (fn [y]
      ;; (pr* (str "x:" x "\n"))
      ;; (println "sum:" (+ x y))
      (+ y x))))

(defn main [_]
  (println "Checking closure regressions")

  ;; (filter v p)

  ;; (let [p-val 1]
  ;;   (filter v (fn [x]
  ;;               (= p-val x))))

  (let [sep " "]
    (vect-map [] (fn [x]
                   [sep x]))
    (vect-map v (fn [x]
                  [sep x])))

  (let [y (+ 1 3)]
    (-> [1 2 3]
        (map (fn [x]
               (fn []
                 (+ x y))))
        (map (fn [f]
               (f)))
        (map (fn [x]
               (pr* (number-str x))))))
  (((make-f 83)) 7)
  (pr* (str (vect-map [1 2 3] ((make-f 47))) "\n"))

  (println "Closures are good"))
