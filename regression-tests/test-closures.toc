
(add-ns rt (module "regression-tester.toc"))

(defn p [x]
  (= 1 x))

(def v [1 2])

(defn vr [vect n result f]
  (let [el (vect-get vect n)]
    (cond el
          (vr vect (inc n) (f result (.x el)) f)
          result)))

(defn filt [v pred]
  (vr v 0 [] (fn [result x]
               (cond (pred x)
                     (vect-conj result x)
                     result))))

(defn make-f [x]
  (fn []
    (fn [y]
      ;; (pr* (str "x:" x "\n"))
      ;; (println "sum:" (+ x y))
      (+ y x))))

(defn main [_]
  (println "Checking closure regressions")

  ;; (filt v p)

