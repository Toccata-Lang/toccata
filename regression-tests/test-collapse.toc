
(defn cons-small [x l]
  (cond (< x 3)
        (cons x l)
        EndOfList))

(defn main [argv]
  (println 'empty (collapse + (|) 0))
  (println 'empty-children (collapse + (| (|) (|)) 0))
  (println 'left-single (collapse + (| 1) 0))
  (println 'right-single (collapse + (| (|) 2) 0))
  (println 'double (collapse + (| 1 2) 0))
  (println 'balanced (collapse +
                               (| (| 1 2)
                                  (| 3 4))
                               0))
  (println 'list-empty (collapse cons (|) EndOfList))
  (println 'list-empty-children (collapse cons (| (|) (|)) EndOfList))
  (println 'list-left-single (collapse cons (| 1) EndOfList))
  (println 'list-right-single (collapse cons (| (|) 2) EndOfList))
  (println 'list-double (collapse cons (| 1 2) EndOfList))
  (println 'list-balanced (collapse cons
                                    (| (| 1 2)
                                       (| 3 4))
                                    EndOfList))

  (println 'lazy-list-empty (collapse cons-small (|) EndOfList))
  (println 'lazy-list-empty-children (collapse cons-small (| (|) (|)) EndOfList))
  (println 'lazy-list-left-single (collapse cons-small (| 1) EndOfList))
  (println 'lazy-list-right-single (collapse cons-small (| (|) 2) EndOfList))
  (println 'lazy-list-double (collapse cons-small (| 1 2) EndOfList))
  (println 'lazy-list-balanced (collapse cons-small
                                         (| (| 1 2)
                                            (| 3 4))
                                         EndOfList))
  0)
