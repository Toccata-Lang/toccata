;; example.toc - test corpus for the new-toc AST dumper.
;; Every example is a top-level node; every header comment is one too.

;; 01 integer zero
0

;; 02 small integer
42

;; 03 byte-max integer
255

;; 04 large integer
123456789012345

;; 05 bare symbol
x

;; 06 kebab-case symbol
parse-expr

;; 07 camelCase symbol (ctor-style name)
ParserState

;; 08 empty string
""

;; 09 one-char string
"a"

;; 10 string with spaces
"hello world"

;; 11 longer string with punctuation
"the quick brown fox jumps over the lazy dog"

;; 12 string with digits
"item 42 of 100"

;; 13 empty vector
[]

;; 14 single-element vector
[1]

;; 15 three-element vector
[1 2 3]

;; 16 vector of strings
["a" "b" "c"]

;; 17 nested vector
[[1 2] [3 4]]

;; 18 vector of mixed shapes
[1 "two" [3]]

;; 19 empty hash map
{}

;; 20 single-pair hash map
{"k" 1}

;; 21 multi-pair hash map
{"k" 1, "j" 2}

;; 22 hash map with vector value
{"k" [1 2]}

;; 23 nested hash map
{"a" {"b" 1}}

;; 24 zero-arg form
(f)

;; 25 one-arg form
(f x)

;; 26 two-arg form
(f a b)

;; 27 form with literal args
(+ 1 2)

;; 28 nested form
(f (g x))

;; 29 three-deep form
(f (g (h x)))

;; 30 form with a vector arg
(vect-map [1 2 3] f)

;; 31 zero-arg fn
(fn [] 1)

;; 32 identity fn
(fn [x] x)

;; 33 two-arg fn
(fn [x y] x)

;; 34 fn with a form body
(fn [x] (+ x 1))

;; 35 fn inside a call
(map [1 2 3] (fn [x] x))

;; 36 single-binding let
(let [x 1] x)

;; 37 two-binding let (sequential: b sees a)
(let [a 1 b (+ a 1)] b)

;; 38 let with a form initializer
(let [v [1 2 3]] (count v))

;; 39 nested let
(let [x 1] (let [y (+ x 1)] y))

;; 40 let with fn value
(let [inc (fn [x] (+ x 1))] (inc 41))

;; 41 cond, one clause plus default
(cond x 1 2)

;; 42 cond, two clauses (blank-line separated)
(cond (str= s "a")
      1

      (str= s "b")
      2

      0)

;; 43 cond, all clauses on one line
(cond (str= c "x") 1 (str= c "y") 2 0)

;; 44 cond with form values
(cond (empty? v)
      []

      v)

;; 45 cond nested in let
(let [n 2]
  (cond (zero? n)
        "zero"

        "nonzero"))

;; 46 two-way superposition
(| a b)

;; 47 three-way superposition
(| a b c)

;; 48 empty superposition
(|)

;; 49 superposition of forms
(| (f 1) (g 2))

;; 50 superposition inside a call
(h (| 1 2))

;; 51 two-step thread
(-> 5 inc)

;; 52 three-step thread
(-> 5 inc inc)

;; 53 thread from a bare symbol
(-> x inc)

;; 54 thread with a multi-arg step
(-> v conj 9)

;; 55 thread with a fn step
(-> 5 (fn [n] (* n n)))

;; 56 simplest defn
(defn double [x]
  (* x 2))

;; 57 defn with two args
(defn add2 [a b]
  (+ a b))

;; 58 defn with a let body
(defn length-plus [v n]
  (let [c (count v)]
    (+ c n)))

;; 59 defn calling an earlier defn
(defn quadruple [x]
  (double (double x)))

;; 60 mutually recursive defns
(defn even? [n]
  (cond (zero? n)
        true

        (odd? (- n 1))))

(defn odd? [n]
  (cond (zero? n)
        false

        (even? (- n 1))))

;; 61 defn with a cond body
(defn clamp [n lo hi]
  (cond (< n lo)
        lo

        (> n hi)
        hi

        n))

;; 62 defn returning a vector
(defn pair [x]
  [x x])

;; 63 defn returning a hash map
(defn entry [k v]
  {k v})

;; 64 defn with a fn arg
(defn apply-twice [f x]
  (f (f x)))

;; 65 defn with a superposition body
(defn either-branch [x]
  (| (inc x) (dec x)))

;; 66 singleton deftype (no fields)
(deftype Marker
  (Marked))

;; 67 single-ctor deftype with fields
(deftype Point
  [x y])

;; 68 multi-ctor deftype
(deftype Maybe2
  (None)
  (Some [v]))

;; 69 defn using a ctor and a getter
(defn point-x [p]
  (.x p))

;; 70 defn constructing a value
(defn make-point [x y]
  (Point x y))

;; 71 bodyless defp
(defp double? [x])

;; 72 defp with default body
(defp describe [v]
  !returns String
  "value")

;; 73 extend-type impl
(extend-type Point
  (double? [p]
    (zero? (.y p))))

;; 74 defp calling a defn (inline-C stopgap pattern)
(defn default-shape [p]
  "point")

(defp shape [p]
  !returns String
  (default-shape p))

;; 75 add-ns from a module
(add-ns ex (module "example.toc"))

;; 76 defn with an inline C body
(defn c-identity [x]
  (inline "result = x_1;"))

;; 77 defn with a typed inline C body
(defn c-one []
  (inline Integer "
    result = newI60(IntegerType);"))

;; 78 defn with a multi-line inline C body
(defn c-tag [x]
  (inline Integer "
    switch(termTag(x_1)) {
    case I60:
      result = newI60(IntegerType);
      break;
    default:
      result = newI60(FunctionType);
    }"))

;; 79 let binding a hash map, used twice
(let [m {"a" 1, "b" 2}]
  (+ (get m "a") (get m "b")))

;; 80 cond over a hash map lookup
(let [m {"a" 1}]
  (cond (get m "a")
        "present"

        "absent"))

;; 81 fn returning a hash map
(fn [k]
  {k 1})

;; 82 vector of fns
[(fn [x] x) (fn [x] (+ x 1))]

;; 83 superposition of vectors
(| [1] [2])

;; 84 thread through a hash map
(-> {} conj)

;; 85 defn with let, cond, and fn all together
(defn safe-div [a b]
  (let [r (fn [d] (cond (zero? d) 0 (/ a d)))]
    (r b)))

;; 86 defn mapping a vector with an inner let
(defn squares [vs]
  (vect-map vs
    (fn [v]
      (let [s (* v v)]
        s))))

;; 87 defn with a four-arg body and nested cond
(defn pick [test val other fallback]
  (cond test
        val

        other
        other

        fallback))

;; 88 defn building right-nested structure via reduce
(defn build-chain [xs base]
  (reduce (reverse xs) base comp))

;; 89 defn with a closure capturing two locals
(defn make-adder [a b]
  (fn [x] (+ a (+ b x))))

;; 90 defn using extract on a vector head
(defn head [v]
  (extract (first v)))

;; 91 defn combining thread and let
(defn norm [v]
  (let [c (count v)]
    (-> v conj c)))

;; 92 defn with a superposition of calls
(defn probe [x]
  (| (f x) (g x)))

;; 93 defn returning a nested vector of pairs
(defn pairs [a b]
  [[a b] [b a]])

;; 94 defn with a three-clause cond and form tests
(defn classify [n]
  (cond (< n 0)
        "neg"

        (zero? n)
        "zero"

        "pos"))

;; 95 defn with sequential let of three bindings
(defn summarize [v]
  (let [c (count v)
        h (extract (first v))
        t (extract (last v))]
    [c h t]))

;; 96 defn taking a hash map and threading over it
(defn map-size [m]
  (-> m keys count))

;; 97 defn with a fn arg applied inside a let
(defn wrap-apply [f x y]
  (let [fx (f x)]
    [fx (f y)]))

;; 98 defn with nested superpositions
(defn scatter [x]
  (| (| x 1) (| x 2)))

;; 99 defn combining every expression form
(defn kitchen-sink [v f]
  (let [n (count v)
        m {n v}]
    (cond (zero? n)
          (-> {} conj)

          (vect-map v
            (fn [x]
              (| (f x) x))))))

;; 100 main: entry point, args, let, cond, extract, string ops
(main [argv]
  (let [file (extract (get argv 1))]
    (cond (str= file "")
          "no argument given"

          (to-str ["file: " file]))))

;; 101 negative integer
-1

;; 102 negative large integer
-987654321098765

;; 103 vector mixing negative and positive integers
[-3 -2 -1 0 1 2 3]

;; 104 quoted-symbol string literal (exercises the 'symbol branch of read-string-literal)
'foo

;; 105 comment embedded in an expression is ignored as whitespace
(f ;; c
  (g x))

;; 106 simple symbol; expected AST for the symbol node:
;; {"kind": "symbol", "start": 7314, "end": 7315, "children": []}
z
