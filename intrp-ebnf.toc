(add-ns rdr (module "intrp-rdr.toc"))

; EBNF Prototype Function
(defp ebnf [combinator]
  ! combinator rdr/ParserCombinator
  ! -> String
)

; Implementation for CharRange
(extend-type rdr/CharRange
  (ebnf [combinator]
    (str (.lower combinator) " - " (.upper combinator))))

; Implementation for StringMatch
(extend-type rdr/StringMatch
  (ebnf [combinator]
    (str "\"" (.strng combinator) "\"")))

; Implementation for AlwaysSucceed
(extend-type rdr/AlwaysSucceed
  (ebnf [combinator]
    (str "{success: " (.value combinator) "}")))

; Implementation for NotChar
(extend-type rdr/NotChar
  (ebnf [combinator]
    (str "[^" (.char combinator) "]")))

; Implementation for Error
(extend-type rdr/Error
  (ebnf [combinator]
    (str "{error: \"" (.msg combinator) "\"}")))

; Implementation for All
(extend-type rdr/All
  (ebnf [combinator]
    (let [parser-strs (flat-map (.parsers combinator)
                                (fn [x]
                                  [", " x]))]
      (str "(" (rest parser-strs) ")"))))

; Implementation for Many
(extend-type rdr/Many
  (ebnf [combinator]
    (str "{" (.parser combinator) "}*")))

; Implementation for Any
(extend-type rdr/Any
  (ebnf [combinator]
    (let [parser-strs (flat-map (.parsers combinator)
                                (fn [x]
                                  [" | " x]))]
      (str "(" (rest parser-strs) ")"))))

; Implementation for Rule
(extend-type rdr/Rule
  (ebnf [combinator]
    (str "<" (.name combinator) "> = " (.parser combinator))))

(main [_]
  ;; (println (fold rdr/digits ebnf))
  ;; (println (fold rdr/def-keyword ebnf))
  (println (fold rdr/alpha ebnf))
  0)
