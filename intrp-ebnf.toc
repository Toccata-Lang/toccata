(add-ns rdr (module "intrp-rdr.toc"))

(deftype EBNFOut [rules output]
  ! rules [String]
  ! output String
 )

; EBNF Prototype Function
(defp ebnf [combinator]
  ! combinator rdr/ParserCombinator
  ! -> EBNFOut
)

; Implementation for CharRange
(extend-type rdr/CharRange
  (ebnf [combinator]
    (EBNFOut [] (str "\"" (.lower combinator) "\" - \"" (.upper combinator) "\""))))

; Implementation for StringMatch
(extend-type rdr/StringMatch
  (ebnf [combinator]
    (EBNFOut [] (str "\"" (.strng combinator) "\""))))

; Implementation for AlwaysSucceed
(extend-type rdr/AlwaysSucceed
  (ebnf [combinator]
    (EBNFOut [] (str "{success: " (.value combinator) "}"))))

; Implementation for NotChar
(extend-type rdr/NotChar
  (ebnf [combinator]
    (EBNFOut [] (str "[^" (.char combinator) "]"))))

; Implementation for Error
(extend-type rdr/Error
  (ebnf [combinator]
    (EBNFOut [] (str "{error: \"" (.msg combinator) "\"}"))))

; Implementation for All
(extend-type rdr/All
  (ebnf [combinator]
    (let [combined-rules (-> (.parsers combinator)
                             (map .rules)
                             (reduce [] (fn [rules new-rules]
                                          (comp rules new-rules))))
          parser-strs (to-str (interpose (map (.parsers combinator) .output) ", "))]
      (EBNFOut combined-rules (str "(" parser-strs ")")))))

; Implementation for Many
(extend-type rdr/Many
  (ebnf [combinator]
    (EBNFOut (.rules (.parser combinator))
             (str "{" (.output (.parser combinator)) "}*"))))

; Implementation for Any
(extend-type rdr/Any
  (ebnf [combinator]
    (let [combined-rules (-> (.parsers combinator)
                             (map .rules)
                             (reduce [] (fn [rules new-rules]
                                          (comp rules new-rules))))
          parser-strs (to-str (interpose (map (.parsers combinator) .output) " | "))]
      (EBNFOut combined-rules (str "[" parser-strs "]")))))

; Implementation for Rule
(extend-type rdr/Rule
  (ebnf [combinator]
    (let [rule-name (str "<" (.name combinator) ">")
          combined-rules (conj (.rules (.parser combinator))
                               (str rule-name " = " (.output (.parser combinator))))]
      (EBNFOut combined-rules rule-name))))

(main [_]
  (println (to-str (interpose (.rules (fold rdr/symbol ebnf)) "\n")))
  0)
