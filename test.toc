;; test.toc - experiment: a tiny reader over intrp-state.toc that
;; either matches the literal "poop" or returns a ParserError.

(add-ns state (module "interpreter/intrp-state.toc"))

(defn parse-poop [state]
  (let [s (state/skip-whitespace state)]
    (| (cond (str-prefix? "poop" (.input s))
             (state/ParserMatch "poop" (state/take-chars s 4))
             (|))
       (state/ParserError "expected 'poop'" s))))

(defn main [argv]
  (println 'empty (collapse + (|) 0))
  (println 'empty-children (collapse + (| (|) (|)) 0))
  (println 'left-single (collapse + (| 1) 0))
  (println 'right-single (collapse + (| (|) 2) 0))
  (println 'double (collapse + (| 1 2) 0))
  (println 'balanced (collapse +
                               (| (| 1 2)
                                  (| 3 4))
                               0))
  ;; (println 'poop (collapse cons
  ;;                          (parse-poop (state/make-state "poop" "test" 1))
  ;;                          (EndOfList)))
  ;; (println 'nope (parse-poop (state/make-state "nope" "test" 1)))
  0)
