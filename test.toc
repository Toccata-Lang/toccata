
(deftype ParserState [input values]
  ! input String)

(defp pick-result [r f])
(defp next-step [r g])
(defp parser-fn [p])

(deftype ParserResults
  (ParserMatch [value state]
    (next-step [m nxt]
               ((parser-fn (nxt value)) state))
    (pick-result [m acc]
                 m))

  (ParserError [msg]
    (pick-result [err1 err2]
                 err1)))

(deftype Parser [fst]
  (parser-fn [_]
    fst))

(defn bind [p k]
  (Parser (fn [st]
            (next-step ((parser-fn p) st) k))))

(def two-live
  (Parser (fn [state]
            (let [in (.input state)]
              (| (ParserMatch "x" (ParserState (rest in) (.values state)))
                 (ParserMatch "y" (ParserState (rest in) (.values state))))))))

(defn two [p]
  (bind p (fn [xs]
            (bind p
                  (fn [ys]
                    (Parser (fn [st]
                              (ParserMatch (vector xs ys)))))))))

(defn main [argv]
  (collapse pick-result
            ((parser-fn (two two-live)) (ParserState "a" "v"))
            (ParserError "no parse"))
  0)
