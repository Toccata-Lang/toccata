;; @clr = λx. λ&o. λi. λe. x(λp.o(@clr(p)), λp.o(@clr(p)), e)
(def clr1)
(defn clr1 [x o i e]
  (x (fn clr1-0 [p]
       (o (clr1 p)))
     (fn clr1-1 [p]
       (o (clr1 p)))
     e))

;; attempt #1
;; @clr = λx. λo. λi. λe. x(λp.λo.o(@clr(p)), λp.λo.o(@clr(p)), λo.e, o)
(def clr2)
(defn clr2 [x]
  (fn clr2-f [o i e]
    ((x (fn clr2-0 [p]
          (fn clr2-0-c [o]
            (o (clr2 p))))
        (fn clr2-1 [p]
          (fn clr2-1-c [o]
            (o (clr2 p))))
        (fn clr-2-done [o]
          e))
     o)))

