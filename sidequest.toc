(def rep)
(defn rep [xs]
  (xs (fn rep-O [p f x]
        ;; (pr* "rep-O\n")
        ((rep p)
         (fn rep-0-c [k]
           ;; (pr* "rep-0-c\n")
           (f (f k)))
         x))
      (fn rep-I [p f x]
        ;; (pr* "rep-I\n")
        ((rep p)
         (fn rep-1-c [k]
           ;; (pr* "rep-I-c\n")
           (f (f k)))
         (f x)))
      (fn rep-E [f x]
        x)))
        
