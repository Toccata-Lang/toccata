
(defn str-to-int [str]
  (inline "
    if (termTag(str_1) != VAL) {
      fprintf(stderr, \"\\ninvalid type for 'pr*': Integer or Float\\n\");
      abort();
    }
    char dest[100];
    int len;
    char *src;
    int num = 0;
    Value *s = (Value *)((u64)str_1 & ~7);
    if (s->type == StringBufferType) {
      src = ((String *)s)->buffer;
      len = (int)((String *)s)->len;
    } else if (s->type == SubStringType) {
      ReifiedVal *ss = (ReifiedVal *)str_1;
      String *parent = (String *)ss->impls[0];
      long start = getI60(ss->impls[1]);
      len = (int)getI60(ss->impls[2]);
      src = &parent->buffer[start];
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*': %ld\\n\", s->type);
      abort();
    }
    strncpy(dest, src, len);
    dest[len] = 0;
    sscanf(dest, \"%d\", &num);
    dec_and_free(str_1, 1);
    result = newI60(num);"))

(defn /2 [x]
  (inline "
    unsigned x = (unsigned)getI60(x_1);
    result = newI60(x >> 1);
"))

(defn >> [x n]
  (inline "
    unsigned x = (unsigned)getI60(x_1);
    unsigned n = (unsigned)getI60(n_2);
    result = newI60(x >> n);
"))

;; printing 
(def pr0)
(def pr1)

(defn prLF [p]
  (pr* "\n"))

(defn pr0 [p]
  (pr* "0")
  (p pr0 pr1 prLF))

(defn pr1 [p]
  (pr* "1")
  (p pr0 pr1 prLF))

(defn output [bits]
  ((bits pr0 pr1 prLF)))

(defn hbin [N]
  (int-cond N
        ((fn hbin-step [l]
           (fn hbin-n [n]
             ((fn hbin-cond [x]
                (int-cond x
                      (fn hbin-1 [o i e]
                        (i ((hbin (- l 1)) (/2 n))))
                      (fn hbin-0 [o i e]
                        (o ((hbin (- l 1)) (/2 n))))))
              (bit-and n 1))))
         N)

        (fn hbin-done [n]
          (fn hbin-e [o i e]
            e))))

(defn bin [bits v]
  (int-cond bits
            (int-cond (bit-and v 1)
                      ;; '1' bit
                      (fn bin-1-1 [o i e]
                        ;; (pr* "bin-I\n")
                        (i (bin (dec bits) (/2 v))))

                      ;; '0' bit
                      (fn bin-1-1 [o i e]
                        ;; (pr* "bin-O\n")
                        (o (bin (dec bits) (/2 v)))))

            (fn bin-0 [o i e]
              e)))

