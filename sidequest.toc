;; @rep = λxs.
;;   ! O = λp.λ&f.λx.@rep(p,λk.f(f(k)),x)
;;   ! I = λp.λ&f.λx.@rep(p,λk.f(f(k)),f(x))
;;   ! E = λf.λx.x
;;   xs(O, I, E)


(def rep)
(defn rep-O [p f x]
  (rep p
       (fn [k] (f (f k)))
       x))
(defn rep-I [p f x]
  (rep p
       (fn [k] (f (f k)))
       (f x)))
(defn rep-E [f x]
  x)
(defn rep [xs]
  (xs rep-O rep-I rep-E))
        
(defn simplest [b]
  (fn [t]
    (fn [f]
      (b f f))))

(defn counter [b]
  (fn [t]
    (fn [f]
      (b (f f) f))))

(defn O [p o i e]
  (o p))

(defn I [p o i e]
  (i p))

(defn E [o i e]
  e)

(def view)
(defn view [xs]
  (xs (fn [p]
        (pr* "0")
        ;; ["#O" (view p)]
        (view p)
        )
      (fn [p]
        (pr* "1")
        ;; ["#I" (view p)]
        (view p)
        )
      ;; ["#E" []]
      (pr* "\n")
      ))

(defn N [c s n]
  n)

(def insert)
(defn insert [n]
  (let [O (fn [p xs o i e]
            (abort "Boom"))
        I (fn [p xs o i e]
            (let [O (fn [xs]
                      (o (insert p xs)))
                  I (fn [xs]
                      (i (insert p xs)))
                  E (o (insert p N))]
              (xs O I E)))
        E (fn [xs o i e]
            (let [O (fn [xs]
                  (i xs))
                  I (fn [xs]
                  (i xs))
                  E (i N)]
              (xs O I E)))]
    (n O I E)))

