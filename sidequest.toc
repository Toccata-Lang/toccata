(defn bin [bits v]
  (int-cond bits
            (int-cond (bit-and v 1)
                      ;; '1' bit
                      (fn bin-1-1 [o i e]
                        ;; (pr* "bin-I\n")
                        (i (bin (dec bits) (/2 v))))

                      ;; '0' bit
                      (fn bin-1-1 [o i e]
                        ;; (pr* "bin-O\n")
                        (o (bin (dec bits) (/2 v)))))

            (fn bin-0 [o i e]
              e)))

;; @clr = λx. λ&o. λi. λe. x(λp.o(@clr(p)), λp.o(@clr(p)), e)
(def clr1)
(defn clr1 [x]
  (fn clr1-f [o i e]
    (x (fn clr1-0 [p]
         (pr* "clr1 0 bit\n")
         (o (clr1 p)))
       (fn clr1-1 [p]
         (pr* "clr1 1 bit\n")
         (o (clr1 p)))
       e)))

;; @clr = λx. λo. λi. λe. x(λp.λo.o(@clr(p)), λp.λo.o(@clr(p)), λo.e, o)
(def clr2)
(defn clr2 [x]
  (fn clr2-f [o i e]
    ((x (fn clr2-0 [p]
          (fn clr2-0-c [o]
            (pr* "clr2 0 bit\n")
            (o (clr2 p))))
        (fn clr2-1 [p]
          (fn clr2-1-c [o]
            (pr* "clr2 1 bit\n")
            (o (clr2 p))))
        (fn clr-2-done [o]
          e))
     o)))

