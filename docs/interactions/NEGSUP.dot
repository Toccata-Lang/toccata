graph NEG_SUP {
rankdir=TB;

subgraph cluster_before_NEG_SUP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a8_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b8_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg8_1 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
sup8_1 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x8_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y8_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a8_1:s -- neg8_1:nw
b8_1:s -- neg8_1:ne
neg8_1:s -- sup8_1:n
sup8_1:sw -- x8_1:n
sup8_1:se -- y8_1:n
}

subgraph cluster_after_NEG_SUP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a8_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b8_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg8_2 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
neg8_3 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup8_2 [label="D",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
laz8_2 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
sup8_2 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x8_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y8_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
b8_2:s -- sup8_2:n
sup8_2:sw -- neg8_2
sup8_2:se -- neg8_3
laz8_2:sw -- dup8_2:n
laz8_2:se -- a8_2:n
neg8_2:sw -- laz8_2:n
neg8_3:sw -- laz8_2:n
neg8_2:se -- x8_2:n
neg8_3:se -- y8_2:n
}
}
