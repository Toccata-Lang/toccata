graph DUP_NUL {
rankdir=TB;

subgraph cluster_before_DUP_NUL {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a12_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b12_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup12 [label="D",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a12_1:s -- dup12:nw
b12_1:s -- dup12:ne
nul12_1 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
dup12:s -- nul12_1:n
}

subgraph cluster_after_DUP_NUL {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a12_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b12_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
nul12_2 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
nul12_3 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
a12_2:s -- nul12_2:n
b12_2:s -- nul12_3:n
}
}
