graph OP_NUL {
rankdir=TB;

subgraph cluster_before_OP_NUL {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a5_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b5_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
op5 [label="op",  height=0.5, width=0.5, fixedsize=true,  shape=none]
a5_1:s -- op5:nw
b5_1:s -- op5:ne
nul5_1 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
op5:s -- nul5_1:n
}

subgraph cluster_after_OP_NUL {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a5_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b5_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
nul5_2 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
era5_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a5_2:s -- nul5_2:n
b5_2:s -- era5_2:n
}
}
