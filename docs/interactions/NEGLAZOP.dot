graph NEG_LAZ_OP {
rankdir=TB;

subgraph cluster_before_NEG_LAZ_OP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a20_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b20_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg20_1 [label="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
laz20_1 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
neg20_2 [label="*", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x20_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
a20_1:s -- neg20_1:nw
b20_1:s -- neg20_1:ne
neg20_1:s -- laz20_1:n
laz20_1:sw -- neg20_2:n
laz20_1:se -- x20_1:n
c20_1 [label="c",  height=0.4, width=0.4, fixedsize=true, shape=none]
d20_1 [label="d",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg20_2:sw -- c20_1:n
neg20_2:se -- d20_1:nw
d20_1:ne -- laz20_1:s
}

subgraph cluster_after_NEG_LAZ_OP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a20_3 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b20_3 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg20_3 [label="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
neg20_4 [label="*", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x20_3 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
x20_3:s -- neg20_4:n
c20_3 [label="c",  height=0.4, width=0.4, fixedsize=true, shape=none]
d20_3 [label="d",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg20_4:sw -- c20_3:n
neg20_4:se -- d20_3:n
neg20_3:sw -- a20_3:n
neg20_3:se -- b20_3:n
d20_3:s -- neg20_3:n
}
}
