graph ERA_LAZ_OP {
rankdir=TB;

subgraph cluster_before_ERA_LAZ_OP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
era19_1 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
laz19_1 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
neg19_1 [label="*", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x19_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
era19_1:s -- laz19_1:n
laz19_1:sw -- neg19_1:n
laz19_1:se -- x19_1:n
a19_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b19_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg19_1:sw -- b19_1:n
neg19_1:se -- a19_1:nw
a19_1:ne -- laz19_1:s
}

subgraph cluster_after_ERA_LAZ_OP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
era19_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
era19_3 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
nul19_2 [label="NUL", height=0.4, width=0.6, fixedsize=true, shape=plaintext]
x19_2 [label="x", height=0.4, width=0.4, fixedsize=true, shape=none]
neg19_2 [label="*", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
a19_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b19_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg19_2:sw -- b19_2:n
era19_2:s -- x19_2:n
nul19_2:s -- neg19_2:n
neg19_2:se -- a19_2:n
a19_2:s -- era19_3:n
}
}
