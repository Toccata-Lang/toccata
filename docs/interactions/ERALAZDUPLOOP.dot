graph ERA_LAZ_DUPLOOP {
rankdir=TB;

subgraph cluster_before_ERA_LAZ_DUPLOOP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
era21_1 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a21_1 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
laz21_1 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup21_1 [label="D", xlabel="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
era21_1:s -- laz21_1:n
a21_1:s -- laz21_1:n
laz21_1:sw -- dup21_1:n
laz21_1:se -- a21_1:n
}

subgraph cluster_after_ERA_LAZ_DUPLOOP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
era21_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a21_2 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
nul21_2 [label="NUL",  height=0.5, width=0.5, fixedsize=true, shape=none]
era21_2 -- a21_2
a21_2 -- nul21_2:n
}
}
