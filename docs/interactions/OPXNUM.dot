graph OPX_NUM {
rankdir=TB;

subgraph cluster_before_OPX_NUM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a6_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b6_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
op6_1 [label="OPX",  height=0.5, width=0.5, fixedsize=true,  shape=none]
a6_1:s -- op6_1:nw
b6_1:s -- op6_1:ne
num6_1 [label="#",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
op6_1:s -- num6_1:n
}

subgraph cluster_after_OPX_NUM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
num6_2 [label="#",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
b6_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
op6_2 [label="OPY",  height=0.5, width=0.5, fixedsize=true,  shape=none]
num6_2:s -- op6_2:nw
b6_2:s -- op6_2:ne
a6_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
op6_2:s -- a6_2:n
}
}
