graph NEG_SUP2 {
rankdir=TB;

subgraph cluster_before_NEG_SUP2 {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a10_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b10_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg10_1 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
sup10_1 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x10_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y10_1 [label="NUL",  height=0.4, width=0.8, fixedsize=true, shape=none]
a10_1:s -- neg10_1:nw
b10_1:s -- neg10_1:ne
neg10_1:s -- sup10_1:n
sup10_1:sw -- x10_1:n
sup10_1:se -- y10_1:n
}

subgraph cluster_after_NEG_SUP2 {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a10_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b10_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg10_2 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
x10_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
a10_2:s -- neg10_2:nw
b10_2:s -- neg10_2:ne
neg10_2:s -- x10_2:n
}
}
