graph APP_NUL {
rankdir=TB;

subgraph cluster_before_APP_NUL {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a3_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b3_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
app3 [label="A",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a3_1:s -- app3:nw
b3_1:s -- app3:ne
nul3_1 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
app3:s -- nul3_1:n
}

subgraph cluster_after_APP_NUL {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a3_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b3_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
nul3_2 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
era3_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a3_2:s -- nul3_2:n
b3_2:s -- era3_2:n
}
}
