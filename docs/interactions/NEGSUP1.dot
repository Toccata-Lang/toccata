graph NEG_SUP1 {
rankdir=TB;

subgraph cluster_before_NEG_SUP1 {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a9_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b9_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg9_1 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
sup9_1 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x9_1 [label="NUL",  height=0.4, width=0.8, fixedsize=true, shape=none]
y9_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a9_1:s -- neg9_1:nw
b9_1:s -- neg9_1:ne
neg9_1:s -- sup9_1:n
sup9_1:sw -- x9_1:n
sup9_1:se -- y9_1:n
}

subgraph cluster_after_NEG_SUP1 {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a9_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b9_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg9_2 [label="*",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
y9_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a9_2:s -- neg9_2:nw
b9_2:s -- neg9_2:ne
neg9_2:s -- y9_2:n
}
}
