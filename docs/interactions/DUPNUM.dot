graph DUP_NUM {
rankdir=TB;

subgraph cluster_before_DUP_NUM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a13_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b13_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup13 [label="D",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a13_1:s -- dup13:nw
b13_1:s -- dup13:ne
num13_1 [label="#",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
dup13:s -- num13_1:n
}

subgraph cluster_after_DUP_NUM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a13_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b13_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
num13_2 [label="#",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
num13_3 [label="#",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
a13_2:s -- num13_2:n
b13_2:s -- num13_3:n
}
}
