(defn set-type-info [type-sym type-info]
  (assert (instance? c/TaggedSymbol type-sym))
  (assert (instance? (any-of c/SumConstraint
                             c/ReifiedConstraint)
                     type-info))

  (se/assoc-in-val [.namespaces c/no-symbol .types type-sym]
                   type-info))

(deftype CodeContext [strings module refs-map decl init glbl-init]
  ;; reified string values
  (assert (instance? (map-of String String) strings))
  (assert (instance? Module module))
  (assert (instance? HashMap refs-map))
  ;; decl   nested vector of strings
  (assert (instance? Vector decl))
  ;; init   nested vector of strings
  (assert (instance? Vector init))
  ;; glbl-init   nested vector of strings
  (assert (instance? Vector glbl-init))
  )

(def var-punct {"*" "_STAR_"
                "." ""
                "#" "_HASH_"
                "+" "_PLUS_"
                "?" "_QM_"
                "!" "_BANG_"
                "=" "_EQ_"
                "<" "_LT_"
                ">" "_GT_"})

(def C-var-punct (apply-to (fn [punct-char]
                             (either (get var-punct punct-char)
                                     ""))
                           (apply grmr/any (keys var-punct))))

(def C-var-remaining
  (grmr/none-or-more (grmr/any "_"
                               (apply-to (fn [] "_")
                                         (grmr/ignore "-"))
                               grmr/alpha
                               grmr/digit
                               C-var-punct)))

(def C-var (apply-to (fn [start remaining]
                       (to-str (comp [start] remaining)))
                     (grmr/any grmr/alpha
                               (apply-to (fn [] "")
                                         (grmr/ignore "#"))
                               (apply-to (fn [] "_MINUS_")
                                         (grmr/ignore "-"))
                               C-var-punct)
                     C-var-remaining))

(def C-var (rd/parser C-var))

(defn check-C-var [var-name alt-var]
  (either (get (C-var {'file-name "" 'line-number 0}
                      var-name)
               .value)
          alt-var))

(def global-vars (int-generator 0))
(def glbl "glbl")
(def glbl-len (count glbl))

(defn is-glbl [var]
  (= (subs var 0 glbl-len) glbl))

(def glbl-rslt (str glbl Rslt))
(def glbl-rslt-len (count glbl-rslt))

(defn is-glbl-rslt [var]
  (= (subs var 0 glbl-rslt-len) glbl-rslt))

(defn global-var
  ([arg-name]
   (global-var arg-name arg-name))
  ([sym arg-name]
   (str glbl (check-C-var (str sym) arg-name)
        (extract global-vars))))

(defn local-var [prefix]
  (let [prefix (check-C-var (str prefix) "arg")]
    (map (se/get-val .var-count)
         (fn [var-count]
           (str (cond (= "_" (str prefix))
                      "arg"
                      prefix)
                "_" (extract var-count))))))

(defn is-Rslt [var]
  (= (subs var 0 (count Rslt)) Rslt))

(deftype TaggedParam [sym]
  (assert (instance? c/TaggedSymbol sym))

  Container
  (map [x f]
    x)

  (map [x f embed]
    (embed x))

  Stringable
  (string-list [s]
    (string-list sym)))
