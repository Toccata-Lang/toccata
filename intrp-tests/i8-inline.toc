;; intrp-tests/i8-inline.toc — item-8 inline-abort program.
;;
;; A def with an inline-C value: referencing it aborts with the clean
;; eval-time error "inline C is not interpreted" (the eval Inline impl).
;;
;; Run separately from i8-prog.toc (it aborts).
;; Run:  ./i8-harness intrp-tests/i8-inline.toc
;; Expected: stderr "i8-inline.toc:11: inline C is not interpreted"
;; (the Inline node's loc — the def, not the reference site), non-zero exit.

(def bad (inline "result = newI60(42);"))

(main [_]
  (pr* (str* ["using-bad=" (number-str bad) "\n"]))
  0)
