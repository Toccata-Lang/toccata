;; intrp-tests/i8-prog.toc — item-8 success program (interpreted by
;; i8-harness.toc).
;;
;; Covers the item-8 eval surface with hand-verified output:
;;   defn recursion, fn/closures, let, cond/and/or/either, vectors,
;;   hash maps, threading, field access (.x over Some), string/int ops.
;;
;; Interpreted (not compiled): references only the initial-env core
;; symbols (see intrp-eval.toc) plus its own defn / fn / let / control.
;;
;; Run:  ./i8-harness intrp-tests/i8-prog.toc
;; Expected (before the runtime stats lines):
;;   fact-5=120
;;   adder=15
;;   let=15
;;   and=42
;;   or=99
;;   either=7
;;   vec=1
;;   map=1
;;   map-miss=999
;;   thread=1
;;   field=8
;;   str=hello

;; defn recursion: factorial (cond + * + dec).
(defn fact [n]
  (cond (int-= n 0)
        1
        (* n (fact (dec n)))))

;; fn/closure: make-adder returns a closure capturing k.
(defn make-adder [k]
  (fn [x] (+ x k)))

(main [_]
  (pr* (str* ["fact-5=" (number-str (fact 5)) "\n"]))
  (pr* (str* ["adder=" (number-str ((make-adder 10) 5)) "\n"]))
  (pr* (str* ["let=" (number-str (let [x 5 y 10] (+ x y))) "\n"]))
  (pr* (str* ["and=" (number-str (and (int-= 1 1) 42)) "\n"]))
  (pr* (str* ["or=" (number-str (or (int-= 1 2) 99)) "\n"]))
  (pr* (str* ["either=" (number-str (either (Some 7) 99)) "\n"]))
  (pr* (str* ["vec=" (number-str (extract (first (vect-conj (vect-conj empty-vector 1) 2)))) "\n"]))
  (pr* (str* ["map=" (number-str (extract (get (assoc emptyBMI "a" 1) "a"))) "\n"]))
  (pr* (str* ["map-miss=" (number-str (either (get (assoc emptyBMI "a" 1) "b") 999)) "\n"]))
  (pr* (str* ["thread=" (number-str (-> (vect-conj (vect-conj empty-vector 1) 2) first extract)) "\n"]))
  (pr* (str* ["field=" (number-str (let [x (Some 8)] (.x x))) "\n"]))
  (pr* (str* ["str=" "hello\n"])))
