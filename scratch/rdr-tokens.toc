;; Item 4 verification: intrp-rdr.toc state + token helpers.
;;
;; Tokenizes a sample string containing whitespace, symbols, ints, a
;; float, and a double-quoted string, printing each token with a label.
;;
;; Expected output:
;;   symbol: foo
;;   int: 42
;;   float: 3.14
;;   string: hi there
;;   symbol: bar
;;
;; Ordering crutch (current-compiler, not a design constraint): the
;; machine is lazy, so read-and-show threads every pr* count through an
;; accumulator into main's result, forcing the side effects. A
;; continuation that dropped its count would let the machine skip the
;; earlier prints.

(add-ns rdr (module "../intrp-rdr.toc"))

;; read-and-show: skip whitespace, read a token with `reader`, print
;; "label <token>", and pass (acc + printed-counts) and the new state to
;; cont.
(defn read-and-show [acc state reader label cont]
  (let [s (rdr/skip-whitespace state)]
    (let [t (reader s)]
      (let [a (pr* label)]
        (let [b (pr* (rdr/elt0 t))]
          (let [c (pr* "\n")]
            (cont (+ acc (+ a (+ b c))) (rdr/elt1 t))))))))

(main [_]
  (let [s0 (rdr/make-state "foo 42 3.14 \"hi there\" bar" "sample.toc" 1)]
    (read-and-show 0 s0 rdr/read-symbol "symbol: "
      (fn [p1 s1]
        (read-and-show p1 s1 rdr/read-int "int: "
          (fn [p2 s2]
            (read-and-show p2 s2 rdr/read-float "float: "
              (fn [p3 s3]
                (read-and-show p3 s3 rdr/read-string "string: "
                  (fn [p4 s4]
                    (read-and-show p4 s4 rdr/read-symbol "symbol: "
                      (fn [p5 s5] p5))))))))))))
