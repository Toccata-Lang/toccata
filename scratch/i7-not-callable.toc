;; scratch/i7-not-callable.toc — item-7 harness, check 5 (separate
;; sub-run).
;;
;; Interpret an Integer target -> the clean "file:line: not callable"
;; abort (interpret's default body), non-zero exit.
;;
;; Run separately from i7-harness.toc because it aborts (the abort would
;; otherwise prevent checks 1-4 from completing).
;;
;; Build (from the repo root):
;;   ./new-toc scratch/i7-not-callable.toc > i7-not-callable.tmp
;;   awk '/^#$$/ { printf "#line %d \"m.c\"\n", NR+1, "i7-not-callable.c"; next; } { print; }' i7-not-callable.tmp > i7-not-callable.c
;;   rm i7-not-callable.tmp
;;   clang -g -march=native -I. -DCHECK_MEM_LEAK=1 -DSAFETY=1 -DSTATS=1 -lm -lpthread -latomic -o i7-not-callable i7-not-callable.c new.c runtime3.c graph.c
;;   ./i7-not-callable
;;
;; Expected: stderr "i7-not-callable.toc:5: not callable", non-zero exit.

(add-ns eval (module "../interpreter/intrp-eval.toc"))

(main [_]
  (eval/interpret 5 [] eval/initial-env
                  (eval/test-loc "i7-not-callable.toc" 5)))
