;; sup-nul2.toc — all-NUL superpositions: applied and as final result.
(defn empty-sup []
  (inline Integer "
    result = NUL;
  "))

(defn use-it [v]
  (pr* (str "used: "))
  (pr* (str v))
  (pr* "\n")
  v)

(main [_]
  (let [a (pr* "case1: apply all-nul sup\n")
        b (use-it (| (empty-sup) (empty-sup)))
        c (pr* "case2 done\n")]
    (+ a (+ b c))))
