;; Item 1 verification: strCmp STR_PREFIX mode.
;; Succeeds iff one string is a prefix of the other.
;; Some/None results print as "(Some <s>)" / "None".
;;
;; Ordering notes (current-compiler crutches, not design constraints):
;; - The machine is lazy: a let initializer only runs when the result chain
;;   demands it, so each continuation must use its param in the result
;;   chain (the (+ p next) step) or the remaining side effects are dropped.
;; - Side-effect results are combined with + (strict) before reaching cont.
;; - Continuation params must be named: underscore params miscompile
;;   (duplicate C variable) in the current compiler.

(defn str-prefix? [s t]
  ! s String
  ! t String
  (inline Some "result = strCmp(s_1, t_2, STR_PREFIX);"))

(defn check [label s t cont]
  (let [x (pr* label)]
    (let [r (str-prefix? s t)]
      (let [y (pr* (str* (conj (str-vect r) "\n")))]
        (cont (+ x y))))))

(main [_]
  (check "equal:         " "abc" "abc"
    (fn [p0]
      (+ p0
    (check "prefix:        " "abc" "abcd"
      (fn [p1]
        (+ p1
      (check "superstring:   " "abcd" "abc"
        (fn [p2]
          (+ p2
        (check "different:     " "abc" "abd"
          (fn [p3]
            (+ p3
          (check "different:     " "abc" "xbc"
            (fn [p4]
              (+ p4
            (check "empty vs str:  " "" "abc"
              (fn [p5]
                (+ p5
              (check "str vs empty:  " "abc" ""
                (fn [p6]
                  (+ p6
                (check "empty vs empty:" "" ""
                  (fn [pz] pz))))))))))))))))))))))))
