(defn show [label v]
  (pr* label)
  (pr* " ")
  (pr* (str v))
  (pr* "\n"))

(main [_]
  (let [a (show "sup-1val" (| 1))
        b (show "sup-2vals" (| 1 2))
        c (show "sup-in-cond" (cond (str= "a" "a") (| 5 6) 7))
        d (show "sup-through-fn" ((fn [x] (+ x 10)) (| 1 2)))]
    (+ a (+ b (+ c d)))))
