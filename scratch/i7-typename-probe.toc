;; scratch/i7-typename-probe.toc — proto-branch-c fix probe (item 7).
;;
;; `type-name` is a defp WITH a body (default-type-name) AND an
;; `extend-type Integer` impl ("Integer"). Under the pre-fix
;; proto-branch-c (last-key-wins reduce) the I60 branch dispatches to
;; the default body; after the fix it must dispatch to the Integer
;; impl.
;;
;; Build with the FIXED compiler (scratch/new-toc-fb), from the repo
;; root:
;;   ./scratch/new-toc-fb scratch/i7-typename-probe.toc > i7-tn.tmp
;;   awk '/^#$$/ { printf "#line %d \"m.c\"\n", NR+1, "i7-tn.c"; next; } { print; }' i7-tn.tmp > i7-tn.c
;;   rm i7-tn.tmp
;;   clang -g -march=native -I. -DCHECK_MEM_LEAK=1 -DSAFETY=1 -DSTATS=1 -lm -lpthread -latomic -o i7-tn i7-tn.c new.c runtime3.c graph.c
;;   ./i7-tn
;;
;; Expected: "Integer", zero leaks.

(main [_]
  (pr* (type-name 5)))
