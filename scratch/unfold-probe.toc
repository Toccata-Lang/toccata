(deftype Node [label children]
  (recurse [v f]
    (Node (.label v) (map (.children v) f)))
  (map [v f]
    (Node (.label v) (map (.children v) f)))
  (str-vect [v]
    (str-vect (number-str (.label v)))))

(main [_]
  (let [n (unfold 2 (fn [x]
                      (cond (int-< 0 x)
                            (Node x [(- x 1) (- x 1)])
                            (Node x []))))
        a (pr* (str "unfolded: "))
        b (pr* (str (recurse n identity)))
        c (pr* (str " label=" (number-str (.label n))
                   " nchildren=" (number-str (count (.children n))) "\n"))]
    (+ a (+ b c))))
