;; sup-nul.toc — what does the runtime do with a NUL inside a superposition?
(defn empty-sup []
  (inline Integer "
    result = NUL;
  "))

(main [_]
  (let [a (pr* (str "sup-nul-then-val: "))
        b (pr* (str (| (empty-sup) 5)))
        c (pr* (str "\nsup-val-then-nul: "))
        d (pr* (str (| 5 (empty-sup))))
        e (pr* "\n")]
    (+ a (+ b (+ c (+ d e))))))
