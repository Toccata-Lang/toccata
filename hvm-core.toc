;; Some useful types
;; (deftype WholeInt (min-value 0))

(defn prefs [tag x]
  ! tag String
  (inline "
    {
      char tagBuf[64];
      int64_t n;
      char *buf;
      if (termTag(tag_1) == VAL && ((Value *)tag_1)->type == SubStringType) {
        ReifiedVal *ss = (ReifiedVal *)tag_1;
        String *parent = (String *)ss->impls[0];
        buf = &parent->buffer[getI60(ss->impls[1])];
        n = getI60(ss->impls[2]);
      } else {
        String *s = (String *)tag_1;
        buf = s->buffer;
        n = s->len;
      }
      if (n > 63) n = 63;
      memcpy(tagBuf, buf, n);
      tagBuf[n] = 0;
      prefs(tagBuf, x_2);
    }
    dec_and_free(tag_1, 1);
    result = x_2;\n"))

(defn default-type-name [x]
  (inline "if (termTag(x_1) == I60) {
    result = termVal((Term)stringValue(\"Integer\"));
  } else {
    char *name = typeName(((Value *)x_1)->type);
    result = termVal((Term)stringValue(name));
  };"))

;; Some basic type related fns
(defp type-name [x]
  !returns String
  (default-type-name x))

(defn type-num [x]
  (inline Integer "
    switch(termTag(x_1)) {
    case I60:
      result = newI60(IntegerType);
      break;

    case F60:
      result = newI60(FloatType);
      break;

    case REF:
      BOOM(\"too tire\");
      break;

    default:
      result = newI60(((Value *)x_1)->type);
      dec_and_free(x_1, 1);
    }"))

;; For debugging
(def graph (inline "newRef(graphFn);"))
(deftype Maybe
  (None)
  (Some [x]))

;; Comparison protocols
(defp = [x y]
    ;; Compare two values for equality
  !returns Maybe
  )
(defp < [x y]
    ;; Compare two values for order
  !returns Maybe
  )

;; Flow control protocols
(defp and [x y])
(defp or [x y])
(defp either [test-clause else])
(defp cond [test clause else])

;; Composition protocols
(defp zero [x])
(defp comp [x y])

;; Container protocols
(defp recurse [v f])
(defp map [v f])
(defp map! [v f effect])
(defp flat-map [v f])
(defp flatten [v])
(defp extend [v f])
(defp duplicate [x])
(defp wrap [x v])
(defp extract [x])
(defp apply [xf xs])
(defp interpose [coll serparator]
  ;; ! separator (contents coll)
  )

;; Collection protocols
(defp empty? [coll]
  !returns Some
  )
(defp count [coll]
  !returns Integer ;; WholeInt
  )
(defp empty [coll])
(defp conj [coll x])
(defp filter [coll f])
(defp reduce [coll init f])

;; Seqable protocols
(defp vec [coll]
  ;; Create a vector of the contents
  !returns Vector
  )
(defp first [coll]
  !returns Some
  )
(defp rest [coll])
(defp last [coll]
  ;; Return the last element in the `coll` (wrapped in a `Some`) if `coll`
  ;; is not empty. Returns 'nothing', if `coll` is empty.
  !returns Maybe
  )
(defp butlast [coll]
  ;; Returns a new collection with all but the last value of `coll`
  )
(defp split [coll n]
  ;; divides a sequence into to parts with at most 'n' elements being in the first part
  ! n Integer
  )
(defp split-with [coll pred])
(defp take [coll n]
  ! n Integer
  )
(defp drop [coll n]
  ! n Integer
  )
(defp drop-while [coll pred])
(defp take-while [coll pred])
(defp reverse [coll]
  ;; Create a new collection of same type as `coll` with the contents
  ;; in reverse order
  )

;; For collections whose contents can be indexed by integers
(defp nth [coll n]
  ;; Retrieve the `n`th value from `coll`, wrapped in a Maybe, if there are
  ;; enough values in `coll`. Otherwise, returns `nothing`.
  ! n Integer
  !returns Maybe
  )
(defp store [coll n v]
  ;; Create a new copy of `coll` (wrapped in a Maybe)  with `v` at index `n`
  ;; if `coll` is at least size of `n` - 1. Otherwise, return `nothing`.
  ! n Integer
  !returns Maybe
  )

;; For types whose values can be hashed to an integer
(defp sha1-update [x context])
(defp sha1 [x]
  ;; Compute the SHA1 hash of `x`
  !returns Integer
  )

(def emptyBMI (inline BitmapIndexedNode "(Term)&emptyBMI"))

;; For types that emulate a key/value store
(defp assoc [m k v])
(defp copyAssoc [m k v hash shift])
(defp assoc* [m k v hash shift])
(defp get* [m k def hash shift])
(defp dissoc* [m k hash shift])
(defp dissoc [m k])
(defp get [m k]
  ;; Retrieve the value associated with `k` in `m`, wrapped in a `Maybe` if it exists.
  ;; Otherwise, return `nothing`
  !returns Maybe
  )
(defp hash-vec [m s]
  ;; Conjs the [k v] pairs of `m` onto the seed vector `s`, in slot order
  ;; (sub-node pairs flattened in). The Toccata counterpart of the C
  ;; bmiHashSeq/arrayNodeSeq/collisionSeq (core.c) — the C hashSeq/hashVec
  ;; dispatchers are dead, so the sub-node recurse goes through this
  ;; protocol (type dispatch: a child may be a BMI, ArrayNode, or
  ;; HashCollisionNode).
  ! s Vector
  !returns Vector
  )
(defp keys [m]
  ;; Get a list of the keys from `m`
  !returns Vector
  )
(defp vals [m]
  ;; Get a list of the vals from `m`
  !returns Vector
  )

