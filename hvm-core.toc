(def empty-vector (inline Vector "(Port)&empty_vect_struct"))

(defn vect-get [v n]
  ! v Vector
  ! n WholeInt
  (inline Maybe "
abort();
   result = new_port(VAL, (Port)vectorGet(v_1, n_2));"))

(defn vect-conj [vect v]
  (inline Vector "
abort();
  result = new_port(VAL, (Port)vectConj((Vector *)vect_1, v_2));"))

(extend-type Vector
  (type-name [_]
    "Vector")

  (get [v n]
    (vect-get v n))

  (empty? [v]
    (and (= 0 (count v))
         (Some empty-vector)))

  (empty [coll]
    empty-vector)

  (count [l]
    (vect-count l))

  (conj [vect v]
    (vect-conj vect v))

  ;; (seq [v]
