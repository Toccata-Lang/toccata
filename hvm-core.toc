(defn + [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_ADD
  (inline Integer "
  fprintf(stderr, \"'+' should be optimized away\\n\");
  abort();
"))

(defn inc [x]
  (+ 1 x))

(defn - [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_ADD
  (inline Integer "
  fprintf(stderr, \"'-' should be optimized away\\n\");
  abort();
"))

(defn dec [x]
  (- 1 x))

(defn * [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_ADD
  (inline Integer "
  fprintf(stderr, \"'*' should be optimized away\\n\");
  abort();
"))

