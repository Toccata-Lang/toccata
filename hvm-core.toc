(defn vect-get [v n]
  ! v Vector
  ! n WholeInt
  (inline Maybe "
   result = term_val((Term)vectorGet(v_1, n_2));"))

;; TODO: this would be simpler with a 'match' expression
(defp vect-reduce [v vect n result f]
  ! vect Vector
  ! n WholeInt
  ;; ! f (required-args 2)
  )

(extend-type None
  (vect-reduce [el vect n result f]
    result))
(extend-type Some
  (vect-reduce [el vect n result f]
    (vect-reduce (get vect n) vect (inc n) (f result (.x el)) f)))

(defn subvec* [v curr-index max-index result]
  ! v Vector
  ! curr-index Integer ;; WholeInt
  ! max-index Integer ;; WholeInt
  ! result Vector
  (either (and (<= curr-index max-index)
               (map (vect-get v curr-index)
                    (fn [x]
                      (subvec* v (inc curr-index) max-index (vect-conj result x)))))
          result))

(defn subvec [v start len]
  ;; Extract a smaller vector from a larger one
  (subvec* v start (dec (+ start len)) empty-vector))

(extend-type Vector
  (type-name [_]
    "Vector")

  (count [l]
    (vect-count l))

  (get [v n]
    (vect-get v n))

  (nth [v n]
    (vect-get v n))

  (empty? [v]
    (and (int-= 0 (count v))
         (Some empty-vector)))

  (empty [coll]
    empty-vector)

  (first [v]
    (get v 0))

  (rest [v]
    (subvec* v 1 (dec (count v)) []))

  (conj [vect v]
    (vect-conj vect v))

  (reduce [v result f]
    (vect-reduce (first v) v 1 result f))

  (flat-map [v f]
    (reduce v []
            (fn [result x]
              (reduce (f x) result vect-conj)))))

(defn to-str [vect]
  (let [ss-vect (flat-map vect str-vect)
        new-len (reduce ss-vect 0 (fn [len s]
                                    (+ len (count s))))]
    (reduce ss-vect (str-malloc new-len) str-append)))

