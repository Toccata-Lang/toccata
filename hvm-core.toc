;;                                 (unfold! w f embed))
;;                             embed))))

(deftype Leaf [])

(defn str-count [s]
  (inline Integer "
    result = strCount(s_1);"))

(defn str-malloc [len]
  ;; ! len WholeInt
  (inline StringBuffer "
  String *strVal = malloc_string(get_i60(len_1));
  strVal->len = 0;
  strVal->buffer[0] = 0;
  dec_and_free(len_1, 1);
  result = term_val((Term)strVal);\n"))

(defn str-append [dest src]
  ! dest StringBuffer
  ! src StringBuffer
  (inline StringBuffer "
  String *s_1 = (String *)dest_1;
  String *s_2 = (String *)src_2;
  strncat(s_1->buffer, s_2->buffer, s_2->len);
  s_1->len += s_2->len;
  dec_and_free(src_2, 1);
  result = term_val(dest_1);"))

(defp subs [s start len])

(deftype String
  StringBuffer
  (SubString [s start len]
    (count [_]
           len)

    (subs [s new-start new-len]
          (pr* "SubString subs\n")
      (let [final-len (min new-len (- (+ start len) (count s)))]
        (cond (or (< final-len 0)
                  (= final-len 0))
              ""

              (SubString s (+ start new-start) final-len))))))

(extend-type StringBuffer
  (count [s]
    77)

  (subs [s start len]
    (pr* "StringBuffer subs\n")
    (let [new-len (min len (- (+ start len) (count s)))]
      (pr* (number-str new-len))
      (cond (or (< new-len 0)
                (= new-len 0))
            (do
              (pr* "empty string\n")
              "")

            (do
              (pr* "non-empty string\n")
              (SubString s start new-len))))))

