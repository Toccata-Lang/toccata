(deftype Leaf [])

(defn str-count [s]
  (inline Integer "
    result = strCount(s_1);
    dec_and_free(s_1, 1);"))

(defn str-malloc [len]
  ! len Integer ;; WholeInt
  (inline StringBuffer "
  String *strVal = malloc_string(getI60(len_1));
  strVal->len = 0;
  strVal->buffer[0] = 0;
  dec_and_free(len_1, 1);
  result = termVal((Term)strVal);\n"))

(defn str-append [dest src]
  ! dest StringBuffer
  ! src StringBuffer
  (inline StringBuffer "
  String *s_1 = (String *)dest_1;
  String *s_2 = (String *)src_2;
  strncat(s_1->buffer, s_2->buffer, s_2->len);
  s_1->len += s_2->len;
  dec_and_free(src_2, 1);
  result = termVal(dest_1);"))

(defn str= [s tgt]
  ! s String
  ! String tgt
  (inline Some "result = strCmp(s_1, tgt_2, STR_EQ);"))

(defn str< [s tgt]
  ! s String
  ! String tgt
  (inline Some "result = strCmp(s_1, tgt_2, STR_LT);"))

(defn str<= [s tgt]
  ! s StringBuffer
  ! String tgt
  (inline Some "result = strCmp(s_1, tgt_2, STR_LT | STR_EQ);"))

;; str-prefix?: Some iff one string is a prefix of the other (the shorter
;; matches the start of the longer). Symmetric: (str-prefix? "let" "let [x 1]")
;; and (str-prefix? "le" "let") both return Some.
(defn str-prefix? [s tgt]
  ! s String
  ! String tgt
  (inline Some "result = strCmp(s_1, tgt_2, STR_PREFIX);"))

(defn escape-chars [s]
  ! s String
  (inline StringBuffer "result = termVal((Term)escapeChars(s_1));"))

(defn char [n]
  ;; Convert an integer to a one-character string
  ! n Integer ;; WholeInt
  (inline StringBuffer "
  String *strVal = malloc_string(2);
  strVal->len = 1;
  strVal->buffer[0] = getI60(n_1);
  strVal->buffer[1] = 0;
  result = termVal((Term)strVal);\n"))

;; TODO: define a char type of 0 - 255
(defn char-code [c]
  ;; Convert the first character of a string to an integer
  ! c String
  (inline Integer "
   if (((Value *)c_1)->type == StringBufferType) {
     String *s = (String *)c_1;
     result = newI60((unsigned char)s->buffer[0]);
     dec_and_free(c_1, 1);
   } else if (((Value *)c_1)->type == SubStringType) {
     ReifiedVal *ss = (ReifiedVal *)c_1;
     String *parent = (String *)ss->impls[0];
     long start = getI60(ss->impls[1]);
     result = newI60((unsigned char)parent->buffer[start]);
     dec_and_free(c_1, 1);
   }\n"))

(defp subs [s start len])

(deftype String
    StringBuffer
    (SubString [s start len]
      ;; ! start WholeInt
      ;; ! len WholeInt

      (str-vect [s] [s])
      (count [_] len)

      (subs [s new-start new-len]
            (let [final-len (min new-len (- len new-start))]
              (cond (<= final-len 0)
                    ""
                    (SubString s (+ start new-start) final-len))))))

(extend-type StringBuffer
  (str-vect [s]
    [s])
  
  (count [s]
    (str-count s))

  (subs [s start len]
    (let [final-len (min (- (count s) start) len)]
      (cond (<= final-len 0)
            ""
            (SubString s start final-len)))))

(defn string-vec [s]
  !returns [SubString]
  (inline "result = termVal((Term)strVec((Value *)s_1));"))

(defn str-sha1 [s]
  (inline Integer "
  result = newI60(strSha1((Value *)s_1));"))

(extend-type String
  (type-name [_]
    "String")

  (empty [s]
    "")

  (str-vect [s]
    [s])

  (recurse [s f]
    s)

  (empty? [s]
    (and (= 0 (count s))
         (Some "")))

  (= [x y]
    ! String x
    ! String y
    !returns Maybe ;; (Maybe String)
    (str= x y))

  (< [x y]
    ! String x
    ! String y
    !returns Maybe ;; (Maybe String)
    (str< x y))


  (first [s]
    (int-cond (count s)
              (Some (subs s 0 1))
              None))

  (rest [s]
    (subs s 1 (count s)))

  (butlast [s]
    (subs s 0 (dec (count s))))

  (last [s]
    (int-cond (count s)
              (Some (subs s (dec (count s)) 1))
              None))

  (vec [coll]
    (string-vec coll []))

  (nth [s n]
    (cond (< n (count s))
          (Some (subs s n 1))
          None))

  ;;   (sha1-update [x ctxt]
  ;;     (inline C Integer "
  ;;   strSha1Update(((Opaque *)ctxt_1)->ptr, x_0);
  ;;   dec_and_free(x_0, 1);
  ;;   return(ctxt_1);
  ;; "))

  (sha1 [s]
    (str-sha1 s))

  ;; (split [s n]
  ;;   [(subs s 0 n)
  ;;    (subs s n (- (count s) n))])

  ;; (split-with [s pred prefix]
  ;;   (assert (instance? Vector prefix))
  ;;   (either (for [head (first s)
  ;;                 :when (pred head)]
  ;;             (split-with (subs s 1) pred (conj prefix head)))
  ;;           [(to-str prefix) s]))

  ;; (split-with [s pred]
  ;;   (split-with s pred []))

  ;; (take [s n]
  ;;   (subs s 0 n))

  ;; (drop [s n]
  ;;   (subs s n (- (count s) n)))

  ;; (drop-while [coll pred]
  ;;   (either (first (rest (split-with coll pred)))
  ;;           ""))

  ;; (take-while [coll pred]
  ;;   (either (first (split-with coll pred))
  ;;           ""))
  )

