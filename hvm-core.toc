(deftype List
    (EndOfList
     (recurse [l f]
              l)
     ;; (first [l]
     ;;        nothing)
     ;; (rest [l]
     ;;       l)
     (count [l]
            0))

  (Cons [head tail len]
    ;; ! tail (any-of Cons EndOfList)
    ;; ! len Integer

    (recurse [_ f]
             (Cons head (f tail) len))
    ;; (first [l]
    ;;        (Some (.head l)))
    ;; (rest [l]
    ;;       (.tail l))
    (count [l]
           (.len l))))

(defn cons [v l]
  ! List l
  (Cons v l (inc (count l))))

(defn println* [vs]
  ! vs Vector
  (reduce (conj vs "\n") []
          (fn [v val]
            (conj v (reduce (conj (str-vect val) " ") []
                            (fn [v s]
                              (conj v (pr* s))))))))

(defn str* [vs]
  ;; Converts the list of arguments into a single string of characters. Every argument
  ;; must implment the `str-vect` protocol function.
  ! vs Vector
  (to-str vs))
