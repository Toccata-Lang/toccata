;; Some useful types
;; (deftype WholeInt (min-value 0))

;; Flow control
(defp and [x y])
(defp or [x y])
(defp either [test-clause else])
(defp cond [test clause else])

;; Some basic type related fns
(defp type-name [x]
  !returns String
  )

;; Composition
(defp zero [x])
(defp comp [x y])

;; Container
(defp map [v f])
(defp map! [v f effect])
(defp flat-map [v f])
(defp extend [v f])
(defp duplicate [x])
(defp wrap [x v])
(defp apply [xf xs])

;; recursion schemes
(defn fold [f x]
  (f (map x (fn [v]
              (fold f v)))))

(defn fold! [f x embed]
 (flat-map (map! x (fn [v]
                     (fold! f v embed))
                embed)
           f))

(defn unfold [f x]
  (map (f x) (fn [v]
               (unfold f v))))

(defn unfold! [f x embed]
 (flat-map (f x)
           (fn [v]
             (map! v (fn [w]
                       (unfold! f w embed))
                   embed))))

(deftype Maybe
    (None
     (either [v cont]
             cont)
    (cond [v x cont]
          cont)
     (and [x _]
          x)
     (or [_ y]
         y))
  (Some [x]
    (either [v _]
            x)
    (cond [v clause _]
          clause)
    (and [_ y]
         y)
    (or [q _]
        q)
    (map [_ f]
         (Some (f x)))))

(def nothing (None))

;; Collection
(defp empty? [coll]
  !returns Some
  )
(defp count [coll]
  !returns WholeInt
  )
(defp empty [coll])
(defp conj [coll x])
(defp filter [coll f])
(defp reduce [coll f])

(deftype EndOfList [])
(deftype List [head tail len]
  ! tail (any-of List
           EndOfList)
  ! len Integer
  )

(def eol (EndOfList))

;; Seqable
(defp seq [coll]
  !returns List
  )
(defp vec [coll]
  ;; Create a vector of the contents
  !returns Vector
  )
(defp first [coll]
  !returns Some
  )
(defp rest [coll])
(defp last [coll]
  ;; Return the last element in the `coll` (wrapped in a `Some`) if `coll`
  ;; is not empty. Returns 'nothing', if `coll` is empty.
  !returns Maybe
  )
(defp butlast [coll]
  ;; Returns a new collection with all but the last value of `coll`
  )
(defp split [coll n]
  ;; divides a sequence into to parts with at most 'n' elements being in the first part
  ! n Integer
  )
(defp split-with [coll pred])
(defp take [coll n]
  ! n Integer
  )
(defp drop [coll n]
  ! n Integer
  )
(defp drop-while [coll pred])
(defp take-while [coll pred])
(defp reverse [coll]
  ;; Create a new collection of same type as `coll` with the contents
  ;; in reverse order
  )

;; For collections whose contents can be indexed by integers
(defp nth [coll n]
  ;; Retrieve the `n`th value from `coll`, wrapped in a Maybe, if there are
  ;; enough values in `coll`. Otherwise, returns `nothing`.
  ! n Integer
  !returns Maybe
  )
(defp store [coll n v]
  ;; Create a new copy of `coll` (wrapped in a Maybe)  with `v` at index `n`
  ;; if `coll` is at least size of `n` - 1. Otherwise, return `nothing`.
  ! n Integer
  !returns Maybe
  )

;; For types whose values can be hashed to an integer
(defp sha1-update [x context])
(defp sha1 [x]
  ;; Compute the SHA1 hash of `x`
  !returns Integer
  )

;; For types that emulate a key/value store
(defp assoc [m k v])
(defp get [m k]
  ;; Retrieve the value associated with `k` in `m`, wrapped in a `Maybe` if it exists.
  ;; Otherwise, return `nothing`
  !returns Maybe
  )
(defp keys [m]
  ;; Get a list of the keys from `m`
  !returns List
  )
(defp vals [m]
  ;; Get a list of the vals from `m`
  !returns List
  )

;; For types that have some notion of order of their values
(defp = [x y]
  ;; Compare two values for equality
  !returns Maybe
  )
(defp <* [x y]
  ;; Compare two values for order
  !returns Maybe
  )

(defn abort [_]
  (inline Maybe
   "abort();"))

(defn pr* [str]
  ! str String
  (inline Integer "
    Value *s = (Value *)((u64)str_1 & ~7);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*': %ld\\n\", s->type);
      abort();
    }
    link(erase, str_1);
    result = new_num(new_i24(0));"))

(defn sha1-init []
  (inline Opaque "
abort();
    result = new_port(VAL, (Port)malloc_sha1());"))

(defn sha1-finalize [ctxt]
  (inline Integer "
abort();
    Value *ctxt = (Value *)((u64)ctxt_1 & ~7);
    result = new_num(new_i24(finalize_sha1(ctxt)));"))

(defn + [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_ADD
  (inline Integer "
   link(x_1, erase);
   link(y_2, erase);
"))

(defn inc [x]
  (+ 1 x))

(defn number-str [n]
  ! n Integer
  (inline String "
   result = number_str(n_1);
"))

(defn str-malloc [len]
  ! len Integer
  (inline StringBuffer "
abort();
  String *strVal = malloc_string(get_i24(get_val(len_1)));
  strVal->len = 0;
  strVal->buffer[0] = 0;
  result = new_port(VAL, (Port)strVal);"))

(defn mutate-vect-conj [v x]
  ! v Vector
  (inline Vector "
abort();
    result = new_port(VAL, (Port)mutateVectConj((Vector *)v_1, x_2));"))

(defn vect-count [v]
  ;; (assert (instance? Vector v))
  (inline Integer "
abort();
   Vector *v = (Vector *)((u64)v_1 & ~7);
   result = new_num(new_i24(v->count));"))

(defn int-= [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = new_port(VAL, integer_EQ(x_1, y_2));"))

(defn int-< [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = new_port(VAL, integer_LT(x_1, y_2));"))

(extend-type Integer
  (type-name [_]
    "Integer")

  (= [x y]
    (int-= x y))

  (<* [x y]
    (int-< x y))

  (sha1 [x]
    x))

(extend-type EndOfList
  (first [_]
    nothing)
  (rest [eol]
    eol)
  (count [_]
    0))

(def eol (EndOfList))

(extend-type List
  (first [l]
    (Some (.head l)))
  (rest [l]
    (.tail l))
  (count [l]
    (.len l)))

