
(inline "
#define _XOPEN_SOURCE 600
#include <stdlib.h>
#include <limits.h>
#include <stdio.h>
#include <stdatomic.h>
#include \"runtime.h\"
")

(inline "
// TODO: these are only needed until core.toc codegen is complete
Value *noImpl1(FnArity *arity, Value *str_0) {
abort();
}

Value *noImpl2(FnArity *arity, Value *str_0, Value *arg1) {
abort();
}

Value *noImpl3(FnArity *arity, Value *str_0, Value *arg1, Value *arg2) {
abort();
}
")

(defp get [v fld])
(defp set [v fld new-val])
(defp and [x y])
(defp or [x y])
(defp either [test-clause else])
(defp cond [test clause else])

(defn abort [_]
  (inline Maybe
   "abort();"))

(defn pr* [str]
  ;; ! str String
  (inline Integer "
    Value *s = (Value *)((u64)str_1 & ~7);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*': %ld\\n\", s->type);
      abort();
    }
    link(erase, str_1);
    result = new_num(new_i24(0));"))

(defn + [x y]
  ;; ! x Integer
  ;; ! y Integer
  ;; This function is optimized away with OP_ADD
  (inline Integer "
   link(x_1, erase);
   link(y_2, erase);
"))

(defn inc [x]
  (+ 1 x))

(defn number-str [n]
  ;; ! n Integer
  (inline String "
   result = number_str(n_1);
"))

;; The Maybe type is predefined by the runtime and used by low level
;; functions. Declared here to allow implementations of protocol fns
(deftype Maybe
    (None
     (either [v cont]
             cont)
    (cond [v x cont]
          cont)
     (and [x _]
          x)
     (or [_ y]
          y))
  (Some [x]
    ;; TODO: can't access fields yet
    ;; (either [v _]
    ;;         x)
    (cond [v clause _]
          clause)
    (and [_ y]
         y)
    ;; TODO: doesn't work because field name is shadowed
    ;; (or [x _]
    ;;     x)
    (or [q _]
         q)))

(def nothing (None))

