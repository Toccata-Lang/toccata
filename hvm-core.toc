(deftype Maybe
    (None
     (either [v cont]
             cont)
     (cond [v x cont]
           cont)
     (and [x _]
          x)
     (or [_ y]
         y)
     (map [x f]
         x))
  (Some [x]
    (either [v _]
            x)
    (cond [v clause _]
          clause)
    (and [_ y]
         y)
    (or [q _]
        q)
    (map [_ f]
         (Some (f x)))))

