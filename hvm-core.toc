(defn pr* [str]
  (inline Integer
   "    Value *s = (Value *)((u64)str_1 & ~TAG_MASK);
    if (s->type == StringBufferType) {
      fprintf(stdout, \"%-.*s\", (int)((String *)s)->len, ((String *)s)->buffer);
    } else if (s->type == SubStringType) {
      fprintf(stdout, \"%-.*s\", (int)((SubString *)s)->len, ((SubString *)s)->buffer);
    } else {
      fprintf(stdout, \"\\ninvalid type for 'pr*'\\n\");
      abort();
    }
    link(tm, erase, str_1);
    result = new_num(new_i24(0));"))

(defn + [x y]
  (inline Integer "
   link(tm, x_1, erase);
   link(tm, y_2, erase);
"))

(defn number-str [n]
  (inline String "
   result = number_str(n_1);
"))
