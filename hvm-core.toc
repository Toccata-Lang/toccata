(defn + [x y]
  ! x Integer
  ! y Integer
  (inline Integer "
    if (term_tag(x_1) != I60 && term_tag(y_2) != I60) {
      BOOM(\"Invalid inputs to '+'\");
    }
    result = new_i60(get_i60(x_1) + get_i60(y_2));
"))

(defn inc [x]
  (+ 1 x))

(defn - [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_SUB
  (inline Integer "
  fprintf(stderr, \"'-' should be optimized away\\n\");
  abort();
"))

(defn dec [x]
  (- x 1))

(defn * [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
  fprintf(stderr, \"'*' should be optimized away\\n\");
  abort();
"))

(def empty-vector (inline Vector "(Term)&empty_vect_struct"))

(defn vect-conj [vect v]
  (inline Vector "
  result = term_val((Term)vectConj((Vector *)vect_1, v_2));"))

(extend-type None
  (= [x y]
    (= (type-num x) (type-num y)))
  (recurse [v f]
    v)
  (either [v cont]
    cont)
  (cond [v x cont]
        cont)
  (and [x _]
    x)
  (or [_ y]
    y)
  (map [x f]
    x))

(defn println* [vs]
  ! vs Vector
  (reduce (conj vs "\n") []
          (fn [v val]
            (conj v (reduce (conj (str-vect val) " ") []
                            (fn [v s]
                              (conj v (pr* s))))))))

(extend-type Some
  (str-vect [s]
    (-> ["(Some "]
        (comp (str-vect (.x s)))
        (vect-conj ")")))
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= (.x x) (.x y))))
  (extract [v]
    (.x v))
  (recurse [v f]
    (Some (f (.x v))))
  (either [v _]
    (.x v))
  (cond [v clause _]
        clause)
  (and [_ y]
    y)
  (or [q _]
    q)
  (map [v f]
    (Some (f (.x v))))
  (flat-map [v f]
    (f (.x v))))

(defn int-= [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = term_val(integer_EQ(x_1, y_2));"))

(defn int-< [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = term_val(integer_LT(x_1, y_2));"))

(defn number-str [n]
  ! n Integer
  (inline String "
    if (term_tag(n_1) == VAL) {
      fprintf(stderr, \"\\ninvalid type for 'number-str': Value\\n\");
      abort();
    }
    result = number_str(n_1);
"))

(defn <= [x y]
  (or (int-< x y)
      (int-= x y)))

(extend-type Integer
  (type-name [_]
    "Integer")

  (str-vect [n]
    [(number-str n)])

  (= [x y]
    (int-= x y))

  (< [x y]
    (int-< x y))

  ;; (sha1 [x]
  ;;   x)
  )

(defn min [x y]
  ! x Integer
  ! y Integer

  (either (< x y)
          y))

(defn vect-count [v]
  ! v Vector
  (inline Integer "
   Vector *v = (Vector *)((u64)v_1 & ~7);
   result = new_i60(v->count);
   dec_and_free((Term)v, 1);"))

(defn identity [x]
  x)

;; recursion schemes
(defn fold [x f]
  (f (recurse x (fn [v]
                  (fold v f)))))

;; (defn fold! [x f embed]
;;   (flat-recurse (recurse! x (fn [v]
;;                               (fold! v f embed))
;;                           embed)
;;                 f))

(defn unfold [x f]
  (recurse (f x) (fn [v]
                   (unfold v f))))

