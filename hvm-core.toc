;; Some useful types
;; (deftype WholeInt (min-value 0))

;; Flow control
(defp and [x y])
(defp or [x y])
(defp either [test-clause else])
(defp cond [test clause else])

;; Some basic type related fns
(defp type-name [x]
  !returns String
  )

;; Composition
(defp zero [x])
(defp comp [x y])

;; Container
(defp map [v f])
(defp map! [v f effect])
(defp flat-map [v f])
(defp extend [v f])
(defp duplicate [x])
(defp wrap [x v])
(defp apply [xf xs])

