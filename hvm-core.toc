(deftype Leaf [])

(defn str-count [s]
  (inline Integer "
    result = strCount(s_1);"))

(defn str-malloc [len]
  ! len Integer ;; WholeInt
  (inline StringBuffer "
  String *strVal = malloc_string(get_i60(len_1));
  strVal->len = 0;
  strVal->buffer[0] = 0;
  dec_and_free(len_1, 1);
  result = term_val((Term)strVal);\n"))

(defn str-append [dest src]
  ! dest StringBuffer
  ! src StringBuffer
  (inline StringBuffer "
  String *s_1 = (String *)dest_1;
  String *s_2 = (String *)src_2;
  strncat(s_1->buffer, s_2->buffer, s_2->len);
  s_1->len += s_2->len;
  dec_and_free(src_2, 1);
  result = term_val(dest_1);"))

(defp subs [s start len])

(defn str= [s start len tgt]
  ! s StringBuffer
  ! start Integer ;; WholeInt
  ! len Integer ;; WholeInt
  ! String tgt
  (inline Some "result = strEQ(s_1, start_2, len_3, tgt_4);"))

(deftype String
  StringBuffer
  (SubString [s start len]
    ;; ! start WholeInt
    ;; ! len WholeInt

    (str-vect [s] [s])
    (count [_] len)

    (= [x y]
       (str= s start len y))

    (subs [s new-start new-len]
      (let [final-len (min new-len (- (+ start len) (count s)))]
        (cond (<= final-len 0)
              ""
              (SubString s (+ start new-start) final-len))))))

(extend-type StringBuffer
  (str-vect [s]
    [s])
  
  (count [s]
    (str-count s))

  (= [x y]
    (str= x 0 (str-count x) y))

  (subs [s start len]
    (let [final-len (min (- (count s) start) len)]
      (cond (<= final-len 0)
            ""
            (SubString s start final-len)))))

