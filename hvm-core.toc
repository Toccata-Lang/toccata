(defn + [x y]
  ! x Integer
  ! y Integer
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '+'\");
    }
    result = newI60(getI60(x_1) + getI60(y_2));
"))

(defn inc [x]
  (+ 1 x))

(defn - [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_SUB
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '-'\");
    }
    result = newI60(getI60(x_1) - getI60(y_2));
"))

(defn dec [x]
  (- x 1))

(defn * [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '*'\");
    }
    result = newI60(getI60(x_1) * getI60(y_2));
"))

(defn div [x y]
  ! x Integer
  ! y Integer ;; NonZero
  (assert (instance? Integer x))
  (assert (instance? Integer y))
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '/'\");
    }
    int64_t denom = getI60(y_2);
    if (denom == 0) {
      fprintf(stderr, \"*** Can not divide by 0\\n\");
      abort();
    }
    result = newI60(getI60(x_1) / denom);
"))

(defn mod [x y]
  (assert (instance? Integer x))
  (assert (instance? Integer y))
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '%'\");
    }
    int64_t denom = getI60(y_2);
    if (denom == 0) {
      fprintf(stderr, \"*** Can not divide by 0\\n\");
      abort();
    }
    result = newI60(getI60(x_1) % denom);
"))

(defn bit-and [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '&'\");
    }
    result = newI60(getI60(x_1) & getI60(y_2));
"))

(defn bit-or [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '|'\");
    }
    result = newI60(getI60(x_1) | getI60(y_2));
"))

(defn bit-xor [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '^'\");
    }
    result = newI60(getI60(x_1) ^ getI60(y_2));
"))

(defn bit-not [x]
  ! x Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60) {
      BOOM(\"Invalid inputs to '~'\");
    }
    result = newI60(~getI60(x_1));
"))

(defn bit-shift-left [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '<<'\");
    }
    result = newI60(getI60(x_1) << getI60(y_2));
"))

(defn bit-shift-right [x y]
  ! x Integer
  ! y Integer
  ;; This function is optimized away with OP_MUL
  (inline Integer "
    if (termTag(x_1) != I60 && termTag(y_2) != I60) {
      BOOM(\"Invalid inputs to '>>'\");
    }
    result = newI60(getI60(x_1) >> getI60(y_2));
"))

(def empty-vector (inline Vector "(Term)&empty_vect_struct"))

(defn vect-conj [vect v]
  (inline Vector "
  result = termVal((Term)vectConj((Vector *)vect_1, v_2));"))

(extend-type None
  (str-vect [_]
    ["None"])
  (= [x y]
    (= (type-num x) (type-num y)))
  (recurse [v f]
    v)
  (either [v cont]
    cont)
  (cond [v x cont]
        cont)
  (and [x _]
    x)
  (or [_ y]
    y)
  (map [x f]
    x))

(defn println* [vs]
  ! vs Vector
  (reduce (conj vs "\n") []
          (fn [v val]
            (conj v (reduce (conj (str-vect val) " ") []
                            (fn [v s]
                              (conj v (pr* s))))))))

(extend-type Some
  (str-vect [s]
    (-> ["(Some "]
        (comp (str-vect (.x s)))
        (vect-conj ")")))
  (= [x y]
    (and (= (type-num x) (type-num y))
         (= (.x x) (.x y))))
  (extract [v]
    (.x v))
  (recurse [v f]
    (Some (f (.x v))))
  (either [v _]
    (.x v))
  (cond [v clause _]
        clause)
  (and [_ y]
    y)
  (or [q _]
    q)
  (map [v f]
    (Some (f (.x v))))
  (flat-map [v f]
    (f (.x v))))

(defn int-= [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = termVal(integer_EQ(x_1, y_2));"))

(defn int-< [x y]
  ! x Integer
  ! y Integer
  (inline "
    result = termVal(integer_LT(x_1, y_2));"))

(defn number-str [n]
  ! n Integer
  (inline String "
    if (termTag(n_1) == VAL) {
      fprintf(stderr, \"\\ninvalid type for 'number-str': Value\\n\");
      abort();
    }
    result = number_str(n_1);
"))

(defn <= [x y]
  (or (int-< x y)
      (int-= x y)))

(def int-cond (inline "newRef(intCond);"))

(defn int-sha1 [x]
  ! x Integer
  !returns Integer
  (inline "result = newI60(integerSha1(x_1));"))

(extend-type Integer
  (type-name [_]
    "Integer")

  (str-vect [n]
    [(number-str n)])

  (= [x y]
    (int-= x y))

  (< [x y]
    (int-< x y))

  (cond [n non-z z]
        (int-cond n non-z z))

  (sha1 [x]
    (int-sha1 x)))

(defn min [x y]
  ! x Integer
  ! y Integer

  (either (< x y)
          y))

(defn vect-count [v]
  ! v Vector
  ;; Zero-extend the int32_t count to 64 bits (a plain newI60 would
  ;; sign-extend a negative count, setting bits 32..63).
  (inline Integer "
   Vector *v = (Vector *)((u64)v_1 & ~7);
   result = newI60((int64_t)((uint32_t)v->count));
   dec_and_free((Term)v, 1);"))

(defn identity [x]
  x)

;; recursion schemes
(defn fold [x f]
  (f (recurse x (fn [v]
                  (fold v f)))))

;; (defn fold! [x f embed]
;;   (flat-recurse (recurse! x (fn [v]
;;                               (fold! v f embed))
;;                           embed)
;;                 f))

(defn unfold [x f]
  (recurse (f x) (fn [v]
                   (unfold v f))))

