(defn vect-get [v n]
  ! v Vector
  ! n Integer ;; WholeInt
  (inline Maybe "
   result = termVal((Term)vectorGet(v_1, n_2));"))

(defn range* [v n x]
  ! v [Integer] ;; [WholeInt]
  ! n Integer ;; WholeInt
  ! x Integer ;; WholeInt
  !returns [Integer] ;; [WholeInt]
  (cond (= n x)
        v
        (range* (conj v x) n (inc x))))

(defn range [n]
  ! n Integer ;; WholeInt
  !returns [Integer] ;; [WholeInt]
  (range* [] n 0))

;; TODO: this would be simpler with a 'match' expression
;; it's more effecient to dispatch on the type of 'v'
(defp vect-reduce [v vect n result f]
  ! vect Vector
  ! n Integer ;; WholeInt
  ;; ! f (required-args 2)
  )

(extend-type None
  (vect-reduce [el vect n result f]
    result))
(extend-type Some
  (vect-reduce [el vect n result f]
    (vect-reduce (get vect n) vect (inc n) (f result (.x el)) f)))

;; TODO: this would be simpler with a 'match' expression
;; it's more effecient to dispatch on the type of 'v'
(defp vect-reverse [v vect n result]
  ! vect Vector
  ! n Integer
  )

(extend-type None
  (vect-reverse [el vect n result]
    result))
(extend-type Some
  (vect-reverse [el vect n result]
    (vect-reverse (and (<= 0 n) (get vect n))
                  vect (dec n) (conj result (.x el)))))

(defp vect-sub [v vect n max-n result]
  ! vect Vector
  ! n Integer ;; WholeInt
  ! max-n Integer ;; WholeInt
  )

(extend-type None
  (vect-sub [el vect n max-n result]
    result))
(extend-type Some
  (vect-sub [el vect n max-n result]
    (vect-sub (and (< n max-n) (get vect n))
              vect (inc n) max-n (conj result (.x el)))))

(defn subvec [v start len]
  !returns Vector
  ;; Extract a smaller vector from a larger one
  (vect-sub (vect-get v start) v (inc start) (+ start len) []))

(def vect-map (inline "newRef(vectMap)"))

(defn to-str [vect]
  ! vect Vector
  (let [ss-vect (flat-map vect str-vect)
        new-len (vect-reduce (first ss-vect) ss-vect 1 0
                             (fn [len s]
                               (+ len (count s))))]
    (vect-reduce (first ss-vect) ss-vect 1 (str-malloc new-len) str-append)))

(defn vect-= [x y start]
  ! x Vector
  ! y Vector
  ! start Integer ;; WholeInt
  ;; TODO: this is actually slightly more iters
  ;; (cond (< start 0)
  ;;       (Some x)
  ;;       (flat-map (nth x start)
  ;;                 (fn [v1]
  ;;                   (flat-map (nth y start)
  ;;                             (fn [v2]
  ;;                               (and (= v1 v2)
  ;;                                    (vect-= x y (dec start))))))))
  (cond (< start 0)
        (Some x)
        (and (= (.x (nth x start)) (.x (nth y start)))
             (vect-= x y (dec start)))))

(defn vect-store [v n x]
  ! v Vector
  ! n Integer ;; WholeInt
  !returns Some 
  (inline C "
  result = vectStore((Vector *)v_1, getI60(n_2), (Term)x_3);
  dec_and_free(n_2, 1);"))

;; TODO: many of these implementations could be more efficient
(extend-type Vector
  (= [x y]
    ;; TODO: this takes an amazingly large number of iters
    (and (= (type-num x) (type-num y))
         (= (vect-count x) (vect-count y))
         (vect-= x y (dec (count x)))))

  (type-name [_]
    "Vector")

  (str-vect [v]
    ["[" (to-str (interpose v " ")) "]"])

  (count [l]
    (vect-count l))

  (get [v n]
    (vect-get v n))

  (nth [v n]
    (vect-get v n))

  (empty? [v]
    (and (int-= 0 (count v))
         (Some empty-vector)))

  (empty [coll]
    empty-vector)

  (comp [v1 v2]
    (reduce v2 v1 vect-conj))

  (first [v]
    (get v 0))

  (last [v]
    (get v (dec (count v))))

  (rest [v]
    (subvec v 1 (dec (count v))))

  (butlast [v]
    (cond (= (count v) 1)
      empty-vector
      (subvec v 0 (dec (count v)))))

  (conj [vect v]
    (vect-conj vect v))

  (store [vect n v]
    (vect-store vect n v))

  (reduce [v result f]
    (vect-reduce (first v) v 1 result f))

  (reverse [v]
    (vect-reverse (last v) v (- (count v) 2) []))

  (map [v f]
    ;; ! f (-> [_] _)
    (vect-map v f))

  (wrap [_ v]
    [v])

  (flat-map [v f]
    (flatten (vect-map v f)))

  (flatten [v]
    (vect-reduce (first v) v 1 [] comp))

  (filter [v pred]
    (vect-reduce (first v) v 1 [] (fn [result x]
                                    (cond (pred x)
                                          (conj result x)
                                          result))))

  (interpose [coll sep]
    ;; build vector by inserting `sep` between each of the elements of `coll`
    (-> coll
        (flat-map (fn [x] [sep x]))
        rest)))

;; ;; (defn print-err [v]
;; ;;   ! v Vector
;; ;;   !returns Integer

