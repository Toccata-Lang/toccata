;; ArrayNode surface (Phase 3)

(defn emptyArrayNode []
  (inline ArrayNode "
   result = (Term)malloc_arrayNode();"))

(defn arrayNodeCopyChild [m idx]
  ! m ArrayNode
  ! idx Integer
  ;; !returns (any-of (Some HashMap) None)
  ;; Read slot `idx` of an ArrayNode. ArrayNode slots hold either 0 (empty) or
  ;; a sub-node — never a flat key/val pair (unlike BMI slots, whose key slot
  ;; is 0 for sub-nodes) — so this returns Some(child) with an owned ref
  ;; (incRef) when the slot is occupied and None when it is empty. Consumes
  ;; `m` (the bmiCopyChild pattern).
  (inline "
  ArrayNode *node = (ArrayNode *)m_1;
  Term child = node->array[getI60(idx_2)];
  if (child != 0) {
    incRef(child, 1);
    result = some(child);
  } else
    result = nothing();
  dec_and_free((Term)m_1, 1);"))

(defn arrayNodeUpdate [m idx child]
  ! m ArrayNode
  ! idx Integer
  ! child HashMap
  ;; Point slot `idx` at `child`, mirroring the C bmiUpdate (runtime3.c:2289):
  ;; if the slot already holds `child` (pointer identity — the sub-node
  ;; recurse was a no-op), release the extra ref and return `m` unchanged;
  ;; otherwise clone `m` with slot `idx` replaced (the other non-zero slots
  ;; are incRef'd into the clone), free `m`, and return the clone. In the
  ;; empty-slot case the old slot is 0, so the clone simply copies the other
  ;; non-zero slots and installs `child` — the C arrayNodeCopyAssoc
  ;; empty-slot branch.
  (inline ArrayNode "
   ArrayNode *node = (ArrayNode *)m_1;
   int idx = getI60(idx_2);
   if (node->array[idx] == child_3) {
     dec_and_free(child_3, 1);
     result = (Term)node;
   } else {
     ArrayNode *newNode = (ArrayNode *)malloc_arrayNode();
     for (int i = 0; i < ARRAY_NODE_LEN; i++) {
       if (i != idx && node->array[i] != 0) {
         newNode->array[i] = node->array[i];
         incRef(node->array[i], 1);
       }
     }
     newNode->array[idx] = child_3;
     dec_and_free((Term)node, 1);
     result = (Term)newNode;
   }"))

(defn arrayNodeMutateChild [m idx]
  ! m ArrayNode
  ! idx Integer
  ;; !returns (any-of (Some HashMap) None)
  ;; Read slot `idx` of an ArrayNode, borrowed (no incRef — the
  ;; bmiMutateChild pattern): Some(child) when the slot is occupied, None
  ;; when it is empty. The ref the caller receives IS the slot's ref; the
  ;; sub-node recurse goes through assoc* on it, which mutates an
  ;; exclusively-owned child in place and copies a shared one (the copy
  ;; consumes a ref that the arrayNodeSetSlot swap then replaces). Consumes
  ;; `m`.
  (inline "
  ArrayNode *node = (ArrayNode *)m_1;
  Term child = node->array[getI60(idx_2)];
  if (child != 0)
    result = some(child);
  else
    result = nothing();
  dec_and_free((Term)m_1, 1);"))

(defn arrayNodeSetSlot [m idx child]
  ! m ArrayNode
  ! idx Integer
  ! child HashMap
  ;; Mutate-in-place: point slot `idx` at `child` — the C
  ;; arrayNodeMutateAssoc `node->array[idx] = ...` (no release of the old
  ;; slot ref: in the in-place-child case the slot already holds `child`,
  ;; and in the copy-fallback case the copy path consumed the old child's
  ;; slot ref). Transfers `m`'s ref and takes `child`'s.
  (inline ArrayNode "
   ((ArrayNode *)m_1)->array[getI60(idx_2)] = child_3;
   result = (Term)m_1;"))

(defn bmiCount [m]
  ! m BitmapIndexedNode
  (inline Integer "result = (Term)bmiCount((Value *)m_1);"))

(defn arrayNodeCount [m]
  ! m ArrayNode
  ;; The C arrayNodeCount (runtime3.c:2613) sums mapCount over the non-empty
  ;; slots — all mechanical I60 arithmetic (no key equality), so it is wrapped
  ;; directly (the bmiCount pattern). Consumes `m`.
  (inline Integer "result = (Term)arrayNodeCount((Value *)m_1);"))

(defn bmiHashVec [m]
  ! m BitmapIndexedNode
  (inline Vector "result = (Term)bmiHashVec((Value *)m_1, (Value *)empty_vect);"))

(defn addCopiedBMI [m k v hash shift]
  ! m BitmapIndexedNode
  ! hash Integer
  ! shift Integer
  (inline HashMap "
    result = (Term)addCopiedBMI((BitmapIndexedNode *)m_1, k_2, v_3, getI60(hash_4), getI60(shift_5));\n"))

(defn bmiBitMap [bmi]
  ! bmi BitmapIndexedNode
  ;; Zero-extend the int32_t bitmap to 64 bits (treat it as unsigned). The
  ;; bitmap uses bits 0..31; when bit 31 is set the int32_t value is
  ;; negative, and a plain newI60 would sign-extend it, setting bits 32..63.
  ;; The Toccata bit-iteration (bmiHashSeq-bm / bmiVec-bm lowest-set-bit
  ;; logic) would then treat those sign bits as real entries and read
  ;; out-of-range array slots. C-side bitmap ops are unaffected (they use
  ;; node->bitmap directly as int32_t).
  (inline Integer "
   result = newI60((int64_t)((uint32_t)((BitmapIndexedNode *)bmi_1)->bitmap));
   dec_and_free((Term)bmi_1, 1);\n"))

(defn bitpos [hash shift]
  ! hash Integer
  ! shift Integer
  ;; Zero-extend the int32_t bit position to 64 bits (treat it as unsigned).
  ;; bitpos returns 1 << (0..31); when the mask is 31 the value is
  ;; 0x80000000, negative as an int, and a plain newI60 would sign-extend it,
  ;; setting bits 32..63. The bmiCopyChild/bmiMutateChild popcount logic
  ;; (node->bitmap & (bit - 1) in 64 bits) would then count the sign bits and
  ;; index out-of-range array slots. C-side consumers take `int bit` and
  ;; truncate, so they are unaffected.
  (inline Integer "
   result = newI60((int64_t)((uint32_t)bitpos(getI60(hash_1), getI60(shift_2))));\n"))

(defn bmiClone [bmi bit key val]
  ! bmi BitmapIndexedNode
  ! bit Integer
  (inline BitmapIndexedNode "
   result = (Term)bmiClone((BitmapIndexedNode *)bmi_1, getI60(bit_2), key_3, val_4);"))

(defn bmiUpdate [bmi bit child]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ! child HashMap
  (inline BitmapIndexedNode "
   result = (Term)bmiUpdate((BitmapIndexedNode *)bmi_1, getI60(bit_2), child_3);"))

(defn bmiCopyChild [bmi bit]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; !returns (any-of (Some HashMap) None)
  (inline "
  BitmapIndexedNode *node = (BitmapIndexedNode *)bmi_1; 
  int idx = __builtin_popcount(node->bitmap & (getI60(bit_2) - 1));
  Term child;
  if (node->array[2 * idx] == 0) {
    child = node->array[2 * idx + 1];
    incRef(child, 1);
    result = some(child);
  } else
    result = nothing();
  dec_and_free(bmi_1, 1);"))

(defn bmiMutateChild [bmi bit]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; !returns (any-of (Some HashMap) None)
  (inline "
  BitmapIndexedNode *node = (BitmapIndexedNode *)bmi_1; 
  int idx = __builtin_popcount(node->bitmap & (getI60(bit_2) - 1));
  Term child;
  if (node->array[2 * idx] == 0) {
    child = node->array[2 * idx + 1];
    result = some(child);
  } else
    result = nothing();
  dec_and_free(bmi_1, 1);"))

(defn bmiKey [bmi bit]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; incRef so the caller gets an owned reference.
  ;; The C bmiKey returns a borrowed pointer into the node's array.
  (inline "
   result = incRef((Term)bmiKey((BitmapIndexedNode *)bmi_1, getI60(bit_2)), 1);
   dec_and_free(bmi_1, 1);"))

(defn bmiVal [bmi bit]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; incRef so the caller gets an owned reference.
  ;; The C bmiVal returns a borrowed pointer into the node's array.
  (inline "
   result = incRef((Term)bmiVal((BitmapIndexedNode *)bmi_1, getI60(bit_2)), 1);
   dec_and_free(bmi_1, 1);"))

(defn bmiSlotCount [bmi]
  ! bmi BitmapIndexedNode
  ;; Number of occupied slots (popcount of the bitmap), as an Integer — the
  ;; C bmiDissoc's `__builtin_popcount(node->bitmap) == 1` "only entry"
  ;; check, exposed for the Toccata level. Read-only field access (the
  ;; bmiBitMap pattern) — the node is still needed.
  (inline Integer "
   result = newI60(__builtin_popcount(((BitmapIndexedNode *)bmi_1)->bitmap));
   dec_and_free((Term)bmi_1, 1);"))

(defn bmiShrink [bmi bit]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; Copy `bmi` with the slot at `bit` removed: the remaining entries are
  ;; compacted and the bit is cleared from the bitmap. Mirrors the
  ;; flat-entry-removed path of the C bmiDissoc (runtime3.c:2455).
  ;; Consumes `bmi`, returns the new node.
  (inline BitmapIndexedNode "
   extern BitmapIndexedNode *malloc_bmiNode(int itemCount);
   BitmapIndexedNode *node = (BitmapIndexedNode *)bmi_1;
   int bit = getI60(bit_2);
   int idx = __builtin_popcount(node->bitmap & (bit - 1));
   int itemCount = __builtin_popcount(node->bitmap);
   BitmapIndexedNode *newNode = malloc_bmiNode(itemCount - 1);
   newNode->bitmap = node->bitmap;
   for (int i = 0, j = 0; i < itemCount; i++) {
     if (i != idx) {
       if (node->array[i * 2] != 0) {
         incRef((Term)node->array[i * 2], 1);
       }
       if (node->array[i * 2 + 1] != 0) {
         incRef((Term)node->array[i * 2 + 1], 1);
       }
       newNode->array[j * 2] = node->array[i * 2];
       newNode->array[j * 2 + 1] = node->array[i * 2 + 1];
       j++;
     }
   }
   newNode->bitmap &= ~bit;
   dec_and_free((Term)bmi_1, 1);
   result = (Term)newNode;"))

;; HashCollisionNode surface (Phase 4)

(defn emptyCollisionNode []
  ;; Fresh empty HashCollisionNode (0 entries, capacity 2 — the C
  ;; testCollisionNode allocation, runtime3.c malloc_hashCollisionNode(2);
  ;; direct my_malloc, no pool). Returns a new node per call — the caller
  ;; owns the ref (the emptyArrayNode pattern; a def-inline would be a
  ;; single shared global, so this must be a defn).
  ;; Note: C's count field is dual-use — malloc sets count = 2 * capacity,
  ;; so collisionCount reports 2 for a fresh node, not 0 (C's
  ;; collisionVec/collisionGet guard each entry with a NULL check for this
  ;; reason; collisionAssoc/collisionDissoc do not).
  (inline HashCollisionNode "
   result = (Term)malloc_hashCollisionNode(2);"))

(defn collisionCount [m]
  ! m HashCollisionNode
  ;; !returns Integer
  ;; Read-only item count (node->count / 2). The C collisionCount
  ;; (runtime3.c:2616) consumes its argument, so this reads the field
  ;; directly (bmiBitMap pattern) — the node is still needed for the scan.
  ;; The int16_t count is zero-extended to 64 bits (a plain newI60 would
  ;; sign-extend a negative count, setting bits 32..63).
  (inline Integer "
   result = newI60((int64_t)((uint32_t)(((HashCollisionNode *)m_1)->count / 2)));
   dec_and_free((Term)m_1, 1);"))

(defn collisionKey [m i]
  ! m HashCollisionNode
  ! i Integer
  ;; incRef so the caller gets an owned reference (bmiKey pattern).
  ;; Collision-node entries are always non-NULL key/val pairs (unlike BMI
  ;; slots, whose key is 0 for sub-nodes), so no None case.
  (inline "
   result = incRef((Term)((HashCollisionNode *)m_1)->array[2 * getI60(i_2)], 1);
   dec_and_free((Term)m_1, 1);"))

(defn collisionVal [m i]
  ! m HashCollisionNode
  ! i Integer
  ;; incRef so the caller gets an owned reference (bmiVal pattern).
  (inline "
   result = incRef((Term)((HashCollisionNode *)m_1)->array[2 * getI60(i_2) + 1], 1);
   dec_and_free((Term)m_1, 1);"))

(defn collisionUpdate [m i k v]
  ! m HashCollisionNode
  ! i Integer
  ;; Clone `m` with the entry at `i` replaced by (k v) — a copy, not in-place.
  ;; Mirrors the hash-match/update outcome of the C collisionAssoc
  ;; (runtime3.c:2552): the new node has capacity itemCount+1 but count drops
  ;; to 2*itemCount (C's `newNode->count -= 2`), leaving the trailing slot
  ;; NULL. The other entries are copied with fresh refs; (k v) is moved in (no
  ;; incRef). Consumes `m` and (k v), returns the new node.
  (inline HashCollisionNode "
   HashCollisionNode *node = (HashCollisionNode *)m_1;
   int64_t i = getI60(i_2);
   int itemCount = node->count / 2;
   HashCollisionNode *newNode = malloc_hashCollisionNode(itemCount + 1);
   for (int j = 0; j < itemCount; j++) {
     if (j == i) {
       newNode->array[2 * j] = (Value *)k_3;
       newNode->array[2 * j + 1] = (Value *)v_4;
     } else {
       newNode->array[2 * j] = node->array[2 * j];
       newNode->array[2 * j + 1] = node->array[2 * j + 1];
       incRef((Term)node->array[2 * j], 1);
       incRef((Term)node->array[2 * j + 1], 1);
     }
   }
   newNode->count = 2 * itemCount;
   dec_and_free((Term)m_1, 1);
   result = (Term)newNode;"))

(defn collisionAppend [m k v]
  ! m HashCollisionNode
  ;; Clone `m` with (k v) appended as a new last entry — a copy, not
  ;; in-place. Mirrors the hash-match/append outcome of the C collisionAssoc
  ;; (runtime3.c:2552): the new node has capacity itemCount+1 and count stays
  ;; 2*(itemCount+1) (C's `newNode->array[2*itemCount] = key` with count
  ;; unchanged). The old entries are copied with fresh refs; (k v) is moved in
  ;; (no incRef). Consumes `m` and (k v), returns the new node.
  (inline HashCollisionNode "
   HashCollisionNode *node = (HashCollisionNode *)m_1;
   int itemCount = node->count / 2;
   HashCollisionNode *newNode = malloc_hashCollisionNode(itemCount + 1);
   for (int j = 0; j < itemCount; j++) {
     newNode->array[2 * j] = node->array[2 * j];
     newNode->array[2 * j + 1] = node->array[2 * j + 1];
     incRef((Term)node->array[2 * j], 1);
     incRef((Term)node->array[2 * j + 1], 1);
   }
   newNode->array[2 * itemCount] = (Value *)k_2;
   newNode->array[2 * itemCount + 1] = (Value *)v_3;
   dec_and_free((Term)m_1, 1);
   result = (Term)newNode;"))

(defn collisionShrink [m i]
  ! m HashCollisionNode
  ! i Integer
  ;; Clone `m` with the entry at `i` removed: the remaining entries are
  ;; compacted. Mirrors the multi-entry hit path of the C collisionDissoc
  ;; (runtime3.c:2649): the new node has capacity itemCount-1 and count
  ;; 2*(itemCount-1) (malloc_hashCollisionNode sets count = 2 * itemCount,
  ;; so no count overwrite is needed). The surviving entries are copied with
  ;; fresh refs. Consumes `m`, returns the new node. Only called for a node
  ;; with >= 2 entries (the 1-entry case returns emptyBMI, not a shrunk node).
  (inline HashCollisionNode "
   HashCollisionNode *node = (HashCollisionNode *)m_1;
   int64_t i = getI60(i_2);
   int itemCount = node->count / 2;
   HashCollisionNode *newNode = malloc_hashCollisionNode(itemCount - 1);
   for (int j = 0, k = 0; j < itemCount; j++) {
     if (j != i) {
       newNode->array[2 * k] = node->array[2 * j];
       newNode->array[2 * k + 1] = node->array[2 * j + 1];
       incRef((Term)newNode->array[2 * k], 1);
       incRef((Term)newNode->array[2 * k + 1], 1);
       k++;
     }
   }
   dec_and_free((Term)m_1, 1);
   result = (Term)newNode;"))

(defn collisionVec [m v]
  ! m HashCollisionNode
  ! v Vector
  ;; Conjs a (k v) pair for each non-NULL entry onto `v`, in entry order —
  ;; the C collisionVec (runtime3.c:2633). It is alive and purely mechanical
  ;; (no key equality, no sha1), so it's called directly (the arrayNodeCount
  ;; pattern — unlike arrayNodeVec/bmiHashVec, which abort via the dead
  ;; hashVec dispatcher and need Toccata-level reimplementation). The NULL
  ;; guard skips the trailing slots of a fresh emptyCollisionNode (count =
  ;; 2 * capacity, entries NULL — the 4.2 note), so a fresh node vecs to the
  ;; initial vec unchanged. Consumes `m` and `v`, returns the extended vec.
  (inline Vector "
   result = (Term)collisionVec((Value *)m_1, (Value *)v_2);"))

(defn bmiReplaceCopied [bmi key val hash shift currKey currVal]
  ! bmi BitmapIndexedNode
  ! hash Integer
  ! shift Integer
  ;; The C function treats currKey/currVal as borrowed pointers (its C-level
  ;; caller passes raw bmiKey/bmiVal results) and consumes only bmi/key/val.
  ;; The wrappers for bmiKey/bmiVal hand us owned refs, so we consume them here.
  (inline BitmapIndexedNode "
   result = (Term)bmiReplaceCopied((BitmapIndexedNode *)bmi_1, key_2, val_3, getI60(hash_4), getI60(shift_5), currKey_6, currVal_7);
   dec_and_free(currKey_6, 1);
   dec_and_free(currVal_7, 1);")
  )

(defn bmiReplaceMutate [bmi key val hash shift currKey currVal]
  ! bmi BitmapIndexedNode
  ! hash Integer
  ! shift Integer
  ;; Mutate-in-place counterpart of bmiReplaceCopied: extends `bmi` a level at
  ;; the occupied bit (collision node or sub-node) instead of cloning it, and
  ;; returns `bmi` itself. The C function transfers bmi's slot refs on
  ;; currKey/currVal into the new leaf and consumes key/val; it does NOT free
  ;; bmi. The bmiKey/bmiVal wrappers hand us owned refs for currKey/currVal,
  ;; so we consume them here (one per).
  (inline BitmapIndexedNode "
   result = (Term)bmiReplaceMutate((BitmapIndexedNode *)bmi_1, key_2, val_3, getI60(hash_4), getI60(shift_5), currKey_6, currVal_7);
   dec_and_free(currKey_6, 1);
   dec_and_free(currVal_7, 1);")
  )

(defn bmiSetKV [bmi bit k v currKey currVal]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; Mutate-in-place: replace the slot at `bit` with (k v) and free the old
  ;; key/val. k/v are moved into the node's slot (bmiSetKey/bmiSetVal do not
  ;; touch the old slot's refs). currKey/currVal each carry TWO refs here --
  ;; the node's slot ref plus the owned ref the bmiKey/bmiVal wrappers added --
  ;; and the node is not freed (mutated in place), so we release both.
  (inline BitmapIndexedNode "
    bmiSetKey((BitmapIndexedNode *)bmi_1, getI60(bit_2), k_3);
    bmiSetVal((BitmapIndexedNode *)bmi_1, getI60(bit_2), v_4);
    dec_and_free(currKey_5, 2);
    dec_and_free(currVal_6, 2);
    result = (Term)bmi_1;"))

(defn bmiSetChild [bmi bit n]
  ! bmi BitmapIndexedNode
  ! bit Integer
  ;; Mutate-in-place: point the slot at `bit` at the (re)built sub-node `n`
  ;; (key slot cleared to 0 marks a sub-node).
  (inline BitmapIndexedNode "
    bmiSetKey((BitmapIndexedNode *)bmi_1, getI60(bit_2), 0);
    bmiSetVal((BitmapIndexedNode *)bmi_1, getI60(bit_2), n_3);
    result = (Term)bmi_1;"))

(defn set-hash-val [k hash]
  ;; Write `hash` into the key's `hashVal` cache field, if the key's type has
  ;; one: String, Vector, BitmapIndexedNode, ArrayNode, HashCollisionNode, and
  ;; user deftypes (ReifiedVal). Keys without a cache field (I60, TermVal,
  ;; FnArity, Opaque, ...) are a no-op. Returns the key (ownership
  ;; transferred). The write is safe even for a shared key term, since the
  ;; value written is the deterministic hash of that term.
  ! hash Integer
  (inline "
    if (termTag(k_1) == VAL) {
      Value *v = (Value *)k_1;
      switch (v->type) {
      case StringBufferType:
        ((String *)v)->hashVal = getI60(hash_2);
        break;
      case VectorType:
        ((Vector *)v)->hashVal = getI60(hash_2);
        break;
      case BitmapIndexedType:
        ((BitmapIndexedNode *)v)->hashVal = getI60(hash_2);
        break;
      case ArrayNodeType:
        ((ArrayNode *)v)->hashVal = getI60(hash_2);
        break;
      case HashCollisionNodeType:
        ((HashCollisionNode *)v)->hashVal = getI60(hash_2);
        break;
      default:
        // user deftypes (type >= CoreTypeCount) are ReifiedVals
        if (v->type >= CoreTypeCount)
          ((ReifiedVal *)v)->hashVal = getI60(hash_2);
        break;
      }
    }
    dec_and_free(hash_2, 1);
    result = k_1;"))

;; Toccata-level vec: the C bmiHashVec routes sub-node slots through the
;; C-level hashVec dispatcher, which aborts, so recursion into sub-nodes
;; happens here instead. Pairs come out in bit order, sub-node pairs
;; flattened in (same shape as the C flat-node path).
(defn bmiVec-bm [m bm]
  ! m BitmapIndexedNode
  ! bm Integer
  (cond (= 0 bm)
        []
        (let [bit (bit-and bm (bit-not (dec bm)))
              rest-bm (bit-and bm (bit-not bit))]
          (either (map (bmiCopyChild m bit)
                       (fn [child]
                         (comp (bmiVec-bm child (bmiBitMap child))
                               (bmiVec-bm m rest-bm))))
                  (let [k (bmiKey m bit)
                        v (bmiVal m bit)]
                    (comp [[k v]] (bmiVec-bm m rest-bm)))))))

(defn bmiVec [m]
  ! m BitmapIndexedNode
  (bmiVec-bm m (bmiBitMap m)))

;; Toccata-level vec for an ArrayNode: the C arrayNodeVec (runtime3.c:2715)
;; aborts (its body is commented out, routing through the dead hashVec
;; dispatcher), so the recursion happens here instead. Slots are walked in
;; index order 0..31; an occupied slot's child vec is flattened in (the `vec`
;; protocol — type dispatch, the Toccata counterpart of the dead hashVec
;; dispatcher), an empty slot contributes nothing. Pairs come out in slot
;; order (same shape as the C flat-node path).
(defn arrayNodeVec-i [m i]
  ! m ArrayNode
  ! i Integer
  (cond (= i 32)
        []
        (either (map (arrayNodeCopyChild m i)
                     (fn [child]
                       (comp (vec child) (arrayNodeVec-i m (inc i)))))
                (arrayNodeVec-i m (inc i)))))

(defn arrayNodeVec [m]
  ! m ArrayNode
  (arrayNodeVec-i m 0))

;; Toccata-level hash-vec for a BitmapIndexedNode: the C bmiHashSeq (core.c)
;; routes sub-node slots through the C-level hashSeq dispatcher, which is
;; dead, so the sub-node recurse goes through the hash-vec protocol here
;; (type dispatch — the child may be a BMI, ArrayNode, or HashCollisionNode).
;; Pairs come out in bit order, sub-node pairs flattened in (the bmiVec-bm
;; pattern). The seed vector `s` is threaded through the recursion and each
;; slot's pair(s) are conjs'd onto it in order.
(defn bmiHashSeq-bm [m s bm]
  ! m BitmapIndexedNode
  ! s Vector
  ! bm Integer
  (cond (= 0 bm)
        s
        (let [bit (bit-and bm (bit-not (dec bm)))
              rest-bm (bit-and bm (bit-not bit))]
          (either (map (bmiCopyChild m bit)
                       (fn [child]
                         (bmiHashSeq-bm m (hash-vec child s) rest-bm)))
                  (let [k (bmiKey m bit)
                        v (bmiVal m bit)]
                    (bmiHashSeq-bm m (conj s [k v]) rest-bm))))))

(defn bmiHashSeq [m s]
  ! m BitmapIndexedNode
  ! s Vector
  (bmiHashSeq-bm m s (bmiBitMap m)))

;; Toccata-level hash-vec for an ArrayNode: the C arrayNodeSeq (core.c)
;; routes occupied slots through the dead hashSeq dispatcher, so the recurse
;; goes through the hash-vec protocol here (type dispatch). Slots are walked
;; in index order 0..31; an occupied slot's child pairs are conjs'd in (the
;; hash-vec protocol), an empty slot contributes nothing. The seed vector `s`
;; is threaded through the recursion.
(defn arrayNodeHashSeq-i [m s i]
  ! m ArrayNode
  ! s Vector
  ! i Integer
  (cond (= i 32)
        s
        (either (map (arrayNodeCopyChild m i)
                     (fn [child]
                       (arrayNodeHashSeq-i m (hash-vec child s) (inc i))))
                (arrayNodeHashSeq-i m s (inc i)))))

(defn arrayNodeHashSeq [m s]
  ! m ArrayNode
  ! s Vector
  (arrayNodeHashSeq-i m s 0))

(defn pair-val [pair]
  ;; The value (second element) of a [k v] pair. Vector element access
  ;; (`get`) returns a Maybe, so extract it. (A destructuring lambda
  ;; `(fn [[k v]] v)` does not codegen — the compiler emits undeclared
  ;; destructured vars — so the extraction goes through this helper.)
  (extract (get pair 1)))

(defn bmiCopyAssoc [m k v hash shift]
  ! m BitmapIndexedNode
  (let [k (set-hash-val k hash)
        bit (bitpos hash shift)]
    (int-cond (bit-and bit (bmiBitMap m))
              (either (map (bmiCopyChild m bit)
                           (fn [childNode]
                             (bmiUpdate m bit (copyAssoc childNode k v hash (+ 5 shift)))))
                      (let [currKey (bmiKey m bit)
                            currVal (bmiVal m bit)]
                        (cond (= currKey k)
                              (cond (= currVal v)
                                    m
                                    (bmiClone m bit k v))
                              (bmiReplaceCopied m k v hash shift currKey currVal))))
              (addCopiedBMI m k v hash shift))))

(defn bmiMutateAssoc [m k v hash shift]
  ;; Toccata-level mutate-in-place assoc for a BitmapIndexedNode, mirroring the
  ;; C bmiMutateAssoc (runtime3.c:2329). Only called via assoc* when the node is
  ;; safe to mutate (refs-count == 3), so the C-level `refs != 1` fallback is
  ;; handled by the assoc* dispatch instead. The mechanical slot ops reuse the
  ;; wrapped C functions; the semantic key/val equality uses the `=` protocol.
  ;; The sub-node recurse borrows the child (bmiMutateChild, no incRef) and
  ;; calls assoc* on it, which mutates the child in place when it is
  ;; exclusively owned (refs-count == 3) and copies it otherwise; either way
  ;; bmiSetChild points the slot at the (re)built child.
  ;; The empty-slot case reuses the (fixed) addCopiedBMI rather than wrapping
  ;; addMutateBMI: addCopiedBMI's 16+ promotion branch is correct for an
  ;; exclusively-owned node (its extra incRefs balance against the old node's
  ;; release), so no separate mutate wrapper is needed (task 3.3).
  ! m BitmapIndexedNode
  (let [k (set-hash-val k hash)
        bit (bitpos hash shift)]
    (int-cond (bit-and bit (bmiBitMap m))
              (either (map (bmiMutateChild m bit)
                           (fn [childNode]
                             (bmiSetChild m bit (assoc* childNode k v hash (+ 5 shift)))))
                      (let [currKey (bmiKey m bit)
                            currVal (bmiVal m bit)]
                        (cond (= currKey k)
                              (bmiSetKV m bit k v currKey currVal)
                              (bmiReplaceMutate m k v hash shift currKey currVal))))
              (addCopiedBMI m k v hash shift))))

(defn arrayNodeCopyAssoc [m k v hash shift]
  ! m ArrayNode
  ;; Toccata-level copy assoc for an ArrayNode, mirroring the C
  ;; arrayNodeCopyAssoc (runtime3.c:2494): the node with `k`→`v` associated,
  ;; cloned (the caller's ref to `m` is consumed, a fresh node returned).
  ;; The slot index is mask(hash, shift) = (hash >> shift) & 31. The
  ;; mechanical slot ops reuse the wrapped C functions; the semantic part is
  ;; the sub-node recurse, which goes through the copyAssoc protocol — type
  ;; dispatch, the Toccata counterpart of C's copyAssoc dispatcher (C's
  ;; internal `equal` can't reach the `=` protocol, so the key/val equality
  ;; happens in the child's own copyAssoc). An empty slot gets a fresh BMI
  ;; child (copyAssoc on emptyBMI at shift+5), mirroring C; arrayNodeUpdate's
  ;; same-child path covers the no-op case (returns `m` unchanged).
  (let [k (set-hash-val k hash)
        idx (bit-and (bit-shift-right hash shift) 31)]
    (either (map (arrayNodeCopyChild m idx)
                 (fn [child]
                   (arrayNodeUpdate m idx (copyAssoc child k v hash (+ 5 shift)))))
            (arrayNodeUpdate m idx (copyAssoc emptyBMI k v hash (+ 5 shift))))))

(defn arrayNodeMutateAssoc [m k v hash shift]
  ! m ArrayNode
  ;; Toccata-level mutate-in-place assoc for an ArrayNode, mirroring the C
  ;; arrayNodeMutateAssoc (runtime3.c:2532). Only called via assoc* when the
  ;; node is safe to mutate (refs-count == 3), so the C-level `refs != 1`
  ;; fallback is handled by the assoc* dispatch instead. The slot index is
  ;; mask(hash, shift) = (hash >> shift) & 31. The mechanical slot ops reuse
  ;; the wrapped C functions; the semantic part is the sub-node recurse,
  ;; which goes through the assoc* protocol — type dispatch, the Toccata
  ;; counterpart of C's mutateAssoc dispatcher (C's internal `equal` can't
  ;; reach the `=` protocol, so the key/val equality happens in the child's
  ;; own assoc*). The sub-node recurse borrows the child
  ;; (arrayNodeMutateChild, no incRef) and calls assoc* on it, which mutates
  ;; the child in place when it is exclusively owned (refs-count == 3) and
  ;; copies it otherwise; either way arrayNodeSetSlot points the slot at the
  ;; (re)built child — in the copy case the swap balances, since the copy
  ;; path consumed the old child's slot ref. An empty slot gets a fresh BMI
  ;; child (copyAssoc on emptyBMI at shift+5), mirroring C.
  (let [k (set-hash-val k hash)
        idx (bit-and (bit-shift-right hash shift) 31)]
    (either (map (arrayNodeMutateChild m idx)
                 (fn [child]
                   (arrayNodeSetSlot m idx (assoc* child k v hash (+ 5 shift)))))
            (arrayNodeSetSlot m idx (copyAssoc emptyBMI k v hash (+ 5 shift))))))

(defn bmiGet [m k def hash shift]
  ! m BitmapIndexedNode
  ;; Toccata-level get for a BitmapIndexedNode, mirroring the C bmiGet
  ;; (runtime3.c:2368): the value stored under `k`, or `def` on miss.
  ;; The mechanical slot ops reuse the wrapped C functions; the semantic key
  ;; equality uses the `=` protocol (C's `equal` only handles I60/String).
  ;; Sub-node slots recurse through the get* protocol — type dispatch, the
  ;; Toccata counterpart of C's mapGet dispatcher.
  (let [bit (bitpos hash shift)]
    (int-cond (bit-and bit (bmiBitMap m))
              (either (map (bmiCopyChild m bit)
                           (fn [childNode]
                             (get* childNode k def hash (+ 5 shift))))
                      (let [currKey (bmiKey m bit)]
                        (cond (= k currKey)
                              (bmiVal m bit)
                              def)))
              def)))

(defn arrayNodeGet [m k def hash shift]
  ! m ArrayNode
  ;; Toccata-level get for an ArrayNode, mirroring the C arrayNodeGet
  ;; (runtime3.c:2595): the value stored under `k`, or `def` on miss.
  ;; ArrayNode slots hold only sub-nodes (never flat key/val pairs), so the
  ;; slot index is mask(hash, shift) = (hash >> shift) & 31; an empty slot is
  ;; a miss (`def`), an occupied slot recurses into the child at shift+5
  ;; through the get* protocol — type dispatch, the Toccata counterpart of
  ;; C's mapGet dispatcher (C calls bmiGet directly, which can't reach the `=`
  ;; protocol and can't handle a collision-node child).
  (let [idx (bit-and (bit-shift-right hash shift) 31)]
    (either (map (arrayNodeCopyChild m idx)
                 (fn [child]
                   (get* child k def hash (+ 5 shift))))
            def)))

(defn bmiDissoc [m k hash shift]
  ! m BitmapIndexedNode
  ;; Toccata-level dissoc for a BitmapIndexedNode, mirroring the C bmiDissoc
  ;; (runtime3.c:2427): the node with `k` removed, or `m` unchanged on miss.
  ;; Returns emptyBMI when the last entry is removed. The mechanical slot
  ;; ops reuse the wrapped C functions; the semantic key equality uses the
  ;; `=` protocol with the lookup key first (the C bmiDissoc convention —
  ;; an eq-gated lookup key that gates off removes nothing). Sub-node slots
  ;; recurse through the dissoc* protocol — type dispatch, the Toccata
  ;; counterpart of C's baseDissoc dispatcher; the bmiUpdate same-child path
  ;; covers the no-change case, and a sub-node that empties as the parent's
  ;; only entry collapses to emptyBMI.
  (let [bit (bitpos hash shift)]
    (int-cond (bit-and bit (bmiBitMap m))
      (either (map (bmiCopyChild m bit)
                   (fn [childNode]
                     (let [n (dissoc* childNode k hash (+ 5 shift))]
                       (cond (and (empty? n) (= 1 (bmiSlotCount m)))
                             emptyBMI
                             (bmiUpdate m bit n)))))
      (let [currKey (bmiKey m bit)]
        (cond (= k currKey)
              (cond (= 1 (bmiSlotCount m))
                    emptyBMI
                    (bmiShrink m bit))
              m)))
      m)))

(defn arrayNodeDissoc [m k hash shift]
  ! m ArrayNode
  ;; Toccata-level dissoc for an ArrayNode, mirroring the C arrayNodeDissoc
  ;; (runtime3.c:2733): the node with `k` removed, or `m` unchanged on miss.
  ;; The slot index is mask(hash, shift) = (hash >> shift) & 31; an empty slot
  ;; is a miss (`m` unchanged). An occupied slot recurses into the child at
  ;; shift+5 through the dissoc* protocol — type dispatch, the Toccata
  ;; counterpart of C's baseDissoc dispatcher; arrayNodeUpdate's same-child
  ;; path covers the no-change case (returns `m` unchanged), otherwise the
  ;; parent is cloned with the slot replaced. Unlike a BMI, an ArrayNode never
  ;; collapses to emptyBMI — an emptied child simply leaves the slot pointing
  ;; at emptyBMI.
  (let [idx (bit-and (bit-shift-right hash shift) 31)]
    (either (map (arrayNodeCopyChild m idx)
                 (fn [child]
                   (let [n (dissoc* child k hash (+ 5 shift))]
                     (arrayNodeUpdate m idx n))))
            m)))

(defn collisionGet-i [m k def n i]
  (cond (= i n)
        def
        (let [ek (collisionKey m i)]
          (cond (= ek k)
                (collisionVal m i)
                (collisionGet-i m k def n (inc i))))))

(defn collisionGet [m k def hash shift]
  ! m HashCollisionNode
  ;; Toccata-level get for a HashCollisionNode, mirroring the C collisionGet
  ;; (runtime3.c:2680): the value stored under `k`, or `def` on miss.
  ;; Linear scan over the entries (collisionGet-i); the semantic key equality
  ;; uses the `=` protocol with the entry key first (the bmiCopyAssoc/
  ;; bmiMutateAssoc convention — C's `equal` only handles I60/String).
  ;; hash/shift are unused: a collision node holds only keys with one hash.
  (collisionGet-i m k def (collisionCount m) 0))

(defn collisionAssoc-find [m k n i]
  ;; First index in 0..n-1 whose entry key `=`-equals `k` (entry key first,
  ;; the bmiCopyAssoc convention), as (Some i); None if no entry matches.
  ;; Read-only scan — collisionKey hands out an owned ref that `=` consumes.
  (cond (= i n)
        None
        (let [ek (collisionKey m i)]
          (cond (= ek k)
                (Some i)
                (collisionAssoc-find m k n (inc i))))))

(defn collisionAssoc-promote-i [bmi m n i]
  ;; Fold the collision node's entries 0..n-1 into the fresh BMI `bmi` — the
  ;; promote-to-BMI loop of the C collisionAssoc: each entry is assoc*'d at
  ;; shift 0 with its own sha1 (the Toccata counterpart of C's mutateAssoc
  ;; loop; the fresh BMI is exclusively owned, so assoc* mutates it in place).
  ;; `m` is threaded for the entry reads and released by the base case (the
  ;; collisionGet-i pattern).
  (cond (= i n)
        bmi
        (let [ek (collisionKey m i)
              ev (collisionVal m i)
              eh (sha1 ek)]
          (collisionAssoc-promote-i (assoc* bmi ek ev eh 0) m n (inc i)))))

(defn collisionAssoc [m k v hash shift]
  ! m HashCollisionNode
  ;; Toccata-level copy assoc for a HashCollisionNode, mirroring the C
  ;; collisionAssoc (runtime3.c:2552): the node with `k`→`v` associated,
  ;; cloned (the caller's ref to `m` is consumed, a fresh node returned).
  ;; The mechanical node building reuses the wrapped C allocation
  ;; (collisionUpdate/collisionAppend); the semantic parts use the `=`/`sha1`
  ;; protocols (C's `equal`/`sha1` only handle I60/String).
  ;;
  ;; Hash match (the new key's hash equals the node's hash — C checks
  ;; sha1(array[0]) == hash; a collision node holds only one hash): the result
  ;; is a collision node. The first entry whose key `=`-equals `k` (entry key
  ;; first, the bmiCopyAssoc convention) is updated to (k v) (collisionUpdate,
  ;; count unchanged); if no entry matches, (k v) is appended (collisionAppend,
  ;; count +1).
  ;;
  ;; Hash mismatch: the node is promoted to a BMI — the new (k v) goes into a
  ;; fresh BMI (copyAssoc on emptyBMI at shift 0), then each existing entry is
  ;; assoc*'d in (collisionAssoc-promote-i). The result is a
  ;; BitmapIndexedNode, not a collision node.
  ;;
  ;; Like C, this assumes the node has at least one entry (array[0] is read
  ;; for the hash check); a fresh emptyCollisionNode (0 entries) is not a valid
  ;; input. hash/shift: shift is unused (a collision node holds one hash; the
  ;; promotion rebuilds from shift 0), mirroring C.
  (let [k (set-hash-val k hash)
        n (collisionCount m)]
    (cond (= (sha1 (collisionKey m 0)) hash)
          (either (map (collisionAssoc-find m k n 0)
                       (fn [i] (collisionUpdate m i k v)))
                  (collisionAppend m k v))
          (let [bmi (copyAssoc emptyBMI k v hash 0)]
            (collisionAssoc-promote-i bmi m n 0)))))

(defn collisionDissoc-find [m k n i]
  ;; First index in 0..n-1 whose entry key is `=`-equal to `k` (lookup key
  ;; first, the C collisionDissoc / bmiDissoc convention — an eq-gated lookup
  ;; key that gates off removes nothing), as (Some i); None if no entry
  ;; matches. Read-only scan — collisionKey hands out an owned ref that `=`
  ;; consumes (the collisionAssoc-find pattern).
  (cond (= i n)
        None
        (let [ek (collisionKey m i)]
          (cond (= k ek)
                (Some i)
                (collisionDissoc-find m k n (inc i))))))

(defn collisionDissoc [m k hash shift]
  ! m HashCollisionNode
  ;; Toccata-level dissoc for a HashCollisionNode, mirroring the C
  ;; collisionDissoc (runtime3.c:2649): the node with `k` removed, or `m`
  ;; unchanged on miss. Returns emptyBMI when the last entry is removed (the
  ;; C itemCount == 1 path). The mechanical node building reuses the wrapped
  ;; C allocation (collisionShrink); the semantic key equality uses the `=`
  ;; protocol with the lookup key first (the C collisionDissoc / bmiDissoc
  ;; convention — C's `equal` only handles I60/String). hash/shift are
  ;; unused: a collision node holds only keys with one hash. Like C, this
  ;; assumes the node has at least one entry (a fresh emptyCollisionNode is
  ;; not a valid input, per 4.2).
  (let [n (collisionCount m)]
    (cond (= n 1)
          (let [ek (collisionKey m 0)]
            (cond (= k ek)
                  emptyBMI
                  m))
          (let [idx (collisionDissoc-find m k n 0)]
            (either (map idx (fn [i] (collisionShrink m i)))
                    m)))))

(defn refs-count [v]
  !returns Integer
  (inline "
    if (termTag(v_1) == I60) {
      result = newI60(-2);
    } else {
      result = newI60((int64_t)((Value *)v_1)->refs);
    }
    dec_and_free(v_1, 1);
  "))

;; Sentinel for the get method: a private type a stored value can never be,
;; so it distinguishes a hit from a miss. It goes first in the `=` comparison:
;; its `=` only compares type-num, so it never BOOMs on a non-sentinel second
;; arg (String's `=` would, via strCmp). GetSentinelVal is the zero-arg
;; constructor (a global singleton, like List's EndOfList).
(deftype GetSentinelVal []
    (= [x y] (= (type-num x) (type-num y))))

(extend-type BitmapIndexedNode
  (count [m]
    (bmiCount m))

  (vec [m]
    (bmiVec m))

  (hash-vec [m s]
    (bmiHashSeq m s))

  (vals [m]
    (map (hash-vec m []) pair-val))

  (copyAssoc [m k v hash shift]
    (bmiCopyAssoc m k v hash shift))

  (assoc* [m k v hash shift]
    ;; 3 is a magic number. It's the number of times 'm' appears in this function
    (cond (= 3 (refs-count m))
          (bmiMutateAssoc m k v hash shift)
          (bmiCopyAssoc m k v hash shift)))

  (get* [m k def hash shift]
    (bmiGet m k def hash shift))

  (dissoc* [m k hash shift]
    (bmiDissoc m k hash shift)))

(extend-type ArrayNode
  (count [m]
    (arrayNodeCount m))

  (vec [m]
    (arrayNodeVec m))

  (hash-vec [m s]
    (arrayNodeHashSeq m s))

  (vals [m]
    (map (hash-vec m []) pair-val))

  (copyAssoc [m k v hash shift]
    (arrayNodeCopyAssoc m k v hash shift))

  (assoc* [m k v hash shift]
    ;; 3 is a magic number. It's the number of times 'm' appears in this function
    (cond (= 3 (refs-count m))
          (arrayNodeMutateAssoc m k v hash shift)
          (arrayNodeCopyAssoc m k v hash shift)))

  (get* [m k def hash shift]
    (arrayNodeGet m k def hash shift))

  (dissoc* [m k hash shift]
    (arrayNodeDissoc m k hash shift))
  )

(extend-type HashCollisionNode
  (count [m]
    (collisionCount m))

  (vec [m]
    (collisionVec m []))

  (hash-vec [m s]
    ;; The C collisionVec (runtime3.c:2633) already conjs a (k v) pair for
    ;; each non-NULL entry onto the seed vec in entry order (NULL-guarded),
    ;; so it is the hash-vec for a collision node directly (the
    ;; arrayNodeCount pattern — alive and purely mechanical).
    (collisionVec m s))

  (vals [m]
    (map (hash-vec m []) pair-val))

  (copyAssoc [m k v hash shift]
    (collisionAssoc m k v hash shift))

  (assoc* [m k v hash shift]
    ;; No in-place variant for collision nodes: C has no collisionMutateAssoc,
    ;; and the C mutateAssoc dispatcher's HashCollisionNodeType case is
    ;; commented out, falling through to copyAssoc (runtime3.c:2775). So
    ;; assoc* always copies, matching the C fallback — collisionAssoc consumes
    ;; the caller's ref and returns a fresh node (or a promoted BMI on hash
    ;; mismatch); the bmiSetChild/arrayNodeSetSlot swap balances, since the
    ;; copy path consumed the old child's slot ref (the shared-child pattern).
    (collisionAssoc m k v hash shift))

  (get* [m k def hash shift]
    (collisionGet m k def hash shift))

  (dissoc* [m k hash shift]
    (collisionDissoc m k hash shift)))

(extend-type HashMap
  (str-vect [v]
    ;; Stub to be filled in later
    ["{ ... }"])

  (empty? [m]
    (and (= 0 (count m))
         (Some m)))

  (= [m1 m2]
    ;; TODO: rewrite this to short circuit on first failure
    ;; using recursion scheme
    (and (= (count m1) (count m2))
         (reduce (hash-vec m1 []) (Some 1)
                 (fn [f kv-pair]
                   (and f
                        (flat-map (nth kv-pair 0)
                                  (fn [k]
                                    (flat-map (nth kv-pair 1)
                                              (fn [v1]
                                                (flat-map (get m2 k)
                                                          (fn [v2]
                                                            (= v1 v2))))))))))))

  (assoc [m k v]
    ;; Map-level assoc: compute the key's hash and route through assoc*
    ;; at shift 0 — the refs-count dispatch inside assoc* handles
    ;; mutate-vs-copy (no dispatch needed here).
    (let [h (sha1 k)]
      (assoc* m k v h 0)))

  (dissoc [m k]
    (let [h (sha1 k)]
      (dissoc* m k h 0)))

  (get [m k]
    (let [h (sha1 k)
          sentinel GetSentinelVal
          r (get* m k sentinel h 0)]
      (cond (= sentinel r)
            None
            (Some r)))))

(deftype List
    (EndOfList
      (recurse [l f]
               l)
      ;; (first [l]
      ;;        nothing)
      ;; (rest [l]
      ;;       l)
      (count [l]
             0))

    (Cons [head tail len]
      ;; ! tail (any-of Cons EndOfList)
      ;; ! len Integer

      (recurse [_ f]
               (Cons head (f tail) len))
      ;; (first [l]
      ;;        (Some (.head l)))
      ;; (rest [l]
      ;;       (.tail l))
      (count [l]
             (.len l))))

(defn cons [v l]
  ! List l
  (Cons v l (inc (count l))))

(defn str* [vs]
  ;; Converts the list of arguments into a single string of characters. Every argument
  ;; must implment the `str-vect` protocol function.
  ! vs Vector
  (to-str vs))
