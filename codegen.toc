(def StaticOrDispatcher (any-of b/StaticArity
                                Dispatcher))

(extend-type ast/definition-ast
  CodeGen
  (gen-code [ast]
    (let [[expr] (.value-exprs ast)
          sym (.sym ast)]
      (for [init (se/update-val .init (fn [_] []))
            _ (se/update-val .glbl-init (fn [glbl-init]
                                          (comp glbl-init
                                                ;; TODO: only insert if 'init' has something
                                                "if(1){" line-sep
                                                init
                                                "}" line-sep)))
            _ (cond (or (instance? c/TaggedSymbol expr)
                        (instance? b/StaticArity expr)
                        (instance? ast/string-ast expr)
                        (instance? ast/integer-ast expr))
                    b/se-nop

                    (se/update-val .decl (fn [decl]
                                           [decl
                                            (cond (= sym 'main)
                                                  "// main fn\n"
                                                  "")
                                            "Port " (.var expr) ";" line-sep])))]
        ast))))

(extend-type ast/integer-ast
  CodeGen
  (gen-code [ast]
    (se/state-error
     (.var ast (str "new_num_(new_i24_(" (.int ast) "))")))))

(extend-type ast/string-ast
  CodeGen
  (gen-code [ast]
    (let [str-val (.string ast)
          str-len (count str-val)
          str-ptr (.var ast)]
      (comp (map (se/get-in-val [.strings str-val])
                 (fn [var]
                   (.var ast var)))
            (for [const-strs (se/get-val .strings)
                  :let [str-idx (count const-strs)
                        str-sym (str "str" str-idx)]
                  _ (se/assoc-in-val [.strings str-val] str-ptr)
                  _ (se/update-in-val [.glbl-init]
                                      (fn [glbl-init]
                                        [glbl-init
                                         str-sym " = stringValue(\"" (escape-chars str-val)
                                         "\");" str-sym "->refs = refsConstant;\n"
                                         "globals = listCons(" str-sym ", globals);\n"
                                         str-ptr " = new_port(VAL, (Port)" str-sym ");\n"]))
                  _ (se/update-val .decl
                                   (fn [decl]
                                     [decl
                                      "Value *" str-sym ";\n"
                                      "Port " str-ptr ";\n"]))]
              ast)))))

(extend-type ast/call-ast
  CodeGen
  (gen-call [tgt args result-var]
    (generic-call tgt args result-var))

  (gen-code [ast]
    (map (gen-call (.call-target ast) (.args ast) (.var ast))
         (fn [_]
           ast))))

