(defn name-natives [params]
  [(reduce (zip-lists (range (count (.fixed params)))
                      (.fixed params))
           []
           (fn [args [idx arg]]
             (conj args (str "  Term " (.var arg)
                             " = arityArgs.args[" idx "];\n"))))])

(extend-type ast/params-ast
  CodeGen
  ;; (pre-gen [ast]
  ;;   (se/state-error (cata (fn [p]
  ;;                           (cond (instance? c/TaggedSymbol p)
  ;;                                 (b/TaggedParam p)

  ;;                                 p))
  ;;                         ast)))

  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/fn-arity-ast
  CodeGen
  (gen-code [ast]
    (let [params (.params ast)
          body (remove (.body ast) (fn [expr]
                                     (instance? ast/block-comment-ast expr)))]
      (either (map (last body)
                   (fn [last-ast]
                     (let [last-v (.var last-ast)]
                       (cond (instance? ast/inline-ast last-ast)
                             (se/state-error ast)

                             (for [_ (destruct-params params (.dup-label ast))
                                   _ (se/update-val
                                      .init
                                      (fn [init]
                                        (let [var-loc (str "r_" (.var params))]
                                          [init
                                           "// link args to body\n"
                                           "swapStore(" var-loc ", " last-v ");\n"
                                           (cond (instance? ast/call-ast last-ast)
                                                 ["\nTerm " last-v "V = get(term_loc(" last-v "));\n"
                                                  "apps = take(port(1, term_loc(" last-v "V)));\n"
                                                  "lams = take(port(2, term_loc(" last-v
                                                  "V)));\n\n"]
                                                 ["\nV = get(" var-loc ");\n"
                                                  "apps = pair_make(APP, 0, V, SUB);\n"
                                                  "lams = pair_make(LAM, 0, SUB, NUL);\n"
                                                  "swapStore(port(2, term_loc(lams)),"
                                                  "term_new(VAR, 0, port(1, term_loc(lams))));\n"])
                                           "vLoc = port(2, term_loc(apps));\n"
                                           (-> (reverse body)
                                               rest
                                               (reduce []
                                                       (fn [s expr]
                                                         (conj s
                                                               ["apps = pair_make(APP, 0, "
                                                                (.var expr) ", apps);\n"
                                                                "lams = pair_make(LAM, 0,"
                                                                " sideEffects, lams);\n\n"]))))
                                           (cond (instance? ast/call-ast last-ast)
                                                 ["swapStore(term_loc(" last-v
                                                  "), pair_make(LAZ, 0, apps, lams));\n"]
                                                 ["swapStore(vLoc, pair_make(LAZ, 0, apps, lams));\n"
                                                  "swapStore(" var-loc
                                                  ", term_new(VAR, 0, vLoc));\n"])])))]
                               (.var ast (.var params)))))))
              (b/compilation-error "Invalid function body at:" (ast/location ast))))))

(extend-type b/StaticArity
  CodeGen
  (prep-gen [ast]
    (for [init (se/get-val .init)
          _ (se/set-val .init [])]
      (.curr-init ast init)))

  (gen-code [ast]
    (let [c-fn (.c-fn ast)
          params (-> ast .arity .params)
          arity-var (b/global-var 'Arity)
          arity-struct-var (.var (.arity ast))
          last-ast (-> ast .arity .body last extract)
          inline? (instance? ast/inline-ast last-ast)
          ;; checker (checking-fn (-> ast .arity .params) c-fn)
          ]
      (for [init (se/get-val .init)
            _ (se/set-val .init (.curr-init ast))
            _ (se/update-val .decl
                             (fn [decl]
                               [decl
                                "Term " (.var ast) ";\n"
                                "void " c-fn "(Term ref, Term args) {\n"
                                (cond inline?
                                      ["  NativeArgs arityArgs = {0, {}};\n"
                                       "  args = strictArgs(ref, args, " (count (.fixed params))
                                       ", &arityArgs);\n"
                                       "  Term result = NUL;\n"
                                       "    if (arityArgs.count == " (count (.fixed params))
                                       ") {\n"
                                       (name-natives params)]

                                      ["Term apps, lams, V;\n"
                                       "Location vLoc;\n"])
                                init
                                (cond inline?
                                      ["\nmoveStore(port(2, term_loc(args)), result);\n}\n"]

                                      ["store_redex(args, " (.var params) ");\n"])
                                "return;\n}\n"
                                "Term " (.var ast) " = new_ref(" c-fn ");\n"]))]
        ast)))

  (gen-call [sym call-ast]
    (generic-call call-ast)))

(extend-type b/ClosureArity
  CodeGen
  (gen-code [ast]
    (for [_ (se/update-val .init (fn [init]
                                   (conj init
                                         ["\n// closure arity " (.var ast) " " (.var (.arity ast)) "\n"
                                          "TermVal *" (.var ast) " = malloc_term();\n"
                                          (.var ast) "->trm = pair_alloc();\n"
                                          "swapStore(port(1, " (.var ast) "->trm), term_new(VAR, 0, "
                                          (.var (.arity ast)) "));\n"])))]
      (.var ast (str "(Term)" (.var ast))))))

