
(add-ns c (git-dependency "https://github.com/Toccata-Lang/constraints.git"
                          "constraints.toc"
                          :sha "ff96b0c"))
(add-ns ast (git-dependency "https://github.com/Toccata-Lang/ast.git"
                            "ast.toc"
                            :sha "5bd1cd5"))
(add-ns se (git-dependency "https://github.com/Toccata-Lang/state-error.git"
                           "state-error.toc"
                           :sha "8b250fe"))
(add-ns ty (module "typer.toc"))
(add-ns b (module "base.toc"))

(def lf "\n")
(def lflf "\n\n")

(def line-sep lf)

(defn line-marker [loc marker]
  (assert (instance? c/Location loc))

  (cond (or (= "" (.file loc))
            (and (= 'core (.file loc))
                 (= 0 (.line loc)))
            (= line-sep lf))
        ;; ["\n// " loc "\n#\n"]
        ["\n"]
        ["\n" marker "\n#line "
         (str (.line loc)) " " "\""
         (cond (= 'core (.file loc))
               b/path-to-core
               (.file loc))
         "\"\n"]))

(def output (agent (maybe 'output)))

(defn code-out [& code]
  (send output (fn [out-file?]
                 (hylo (fn [x]
                         (cond (or (instance? String x)
                                   (instance? Integer x))
                               (do
                                 (print x)
                                 [])

                               x))
                       (fn [x]
                         (cond (instance? Sequence x)
                               x

                               (print x)))
                       code)
                 out-file?)))

(defn wait-for-output []
  (let [p (promise)]
    (send output (fn [outfile]
                   (deliver p outfile)
                   outfile))
    (extract p)))


(defn reset-code-context []
  (for [_ (se/set-val .decl [])
        _ (se/set-val .init [])
        _ (se/update-val .refs-map
                         (fn [refs-map]
                           (filter-keys refs-map b/is-glbl)))]
    '_))

(defn call-vector [ast]
  (-> (.args ast)
      (reduce [line-sep
               (cond (b/is-glbl (.var ast))
                     ""
                     ["Port " (.var ast) ";"  line-sep])
               "if (1) {" line-sep
               "  Vector *v = malloc_vector();" line-sep]
              (fn [v arg]
                (comp v ["  v = mutateVectConj(v, "
                         (.var arg) ");" line-sep])))
      (comp [(.var ast) " = new_port(VAL, (Port)v);" line-sep
             "}" line-sep])))

(defn call-list [ast]
  (-> (.args ast)
      reverse
      (reduce [line-sep
               (cond (b/is-glbl (.var ast))
                     ""
                     ["Port " (.var ast) ";"  line-sep])
               "if (1) {" line-sep
               "  List *l = malloc_list();" line-sep]
              (fn [v arg]
                (comp v ["  l = listCons(" (.var arg)
                         ", l);" line-sep])))
      (comp [(.var ast) " = new_port(VAL, (Port)l);" line-sep
             "}" line-sep])))

(defn call-op [op]
  (fn [ast]
    (cond (= 2 (count (.args ast)))
          (let [[x y] (map (.args ast) .var)]
            [(cond (b/is-glbl (.var ast))
                   ""
                   "Port ")
             (.var ast) " = vars_alloc();" line-sep
             "make_op(" op ", " x ", " y ", " (.var ast) ");" line-sep])

          (do
            (print-err "Wrong number of args for" (str "'" (.call-target ast) "'") "at"
                       (ast/location ast))
            (abort)))))

(def call-gens {'vector call-vector
                'list call-list
                '+ (call-op "OP_ADD")
                })

(defn generic-call [ast]
  (let [tgt (.call-target ast)
        args (.args ast)
        result-var (.var ast)
        num-args (count args)]
    (se/state-error ["// call " (either (or (instance? c/TaggedSymbol tgt)
                                            (get tgt .fn-sym))
                                        "")
                     " at " (ast/location args) "\n"
                     (cond (b/is-glbl (.var ast))
                           ""
                           "Port ")
                     (.var ast) " = vars_alloc();" line-sep
                     (-> args
                         (map .var)
                         (reverse)
                         (conj (.var ast))
                         (reduce (str "callArgs = endArgs;" line-sep)
                                 (fn [args arg]
                                   (str args
                                        "callArgs = node_make(ARG, " arg
                                        ", callArgs);" line-sep))))
                     (cond (b/is-glbl (.var ast))
                           ["link(" (.var tgt) ", callArgs);"]

                           ["vars_create(" (.var ast) ", node_make(RDX, "
                            (.var tgt) ", callArgs));"])
                     line-sep])))

(defprotocol CodeGen
  (gen-code [ast]
    (assert-result r (instance? se/StateError r))
    )

  (gen-code [ast arity]
    (assert-result r (instance? se/StateError r))

    (gen-code ast))

  (gen-call [ast call-ast]
    (generic-call call-ast)))

(extend-type Vector
  CodeGen
  (gen-code [v]
    b/se-nop))

(defn emit-code [ast mod]
  (cond (instance? ast/inline-ast ast)
        (se/state-error (code-out (.txt ast)))

        (instance? Vector ast)
        (se/traverse ast (fn [inner]
                           (emit-code inner mod)))

        (for [_ (reset-code-context)
              _ (se/set-val .module mod)
              _ (cata gen-code ast se/state-error)
              decl (se/get-val .decl)]
          (code-out decl))))

(extend-type c/NoSymbol
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type b/TaggedParam
  CodeGen
  (gen-code [ast]
    (se/state-error (.sym ast))))

(defn get-value [sym]
  (assert (instance? c/TaggedSymbol sym))

  (cond (= (str sym) "")
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (= sym c/no-symbol)
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (comp (se/get-in-val [.module .namespaces (.ns sym) .values 0 sym])
              (cond (= (.ns sym) c/no-symbol)
                    (se/get-in-val [.module .namespaces b/core .values 0 sym])

                    se/zero-se)
              (b/compilation-error "Undefined symbol:" (str "'" sym "'") "at" (ast/location sym)))))

(extend-type c/TaggedSymbol
  CodeGen
  (gen-code [ast]
    (let [var (.var ast)]
      (comp (cond (= "" var)
                  (se/state-error ast)

                  se/zero-se)
            (for [refs (se/update-in-val [.refs-map var] inc)
                  :let [dupe-var (str var "_" refs)]
                  _ (se/update-val .init
                                   (fn [init]
                                     ["\nPort " dupe-var " = vars_alloc();\n"
                                      var " = dupeArg(" var, ", " dupe-var ");\n"
                                      init]))]
              (.var ast dupe-var))
            (cond (b/is-glbl var)
                  (flat-map (get-value ast)
                            (fn [val]
                              (cond (or (instance? b/StaticArity val)
                                        (instance? ast/integer-ast val))
                                    (se/state-error ast)

                                    (for [_ (se/assoc-in-val [.refs-map var] 2)
                                          :let [dupe-var (str var "_" 1)]
                                          _ (se/update-val .init
                                                           (fn [init]
                                                             ["\nPort " dupe-var
                                                              " = vars_alloc();\n"
                                                              var " = dupeArg(" var, ", "
                                                              dupe-var ");\n"
                                                              init]))]
                                      (.var ast dupe-var)))))
                  (for [_ (se/assoc-in-val [.refs-map var] 1)]
                    ast)))))

  (gen-call [sym call-ast]
    (either (map (get call-gens sym)
                 (fn [cg]
                   (se/state-error (cg call-ast))))
            (flat-map (get-value sym)
                      (fn [tgt-val]
                        (cond (instance? c/TaggedSymbol tgt-val)
                              (generic-call tgt-val)

                              (gen-call tgt-val call-ast)))))))

(extend-type ast/field-ast
  CodeGen
  (gen-code [ast]
    (cond (b/is-glbl (.var ast))
          (let [c-fn (b/global-var 'FldFn)]
            (se/update-val .decl
                           (fn [decl]
                             [decl
                              "Port " (.var ast) ";\n"
                              "bool " c-fn "(Port ref, Port args) {\n"
                              "Pair pr = node_take(args);\n"
                              "Port resultVar = pr.fst;\n"
                              "args = pr.snd;\n"
                              "args = node_make(ARG, new_num_(new_i24_(" (.idx ast) ")), args);\n"
                              "args = node_make(ARG, resultVar, args);\n"
                              "link(accessField, args);\n"
                              "return TRUE;\n}\n"
                              "Port " (.var ast) " = new_port_(REF, " c-fn ");\n"])))
          
          (let [val-var (.val-var ast)
                get-field ["Port " (.var ast) " = vars_alloc();\n"
                           "callArgs = endArgs;\n"
                           "callArgs = node_make(ARG, " val-var ", callArgs);\n"
                           "callArgs = node_make(ARG, new_num_(new_i24_(" (.idx ast) ")), callArgs);\n"
                           "callArgs = node_make(ARG, " (.var ast) ", callArgs);\n"
                           "link(accessField, callArgs);\n"]]
            (comp (for [refs (se/update-in-val [.refs-map val-var] inc)
                        :let [dupe-var (str val-var "_" refs)]
                        _ (se/update-val .init
                                         (fn [init]
                                           ["\nPort " dupe-var " = vars_alloc();\n"
                                            val-var " = dupeArg(" val-var, ", " dupe-var ");\n"
                                            get-field
                                            init]))]
                    (.var ast dupe-var))
                  ;; if val-var is not in the refs-map, being seen for the first time
                  (for [_ (se/assoc-in-val [.refs-map val-var] 1)
                        _ (se/update-val .init
                                         (fn [init]
                                           [get-field init]))]
                    ast))))))

(extend-type ast/inline-ast
  CodeGen
  (gen-code [x]
    (map (cond (= (.var x) "")
               (se/update-val .init (fn [init]
                                      [init (.txt x)]))

               (se/update-val .decl (fn [decl]
                                      ["Port " (.var x) " = " (.txt x) ";\n"])))
         (fn [_]
           x)))

  (gen-code [x arity]
    (gen-code x)))

(deftype ParamInit [var init]
  ;; Container
  ;; (map [x f]
  ;;   x)
  )

(defprotocol DestParams
  (dest-params [ast]
    (assert-result r (instance? ParamInit r))))

(deftype PlainParams [fixed variadic var]
  Container
  (map [x f]
    (PlainParams (map fixed f) (f variadic) var))

  DestParams
  (dest-params [ast]
    (let [var (.var ast)]
      (-> (reverse (.fixed ast))
          (reduce (ParamInit var (str "Port " var " = new_port(ARG, 0);\n"))
                  (fn [args arg]
                    (assert (instance? ParamInit args))
                    (assert (instance? ParamInit arg))

                    (.init args [(.init args)
                                 (.init arg)
                                 (str var " = node_make(ARG, " (.var arg)
                                      ", " var ");" line-sep)])))))))

(extend-type c/TaggedSymbol
  DestParams
  (dest-params [s]
    (ParamInit (.var s) [])))

(extend-type c/NoSymbol
  DestParams
  (dest-params [s]
    (ParamInit "" [])))

(defn destruct-params [params]
  (let [args-init (hylo (fn [ast]
                          (cond (instance? ast/params-ast ast)
                                (PlainParams (.fixed ast) (.variadic ast) (.var ast))

                                ast))
                        dest-params params)]
    (for [rm (se/get-val .refs-map)
          _ (se/update-val .init
                           (fn [init]
                             ["// allocate args at " (ast/location params) "\n"
                              (cata (fn [ast]
                                      (cond (instance? c/TaggedSymbol ast)
                                            (either (map (get rm (.var ast))
                                                         (fn [_]
                                                           [(str "Port " (.var ast)
                                                                 " = vars_alloc();\n")]))

                                                    (str "Port " (.var ast) " = erase;\n"))

                                            (instance? ast/params-ast ast)
                                            (.fixed ast)

                                            ""))
                                    params)
                              (.init args-init)
                              init]))]
      '_)))

