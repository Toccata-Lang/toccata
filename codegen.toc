(extend-type ty/ProtoArity
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(defn emit-proto [ptype]
  (assert (instance? ast/prototype-ast ptype))

  (let [c-fn (b/global-var b/CFn)]
    (se/update-val .decl
                   (fn [decl]
                     [decl
                      "Port " (.var ptype) ";" line-sep
                      "bool " c-fn "(Port ref, Port args) {\n"
                      "  Pair pr = node_take(args);\n"
                      "  Port resultVar = pr.fst;\n"
                      "  args = pr.snd;\n"
                      "  Port result = erase;\n"
                      "  NativeArgs arityArgs = {0, {}, resultVar};"
                      line-sep
                      (repeat 3 (str "    args = nativeArg(ref, args"
                                     ", &arityArgs);" line-sep))
                      "    if (arityArgs.count == 3) {" line-sep
                      "String *fileStr = (String *)arityArgs.args[0];\n"
                      "Value *dispVal = (Value *)arityArgs.args[2];\n"
                      "args = node_make(ARG, (Port)dispVal, args);\n"
                      "args = node_make(ARG, resultVar, args);\n"
                      "switch(dispVal->type) {\n"
                      (-> (.impls ptype)
                          seq
                          (reduce [] (fn [cases [type-num impl-arity]]
                                       (cond (= 0 type-num)
                                             cases

                                             [cases
                                              "case " (str type-num) ":\n"
                                              "link(" (.var impl-arity) ", args);\nbreak;\n"]))))
                      "default:\n"
                      (either (map (get-in ptype [.impls c/UnknownType])
                                   (fn [def-arity]
                                     ["link(" (.var def-arity) ", args);\n"]))
                              ["fprintf(stderr, \"No implementation found for '" (.fn-name ptype)
                               "' at %.*s: %ld\\n\", (int)fileStr->len, fileStr->buffer,"
                               "get_i24(get_val(arityArgs.args[1])));\n"
                               "abort();\n"])
                      "}\n}\nreturn TRUE;\n}\n"
                      "Port " (.var ptype) " = new_port_(REF, " c-fn ");" line-sep]))))

(defn emit-protos [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        protos (for [mod (vals mods)
                     [sym val] (either (map (get-in mod [.namespaces c/no-symbol .values 0])
                                        seq)
                                   [])
                     :when (instance? ast/prototype-ast val)]
                 val)
        emitter (for [_ (se/set-val .decl [])
                      _ (se/traverse protos (fn [val]
                                              (se/try
                                                (emit-proto val)
                                                (fn [err]
                                                  (b/status (.val err))
                                                  (b/wait-for-err-out)
                                                  (abort)))))
                      proto-decl (se/get-val .decl)
                      _ (se/set-val .decl [])]
                  (code-out proto-decl))]
    (let [[_ code-context] (emitter code-context)]
      code-context)))

(defn emit-main [code-context done-promise main-module]
  (let [main-fn (either (get-in main-module [.namespaces c/no-symbol .values 0
                                             ast/main .c-fn])
                        (do
                          (b/status "'main' function is missing or malformed")
                          ;; TODO: make sure to abort
                          ;; (abort)
                          ))
        code-context (emit-protos code-context)
        mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        dyn-glbls (flat-map (vals mods) .glbl-exprs)]
    (cond (instance? se/Error code-context)
          (do
            (b/status (.val code-context))
            (b/wait-for-err-out)
            (abort)) 

          (code-out "void normGlobals(){\n"
                    "  Port callArgs;\n"
                    (.glbl-init code-context)
                    (cond (first dyn-glbls)
                          "  normalize();\n"
                          "")
                    (map dyn-glbls
                         (fn [var]
                           (str "  " var " = enter(" var ");" line-sep)))
                    "}\n"
                    "void freeGlobals(){\n"
                    (map dyn-glbls
                         (fn [var]
                           (str "  freeGlobal(" var ");" line-sep)))
                    (cond (first dyn-glbls)
                          "  normalize();\n"
                          "")
                    "}\n"

                    "Port mainFn = new_port_(REF, " main-fn ");\n"
                    "int typeCount = " (extract b/type-counter) ";\n"))
    (deliver done-promise 'done)
    code-context))

(def core-dispatchers (-> [(c/tag 'type-name) 1 "type_name"
                           (c/tag 'zero) 1 "zero"
                           (c/tag 'invoke) 1 "invoke0Args"
                           (c/tag 'invoke) 2 "invoke1Arg"
                           (c/tag 'invoke) 3 "invoke2Args"
                           (c/tag '=*) 2 "equalSTAR"
                           (c/tag 'hash-seq) 2 "hashSeq"
                           (c/tag 'count) 1 "count"
                           (c/tag 'vals) 1 "vals"
                           (c/tag 'first) 1 "first"
                           (c/tag 'rest) 1 "rest"
                           (c/tag 'seq) 1 "seq"
                           (c/tag 'sha1) 1 "sha1"
                           (c/tag 'has-field) 2 "hasField"
                           (c/tag 'show) 1 "showFn"
                           (c/tag 'new-hash-set) 1 "newHashSet"
                           (c/tag 'apply) 2 "fn_apply"
                           (c/tag 'pr-value) 1 "prValue"]
                          (partition 3)))

(defn fixup-core-dispatchers [code-context core-mod]
  (map core-dispatchers
       (fn [[sym arg-count var]]
         (let [arity-var (either ;; (get-in core-mod [.namespaces c/no-symbol .values 0
                                 ;;                   sym .arities 0 .var])
                                  nothing

                                 ;; TODO: abort with message instead
                                 (str "noImpl" arg-count))]
           (code-out "Value *(*" var ")(FnArity *, "
                     (-> (repeat arg-count "Value *")
                         (interpose ","))
                     ") = " arity-var ";\n"))))
  code-context)

