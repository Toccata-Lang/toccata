(extend-type ast/do-ast
  CodeGen
  (gen-code [ast]
    (print-err 'boom _FILE_ _LINE_)
    (abort)
    ;; (map (se/traverse (.body ast) gen-code)
    ;;      comp-code)
    (se/state-error ast)
    ))

(defn name-natives [params]
  (cond (= (.variadic params) c/no-symbol)
        [(reduce (zip-lists (range (count (.fixed params)))
                            (.fixed params))
                 []
                 (fn [args [idx arg]]
                   (conj args (str "  Port " (.var arg)
                                   " = arityArgs.args[" idx "];\n"))))]

        (do
          (b/status "variadiac inline fn")
          (abort)
          [", Value *" (.var params)])))

(extend-type ast/params-ast
  CodeGen
  ;; (pre-gen [ast]
  ;;   (se/state-error (cata (fn [p]
  ;;                           (cond (instance? c/TaggedSymbol p)
  ;;                                 (b/TaggedParam p)

  ;;                                 p))
  ;;                         ast)))

  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/fn-arity-ast
  CodeGen
  ;; (pre-gen [ast]
  ;;   (for [_ (se/update-val .refs-map
  ;;                          (fn [refs]
  ;;                            (either (map (first refs)
  ;;                                         (fn [refs-map]
  ;;                                           (cons refs-map refs)))
  ;;                                    (list {}))))]
  ;;     ast))

  (gen-code [ast]
    (let [params (.params ast)]
      (either (map (last (.body ast))
                   (fn [last-ast]
                     (let [last-v (.var last-ast)]
                       (cond (instance? ast/inline-ast last-ast)
                             (se/state-error ast)

                             (for [_ (destruct-params params)
                                   _ (se/update-val
                                      .init
                                      (fn [init]
                                        [init
                                         "// link args to body\n"
                                         (map (butlast (.body ast))
                                              (fn [expr]
                                                (let [v (.var expr)]
                                                  (cond (= v last-v)
                                                        ""

                                                        (b/is-Rslt v)
                                                        ["link(tm, " v ", erase);" line-sep]

                                                        ""))))
                                         (.var params) " = new_port(ARG, node_make(tm, " last-v
                                         ", " (.var params) "));" line-sep]))]
                               ast)))))
              (b/compilation-error "Invalid function body at:" (ast/location ast)))))

  (gen-call [tgt args result-var]
    (se/update-val .init
                   (fn [init]
                     ;; (b/status 'call _LINE_ (ast/location tgt)
                     ;;           lf 'tgt (type-name tgt-code) (.var tgt-code) (.refs-map tgt-code)
                     ;;           lf 'args lf (str "[" (to-str (-> arg-codes
                     ;;                                            (map (fn [code]
                     ;;                                                   [(type-name code)
                     ;;                                                    (.var code)
                     ;;                                                    (.refs-map code)]))
                     ;;                                            (interpose (str lf "  ")))) "]")
                     ;;           lf 'refs-map (.refs-map code))
                     [init
                      "// call " (.fn-sym tgt) " at " (ast/location args) "\n"
                      (cond (b/is-glbl result-var)
                            ""
                            "Port ")
                      result-var " = vars_alloc(tm);" line-sep
                      (-> args
                          (map .var)
                          (conj result-var)
                          (reduce (str "callArgs = new_port(ARG, 0);" line-sep)
                                  (fn [args arg]
                                    (str args
                                         "callArgs = new_port(ARG, node_make(tm, " arg
                                         ", callArgs));" line-sep))))

                      "link(tm, " (.var (.params tgt)) ", callArgs);" line-sep]))))

(extend-type b/StaticArity
  CodeGen
  (gen-code [ast]
    (let [c-fn (.c-fn ast)
          params (-> ast .arity .params)
          arity-var (b/global-var 'Arity)
          arity-struct-var (.var (.arity ast))
          last-ast (-> ast .arity .body last extract)
          inline? (instance? ast/inline-ast last-ast)
          ;; checker (checking-fn (-> ast .arity .params) c-fn)
          ]
      (for [init (se/get-val .init)
            _ (se/set-val .init [])
            _ (se/update-val .decl
                             (fn [decl]
                               [decl
                                "Port " (.var ast) ";" line-sep
                                "bool " c-fn "(TM *tm, Port ref, Port args) {\n"
                                (cond inline?
                                      ["  Pair pr = node_take(args);\n"
                                       "  Port resultVar = pr.fst;\n"
                                       "  Port result = erase;\n"
                                       "  NativeArgs arityArgs = {0, {}, resultVar};"
                                       line-sep
                                       (repeat (count (.fixed params))
                                               (str "    args = nativeArg(tm, ref, pr.snd"
                                                    ", &arityArgs);" line-sep))
                                       "    if (arityArgs.count == " (count (.fixed params))
                                       ") {" line-sep
                                       (name-natives params)]

                                      ["Port callArgs, n0;" line-sep])
                                init
                                (cond inline?
                                      ["\nlink(tm, resultVar, result);" line-sep "}" line-sep
                                       "return TRUE;" line-sep
                                       line-sep "}" line-sep]

                                      ["link(tm, " (.var params) ", args);" line-sep
                                       "return TRUE;" line-sep "}" line-sep])]))
            _ (se/update-val .glbl-init
                             (fn [glbl-init]
                               [glbl-init
                                (.var ast) " = new_port_(REF, " c-fn ");" line-sep]))]
        ast)))

  (gen-call [tgt args result-var]
    (se/update-val .init
                   (fn [init]
                     [init
                      "// call " (.fn-sym (.arity tgt)) " at " (ast/location args) "\n"
                      (cond (b/is-glbl result-var)
                            ""
                            "Port ")
                      result-var " = vars_alloc(tm);" line-sep
                      (-> (reverse args)
                          (map .var)
                          (conj result-var)
                          (reduce (str "callArgs = new_port(ARG, 0);" line-sep)
                                  (fn [args arg]
                                    (str args
                                         "callArgs = new_port(ARG, node_make(tm, " arg
                                         ", callArgs));" line-sep))))

                      "link(tm, " (.var tgt) ", callArgs);" line-sep]))))

(defn default-fn [val c-fn]
  (assert (instance? ast/prototype-ast val))

  (let [default-body (.default-body val)]
    (b/StaticArity (ast/fn-arity-ast
                    (.fn-name val) c/no-symbol (.params val) (.doc val)
                    (cond (empty? default-body)
                          [(ast/inline-ast c/top-type (str "
   fprintf(stderr, \"*** Could not find implementation of '" (.fn-name val)
                                                           "' for *finish this error message*\\n\");
   abort();
   return ((Value *)0);
")
                                           (ast/location (.params val))
                                           "")]

                          default-body)
                    (b/global-var 'ArityStruct)
                    c/top-type)
                   c-fn
                   (b/global-var 'Fn)
                   c/top-type)))

