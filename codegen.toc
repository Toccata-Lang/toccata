
(add-ns c (git-dependency "https://github.com/Toccata-Lang/constraints.git"
                          "constraints.toc"
                          :sha "80258a3"))
(add-ns ast (git-dependency "https://github.com/Toccata-Lang/ast.git"
                            "ast.toc"
                            :sha "1b7b23c"))
(add-ns se (git-dependency "https://github.com/Toccata-Lang/state-error.git"
                           "state-error.toc"
                           :sha "8b250fe"))
(add-ns b (module "base.toc"))

(def lf "\n")
(def lflf "\n\n")

(def line-sep lf)

(defn line-marker [loc marker]
  (assert (instance? c/Location loc))

  (cond (or (= "" (.file loc))
            (and (= 'core (.file loc))
                 (= 0 (.line loc)))
            (= line-sep lf))
        ;; ["\n// " loc "\n#\n"]
        ["\n"]
        ["\n" marker "\n#line "
         (str (.line loc)) " " "\""
         (cond (= 'core (.file loc))
               b/path-to-core
               (.file loc))
         "\"\n"]))

(def output (agent (maybe 'output)))

(defn code-out [& code]
  (send output (fn [out-file?]
                 (hylo (fn [x]
                         (cond (or (instance? String x)
                                   (instance? Integer x))
                               (do
                                 (print x)
                                 [])

                               x))
                       (fn [x]
                         (cond (instance? Sequence x)
                               x

                               (print x)))
                       code)
                 out-file?)))

(defn wait-for-output []
  (let [p (promise)]
    (send output (fn [outfile]
                   (deliver p outfile)
                   outfile))
    (extract p)))


(defn reset-code-context []
  (for [_ (se/set-val .decl [])
        _ (se/set-val .init [])
        _ (se/update-val .refs-map
                         (fn [refs-map]
                           (filter-keys refs-map b/is-glbl)))]
    '_))

(defn call-op [op]
  (fn [ast]
    (cond (= 2 (count (.args ast)))
          (let [[x y] (map (.args ast) .var)]
            [(cond (b/is-glbl (.var ast))
                   ""
                   "Term ")
             (.var ast) " = make_op(" op ", " x ", " y ");\n"])

          (do
            (print-err "Wrong number of args for" (str "'" (.call-target ast) "'") "at"
                       (ast/location ast))
            (abort)))))

(def call-gens {'+ (call-op "OP_ADD")
                '- (call-op "OP_SUB")
                '* (call-op "OP_MUL")
                })

(def generic-call)
(defprotocol CodeGen
  (wrap-proto [ast loc]
    (assert (instance? c/Location loc))
    (se/state-error (.var ast)))

  (prep-gen [x]
    (se/state-error x))

  (gen-code [ast]
    (assert-result r (instance? se/StateError r))
    )

  (gen-code [ast arity]
    (assert-result r (instance? se/StateError r))

    (gen-code ast))

  (gen-call [ast call-ast]
    (generic-call call-ast)))

(defn generic-call [ast]
  (assert (instance? ast/call-ast ast))
  (let [tgt (.call-target ast)
        args (reverse (.args ast))
        result-var (.var ast)
        num-args (count args)
        loc (ast/location ast)]
    (for [wrapped-args (se/traverse args (fn [arg]
                                           (wrap-proto arg loc)))]
      ["// call " (either (or (instance? c/TaggedSymbol tgt)
                              (get tgt .fn-sym))
                          "")
       " at " loc "\n"
       "Term " result-var "Args = pair_make(APP, 0, "
       (either (first wrapped-args)
               "NUL")
       ", SUB);\n"
       (cond (b/is-glbl result-var)
             ""
             "Term ")
       result-var " = term_new(VAR, 0, port(2, term_loc(" result-var "Args)));\n"
       (-> (rest wrapped-args)
           (reduce []
                   (fn [args arg]
                     [args
                      result-var "Args = pair_make(APP, 0, " arg ", "
                      result-var "Args);\n"])))
       (cond (b/is-glbl result-var)
             ["store_redex(" result-var "Args, " (.var tgt) ");"]

             (= "" (.var tgt))
             (do
               (b/status 'boom _FILE_ _LINE_)
               (b/status ast (ast/location ast))
               (b/wait-for-err-out)
               (abort))

             ["#ifdef STRICT\n"
              "store_redex(" result-var "Args, " (.var tgt) ");\n"
              "#else\n"
              "swapStore(term_loc(" result-var
              "), pair_make(LAZ, 0, " result-var "Args, " (.var tgt) "));\n"
              "#endif\n"])
       "\n"])))

(extend-type Vector
  CodeGen
  (gen-code [v]
    b/se-nop))

(defn emit-code [ast mod]
  (cond (instance? ast/inline-ast ast)
        (se/state-error (code-out (.txt ast)))

        (instance? Vector ast)
        (se/traverse ast (fn [inner]
                           (emit-code inner mod)))

        (for [_ (reset-code-context)
              _ (se/set-val .module mod)
              _ (hylo prep-gen gen-code ast se/state-error)
              decl (se/get-val .decl)]
          (code-out decl))))

(extend-type c/NoSymbol
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type b/TaggedParam
  CodeGen
  (gen-code [ast]
    (se/state-error (.sym ast))))

;; don't throw an error like 'get-value' does
;; just fail
(defn lookup-sym [sym]
  (assert (instance? c/TaggedSymbol sym))

  (cond (or (= (str sym) "")
            (= sym c/no-symbol))
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (comp (se/get-in-val [.module .namespaces (.ns sym) .values 0 sym])
              (cond (= (.ns sym) c/no-symbol)
                    (comp (se/get-in-val [.module .namespaces b/core .values 0 sym])
                          (flat-map b/se-nop
                                    (fn [_]
                                      (let [proto-prom (promise)]
                                        (send b/modules
                                              (fn [mods]
                                                (deliver proto-prom
                                                         (either (flat-map (map (get mods b/core)
                                                                                (fn [m]
                                                                                  (cond (instance? Promise m)
                                                                                        (extract m)
                                                                                        m)))
                                                                           (fn [core-mod]
                                                                             (map (get-in core-mod
                                                                                          [.namespaces c/no-symbol .values 0 sym])
                                                                                  se/state-error)))
                                                                 se/zero-se))
                                                mods))
                                        (extract proto-prom)))))

                    se/zero-se))))

;; This 'get-value' is only for code generation, not type checking
(defn get-value [sym]
  (assert (instance? c/TaggedSymbol sym))

  (comp (lookup-sym sym)
        (b/compilation-error "Codegen Undefined symbol:" (str "'" sym "'") "at" (ast/location sym))))

(extend-type c/TaggedSymbol
  CodeGen
  (wrap-proto [ast loc]
    (se/try
      (flat-map (get-value ast)
                (fn [val]
                  (cond (instance? ast/prototype-ast val)
                        (let [new-var (str (.var ast) "_" (extract b/global-vars))]
                          (for [file-str (-> (.file loc)
                                             (str)
                                             (ast/string-ast loc (b/global-var 'Str)
                                                             c/string-constraint)
                                             gen-code)
                                _ (se/update-val .decl
                                                 (fn [decl]
                                                   [decl
                                                    "void " new-var "(Term ref, Term args) {\n"
                                                    "  args = pair_make(APP, 0, new_i60(" (.line loc )
                                                    "), args);\n"
                                                    "  args = pair_make(APP, 0, " (.var file-str)
                                                    ", args);\n"
                                                    "  interact(args, " (.var ast) ");\n"
                                                    "}\n"]))]
                            (str "new_ref(" new-var ")")))

                        (se/state-error (.var ast)))))
      (fn [c]
        (se/state-error (.var ast)))))

  (gen-code [ast]
    (let [var (.var ast)]
      (cond (= "" var)
            (se/state-error ast)

            (b/is-glbl var)
            (se/state-error ast)

            (comp (for [refs (se/update-in-val [.refs-map var] inc)]
                    (.var ast (str var "_" refs)))
                  (for [_ (se/assoc-in-val [.refs-map var] 1)]
                    ast)))))

  (gen-call [sym call-ast]
    (either (map (get call-gens sym)
                 (fn [cg]
                   (se/state-error (cg call-ast))))
            (flat-map (se/try
                        (get-value sym)
                        (fn [c]
                          (se/state-error sym)))
                      (fn [tgt-val]
                        (cond (instance? c/TaggedSymbol tgt-val)
                              (generic-call call-ast)

                              (gen-call tgt-val call-ast)))))))

(extend-type ast/field-ast
  CodeGen
  (gen-code [ast]
    (cond (b/is-glbl (.var ast))
          (let [c-fn (b/global-var 'FldFn)]
            (se/update-val .decl
                           (fn [decl]
                             [decl
                              "Term " (.var ast) ";\n"
                              "void " c-fn "(Term ref, Term args) {\n"
                              "args = pair_make(APP, 0, new_i60(" (.idx ast) "), args);\n"
                              "store_redex(args, accessField);\n"
                              "return;\n}\n"
                              "Term " (.var ast) " = new_ref(" c-fn ");\n"])))
          
          (let [val-var (.val-var ast)]
            (comp (for [refs (se/update-in-val [.refs-map val-var] inc)
                        :let [var (str val-var "_" refs)]
                        _ (se/update-val .init
                                         (fn [init]
                                           ["Term " var "Args = pair_make(APP, 0, " var
                                            ", SUB);\n"
                                            "Term " (.var ast) " = term_new(VAR, 0, port(2, term_loc("
                                            var "Args)));\n"
                                            var "Args = pair_make(APP, 0, new_i60(" (.idx ast)
                                            "), " var "Args);\n"
                                            "store_redex(" var "Args, accessField);\n"
                                            init]))]
                    ast)
                  ;; if val-var is not in the refs-map, being seen for the first time
                  (for [_ (se/assoc-in-val [.refs-map val-var] 1)
                        _ (se/update-val .init
                                         (fn [init]
                                           ["Term " val-var "Args = pair_make(APP, 0, " val-var
                                            ", SUB);\n"
                                            "Term " (.var ast) " = term_new(VAR, 0, port(2, term_loc("
                                            val-var "Args)));\n"
                                            val-var "Args = pair_make(APP, 0, new_i60(" (.idx ast)
                                            "), " val-var "Args);\n"
                                            "store_redex(" val-var "Args, accessField);\n"
                                            init]))]
                    ast))))))

(extend-type ast/inline-ast
  CodeGen
  (gen-code [x]
    (map (cond (= (.var x) "")
               (se/update-val .init (fn [init]
                                      [init (.txt x)]))

               (se/update-val .decl (fn [decl]
                                      ["Term " (.var x) " = " (.txt x) ";\n"])))
         (fn [_]
           x)))

  (gen-code [x arity]
    (gen-code x)))

(deftype ParamInit [var init]
  ;; Container
  ;; (map [x f]
  ;;   x)
  )

(defprotocol DestParams
  (dest-params [ast]
    (assert-result r (instance? ParamInit r))))

(deftype PlainParams [fixed var]
  Container
  (map [x f]
    (PlainParams (map fixed f) var))

  DestParams
  (dest-params [ast]
    (let [var (.var ast)
          args (reverse (.fixed ast))]
      (either (map (first args)
                   (fn [last-arg]
                     (reduce (rest args)
                             (ParamInit var (str "Term " var " = pair_make(LAM, 0, SUB, NUL);\n"
                                                 ;; TODO: this will cause problems when
                                                 ;; destructuring vectors
                                                 "Location r_" var " = port(2, term_loc(" var "));\n"
                                                 "Term " (.var last-arg)
                                                 " = term_new(VAR, 0, port(1, term_loc(" var ")));\n"))
                             (fn [args arg]
                               (assert (instance? ParamInit args))
                               (assert (instance? ParamInit arg))

                               (.init args [(.init args)
                                            (.init arg)
                                            (str var " = pair_make(LAM, 0, SUB, " var ");\n"
                                                 "Term " (.var arg)
                                                 " = term_new(VAR, 0, port(1, term_loc(" var
                                                 ")));\n")])))))
              (ParamInit var (str "Term " var " = pair_make(LAM, 0, ERA, NUL);\n"
                                  "Location r_" var " = port(2, term_loc(" var "));\n"))))))

(extend-type c/TaggedSymbol
  DestParams
  (dest-params [s]
    (ParamInit (.var s) [])))

(extend-type c/NoSymbol
  DestParams
  (dest-params [s]
    (ParamInit "" [])))

(defn destruct-params [params dup-label]
  (let [args-init (hylo (fn [ast]
                          (cond (instance? ast/params-ast ast)
                                (PlainParams (.fixed ast) (.var ast))

                                ast))
                        dest-params params)]
    (for [rm (se/get-val .refs-map)
          _ (se/update-val
             .init
             (fn [init]
               [(.init args-init)
                "// allocate args at " (ast/location params) "\n"
                (cata (fn [ast]
                        (let [var (.var ast)]
                          (cond (instance? c/TaggedSymbol ast)
                                (either (map (get rm var)
                                             (fn [refs]
                                               (reduce (reverse (range (dec refs)))
                                                       []
                                                       (fn [dupes idx]
                                                         (let [dupe-var (str var "_" (inc idx))]
                                                           (conj dupes
                                                                 ["\nTerm " dupe-var ";\n"
                                                                  var " = dupeArg(" var,
                                                                  ", &" dupe-var ", "
                                                                  dup-label ");\n"]))))))

                                        ["swapStore(term_loc(" var "), ERA);\n"])

                                (instance? ast/params-ast ast)
                                (.fixed ast)

                                "")))
                      params)
                init]))]
      '_)))

