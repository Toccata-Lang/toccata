
(add-ns c (git-dependency "https://github.com/Toccata-Lang/constraints.git"
                          "constraints.toc"
                          :sha "80258a3"))
(add-ns ast (git-dependency "https://github.com/Toccata-Lang/ast.git"
                            "ast.toc"
                            :sha "c2ee5b2"))
(add-ns se (git-dependency "https://github.com/Toccata-Lang/state-error.git"
                           "state-error.toc"
                           :sha "8b250fe"))
(add-ns b (module "base.toc"))

(def lf "\n")
(def lflf "\n\n")

(def line-sep lf)

(defn line-marker [loc marker]
  (assert (instance? c/Location loc))

  (cond (or (= "" (.file loc))
            (and (= 'core (.file loc))
                 (= 0 (.line loc)))
            (= line-sep lf))
        ;; ["\n// " loc "\n#\n"]
        ["\n"]
        ["\n" marker "\n#line "
         (str (.line loc)) " " "\""
         (cond (= 'core (.file loc))
               b/path-to-core
               (.file loc))
         "\"\n"]))

(def output (agent (maybe 'output)))

(defn code-out [& code]
  (send output (fn [out-file?]
                 (hylo (fn [x]
                         (cond (or (instance? String x)
                                   (instance? Integer x))
                               (do
                                 (print x)
                                 [])

                               x))
                       (fn [x]
                         (cond (instance? Sequence x)
                               x

                               (print x)))
                       code)
                 out-file?)))

(defn wait-for-output []
  (let [p (promise)]
    (send output (fn [outfile]
                   (deliver p outfile)
                   outfile))
    (extract p)))


(defn reset-code-context []
  (for [_ (se/set-val .decl [])
        _ (se/set-val .init [])
        _ (se/update-val .refs-map
                         (fn [refs-map]
                           (filter-keys refs-map b/is-glbl)))]
    '_))

(defn call-vector [ast]
  (assert (instance? ast/call-ast ast))

  (let [result-var (.var ast)]
    (-> (.args ast)
        (map .var)
        (reduce ["// call 'vector' at " (ast/location ast) "\n"
                 (cond (b/is-glbl result-var)
                       ""
                       ["Term " result-var ";\n"])
                 result-var " = (Term)empty_vect;\n" ]
                (fn [v arg]
                  [v
                   "callArgs = endArgs;\n"
                   "callArgs = pair_make(APP, 0, " arg ", callArgs);\n"
                   "callArgs = pair_make(APP, 0, " result-var ", callArgs);\n"
                   result-var " = vars_alloc();\n"
                   "callArgs = pair_make(APP, 0, " result-var ", callArgs);\n"
                   "vars_create(" result-var ", pair_make(RDX, "
                   "hvmVectConj, callArgs));\n"])))))

(defn call-op [op]
  (fn [ast]
    (cond (= 2 (count (.args ast)))
          (let [[x y] (map (.args ast) .var)]
            [(cond (b/is-glbl (.var ast))
                   ""
                   "Term ")
             (.var ast) " = make_op(" op ", " x ", " y ");\n"])

          (do
            (print-err "Wrong number of args for" (str "'" (.call-target ast) "'") "at"
                       (ast/location ast))
            (abort)))))

(def call-gens {'vector call-vector
                '+ (call-op "OP_ADD")
                '- (call-op "OP_SUB")
                '* (call-op "OP_MUL")
                })

(defn generic-call [ast]
  (assert (instance? ast/call-ast ast))
  (let [tgt (.call-target ast)
        args (reverse (.args ast))
        result-var (.var ast)
        num-args (count args)]
    (se/state-error ["// call " (either (or (instance? c/TaggedSymbol tgt)
                                            (get tgt .fn-sym))
                                        "")
                     " at " (either (map (first args) ast/location)
                                    (ast/location tgt)) "\n"
                     "callArgs = pair_make(APP, 0, "
                     (either (map (first args) .var)
                             "NUL")
                     ", SUB);\n"
                     (cond (b/is-glbl result-var)
                           ""
                           "Term ")
                     result-var " = term_new(VAR, 0, port(2, term_loc(callArgs)));\n"
                     (-> (rest args)
                         (map .var)
                         (reduce []
                                 (fn [args arg]
                                   [args
                                    "callArgs = pair_make(APP, 0, " arg ", callArgs);\n"])))
                     (cond (b/is-glbl result-var)
                           ["store_redex(callArgs, " (.var tgt) ");"]

                           ["#ifdef STRICT\n"
                            "store_redex(callArgs, " (.var tgt) ");\n"
                            "#else\n"
                            "swapStore(term_loc(" result-var
                            "), pair_make(LAZ, 0, callArgs, " (.var tgt) "));\n"
                            "#endif\n"])
                     "\n"])))

(defprotocol CodeGen
  (gen-code [ast]
    (assert-result r (instance? se/StateError r))
    )

  (gen-code [ast arity]
    (assert-result r (instance? se/StateError r))

    (gen-code ast))

  (gen-call [ast call-ast]
    (generic-call call-ast)))

(extend-type Vector
  CodeGen
  (gen-code [v]
    b/se-nop))

(defn emit-code [ast mod]
  (cond (instance? ast/inline-ast ast)
        (se/state-error (code-out (.txt ast)))

        (instance? Vector ast)
        (se/traverse ast (fn [inner]
                           (emit-code inner mod)))

        (for [_ (reset-code-context)
              _ (se/set-val .module mod)
              _ (cata gen-code ast se/state-error)
              decl (se/get-val .decl)]
          (code-out decl))))

(extend-type c/NoSymbol
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type b/TaggedParam
  CodeGen
  (gen-code [ast]
    (se/state-error (.sym ast))))

;; don't throw an error like 'get-value' does
;; just fail
(defn lookup-sym [sym]
  (assert (instance? c/TaggedSymbol sym))

  (cond (= (str sym) "")
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (= sym c/no-symbol)
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (comp (se/get-in-val [.module .namespaces (.ns sym) .values 0 sym])
              (cond (= (.ns sym) c/no-symbol)
                    (se/get-in-val [.module .namespaces b/core .values 0 sym])

                    se/zero-se))))

;; This 'get-value' is only for code generation, not type checking
(defn get-value [sym]
  (assert (instance? c/TaggedSymbol sym))

  (comp (lookup-sym sym)
        (b/compilation-error "Undefined symbol:" (str "'" sym "'") "at" (ast/location sym))))

(extend-type c/TaggedSymbol
  CodeGen
  (gen-code [ast]
    (let [var (.var ast)]
      (comp (cond (= "" var)
                  (se/state-error ast)

                  se/zero-se)
            (for [refs (se/update-in-val [.refs-map var] inc)
                  :let [dupe-var (str var "_" refs)]
                  _ (se/update-val .init
                                   (fn [init]
                                     ["Term " dupe-var ";\n"
                                      var " = dupeArg(" var, ", &" dupe-var ");\n\n"
                                      init]))]
              (.var ast dupe-var))
            (cond (b/is-glbl var)
                  (flat-map (get-value ast)
                            (fn [val]
                              (cond (or (instance? b/StaticArity val)
                                        (instance? ast/integer-ast val))
                                    (se/state-error ast)

                                    (for [_ (se/assoc-in-val [.refs-map var] 2)
                                          :let [dupe-var (str var "_" 1)]
                                          _ (se/update-val .init
                                                           (fn [init]
                                                             ["\nTerm " dupe-var ";\n"
                                                              var " = dupeArg(" var, ", &"
                                                              dupe-var ");\n"
                                                              init]))]
                                      (.var ast dupe-var)))))
                  (for [_ (se/assoc-in-val [.refs-map var] 1)]
                    ast)))))

  (gen-call [sym call-ast]
    (either (map (get call-gens sym)
                 (fn [cg]
                   (se/state-error (cg call-ast))))
            (flat-map (se/try
                        (get-value sym)
                        (fn [c]
                          (se/state-error sym)))
                      (fn [tgt-val]
                        (cond (instance? c/TaggedSymbol tgt-val)
                              (generic-call call-ast)

                              (gen-call tgt-val call-ast)))))))

(extend-type ast/field-ast
  CodeGen
  (gen-code [ast]
    (cond (b/is-glbl (.var ast))
          (let [c-fn (b/global-var 'FldFn)]
            (se/update-val .decl
                           (fn [decl]
                             [decl
                              "Term " (.var ast) ";\n"
                              "void " c-fn "(Term ref, Term args) {\n"
                              "args = pair_make(APP, 0, new_i60(" (.idx ast) "), args);\n"
                              "store_redex(args, accessField);\n"
                              "return;\n}\n"
                              "Term " (.var ast) " = new_ref(" c-fn ");\n"])))
          
          (let [val-var (.val-var ast)
                get-field ["callArgs = pair_make(APP, 0, " val-var ", SUB);\n"
                           "Term " (.var ast) " = term_new(VAR, 0, port(2, term_loc(callArgs)));\n"
                           "callArgs = pair_make(APP, 0, new_i60(" (.idx ast) "), callArgs);\n"
                           "store_redex(callArgs, accessField);\n"]]
            (comp (for [refs (se/update-in-val [.refs-map val-var] inc)
                        :let [dupe-var (str val-var "_" refs)]
                        _ (se/update-val .init
                                         (fn [init]
                                           ["\nTerm " dupe-var " = vars_alloc();\n"
                                            val-var " = dupeArg(" val-var, ", " dupe-var ");\n"
                                            get-field
                                            init]))]
                    (.var ast dupe-var))
                  ;; if val-var is not in the refs-map, being seen for the first time
                  (for [_ (se/assoc-in-val [.refs-map val-var] 1)
                        _ (se/update-val .init
                                         (fn [init]
                                           [get-field init]))]
                    ast))))))

(extend-type ast/inline-ast
  CodeGen
  (gen-code [x]
    (map (cond (= (.var x) "")
               (se/update-val .init (fn [init]
                                      [init (.txt x)]))

               (se/update-val .decl (fn [decl]
                                      ["Term " (.var x) " = " (.txt x) ";\n"])))
         (fn [_]
           x)))

  (gen-code [x arity]
    (gen-code x)))

(deftype ParamInit [var init]
  ;; Container
  ;; (map [x f]
  ;;   x)
  )

(defprotocol DestParams
  (dest-params [ast]
    (assert-result r (instance? ParamInit r))))

(deftype PlainParams [fixed var]
  Container
  (map [x f]
    (PlainParams (map fixed f) var))

  DestParams
  (dest-params [ast]
    (let [var (.var ast)
          args (reverse (.fixed ast))]
      (either (map (first args)
                   (fn [last-arg]
                     (reduce (rest args)
                             (ParamInit var (str "Term " var " = pair_make(LAM, 0, SUB, NUL);\n"
                                                 ;; TODO: this will cause problems when
                                                 ;; destructuring vectors
                                                 "Location r_" var " = port(2, term_loc(" var "));\n"
                                                 "Term " (.var last-arg)
                                                 " = term_new(VAR, 0, port(1, term_loc(" var ")));\n"))
                             (fn [args arg]
                               (assert (instance? ParamInit args))
                               (assert (instance? ParamInit arg))

                               (.init args [(.init args)
                                            (.init arg)
                                            (str var " = pair_make(LAM, 0, SUB, " var ");\n"
                                                 "Term " (.var arg)
                                                 " = term_new(VAR, 0, port(1, term_loc(" var
                                                 ")));\n")])))))
              (ParamInit var (str "Term " var " = pair_make(LAM, 0, ERA, NUL);\n"
                                  "Location r_" var " = port(2, term_loc(" var "));\n"))))))

(extend-type c/TaggedSymbol
  DestParams
  (dest-params [s]
    (ParamInit (.var s) [])))

(extend-type c/NoSymbol
  DestParams
  (dest-params [s]
    (ParamInit "" [])))

(defn destruct-params [params]
  (let [args-init (hylo (fn [ast]
                          (cond (instance? ast/params-ast ast)
                                (PlainParams (.fixed ast) (.var ast))

                                ast))
                        dest-params params)]
    (for [rm (se/get-val .refs-map)
          _ (se/update-val .init
                           (fn [init]
                             [(.init args-init)
                              "// allocate args at " (ast/location params) "\n"
                              (cata (fn [ast]
                                      (cond (instance? c/TaggedSymbol ast)
                                            (either (map (get rm (.var ast))
                                                         (fn [refs]
                                                           ""
                                                           ;; ["Term " (.var ast)
                                                           ;;  " = term_new(VAR, 0, port(1, term_loc(l_"
                                                           ;;  (.var ast) ")));\n"]
                                                           ))

                                                    ["swapStore(term_loc(" (.var ast) "), ERA);\n"])

                                            (instance? ast/params-ast ast)
                                            (.fixed ast)

                                            ""))
                                    params)
                              init]))]
      '_)))

