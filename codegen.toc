          )))

(extend-type ast/do-ast
  CodeGen
  (gen-code [ast]
    (print-err 'boom _FILE_ _LINE_)
    (abort)
    (map (se/traverse (.body ast) (fn [expr]
                                    (gen-code expr)))
         comp-code)))

(defn name-natives [params]
  (cond (= (.variadic params) c/no-symbol)
        [(reduce (zip-lists (range (count (.fixed params)))
                            (.fixed params))
                 []
                 (fn [args [idx arg]]
                   (conj args (str "    Port " (.var arg)
                                   " = arityArgs.args[" idx "];\n"))))]

        (do
          (b/status "variadiac inline fn")
          (abort)
          [", Value *" (.var params)])))

(extend-type ast/params-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/fn-arity-ast
  CodeGen
  (pre-gen [ast]
    (se/state-error ast))

  (gen-code [ast]
    (let [params (.params ast)]
      (either (map (last (.body ast))
                   (fn [last-ast]
                     (for [;;  _ (cata destruct-seq params se/state-error)
                           _ (se/update-val .init
                                            (fn [init]
                                              (cond (instance? ast/inline-ast last-ast)
                                                    ["  NativeArgs arityArgs;\n"
                                                     "  if (getNativeArgs(tm, ref, args, "
                                                     (count (.fixed params))
                                                     ", &arityArgs)) {\n"
                                                     (name-natives params) init
                                                     "\n    link(tm, arityArgs.tail, result);\n  }\n"
                                                     "  return TRUE;\n};\n"]

                                                    (let [arityArgs (str "arity" (.var ast) "Args")]
                                                      [init
                                                       "NativeArgs " arityArgs ";\n"
                                                       "  if (getArgs(args, "
                                                       (count (.fixed params))
                                                       ", &" arityArgs ")) {\n"
                                                       "\n    link(tm, (Port)&" (.var last-ast)
                                                       ", " arityArgs ".tail);}\nreturn TRUE;}\n"]))))]
                       ast)))
              (b/compilation-error "Invalid function body at:" (ast/location ast)))

      ;; (for [_ b/se-nop

      ;;       ;; body-exprs (comp (cond (= (.variadic params) c/no-symbol)
      ;;       ;;                        (flat-map (.fixed params) destruct-seq)

      ;;       ;;                        (destruct-seq params))
      ;;       ;;                  body-exprs)

      ;;       code ]

      ;;   ;; (b/status 'body _LINE_ (ast/location ast) 'params (ast/all-syms params)
      ;;   ;;           lf (str "[" (-> body-exprs
      ;;   ;;                           (map (fn [code]
      ;;   ;;                                  [(type-name code)
      ;;   ;;                                   (.var code)
      ;;   ;;                                   (.refs-map code)]))
      ;;   ;;                           (interpose (str lf "  "))
      ;;   ;;                           to-str) "]"))
      ;;   ;; TODO: handle recursion properly
      ;;   (-> code
      ;;       ;; TODO: don't think this does anything
      ;;       ;; (.decl [(.decl code)])
      ;;       (.init [ "\n  NativeArgs arityArgs;\n"
      ;;               (.init code)
      ;;               "  return TRUE;\n};\n"])))
      )))

(extend-type b/StaticArity
  CodeGen
  (pre-gen [ast]
    (se/state-error ast))

  (gen-code [ast]
    (let [c-fn (.c-fn ast)
          params (-> ast .arity .params)
          arity-var (b/global-var 'Arity)
          arity-struct-var (.var (.arity ast))
          ;; checker (checking-fn (-> ast .arity .params) c-fn)
          ]
      (for [init (se/get-val .init)
            _ (se/set-val .init [])
            decl (se/get-val .decl)
            _ (se/set-val .decl [decl
                                 "bool " c-fn "(TM *tm, Port ref, Port args) {\nu32 vl = 0;"
                                 init
                                 "FnArity " arity-struct-var " = {FnArityType, REFS_STATIC, "
                                 (count params)
                                 ", (Vector *)0, "
                                 (cond (= (-> ast .arity .params .variadic)
                                          c/no-symbol)
                                       ;; fixed arity
                                       0

                                       ;; variadic arity
                                       1)
                                 ", " c-fn "};\n"
                                 "FnArity *" arity-var " = &" arity-struct-var ";"])]
        ast))))

