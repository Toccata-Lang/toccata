(def StaticOrDispatcher (any-of b/StaticArity
                                Dispatcher))

(extend-type ast/definition-ast
  CodeGen
  (gen-code [ast]
    (let [[expr] (.value-exprs ast)
          sym (.sym ast)]
      (cond  (instance? c/TaggedSymbol expr)
             (se/state-error ast)

             (for [init (se/update-val .init (fn [_] []))
                   _ (se/update-val .glbl-init (fn [glbl-init]
                                                 (comp glbl-init
                                                       "if(1){" init "}" line-sep)))
                   _ (cond (or (instance? b/StaticArity expr)
                               (instance? ast/string-ast expr)
                               (instance? ast/integer-ast expr))
                           b/se-nop

                           (se/update-val .decl (fn [decl]
                                                  [decl
                                                   (cond (= sym 'main)
                                                         "// main fn\n"
                                                         "")
                                                   "Port " (.var expr) ";" line-sep])))]
               ast)))))

(extend-type ast/integer-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/string-ast
  CodeGen
  (gen-code [ast]
    (let [str-val (.string ast)
          str-len (count str-val)
          str-ptr (.var ast)]
      (comp (map (se/get-in-val [.strings str-val])
                 (fn [var]
                   (.var ast var)))
            (for [const-strs (se/get-val .strings)
                  :let [str-idx (count const-strs)
                        str-sym (str "str" str-idx)]
                  _ (se/assoc-in-val [.strings str-val] str-ptr)
                  _ (se/update-val .decl
                                   (fn [decl]
                                     [decl
                                      "struct {TYPE_SIZE type;" line-sep
                                      "        REFS_SIZE refs;" line-sep
                                      "        int64_t *hash;" line-sep
                                      "        int64_t len;" line-sep
                                      "        char buffer[" (inc (count str-val)) "];" line-sep
                                      "} " str-sym " = {StringBufferType, REFS_STATIC, 0, "
                                      (count str-val) ", \"" (escape-chars str-val) "\"};" line-sep
                                      "Port " str-ptr " = new_port_(VAL, (Port)&"
                                      str-sym ");" line-sep]))]
              ast)))))

(extend-type ast/call-ast
  CodeGen
  (gen-code [ast]
    (let [tgt (.call-target ast)
          args (.args ast)
          result-var (.var ast)
          num-args (count args)]
      (map (se/update-val .init
                          (fn [init]
                            [init
                             (cond (= tgt 'vector)
                                   (do
                                     (-> args
                                         (reduce [line-sep
                                                  (cond (b/is-glbl result-var)
                                                        ""
                                                        ["Port " result-var ";"  line-sep])
                                                  "if (1) {" line-sep
                                                  "  Vector *v = malloc_vector();" line-sep]
                                                 (fn [v arg]
                                                   (comp v ["  v = mutateVectConj(v, (Value *)"
                                                            (.var arg) ");" line-sep])))
                                         (comp [result-var " = new_port(VAL, (Port)v);" line-sep
                                                "}" line-sep])))

                                   (= tgt 'list)
                                   (-> args
                                       reverse
                                       (reduce [line-sep
                                                (cond (b/is-glbl result-var)
                                                    ""
                                                    ["Port " result-var ";"  line-sep])
                                                "if (1) {" line-sep
                                                "  List *l = malloc_list();" line-sep]
                                               (fn [v arg]
                                                 (comp v ["  l = listCons((Value *)" (.var arg)
                                                          ", l);" line-sep])))
                                       (comp [result-var " = new_port(VAL, (Port)l);" line-sep
                                              "}" line-sep]))

                                   (and (= 2 num-args)
                                        (= tgt '+))
                                   (let [[x y] (map args .var)]
                                     [(cond (b/is-glbl result-var)
                                            ""
                                            "Port ")
                                      result-var " = vars_alloc(tm);" line-sep
                                      "make_op(tm, OP_ADD, " x ", " y ", " result-var ");" line-sep])

                                   ["// call " (either (or (instance? c/TaggedSymbol tgt)
                                                           (get tgt .fn-sym))
                                                       "")
                                    " at " (ast/location args) "\n"
                                    (cond (b/is-glbl result-var)
                                          ""
                                          "Port ")
                                    result-var " = vars_alloc(tm);" line-sep
                                    (-> args
                                        (map .var)
                                        (reverse)
                                        (conj result-var)
                                        (reduce (str "callArgs = new_port(ARG, 0);" line-sep)
                                                (fn [args arg]
                                                  (str args
                                                       "callArgs = node_make(tm, ARG, " arg
                                                       ", callArgs);" line-sep))))
                                    (cond (b/is-glbl result-var)
                                          ["link(tm, " (.var tgt) ", callArgs);"]

                                          ["vars_create(" result-var ", node_make(tm, RDX, "
                                           (.var tgt) ", callArgs));"])
                                    line-sep])]))
           (fn [_]
             ast)))))

