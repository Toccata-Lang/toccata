(defn default-fn [val c-fn]
  (assert (instance? ast/prototype-ast val))

  (let [default-body (.default-body val)]
    (b/StaticArity (ast/fn-arity-ast
                    (.fn-name val) c/no-symbol (.params val) (.doc val)
                    (cond (empty? default-body)
                          [(ast/inline-ast c/top-type (str "
   fprintf(stderr, \"*** Could not find implementation of '" (.fn-name val)
"' for *finish this error message*\\n\");
   abort();
   return ((Value *)0);
")
                                           (ast/location (.params val))
                                           "")]

                          default-body)
                    (b/global-var 'ArityStruct)
                    c/top-type)
                   c-fn)))

(deftype Dispatcher [proto arity-struct-var c-fn]
  (assert (instance? ast/prototype-ast proto))

  CodeGen
  (gen-code [_]
    (print-err 'boom _FILE_ _LINE_)
    (abort)
    (let [impls (.impls proto)
          params (.params proto)
          disp-arg (either (map (first (.fixed params)) .var)
                           "arg0")
          arg-count (count params)
          arity-var (b/global-var 'Arity)]
      (se/state-error (-> empty-c-code
                          (.var arity-var)
                          (.decl ["Value *" (.var proto) "(FnArity *locStr"
                                  (map (.fixed params)
                                       (fn [param]
                                         (str ", Value *" (.var param))))
                                  ") {\nFnArity *arity;\n#\n"
                                  "FnType" arg-count " *_fn;\n"
                                  "switch (" disp-arg "->type) {\n"
                                  (-> impls
                                      vec
                                      (map (fn [[type-num arity]]
                                             ["case " (str type-num) ": _fn = (FnType"
                                              arg-count " *)" (.c-fn arity) ";"
                                              ;; (for [[constraint var] (-> arity
                                              ;;                            .arity
                                              ;;                            .params
                                              ;;                            .fixed
                                              ;;                            (map .var)
                                              ;;                            rest)]
                                              ;;   (-> constraint
                                              ;;       (c/update-var var)
                                              ;;       (runtime-check c/top-type
                                              ;;                      (str "(closures == (FnArity *)0 ? \"\" : "
                                              ;;                           "((String *)closures)->buffer)")
                                              ;;                      checked-var)))
                                              "break;\n"])))
                                  "default:\n"
                                  "_fn = (FnType" arg-count
                                  " *)" c-fn ";\nbreak;\n"
                                  "}\n"
                                  "return(_fn(locStr" (map (.fixed params)
                                                           (fn [param]
                                                             (str ", " (.var param))))
                                  "));\n}\n"
                                  "FnArity " arity-struct-var " = {FnArityType, REFS_STATIC, " arg-count
                                  ", (Vector *)0, 0, " (.var proto) "};"
                                  "FnArity *" arity-var " = &" arity-struct-var ";"]))))))

(def StaticOrDispatcher (any-of b/StaticArity
                                Dispatcher))

(extend-type ast/fn-ast
  CodeGen
  (pre-gen [ast]
    (se/state-error ast))

  (gen-code [ast]
    (let [fn-sym (.fn-sym ast)
          var (.var ast)
          [defaults arities] (reduce (.arities ast) [[] []]
                                     (fn [[defs arities] arity]
                                       (cond (instance? ast/prototype-ast arity)
                                             (let [def-c-fn (b/global-var b/CFn)
                                                   arity-struct-var (b/global-var 'ArityStruct)]
                                               [(conj defs (default-fn arity def-c-fn))
                                                (conj arities
                                                      (Dispatcher arity arity-struct-var def-c-fn))])

                                             [defs (conj arities arity)])))]
      ;; TODO: what if fn-sym is c/no-symbol
      (cond (every arities (partial instance? StaticOrDispatcher))
            (let [struct-var (.struct-var ast)]
              (for [_ (se/update-val .decl
                                     (fn [decl]
                                       [decl
                                        "\n// --------- " fn-sym " -------------\n"
                                        ;; "Value *" var ";" line-sep
                                        "Function " struct-var " = {FunctionType, REFS_STATIC, \""
                                        fn-sym "\", " (count arities) ", "
                                        "{" (-> arities
                                                (map (fn [arity]
                                                       (str "&"
                                                            (cond (instance? b/StaticArity arity)
                                                                  (.var (.arity arity))

                                                                  (.arity-struct-var arity)))))
                                                (interpose ", "))
                                        "}};\n"
                                        "Value *" var " = (Value *)&" struct-var ";\n\n"]))]
                ast))

            (do
              (print-err 'boom _FILE_ _LINE_)
              (abort)
              ;; (let [arity-count (count arities)
              ;;       fn-ptr-var (.struct-var ast)]
              ;;   (-> empty-c-code
              ;;       (.var var)
              ;;       (.decl (map code-vect .decl))
              ;;       (.init [(map code-vect .init)
              ;;               "Function *" fn-ptr-var " = malloc_function(" arity-count ");"
              ;;               "Value *" var " = (Value *)" fn-ptr-var ";"
              ;;               fn-ptr-var "->name = \"" fn-sym "\";"
              ;;               fn-ptr-var "->arityCount = " arity-count ";"
              ;;               (map (zip-lists (map code-vect .var)
              ;;                               (range arity-count))
              ;;                    (fn [[sym index]]
              ;;                      [sym "->parent = " var ";"
              ;;                       fn-ptr-var "->arities[" index "] = " sym ";"]))])
              ;;       (.refs-map (merge-maps + (map code-vect .refs-map)))))
              b/se-nop)))))

(extend-type ast/definition-ast
  CodeGen
  (pre-gen [ast]
    (se/state-error ast))

  (gen-code [ast]
    (let [[expr] (.value-exprs ast)]
      (for [init (se/get-val .init)
            _ (se/update-val .glbl-init
                             (fn [glbl-init]
                               (let [add-global (either (= (.var expr) "")
                                                        [;; keep track of the dynamically created
                                                         ;; global values so they can be freed
                                                         ;; "globals = listCons("
                                                         ;; (.var code) ", globals);\n"
                                                         ])]
                                 (conj glbl-init
                                       (either (empty? init)
                                               [init add-global])))))
            _ (se/set-val .init [])
            _ (se/update-val .decl
                             (fn [decl]
                               ;; TODO: there used to be a problem with multiple 'cond' clauses
                               (cond (empty? init)
                                     ["// " (str (ast/location ast) "\n")
                                      decl]

                                     (cond (= (.var expr) "")
                                           decl

                                           ["Port " (.var expr) ";\n"
                                            decl]))))]
        ast))))

(extend-type ast/integer-ast
  CodeGen
  (gen-code [ast]
    (print-err 'boom _FILE_ _LINE_)
    (abort)
    (se/state-error
     (.var empty-c-code (str "new_num_(new_i24_(" (.int ast) "))")))
    ;; TODO: remove this after we know the above works
    ;; (let [num (.int ast)
    ;;       num-ptr (.var ast)]
    ;;   (se/state-error
    ;;     (-> empty-c-code
    ;;         (.decl ["Port " num-ptr " = new_num_(new_i24_(" num "));\n"])
    ;;         (.var num-ptr))))
    ))

(extend-type ast/string-ast
  CodeGen
  (gen-code [ast]
    (let [str-val (.string ast)
          str-len (count str-val)
          str-ptr (.var ast)]
      (comp (map (se/get-in-val [.constants .strings str-val])
                 (fn [_]
                   ast))
            (for [const-strs (se/get-in-val [.constants .strings])
                  :let [str-idx (count const-strs)
                        str-sym (str "str" str-idx)]
                  _ (se/assoc-in-val [.constants .strings str-val]
                                     (-> empty-c-code
                                         ;; (.init [str-ptr " = new_port_(VAL, (Port)&" str-sym ");\n"])
                                         (.var str-ptr)))
                  _ (se/update-in-val [.glbl-init]
                                      (fn [init]
                                        [init
                                         str-sym " = stringValue(\"" (escape-chars str-val)
                                         "\");" str-sym "->refs = refsConstant;\n"
                                         "globals = listCons(" str-sym ", globals);\n"
                                         str-ptr " = new_port(VAL, " str-sym ");\n"]))
                  _ (se/update-val .decl
                                   (fn [decl]
                                     [decl
                                      "Value *" str-sym ";\n"
                                      "Port " str-ptr ";\n"]))
                  ]
              ast)))))

(extend-type ast/call-ast
  CodeGen
  (pre-gen [ast]
    (se/state-error ast))
  
  (gen-code [ast]
    (map (gen-call (.call-target ast) (.args ast) mod (.var ast))
         (fn [_]
           ast))))

