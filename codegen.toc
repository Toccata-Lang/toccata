    ))

(def StaticOrDispatcher (any-of b/StaticArity
                                Dispatcher))

(extend-type ast/definition-ast
  CodeGen
  (gen-code [ast]
    (let [[expr] (.value-exprs ast)
          sym (.sym ast)]
      (cond (or (instance? c/TaggedSymbol expr)
                (instance? c/Constraints expr))
            (se/state-error ast)

            (for [init (se/update-val .init (fn [_] []))
                  _ (se/update-val .glbl-init (fn [glbl-init]
                                                (cond (empty? init)
                                                      glbl-init

                                                      (comp glbl-init ["{\n" init
                                                                       (.var expr) "= autoDupe(0, 1,"
                                                                       (.var expr) ");\n}\n"]))))
                  _ (cond (or (instance? b/StaticArity expr)
                              (instance? ast/integer-ast expr))
                          b/se-nop

                          (instance? ast/string-ast expr)
                          (cond (= (.var sym) (.var expr))
                                b/se-nop
                                (for [_ (se/update-val .decl (fn [decl]
                                                               [decl
                                                                "Term " (.var sym) ";\n"]))
                                      _ (se/update-val .glbl-init
                                                       (fn [init]
                                                         (comp init [(.var sym) " = " (.var expr) ";\n"])))]
                                  '_))

                          (se/update-val .decl (fn [decl]
                                                 [decl
                                                  (cond (= sym 'main)
                                                        "// main fn\n"
                                                        "")
                                                  "Term " (.var expr) ";\n"])))]
              ast)))))

(extend-type ast/declaration-ast
  CodeGen
  (gen-code [ast]
    (let [sym (.sym ast)]
      (b/status "declare " sym (.var sym))
      (for [_ (se/update-val .decl (fn [decl]
                                     [decl "Term " (.var sym) ";\n"]))]
        ast))))

(extend-type ast/integer-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/string-ast
  CodeGen
  (gen-code [ast]
    (let [str-val (.string ast)
          str-len (count str-val)
          str-ptr (.var ast)]
      (comp (map (se/get-in-val [.strings str-val])
                 (fn [var]
                   (.var ast var)))
            (for [const-strs (se/get-val .strings)
                  :let [str-idx (count const-strs)
                        str-sym (str "str" str-idx)]
                  _ (se/assoc-in-val [.strings str-val] str-ptr)
                  _ (se/update-val .decl
                                   (fn [decl]
                                     [decl
                                      "struct {TYPE_SIZE type;\n"
                                      "        REFS_SIZE refs;\n"
                                      "        int64_t *hash;\n"
                                      "        Value *parent;\n"
                                      "        int64_t len;\n"
                                      "        char buffer[" (inc (count str-val)) "];\n"
                                      "} " str-sym " = {StringBufferType, REFS_STATIC, 0, 0, "
                                      (count str-val) ", \"" (escape-chars str-val) "\"};\n"
                                      "Term " str-ptr " = term_new_(VAL, (Term)&"
                                      str-sym ");\n"]))]
              ast)))))

(extend-type ast/call-ast
  CodeGen
  (gen-code [ast]
    (let [tgt (.call-target ast)]
      (for [call-init (gen-call tgt ast)
            _ (se/update-val .init
                             (fn [init]
                               [init call-init]))]
        ast))))

(extend-type ast/prototype-ast
  CodeGen
  (gen-code [ast]
    (for [_ (se/update-val .decl (fn [decl]
                                   [decl "Term " (.var ast) ";\n"]))]
      ast))

  (gen-call [proto call-ast]
    (let [tgt (.call-target call-ast)
          result-var (.var call-ast)
          arg-vars (reverse (.args call-ast))
          loc (ast/location call-ast)]
      (either (map (first arg-vars)
                   (fn [last-arg]
                     (for [file-str (-> (.file loc)
                                        (str)
                                        (ast/string-ast loc (b/global-var 'Str)
                                                        c/string-constraint)
                                        gen-code)
                           last-arg (wrap-proto last-arg loc)
                           rest-args (se/traverse (rest arg-vars) (fn [arg]
                                                                    (wrap-proto arg loc)))]
                       ["// call " (either (or (instance? c/TaggedSymbol tgt)
                                               (get tgt .fn-sym))
                                           "")
                        " at " loc "\n"
                        (-> rest-args
                            (comp [(str "new_i60(" (.line loc) ")")
                                   (.var file-str)])
                            (reduce ["Term " result-var "Args = pair_make(APP, 0, " last-arg
                                     ", SUB);\n"
                                     (cond (b/is-glbl result-var)
                                           ""
                                           "Term ")
                                     result-var
                                     " = term_new(VAR, 0, port(2, term_loc(" result-var "Args)));\n"]
                                    (fn [args arg]
                                      (comp args
                                            [result-var "Args = pair_make(APP, 0, " arg
                                             ", " result-var "Args);\n"]))))
                        (cond (b/is-glbl (.var call-ast))
                              ["store_redex(" result-var "Args, " (.var tgt) ");\n"]

                              ["#ifdef STRICT\n"
                               "store_redex(" result-var "Args, " (.var tgt) ");\n"
                               "#else\n"
                               "swapStore(term_loc(" result-var
                               "), pair_make(LAZ, 0, " result-var "Args, " (.var tgt) "));\n"
                               "#endif\n"])])))
              (do
                (b/status "Call to prototype fn is invalid. Needs at least one argument.")
                (b/wait-for-err-out)
                (abort))))))

(extend-type ast/superposition-ast
  CodeGen
  (gen-code [ast]
    (let [alts (.alts ast)
          num-alts (count alts)]
      ;; TODO: instead of making this linearly, make it a binary tree of min depth.
      ;; looks like it saves 20% of the iters
      (map (se/update-val .init
                          (fn [init]
                            [init
                             (cond (b/is-glbl (.var ast))
                                   ""
                                   "Term ")
                             (either (map (first alts)
                                          (fn [first-alt]
                                            (-> (rest alts)
                                                (map .var)
                                                (reduce (str (.var ast) " = " (.var first-alt) ";\n")
                                                        (fn [args arg]
                                                          (str args
                                                               (.var ast) " = pair_make(SUP, "
                                                               (.label ast)
                                                               ", " arg ", " (.var ast) ");\n"))))))
                                     (str (.var ast) " = NUL;\n"))]))
           (fn [_]
             ast)))))

(extend-type ast/block-comment-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type b/ProtoArity
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(defn emit-proto [ptype]
  (assert (instance? ast/prototype-ast ptype))

  (let [c-fn (.c-fn ptype)]
    (se/update-val .decl
                   (fn [decl]
                     [decl
                      "Term " (.var ptype) ";\n"
                      "void " c-fn "(Term ref, Term args) {\n"
                      "  NativeArgs arityArgs = {0, {}};\n"
                      "  args = strictArgs(ref, args, 3, &arityArgs);\n"
                      "  if (arityArgs.count == 3) {\n"
                      "    String *fileStr = (String *)arityArgs.args[0];\n"
                      "    Value *dispVal = (Value *)arityArgs.args[2];\n"
                      "    swapStore(term_loc(args), (Term)dispVal);\n"
                      "    if (term_tag((Term)dispVal) == I60) {\n"
                      (either (map (get-in ptype [.impls c/IntegerType])
                                   (fn [impl-arity]
                                     ["store_redex(args, " (.var impl-arity) ");\n"]))
                              ["fprintf(stderr, \"No implementation of '" (.fn-name ptype)
                               "' found for integers called from %.*s: %ld\\n\", (int)fileStr->len,"
                               " fileStr->buffer, get_i60(arityArgs.args[1]));\n"
                               "BOOM(\"Dispatch failed\");\n"])
                      "} else {\n"
                      "switch(dispVal->type) {\n"
                      (-> (.impls ptype)
                          seq
                          (reduce [] (fn [cases [type-num impl-arity]]
                                       (cond (or (= 0 type-num)
                                                 (= c/IntegerType type-num))
                                             cases

                                             [cases
                                              "case " (str type-num) ":\n"
                                              "store_redex(args, " (.var impl-arity) ");\nbreak;\n"]))))
                      "default: {\n"
                      (either (map (get-in ptype [.impls c/UnknownType])
                                   (fn [def-arity]
                                     ["store_redex(args, " (.var def-arity) ");\n"]))
                              ["fprintf(stderr, \"No implementation of '" (.fn-name ptype)
                               "' found for type %s (%ld) called from %.*s: %ld\\n\", typeName(dispVal->type), "
                               "dispVal->type, (int)fileStr->len, fileStr->buffer, get_i60(arityArgs.args[1]));\n"
                               "BOOM(\"Dispatch failed\");\n"])
                      "}\n}\n}\n}\nreturn;\n}\n"
                      "Term " (.var ptype) " = new_ref(" c-fn ");\n"]))))

(defn emit-protos [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        protos (for [mod (vals mods)
                     [sym val] (either (map (get-in mod [.namespaces c/no-symbol .values 0])
                                        seq)
                                   [])
                     :when (instance? ast/prototype-ast val)]
                 val)
        emitter (for [_ (se/set-val .decl [])
                      _ (se/traverse protos (fn [val]
                                              (se/try
                                                (emit-proto val)
                                                (fn [err]
                                                  (b/status (.val err))
                                                  (b/wait-for-err-out)
                                                  (abort)))))
                      proto-decl (se/get-val .decl)
                      _ (se/set-val .decl [])]
                  (code-out proto-decl))]
    (let [[_ code-context] (emitter code-context)]
      code-context)))

(defn emit-ref-map [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        refs (for [mod (vals mods)
                   [sym val] (either (map (get-in mod [.namespaces c/no-symbol .values 0])
                                          seq)
                                     [])
                   :when (or (instance? b/StaticArity val)
                             (instance? ast/prototype-ast val)
                             (and (instance? ast/inline-ast val)
                                  (instance? c/fn-arity (.constraint val))))]
               [sym val])
        emitter (for [_ (se/set-val .decl ["unsigned refsCount = " (count refs) ";\n"
                                           "unsigned refNameCount = " (count refs) ";\n"
                                           "refMap refNames[" (+ 6 (count refs))
                                           "] = {"
                                           "{vectMap, \"vectMap\"},\n"
                                           "{vectConjFn, \"vectConj\"},\n"
                                           "{accessFieldFn, \"accessField\"},\n"
                                           "{hvmVectFn, \"hvmVect\"},\n"
                                           "{constructFn, \"construct\"}"])
                      _ (se/traverse refs (fn [[sym val]]
                                            (se/try
                                              (se/update-val .decl
                                                             (fn [decl]
                                                               [decl ",\n"
                                                                "{" (.c-fn val) ", \""
                                                                sym "\"}"]))
                                              (fn [err]
                                                (b/status (.val err))
                                                (b/wait-for-err-out)
                                                (abort)))))
                      _ (se/update-val .decl
                                       (fn [decl]
                                         [decl "};\n"]))
                      refs-decl (se/get-val .decl)
                      _ (se/set-val .decl [])]
                  (code-out refs-decl))]
    (let [[_ code-context] (emitter code-context)]
      code-context)))

(defn emit-type-map [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        types (for [mod (vals mods)
                   [sym constraint] (either (map (get-in mod [.namespaces c/no-symbol .types])
                                          seq)
                                            [])
                    :when (instance? c/ReifiedConstraint constraint)]
                [sym constraint])
        emitter (for [_ (se/set-val .decl ["typeNameMap typeNames[" (+ 10 (count types))
                                           "] = {{1, \"Integer\"},\n"
                                           "{2, \"String\"},\n"
                                           "{8, \"Vector\"},\n"
                                           "{9, \"VectorNode\"},\n"
                                           "{11, \"HashMap\"},\n"
                                           "{12, \"HashMap\"},\n"
                                           "{13, \"HashMap\"},\n"
                                           "{14, \"HashMap\"}\n"])
                      _ (se/traverse types (fn [[sym val]]
                                            (se/try
                                              (se/update-val .decl
                                                             (fn [decl]
                                                               [decl ",\n"
                                                                "{" (.type-number val) ", \""
                                                                sym "\"}"]))
                                              (fn [err]
                                                (b/status (.val err))
                                                (b/wait-for-err-out)
                                                (abort)))))
                      _ (se/update-val .decl
                                       (fn [decl]
                                         [decl "};\n"]))
                      types-decl (se/get-val .decl)
                      _ (se/set-val .decl [])]
                  (code-out types-decl))]
    (let [[_ code-context] (emitter code-context)]
      code-context)))

(defn emit-main [code-context done-promise main-module]
  (let [main-fn (either (get-in main-module [.namespaces c/no-symbol .values 0
                                             ast/main .c-fn])
                        (do
                          (b/status "'main' function is missing or malformed")
                          ;; TODO: make sure to abort
                          ;; (abort)
                          ))
        code-context (emit-protos code-context)
        code-context (emit-ref-map code-context)
        code-context (emit-type-map code-context)
        mod-prom (promise)
        _ (send b/modules (fn [mods]
                            (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)
        dyn-glbls (flat-map (vals mods) .glbl-exprs)]
    (cond (instance? se/Error code-context)
          (do
            (b/status (.val code-context))
            (b/wait-for-err-out)
            (abort)) 

          (code-out "void normGlobals(){\n"
                    "Term apps, lams, V;\n"
                    "Location vLoc;\n"
                    (.glbl-init code-context)
                    (cond (first dyn-glbls)
                          "  normalize(NULL);\n"
                          "")
                    "}\n"
                    "void freeGlobals(){\n"
                    (map dyn-glbls
                         (fn [var]
                           (str "  freeGlobal(" var ");\n")))
                    (cond (first dyn-glbls)
                          "  normalize(NULL);\n"
                          "")
                    "  check_buff();\n"
                    "}\n"

                    "Term mainFn = new_ref(" main-fn ");\n"
                    "int typeCount = " (extract b/type-counter) ";\n"))
    (deliver done-promise 'done)
    code-context))

(def core-dispatchers (-> [(c/tag 'type-name) 1 "type_name"
                           (c/tag 'zero) 1 "zero"
                           (c/tag 'invoke) 1 "invoke0Args"
                           (c/tag 'invoke) 2 "invoke1Arg"
                           (c/tag 'invoke) 3 "invoke2Args"
                           (c/tag '=*) 2 "equalSTAR"
                           (c/tag 'hash-seq) 2 "hashSeq"
                           (c/tag 'count) 1 "count"
                           (c/tag 'vals) 1 "vals"
                           (c/tag 'first) 1 "first"
                           (c/tag 'rest) 1 "rest"
                           (c/tag 'seq) 1 "seq"
                           (c/tag 'sha1) 1 "sha1"
                           (c/tag 'has-field) 2 "hasField"
                           (c/tag 'show) 1 "showFn"
                           (c/tag 'new-hash-set) 1 "newHashSet"
                           (c/tag 'apply) 2 "fn_apply"
                           (c/tag 'pr-value) 1 "prValue"]
                          (partition 3)))

(defn fixup-core-dispatchers [code-context core-mod]
  (map core-dispatchers
       (fn [[sym arg-count var]]
         (let [arity-var (either ;; (get-in core-mod [.namespaces c/no-symbol .values 0
                                 ;;                   sym .arities 0 .var])
                                  nothing

                                 ;; TODO: abort with message instead
                                 (str "noImpl" arg-count))]
           (code-out "Value *(*" var ")(FnArity *, "
                     (-> (repeat arg-count "Value *")
                         (interpose ","))
                     ") = " arity-var ";\n"))))
  code-context)

