(defn emit-protos [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                          (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)]
    (-> (for [mod (vals mods)
              val (either (map (get-in mod [.namespaces c/no-symbol .values 0])
                               vals)
                          [])
              :when (instance? c/ProtoImpls (.constraint val))]
          val)
        (se/traverse (fn [val]
                       (se/try
                         (for [code (gen-code val)
                               _ (se/update-val .init (fn [init]
                                                        (conj init (.init code))))]
                           (code-out (.decl code)))
                         (fn [err]
                           (b/status (.val err))
                           (b/wait-for-err-out)
                           (abort)))))
        ((fn [emitter]
           (let [[_ code-context] (emitter code-context)]
             code-context))))))

(defn dynamic-globals [code-context]
  (let [mod-prom (promise)
        _ (send b/modules (fn [mods]
                          (deliver mod-prom mods)
                            mods))
        mods (extract mod-prom)]
    (for [mod (vals mods)
          val (either (map (get-in mod [.namespaces c/no-symbol .values 0])
                           vals)
                      [])
          :when-not (or (instance? c/TaggedSymbol val)
                        (instance? b/StaticArity val)
                        (instance? ast/string-ast val)
                        (instance? ast/integer-ast val)
                        (instance? c/ProtoImpls (.constraint val)))]
      (str "  link(tm, " (.var val) ", erase);" line-sep))))

(defn emit-main [code-context done-promise main-module]
  (let [main-fn (either (get-in main-module [.namespaces c/no-symbol .values 0
                                             ast/main .c-fn])
                        (do
                          (b/status "'main' function is missing or malformed")
                          ;; TODO: make sure to abort
                          ;; (abort)
                          ))
        code-context (emit-protos code-context)]
    (cond (instance? se/Error code-context)
          (do
            (b/status (.val code-context))
            (b/wait-for-err-out)
            (abort)) 

          (code-out "void normalizeGlobals(TM *tm){\n"
                    (dynamic-globals code-context)
                    "  normalize();\n"
                    "}\n"
                    "  \nint main (int argc, char **argv) {\n"
                    "  prErrSTAR = &defaultPrErrSTAR;\n"
                    "  #ifdef SINGLE_THREADED\n"
                    "  #ifdef CHECK_MEM_LEAK\n"
                    "  fprintf(stderr, \"Cannot use SINGLE_THREADED (or TOCCATA_WASM) and CHECK_MEM_LEAK "
                    "  at same time.\");\n "
                    "  abort();\n"
                    "  #endif\n"
                    "  #endif\n"
                    ;; "  maybeNothing = maybe((FnArity *)0, (Value *)0, nothing);\n"
                    ;; "  maybeNothing->refs = -1;\n"
                    "  outstream = stdout;\n"
                    "  alloc_static_tms();\n"
                    "  globalNet = malloc(sizeof(Net));\n"
                    "  net_init();\n"
                    "  u64 start = time64();\n"
                    "  TM *tm = tms[0];\n"
                    "  Port callArgs, n0;\n"
                    (.glbl-init code-context)
                    "  normalize();\n"
                    "  Vector *argVect = empty_vect;\n"
                    "  for(int i = 0; i < argc; i++) {\n"
                    "    argVect = mutateVectConj(argVect, stringValue(argv[i]));\n"
                    "  }\n"
                    ;; "  argVect->refs = -1;\n"

                    "  APort resultVar;\n"
                    "  vars_create((Port)&resultVar, FREE);\n"
                    "  int bashResult = 0;\n"
                    "  Value *the_final_answer = nothing;\n"
                    "  NativeArgs natives;\n"
                    "  natives.count = 2;\n"
                    "  natives.args[0] = new_port(VAL, (Port)argVect);\n"
                    "  natives.args[1] = new_port(ARG, (Port)0);\n"
                    "  natives.result = (Port)&resultVar;\n"
                    "  link(tm, new_ref(" main-fn "), argsNet(tm, &natives));\n"
                    "  normalize();\n"
                    "  normalizeGlobals(tm);\n"
                    "  double duration = (time64() - start) / 1000000000.0; // seconds\n"
                    "  u64 itrs = atomic_load(&globalNet->itrs);\n"
                    "  printf(\"- ITRS: %\" PRIu64 \"\\n\", itrs);\n"
                    "  printf(\"- TIME: %.2fs\\n\", duration);\n"
                    "  printf(\"- MIPS: %.2f\\n\", (double)itrs / duration / 1000000.0);\n"
                    "  Port result = vars_load((Port)&resultVar);\n"
                    "  if (get_tag(result) == NUM) {\n"
                    "  bashResult = (int)get_u24(get_val(result));\n"
                    "  } else if (get_tag(result) == VAL ) {\n"
                    "  the_final_answer = (Value *)(result & ~TAG_MASK);\n"
                    "  }\n"
                    "  free_static_tms();\n"
                    "  free(globalNet);\n"

                    "#ifdef CHECK_MEM_LEAK\n"
                    "cleaningUp = 1;\n"
                    "mainThreadDone = 1;\n"
                    "waitForWorkers();\n"
                    ;; TODO: change to argVect
                    ;; "for(List *l = argVect; l != (List *)0; l = l->tail) {\n"
                    ;; "   l->refs = 1;\n"
                    ;; "}\n"
                    ;; TODO: casting argVect to List * is a temp hack

                    ;; "  cleanupMemory(the_final_answer, maybeNothing, (List *)argVect);\n"
                    "  cleanupMemory(the_final_answer, (Value *)NULL, (List *)NULL);\n"

                    "  if (malloc_count - free_count != 0)\n"
                    "    return(1);\n"
                    "#endif\n"
                    "  printf(\"bashResult: %d\\n\", bashResult);\n"
                    "  return(bashResult);\n}\n"
                    "\nint typeCount = " (extract b/type-counter) ";\n"))
    (deliver done-promise 'done)
    code-context))

(def core-dispatchers (-> [(c/tag 'type-name) 1 "type_name"
                           (c/tag 'zero) 1 "zero"
                           (c/tag 'invoke) 1 "invoke0Args"
                           (c/tag 'invoke) 2 "invoke1Arg"
                           (c/tag 'invoke) 3 "invoke2Args"
                           (c/tag '=*) 2 "equalSTAR"
                           (c/tag 'hash-seq) 2 "hashSeq"
                           (c/tag 'count) 1 "count"
                           (c/tag 'vals) 1 "vals"
                           (c/tag 'first) 1 "first"
                           (c/tag 'rest) 1 "rest"
                           (c/tag 'seq) 1 "seq"
                           (c/tag 'sha1) 1 "sha1"
                           (c/tag 'has-field) 2 "hasField"
                           (c/tag 'show) 1 "showFn"
                           (c/tag 'new-hash-set) 1 "newHashSet"
                           (c/tag 'apply) 2 "fn_apply"
                           (c/tag 'pr-value) 1 "prValue"]
                          (partition 3)))

(defn fixup-core-dispatchers [code-context core-mod]
  (map core-dispatchers
       (fn [[sym arg-count var]]
         (let [arity-var (either (get-in core-mod [.namespaces c/no-symbol .values 0
                                                   sym .arities 0 .var])
                                 ;; TODO: abort with message instead
                                 (str "noImpl" arg-count))]
           (code-out "Value *(*" var ")(FnArity *, "
                     (-> (repeat arg-count "Value *")
                         (interpose ","))
                     ") = " arity-var ";\n"))))
  code-context)

