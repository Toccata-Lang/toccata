(extend-type c/NoSymbol
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type b/TaggedParam
  CodeGen
  (gen-code [ast]
    (se/state-error (.sym ast))))

(defn get-value [sym]
  (assert (instance? c/TaggedSymbol sym))

  (cond (= (str sym) "")
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (= sym c/no-symbol)
        (do
          (print-err 'compiler-error _LINE_)
          (se/state-error c/top-type))

        (comp (comp (se/get-in-val [.module .namespaces (.ns sym) .values 0 sym])
                    (se/get-in-val [.module .namespaces b/core .values 0 sym]))
              (b/compilation-error "Undefined symbol:" (str "'" sym "'") "at" (ast/location sym)))))


(extend-type c/TaggedSymbol
  CodeGen
  (gen-code [ast]
    (let [var (.var ast)]
      (comp (for [refs (se/update-in-val [.refs-map var] inc)
                  :let [dupe-var (str var "_" refs)]
                  _ (se/update-val .init
                                   (fn [init]
                                     ["\nPort " dupe-var " = vars_alloc(tm);\n"
                                      var " = dupeArg(tm, " var, ", " dupe-var ");\n"
                                      init]))]
              (.var ast dupe-var))
            (cond (b/is-glbl var)
                  (flat-map (get-value ast)
                            (fn [val]
                              (cond (or (instance? b/StaticArity val)
                                        (instance? ast/integer-ast val))
                                    (se/state-error ast)

                                    (for [_ (se/assoc-in-val [.refs-map var] 2)
                                          :let [dupe-var (str var "_" 1)]
                                          _ (se/update-val .init
                                                           (fn [init]
                                                             ["\nPort " dupe-var
                                                              " = vars_alloc(tm);\n"
                                                              var " = dupeArg(tm, " var, ", "
                                                              dupe-var ");\n"
                                                              init]))]
                                      (.var ast dupe-var)))))
                  (for [_ (se/assoc-in-val [.refs-map var] 1)]
                    ast))))))

(extend-type ast/inline-ast
  CodeGen
  (gen-code [x]
    (map (cond (= (.var x) "")
               (se/update-val .init (fn [init]
                                      [init (.txt x)]))

               (se/update-val .decl (fn [decl]
                                      ["Port " (.var x) " = " (.txt x) ";\n"])))
         (fn [_]
           x)))

  (gen-code [x arity]
    (gen-code x)))

(defn destruct-params [params]
  (for [_ (cata (fn [ast]
                  (cond (instance? ast/params-ast ast)
                        (se/update-val .init
                                       (fn [init]
                                         ["// params at " (ast/location params) "\n"
                                          "Port " (.var ast) ";" line-sep
                                          (-> (reverse (.fixed ast))
                                              (map .var)
                                              (reduce (str (.var ast) " = new_port(ARG, 0);" line-sep)
                                                      (fn [args arg]
                                                        (str args
                                                             (.var ast)
                                                             " = node_make(tm, ARG, " arg
                                                             ", " (.var ast) ");" line-sep))))
                                          init]))

                        (se/state-error ast)))
                params se/state-error)
        rm (se/get-val .refs-map)
        _ (se/update-val .init
                         (fn [init]
                           ["// allocate args at " (ast/location params) "\n"
                            (cata (fn [ast]
                                    (cond (instance? c/TaggedSymbol ast)
                                          (either (map (get rm (.var ast))
                                                       (fn [_]
                                                         [(str "Port " (.var ast)
                                                               " = vars_alloc(tm);\n")]))
                                                  
                                                  (str "Port " (.var ast) " = erase;\n"))

                                          (instance? ast/params-ast ast)
                                          (.fixed ast)

                                          ""))
                                  params)
                            init]))]
    '_))

