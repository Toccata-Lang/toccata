(defn name-natives [params]
  [(reduce (zip-lists (range (count (.fixed params)))
                      (.fixed params))
           []
           (fn [args [idx arg]]
             (conj args (str "  Term " (.var arg)
                             " = arityArgs.args[" idx "];\n"))))])

(extend-type ast/params-ast
  CodeGen
  ;; (pre-gen [ast]
  ;;   (se/state-error (cata (fn [p]
  ;;                           (cond (instance? c/TaggedSymbol p)
  ;;                                 (b/TaggedParam p)

  ;;                                 p))
  ;;                         ast)))

  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/fn-arity-ast
  CodeGen
  (gen-code [ast]
    (let [params (.params ast)
          body (remove (.body ast) (fn [expr]
                                     (instance? ast/block-comment-ast expr)))]
      (either (map (last body)
                   (fn [last-ast]
                     (let [last-v (.var last-ast)]
                       (cond (instance? ast/inline-ast last-ast)
                             (se/state-error ast)

                             (for [_ (destruct-params params)
                                   _ (se/update-val
                                      .init
                                      (fn [init]
                                        [init
                                         "  // cause all internal expressions to be reduced\n"
                                         (map (butlast body)
                                              (fn [expr]
                                                (let [v (.var expr)]
                                                  (cond (= v last-v)
                                                        ""

                                                        (b/is-Rslt v)
                                                        ["  move(term_loc(" v "), ERA);\n"]

                                                        (do
                                                          (print-err 'BOOMITY _FILE_ _LINE_)
                                                          "")))))
                                         "  // link args to body\n"
                                         (cond (instance? ast/integer-ast last-ast)
                                               ["Term " (.var params) " = new_i56(" (.int last-ast)
                                                ");\n"]

                                               (b/is-glbl last-v)
                                               ["  Term " (.var params) " = " last-v ";\n"]

                                               [;; move 'resultVar' to the location holding the SUB
                                                ;; which triggers this function being reduced
                                                "  move(term_loc(" last-v "), SUB);\n"
                                                "  Term " (.var params) " = " last-v ";\n"])
                                         (cond (empty? (.fixed params))
                                               ["  " (.var params) " = pair_make(LAM, ERA, "
                                                (.var params) ");\n"]
                                               (map (.fixed params)
                                                    (fn [param]
                                                      ["  " (.var params) " = pair_make(LAM, "
                                                       (.var param) ", " (.var params) ");\n"])))]))]
                               (.var ast (.var params)))))))
              (b/compilation-error "Invalid function body at:" (ast/location ast))))))

(extend-type b/StaticArity
  CodeGen
  (gen-code [ast]
    (let [c-fn (.c-fn ast)
          params (-> ast .arity .params)
          arity-var (b/global-var 'Arity)
          arity-struct-var (.var (.arity ast))
          last-ast (-> ast .arity .body last extract)
          inline? (instance? ast/inline-ast last-ast)
          ;; checker (checking-fn (-> ast .arity .params) c-fn)
          ]
      (for [init (se/get-val .init)
            _ (se/set-val .init [])
            _ (se/update-val .decl
                             (fn [decl]
                               [decl
                                "Term " (.var ast) ";" line-sep
                                "bool " c-fn "(Term ref, Term args) {\n"
                                (cond inline?
                                      ["  Term result = NUL;\n"
                                       "  NativeArgs arityArgs = {0, {}};\n"
                                       "  args = strictArgs(ref, args, " (count (.fixed params))
                                       ", &arityArgs);\n"
                                       "  if (arityArgs.count == " (count (.fixed params))
                                       ") {\n"
                                       (name-natives params)]

                                      ["  Term callArgs;\n"])
                                init
                                (cond inline?
                                      ["\n    move(port(2, term_loc(args)), result);\n  }\n"
                                       "  return TRUE;\n}\n"
                                       "Term " (.var ast) " = new_ref(" c-fn ");\n"]

                                      ["  link(args, " (.var params) ");\n"
                                       "  return TRUE;\n}\n"
                                       "Term " (.var ast) " = new_ref(" c-fn ");\n"])]))]
        ast)))

  (gen-call [sym call-ast]
    (generic-call call-ast)))

