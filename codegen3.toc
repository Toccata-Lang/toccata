(def StaticOrDispatcher (any-of b/StaticArity
                                Dispatcher))

(extend-type ast/definition-ast
  CodeGen
  (gen-code [ast]
    (let [[expr] (.value-exprs ast)
          sym (.sym ast)]
      (cond (or (instance? c/TaggedSymbol expr)
                (instance? c/Constraints expr))
            (se/state-error ast)

            (for [init (se/update-val .init (fn [_] []))
                  _ (se/update-val .glbl-init (fn [glbl-init]
                                                [glbl-init init]))
                  _ (cond (or (instance? b/StaticArity expr)
                              (instance? ast/string-ast expr)
                              (instance? ast/inline-ast expr)
                              (instance? ast/integer-ast expr))
                          b/se-nop

                          (= sym 'main)
                          (se/update-val .decl (fn [decl]
                                                 [decl "// main fn\n"]))

                          (se/update-val .decl (fn [decl]
                                                 [decl
                                                  "Term " (.var expr) "; // global val "
                                                  sym "\n"])))]
              ast)))))

(extend-type ast/integer-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

(extend-type ast/string-ast
  CodeGen
  (gen-code [ast]
    (let [str-val (.string ast)
          str-len (count str-val)
          str-ptr (.var ast)]
      (comp (map (se/get-in-val [.strings str-val])
                 (fn [var]
                   (.var ast var)))
            (for [const-strs (se/get-val .strings)
                  :let [str-idx (count const-strs)
                        str-sym (str "str" str-idx)]
                  _ (se/assoc-in-val [.strings str-val] str-ptr)
                  _ (se/update-val .decl
                                   (fn [decl]
                                     [decl
                                      "struct {TYPE_SIZE type;\n"
                                      "        REFS_SIZE refs;\n"
                                      "        int64_t *hash;\n"
                                      "        int64_t len;\n"
                                      "        char buffer[" (inc (count str-val)) "];\n"
                                      "} " str-sym " = {StringBufferType, REFS_STATIC, 0, "
                                      (count str-val) ", \"" (escape-chars str-val) "\"};\n"
                                      "Term " str-ptr " = (Term)&" str-sym ";\n"]))]
              ast)))))

(extend-type ast/call-ast
  CodeGen
  (gen-code [ast]
    (let [tgt (.call-target ast)]
      (for [call-init (gen-call tgt ast)
            _ (se/update-val .init
                             (fn [init]
                               [init call-init]))]
        ast))))

(extend-type ast/prototype-ast
  CodeGen
  (gen-code [ast]
    (for [_ (se/update-val .decl (fn [decl]
                                   [decl "Term " (.var ast) ";\n"]))]
      ast))

  (gen-call [proto call-ast]
    (let [tgt (.call-target call-ast)
          args (.args call-ast)
          result-var (.var call-ast)
          num-args (count args)
          loc (ast/location call-ast)]
      (for [file-str (-> (.file loc)
                         (str)
                         (ast/string-ast loc (b/global-var 'Str)
                                         c/string-constraint)
                         gen-code)]
        ["  // call " (either (or (instance? c/TaggedSymbol tgt)
                                (get tgt .fn-sym))
                            "")
         " at " (ast/location args) "\n"
         (cond (b/is-glbl (.var call-ast))
               ""
               "Term ")
         (.var call-ast) " = vars_alloc();" line-sep
         (-> args
             (map .var)
             (reverse)
             (comp [(str "new_num_(new_i24_(" (.line loc) "))")
                    (.var file-str) (.var call-ast)])
             (reduce (str "  callArgs = APP;" line-sep)
                     (fn [args arg]
                       (str args
                            "  callArgs = pair_make(ARG, " arg
                            ", callArgs);" line-sep))))
         (cond (b/is-glbl (.var call-ast))
               ["link(" (.var tgt) ", callArgs);"]

               ["vars_create(" (.var call-ast) ", node_make(SUB, "
                (.var tgt) ", callArgs));"])
         line-sep]))))

(extend-type ast/superposition-ast
  CodeGen
  (gen-code [ast]
    (let [alts (.alts ast)
          num-alts (count alts)]
      ;; TODO: instead of making this linearly, make it a binary tree of min depth.
      ;; looks like it saves 20% of the iters
      (map (se/update-val .init
                          (fn [init]
                            [init
                             (cond (b/is-glbl (.var ast))
                                   ""
                                   "Term ")
                             (-> alts
                                 (map .var)
                                 (reduce (str (.var ast) " = erase;\n")
                                         (fn [args arg]
                                           (str args
                                                (.var ast) " = node_make(CON, "
                                                arg ", " (.var ast) ");\n"))))]))
           (fn [_]
             ast)))))

(extend-type ast/block-comment-ast
  CodeGen
  (gen-code [ast]
    (se/state-error ast)))

