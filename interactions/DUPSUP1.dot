graph DUP_SUP1 {
rankdir=TB;

subgraph cluster_before_DUP_SUP1 {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a15_1 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
b15_1 [label="b", height=0.4, width=0.4, fixedsize=true, shape=none]
dup15_1 [label="D", xlabel="n",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a15_1:s -- dup15_1:nw
b15_1:s -- dup15_1:ne
sup15_1 [label="S", xlabel="n", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x15_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y15_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup15_1:s -- sup15_1:n
sup15_1:sw -- x15_1:n
sup15_1:se -- y15_1:n
}

subgraph cluster_after_DUP_SUP1 {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a15_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b15_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
x15_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y15_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a15_2:s -- x15_2:n
b15_2:s -- y15_2:n
}
}
