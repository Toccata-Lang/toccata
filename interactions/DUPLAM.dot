graph DUP_LAM {
rankdir=TB;

subgraph cluster_before_DUP_LAM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a14_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b14_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup14 [label="D",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a14_1:s -- dup14:nw
b14_1:s -- dup14:ne
lam14 [label="L",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x14_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y14_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup14:s -- lam14:n
lam14:sw -- x14_1:n
lam14:se -- y14_1:n
}

subgraph cluster_after_DUP_LAM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a14_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b14_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
lam14_2 [label="L",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
lam14_3 [label="L",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup14_2 [label="D",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
laz14_2 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
sup14_2 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
x14_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y14_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a14_2:s -- lam14_2:n
b14_2:s -- lam14_3:n
lam14_2:sw -- sup14_2:nw
lam14_3:sw -- sup14_2:ne
laz14_2:se -- y14_2:n
laz14_2:sw -- dup14_2:n
lam14_2:se -- laz14_2:n
lam14_3:se -- laz14_2:n
sup14_2:s -- x14_2:n
}
}
