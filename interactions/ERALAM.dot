graph ERA_LAM {
rankdir=TB;

subgraph cluster_before_ERA_LAM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
era2_1 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
lam2 [label="L",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x2_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y2_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
era2_1:s -- lam2:n
lam2:sw -- x2_1:n
lam2:se -- y2_1:n
}

subgraph cluster_after_ERA_LAM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
era2_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
nul2_2 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
x2_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y2_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
era2_2:s -- x2_2:n
nul2_2:s -- y2_2:n
}
}
