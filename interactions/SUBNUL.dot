graph SUB_NUL {
rankdir=TB;

subgraph cluster_before_SUB_NUL {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a4_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b4_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
sub4 [label="",  height=0.2, width=0.2, fixedsize=true,  shape=circle, orientation=180]
a4_1:s -- sub4:nw
b4_1:s -- sub4:ne
nul4_1 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
sub4:s -- nul4_1:n
}

subgraph cluster_after_SUB_NUL {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a4_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b4_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
nul4_2 [label="NUL",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
era4_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a4_2:s -- nul4_2:n
b4_2:s -- era4_2:n
}
}
