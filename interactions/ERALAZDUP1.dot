graph ERA_LAZ_DUP1 {
rankdir=TB;

subgraph cluster_before_ERA_LAZ_DUP1 {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
era17_1 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
a17_1 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
laz17_1 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup17_1 [label="D", xlabel="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x17_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
era17_1:s -- laz17_1:n
a17_1:s -- laz17_1:n
laz17_1:sw -- dup17_1:n
laz17_1:se -- x17_1:n
}

subgraph cluster_after_ERA_LAZ_DUP1 {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a17_2 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
x17_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
a17_2 -- x17_2:n
}
}
