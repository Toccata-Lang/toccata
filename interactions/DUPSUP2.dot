graph DUP_SUP2 {
rankdir=TB;

subgraph cluster_before_DUP_SUP2 {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a16_1 [label="a", height=0.4, width=0.4, fixedsize=true, shape=none]
b16_1 [label="b", height=0.4, width=0.4, fixedsize=true, shape=none]
dup16_1 [label="D", xlabel="m",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
a16_1:s -- dup16_1:nw
b16_1:s -- dup16_1:ne
sup16_1 [label="S", xlabel="n", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x16_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y16_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
dup16_1:s -- sup16_1:n
sup16_1:sw -- x16_1:n
sup16_1:se -- y16_1:n
}

subgraph cluster_after_DUP_SUP2 {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a16_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b16_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
sup16_2 [label="S", xlabel="n", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
sup16_3 [label="S", xlabel="n", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup16_2 [label="D", xlabel="m", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
dup16_3 [label="D", xlabel="m", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
laz16_2 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
laz16_3 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x16_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y16_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a16_2:s -- sup16_2:n
b16_2:s -- sup16_3:n
laz16_2:se -- x16_2:n
laz16_2:sw -- dup16_2:n
sup16_2:sw -- laz16_2:n
sup16_3:sw -- laz16_2:n
laz16_3:se -- y16_2:n
laz16_3:sw -- dup16_3:n
sup16_2:se -- laz16_3:n
sup16_3:se -- laz16_3:n
}
}
