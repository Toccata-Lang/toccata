graph ERA_SUP {
rankdir=TB;

subgraph cluster_before_ERA_SUP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
era11_1 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
sup11 [label="S",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x11_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y11_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
era11_1:s -- sup11:n
sup11:sw -- x11_1:n
sup11:se -- y11_1:n
}

subgraph cluster_after_ERA_SUP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
era11_2 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
era11_3 [label="", height=0.1, width=0.1, color=black, fixedsize=true,  shape=circle, style=filled]
x11_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y11_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
era11_2:s -- x11_2:n
era11_3:s -- y11_2:n
}
}
