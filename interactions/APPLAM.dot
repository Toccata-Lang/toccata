graph APP_LAM {
rankdir=TB;

subgraph cluster_before_APP_LAM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a1_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b1_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
app1 [label="A",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
lam1 [label="L",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x1_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y1_1 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a1_1:s -- app1:nw
b1_1:s -- app1:ne
app1:s -- lam1:n
lam1:sw -- x1_1:n
lam1:se -- y1_1:n
}

subgraph cluster_after_APP_LAM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a1_2 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b1_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
x1_2 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
y1_2 [label="y",  height=0.4, width=0.4, fixedsize=true, shape=none]
a1_2:s -- x1_2:n
b1_2:s -- y1_2:n
}
}
