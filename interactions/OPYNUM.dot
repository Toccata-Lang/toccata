graph OPY_NUM {
rankdir=TB;

subgraph cluster_before_OPY_NUM {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a7_1 [label="#1",  height=0.4, width=0.4, fixedsize=true, shape=none]
b7_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
op7_1 [label="OPY",  height=0.5, width=0.5, fixedsize=true,  shape=none]
a7_1:s -- op7_1:nw
b7_1:s -- op7_1:ne
num7_1 [label="#2",  height=0.4, width=0.6, fixedsize=true, shape=plaintext]
op7_1:s -- num7_1:n
}

subgraph cluster_after_OPY_NUM {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
b7_2 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
num7_2 [label="#1 op #2",  height=0.4, width=1, fixedsize=true, shape=plaintext]
b7_2:s -- num7_2:n
}
}
