graph NEG_LAZ_DUP {
rankdir=TB;

subgraph cluster_before_NEG_LAZ_DUP {
graph [color=black, style=filled, fillcolor=white, label="Before", fontsize=12]
a18_1 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b18_1 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg18_1 [label="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=180]
c18_1 [label="c", height=0.4, width=0.4, fixedsize=true, shape=none]
laz18_1 [label="Z",  height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
a18_1:s -- neg18_1:nw
b18_1:s -- neg18_1:ne
neg18_1:s -- laz18_1:n
dup18_1 [label="D", xlabel="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x18_1 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
c18_1:s -- laz18_1:n
laz18_1:sw -- dup18_1:n
laz18_1:se -- x18_1:n
}

subgraph cluster_after_NEG_LAZ_DUP {
graph [color=black, style=filled, fillcolor=white, label="After", fontsize=12]
a18_3 [label="a",  height=0.4, width=0.4, fixedsize=true, shape=none]
b18_3 [label="b",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg18_3 [label="", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
neg18_4 [label="D", height=0.4, width=0.4, fixedsize=true,  shape=triangle, orientation=0]
x18_3 [label="x",  height=0.4, width=0.4, fixedsize=true, shape=none]
x18_3:s -- neg18_4:n
c18_3 [label="c",  height=0.4, width=0.4, fixedsize=true, shape=none]
neg18_4:sw -- c18_3:n
neg18_4:se -- neg18_3:n
neg18_3:sw -- a18_3:n
neg18_3:se -- b18_3:n
}
}
