
(def height 19)

(defn leaf [val n l]
  (l val))

(defn node [lft rgt n l]
  (n lft rgt))

(def make)
(defn make-node [h n]
  (node (make leaf make-node h (* 2 n))
        (make leaf make-node h (+ 1 (* 2 n)))))

;; (defn make [leaf make_node h n]
;;   (cond (int-= h 0)
;;         (leaf n)

;;         (make-node (- h 1) n)))

(defn make [leaf make_node h n]
  (inline "
    Term callArgs;
    int h = get_i60(h_3);
    int n = get_i60(n_4);
    if (h == 0) {
      callArgs = pair_make(APP, 0, n_4, SUB);
      result = term_new(VAR, 0, port(2, term_loc(callArgs)));
      store_redex(callArgs, leaf_1);
    } else {
      callArgs = pair_make(APP, 0, n_4, SUB);
      result = term_new(VAR, 0, port(2, term_loc(callArgs)));
      callArgs = pair_make(APP, 0, new_i60(h - 1), callArgs);
      store_redex(callArgs, make_node_2);
    }
"))

(def sum)
(defn sum-leaf [val]
  val)

(defn sum-node [lft rgt]
  (+ (sum lft) (sum rgt)))

(defn sum [t]
  (t sum-node sum-leaf))

(main [_]
  (sum (make leaf make-node height 0)))
