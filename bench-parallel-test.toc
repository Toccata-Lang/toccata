
(def height 10)

(defn leaf [val n l]
  (l val))

(defn node [lft rgt n l]
  (n lft rgt))

(def make)
(defn make-node [h n]
  (node (make h (* 2 n))
        (make h (+ 1 (* 2 n)))))

(defn make [h n]
  (cond (int-= h 0)
        (leaf n)

        (make-node (- h 1) n)))

(def sum)
(defn sum-leaf [val]
  val)

(defn sum-node [lft rgt]
  (+ (sum lft) (sum rgt)))

(defn sum [t]
  (t sum-node sum-leaf))

(main [_]
  (sum (make height 0)))
