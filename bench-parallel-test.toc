
(def height 20)
(def threads 2)

(defn leaf [val n l]
  (l val))

(defn node [lft rgt n l]
  (n lft rgt))

(def make)
(defn make-node [h n]
  (node (make leaf make-node h (* 2 n))
        (make leaf make-node h (+ 1 (* 2 n)))))

;; (defn make [leaf make_node h n]
;;   (cond (int-= h 0)
;;         (leaf n)

;;         (make-node (- h 1) n)))

(defn make [leaf make_node h n]
  (inline "
    Term callArgs;
    int h = get_i60(h_3);
    int n = get_i60(n_4);
    if (h == 0) {
      callArgs = pair_make(APP, 0, n_4, SUB);
      result = term_new(VAR, 0, port(2, term_loc(callArgs)));
      store_redex(callArgs, leaf_1);
    } else {
      callArgs = pair_make(APP, 0, n_4, SUB);
      result = term_new(VAR, 0, port(2, term_loc(callArgs)));
      callArgs = pair_make(APP, 0, new_i60(h - 1), callArgs);
      store_redex(callArgs, make_node_2);
    }
"))

(def sum)
(defn sum-leaf [val]
  val)

(defn sum-node [lft rgt]
  (+ (sum lft) (sum rgt)))

(defn sum [t]
  (t sum-node sum-leaf))

(defn sum-tree []
  (sum (make leaf make-node height 0))
  0)

(inline "
void *threadFn(void *x) {
printf(\"created\\n\");
  Location l = (Location)x;
  Term neg = take(port(1, l));
  Term pos = take(port(2, l));
  store_redex(neg, pos);
  normalize(NULL);
  take(port(2, term_loc(neg)));
printf(\"done\\n\");
  return NULL;
}
")

(defn sum-trees [sum-tree threads]
  (inline "
  threadCount = get_i60(threads_2);
  for (int i = 0; i < threadCount; i++) {
    Term callArgs = pair_make(APP, 0, NUL, SUB);
    Term rdx = pair_make(LAZ, 0, callArgs, sum_tree_1);
    pthread_create(&threads[i], NULL, threadFn, (void *)term_loc(rdx));
  }

  for (int i = 0; i < threadCount; i++) {
    pthread_join(threads[i], NULL);
  }
  
  result = new_i60(0);
"))

(main [_]
  (sum-trees sum-tree threads))
