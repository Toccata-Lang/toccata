;; fixture.toc - test fixture for toc-edit (tools/toc-edit).
;; Covers: a top-level comment, a comment inside a form, nested
;; exprs, a vector, a hash map, a string, a multi-line form, a
;; form immediately preceded by a header comment, and a defn
;; that is used by another top-level form (so deleting the defn
;; is a rejection case).

;; the square function
(defn square [x]
  (* x x))

;; a value computed from an earlier defn; deleting square
;; must be a rejection
(def squared (square 7))

;; a nested expression with a comment inside the form
(defn nested [x]
  ;; the inner value
  (let [y (+ x 1)]
    (* y x)))

;; data values
(def sample-vector [1 2 3])

(def sample-map {"a" 1 "b" 2})

(def sample-string "hello")

;; a multi-line form
(defn multi [x]
  (let [y (+ x 1)
        z (* x 2)]
    [y z]))

;; a form immediately preceded by this header comment
(def headered 42)
