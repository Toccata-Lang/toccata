

(deftype Location [file line]
  ! file String
  ! line WholeNumber
  )

(deftype Module [path]
  ! path String
  )

(deftype Constructor [name field-list implementations]
  ! name String
  ! field-list [String]
  ! implementations [Fn]
  )

(deftype Expression
    (String [ns name loc]
      ! ns String
      ! name (all-of String (min-count 1))
      ! loc Location
      )
    (IntegerLit [value loc]
      ! value Integer
      ! loc Location
      )
    (FloatLit [value loc]
      ! value Float
      ! loc Location
      )
    (StringLit [value loc]
      ! value String
      ! loc Location
      )
    (Call [operator operands]
      ! operator Expression
      ! operands [Expression]
      ) ; Function/macro calls, vectors, hash maps
    (Fn [name parameter-list body]
      ! name String
      ! parameter-list [String]
      ! body BodyExpressions
      ) ; Anonymous functions
    (Superposition [alternatives]
      ! alternatives [Expression]
      ) ; Superposition operator
    (TypeConstraint [symbol type-expr]) ; Type constraints
    (FieldGetter [field-name loc]
      ! field-name (all-of String (min-count 1))
      ! loc Location
      ) ; Field access

    (Match [expr cases default-case])
    (BlockComment [lines]
      ! lines [String]
      ))

;; (deftype BodyExpressions (any-of Inline
;;                                  (all-of [Expression]
;;                                          (min-count 1))))

(deftype TopLevel
    (Definition [name expressions]
      ! name String
      ! expressions BodyExpressions
      ) ; All definitions
    (DefType [type-name constructors]
      ! type-name String
      ! constructors [Constructors]
      ) ; Type definitions
    (Defp [name parameter-list body]
      ! name String
      ! parameter-list [String]
      ! body BodyExpressions
      ) ; Prototype functions
    (ExtendType [type-name methods]
      ! type-name String
      ! methods [Fn]
      ) ; Type extensions
    (AddNs [namespace module-path]
      ! namespace String
      ! module-path Module
      ) ; Namespace additions with embedded Module
    (Inline [c-code]
      ! c-code StringLiteral
      ) ; Inline C code
    BlockComment)
