(deftype TopLevel
    (Definition [name expressions]
      ! name Symbol
      ! expressions BodyExpressions) ; All definitions
    (DefType [type-name constructors]
      ! type-name Symbol
      ! constructors [Constructors]) ; Type definitions
    (Defp [name parameter-list body]
      ! name Symbol
      ! parameter-list [Symbol]
      ! body BodyExpressions) ; Prototype functions
    (ExtendType [type-name methods]
      ! type-name Symbol
      ! methods [Fn]) ; Type extensions
    (AddNs [namespace module-path]
      ! namespace Symbol
      ! module-path Module) ; Namespace additions with embedded Module
    (Inline [c-code]
      ! c-code StringLiteral) ; Inline C code
    BlockComment)

(deftype Expression
    (Symbol [ns name]
      ! ns String
      ! name (all-of String
                     (min-length 1)))
    (IntegerLit [value]
      ! value Integer)
    (StringLit [value]
      ! value String)
    (Call [operator operands]
      ! operator Expression
      ! operands [Expression]) ; Function/macro calls, vectors, hash maps
    (Fn [name parameter-list body]
      ! name String
      ! parameter-list [Symbol]
      ! body BodyExpressions) ; Anonymous functions
    (Superposition [alternatives]
      ! alternatives [Expression]) ; Superposition operator
    (FieldGetter [field-name]
      ! field-name (all-of String
                           (min-length 1))) ; Field access
    (TypeConstraint [symbol type-expr]) ; Type constraints
    (Match [expr cases default-case])
    (BlockComment [lines]
      ! lines [String]))

(deftype Module [path]
  ! path String)

(deftype Constructor
    (Constructor [name field-list implementations]
      ! name Symbol
      ! field-list [Symbol]
      ! implementations [Fn]))

(deftype BodyExpressions (any-of Inline
                                 (all-of [Expression]
                                         (min-length 1))))
