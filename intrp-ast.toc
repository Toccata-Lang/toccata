(deftype TopLevelNode
    (Definition [name expressions]
      ! name Symbol
      ! expressions (all-of [ExpressionNode]
                           (min-length 1))) ; All definitions
    (DefType [type-name constructors]) ; Type definitions
    (Defp [name parameter-list body]
      ! body (all-of [ExpressionNode]
                     (min-length 1))) ; Prototype functions
    (ExtendType [type-name methods]) ; Type extensions
    (AddNs [namespace module-path]
      ! module-path Module) ; Namespace additions with embedded Module
    (Inline [c-code]
      ! c-code StringLiteral) ; Inline C code
    (Main [parameter-list body]
      ! body (all-of [ExpressionNode]
                     (min-length 1))) ; Prototype functions)
    BlockComment)

(deftype ExpressionNode
    (Number [value])
    (Symbol [name])
    (StringLiteral [value])
    (Call [operator operands]) ; Function/macro calls, vectors, hash maps
    (Fn [parameter-list body]
      ! body (all-of [ExpressionNode]
                     (min-length 1))) ; Anonymous functions
    (Superposition [alternatives]) ; Superposition operator
    (FieldGetter [field-name]) ; Field access
    (TypeConstraint [symbol type-expr]) ; Type constraints
    (Match [expr cases default-case])
    BlockComment)

(deftype BlockComment [lines]
  ! lines [String])

(deftype Module [path])

(deftype Constructor
    (Constructor [name field-list implementations]))

(deftype Implementation
    (Implementation [proto-fn parameter-list body]))
