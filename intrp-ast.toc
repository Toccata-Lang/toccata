

(deftype Location [file line]
  ! file String
  ! line WholeNumber
  )

(deftype Module [path]
  ! path String
  )

(deftype Constructor [name field-list implementations]
  ! name Symbol
  ! field-list [Symbol]
  ! implementations [Fn]
  )

;; (deftype BodyExpressions (any-of Inline
;;                                  (all-of [Expression]
;;                                          (min-length 1))))

(deftype Expression
    (Symbol [ns name loc]
      ! ns String
      ! name (all-of String (min-length 1))
      ! loc Location
      )
    (IntegerLit [value loc]
      ! value Integer
      ! loc Location
      )
    (FloatLit [value loc]
      ! value Float
      ! loc Location
      )
    (StringLit [value loc]
      ! value String
      ! loc Location
      )
    (Call [operator operands]
      ! operator Expression
      ! operands [Expression]
      ) ; Function/macro calls, vectors, hash maps
    (Fn [name parameter-list body]
      ! name String
      ! parameter-list [Symbol]
      ! body BodyExpressions
      ) ; Anonymous functions
    (Superposition [alternatives]
      ! alternatives [Expression]
      ) ; Superposition operator
    (TypeConstraint [symbol type-expr]) ; Type constraints
    (FieldGetter [field-name loc]
      ! field-name (all-of String (min-length 1))
      ! loc Location
      ) ; Field access

    (Match [expr cases default-case])
    (BlockComment [lines]
      ! lines [String]
      ))

(deftype TopLevel
    (Definition [name expressions]
      ! name Symbol
      ! expressions BodyExpressions
      ) ; All definitions
    (DefType [type-name constructors]
      ! type-name Symbol
      ! constructors [Constructors]
      ) ; Type definitions
    (Defp [name parameter-list body]
      ! name Symbol
      ! parameter-list [Symbol]
      ! body BodyExpressions
      ) ; Prototype functions
    (ExtendType [type-name methods]
      ! type-name Symbol
      ! methods [Fn]
      ) ; Type extensions
    (AddNs [namespace module-path]
      ! namespace Symbol
      ! module-path Module
      ) ; Namespace additions with embedded Module
    (Inline [c-code]
      ! c-code StringLiteral
      ) ; Inline C code
    BlockComment)
