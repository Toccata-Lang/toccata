(deftype TopLevelNode
    (Definition [kind name parameters body metadata]) ; All definitions
    (DefType [typeName constructors]) ; Type definitions
    (Defp [name parameters body]) ; Prototype functions
    (ExtendType [typeName methods]) ; Type extensions
    (AddNs [namespace modulePath]) ; Namespace additions with embedded Module
    (Inline [cCode]) ; Inline C code
    (Main [parameters body]) ; Main entry point)

(deftype ExpressionNode
    (Number [value])
    (Symbol [name])
    (StringLiteral [value])
    (Call [operator operands]) ; Function/macro calls, vectors, hash maps
    (Fn [parameters body]) ; Anonymous functions
    (Superposition [alternatives]) ; Superposition operator
    (FieldGetter [fieldName]) ; Field access
    (TypeConstraint [symbol typeExpr]) ; Type constraints
    (Match [expr cases defaultCase]) ; Pattern matching
    (Module [path]) ; Module inclusion (only valid within AddNs))

(deftype Constructor
    (Constructor [name fields implementations]))

(deftype Implementation
    (Implementation [protoFn parameters body]))
