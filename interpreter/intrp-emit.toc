;; interpreter/intrp-emit.toc — the parser emitter (library, no main).
;;
;; Takes the parser-combinator grammar data (intrp-grammar.toc) and
;; emits a recursive-descent parser module in Toccata source for it
;; (docs/parser-generator-plan.md).
;;
;; Item 3: skeleton + char-level emission — EmitCtx, the emit-pred
;; protocol (char-level ctors only; the default body aborts, and the
;; abort IS the char-level classification).
;;
;; Item 4: leaf body ctors + end-to-end pipeline — emit-body (the
;; leaf ctors), emit-ref, emit-fn, and emit-module (the full
;; generated module: header + kit + one parser defn per Rule + the
;; parse-seq loop + main template).
;;
;; Item 5: All + Ignore — the emit-body impls (the site-(c)
;; templates), the child-ref protocol (call-position expressions:
;; Rule -> name, bare String -> inlined let-free body, anonymous ->
;; the lifted helper name), and the lifted helper emission (walk-
;; children / child-lifted? / emit-helpers: each anonymous child
;; combinator gets a defn, sub-helpers first).
;;
;; Item 6: Any (parser-level) — the emit-body impl (the site-(a)
;; nested parse-or template; anonymous alts lifted to N-i helpers;
;; char-level Any via emit-pred unchanged), Any in walk-children,
;; and the main-template fix: parse-seq accumulates the OUTPUT STRING
;; in acc (pure dataflow — per-line pr* counts dropped by the error
;; path's exit were skipped by the lazy machine), printed once by
;; main on success or spliced into the exit message on error.
;;
;; Item 7a: Many slow path — the emit-many protocol (flipped
;; receiver: the receiver is the CHILD combinator; the default body
;; is the loop path), the site-(b) acc-recursion loop defn, the
;; emit-body impl for Many (the call expression only — the defn
;; comes from emit-many), the Many child-ref, Many in walk-children,
;; and the lifted-child-block dispatch (a lifted Many child is the
;; loop defn, every other lifted child the plain defn).
;;
;; Item 7b: Many fast path — the char-level emit-many impls
;; (CharRange, NotChar, bare String, Any classifying its alts, and
;; Rule/Many delegating per the ctor table): the <name>-char
;; set-predicate defn from the child's emit-pred + the read-run
;; wrapper (the Token -> ParserMatch wrap), and the call expression
;; (<name> state). alt-char-level? / all-alts-char-level? are the
;; alt-level char queries (a plain defn over type-name — the
;; flipped-receiver protocol stays the Many fast/slow
;; classification). The Many child-ref is path-aware: fast path ->
;; (name sv), loop path -> (name sv empty-vector).

(add-ns grammar (module "intrp-grammar.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; Forward declarations of the public entry (see the defn at the
;; bottom of the file) and the Any recursion (any-body-step calls
;; any-body-acc, defined after it).
(def emit-module)
(def any-body-acc)
(def lifted-child-block)
(def all-alts-char-level?)

;; Context threaded through every emit call:
;;   rule   — name of the rule currently being emitted ("" at top
;;            level); a Recur node renders as a call to this name.
;;   prefix — name prefix for generated helpers (the enclosing rule
;;            or helper name + "-").
(deftype EmitCtx [rule prefix])

;; escape-char: one char string -> its escaped 1- or 2-char form
;; (quote, backslash, and the control chars).
(defn escape-char [c]
  (cond (str= c "\\")
    "\\\\"

    (str= c "\"")
    "\\\""

    (str= c "\n")
    "\\n"

    (str= c "\r")
    "\\r"

    (str= c "\t")
    "\\t"

    (str= c "\f")
    "\\f"

    (str= c "\b")
    "\\b"

    c))

;; escape-str-acc: the escaped form of each char, collected in order
;; (explicit acc recursion, not a reduce — the reduce-capture leak).
(defn escape-str-acc [acc s]
  (cond (= (count s) 0)
    acc

    (escape-str-acc (vect-conj acc (escape-char (extract (first s))))
                    (rest s))))

;; escape-str: a string's body as the contents of a Toccata string
;; literal (quote, backslash, and the control chars escaped).
(defn escape-str [s]
  (to-str (escape-str-acc [] s)))

;; render-literal: a string as a Toccata string literal.
(defn render-literal [s]
  (to-str ["\"" (escape-str s) "\""]))

;; emit-pred: source of a single-char predicate expression over char
;; string `c`. Implemented ONLY for char-level ctors (CharRange,
;; NotChar, bare String, char-level Any, and Rule/Many delegating per
;; the ctor table); the default body aborts with a message naming the
;; ctor — calling it on a general parser is an emitter bug, and the
;; abort IS the char-level classification (no yes/no tag needed).
(defp emit-pred [pc ctx]
  (abort (to-str ["emit-pred: not char-level: " (type-name pc)])))

;; pred-alts: the emit-pred of each alt, joined with single spaces
;; (no trailing space). Explicit acc recursion — a reduce whose
;; closure captured ctx would hit the reduce-capture leak.
(defn pred-alts-acc [acc alts ctx]
  (cond (= (count alts) 0)
    acc
    (pred-alts-acc (to-str [acc " " (emit-pred (extract (first alts)) ctx)])
                   (rest alts) ctx)))

(defn pred-alts [alts ctx]
  (cond (= (count alts) 0)
    ""
    (pred-alts-acc (emit-pred (extract (first alts)) ctx) (rest alts) ctx)))

(extend-type grammar/CharRange (emit-pred [v ctx]
  (to-str ["(and (<= " (number-str (char-code (.lower v)))
         " (char-code c)) (<= (char-code c) "
         (number-str (char-code (.upper v))) "))"])))

(extend-type grammar/NotChar (emit-pred [v ctx]
  (to-str ["(not (str= c " (render-literal (.char v)) "))"])))

(extend-type String (emit-pred [v ctx]
  (to-str ["(str= c " (render-literal v) ")"])))

(extend-type grammar/Any (emit-pred [v ctx]
  (to-str ["(or " (pred-alts (.parsers v) ctx) ")"])))

;; Rule and Many delegate to their child (ctor table).
(extend-type grammar/Rule (emit-pred [v ctx]
  (emit-pred (.parser v) ctx)))

(extend-type grammar/Many (emit-pred [v ctx]
  (emit-pred (.parser v) ctx)))

;; --- Item 4: leaf body ctors + end-to-end pipeline ------------------
;;
;; Generated code references the helper layer with the rdr/ prefix —
;; a bare name resolving through an imported namespace crashes
;; new-toc's codegen (verified 2026-09-04, item 4).

;; emit-body: source lines for an expression which, given the
;; let-bound symbol `state`, yields a ParserResults. Item 4: the leaf
;; ctors (CharRange, NotChar, bare String, AlwaysSucceed, Error); the
;; default body aborts with a message naming the ctor. -> [String]
(defp emit-body [pc ctx]
  (abort (to-str ["emit-body: not implemented for: " (type-name pc)])))

;; one-char-body [pred-line]: the one-char parser body (ctor table):
;; let over input/c, cond over end-of-input / pred / unexpected char.
;; The defn's closing paren is appended by wrap-defn.
(defn one-char-body [pred-line]
  ["(let [input (.input state)"
   "      c (subs input 0 1)]"
   "  (cond (str= c \"\")"
   "    (rdr/ParserError \"unexpected end of input\" state)"
   pred-line
   "    (rdr/ParserMatch c (rdr/take-char state))"
   "    (rdr/ParserError \"unexpected character\" state)))"])

(extend-type grammar/CharRange (emit-body [v ctx]
  (one-char-body (to-str ["    " (emit-pred v ctx)]))))

(extend-type grammar/NotChar (emit-body [v ctx]
  (one-char-body (to-str ["    " (emit-pred v ctx)]))))

;; bare String: let-free (inlinable in a cond clause) — the ctor
;; table's str-prefix? shape.
(extend-type String (emit-body [v ctx]
  ["(cond (str-prefix? " (render-literal v) " (.input state))"
   "  (rdr/ParserMatch " (render-literal v) " (rdr/take-char state))"
   (to-str ["  (rdr/ParserError \"expected " (escape-str (render-literal v)) "\" state))"])]))

;; render-value: a grammar value as generated source — Strings as
;; escaped literals, everything else via to-str.
(defn render-value [v]
  (cond (str= (type-name v) "String")
    (render-literal v)

    (to-str [v])))

(extend-type grammar/AlwaysSucceed (emit-body [v ctx]
  [(to-str ["(rdr/ParserMatch " (render-value (.value v)) " state)"])]))

(extend-type grammar/Error (emit-body [v ctx]
  [(to-str ["(rdr/ParserError " (render-literal (.msg v)) " state)"])]))

;; emit-ref: how to reference this parser in call position. Rule ->
;; its name (the Rule's defn is emitted at module level); anonymous
;; combinators are never referenced directly (the parent lifts them
;; via emit-fn first) — the default aborts. -> String
(defp emit-ref [pc ctx]
  (abort (to-str ["emit-ref: not a Rule: " (type-name pc)])))

(extend-type grammar/Rule (emit-ref [v ctx]
  (.name v)))

;; wrap-defn-acc: indent the body lines two spaces under the defn
;; line; the last line gains the defn's closing paren.
(defn wrap-defn-acc [acc lines]
  (cond (= (count lines) 0)
    acc

    (let [l (extract (first lines))]
      (cond (= (count (rest lines)) 0)
        (vect-conj acc (to-str ["  " l ")"]))

        (wrap-defn-acc (vect-conj acc (to-str ["  " l])) (rest lines))))))

;; defn-line [name]: the defn's opening line. Built in its own defn —
;; the str* inline in a vector argument crashes new-toc's parser
;; (verified 2026-09-04, item 4 — see Inherited verified facts).
(defn defn-line [name]
  (to-str ["(defn " name " [state]"]))

;; wrap-defn [name lines]: (defn <name> [state] <indented body>).
(defn wrap-defn [name lines]
  (wrap-defn-acc [(defn-line name)] lines))

;; emit-fn: lift any combinator to a named parser fn (plain defn, no
;; protocol); the helper's prefix is its name + "-". -> [String]
(defn emit-fn [pc name ctx]
  (wrap-defn name
             (emit-body pc (EmitCtx (.rule ctx) (to-str [name "-"])))))

;; --- Item 5: All + Ignore -------------------------------------------

;; state-var [i]: the state variable for child i of an All / Ignore
;; body — "state" (the defn's param) for the first child, "s<i>"
;; thereafter.
(defn state-var [i]
  (cond (= i 0)
    "state"

    (to-str ["s" (number-str i)])))

;; spaces-acc [acc n]: a string of n spaces.
(defn spaces-acc [acc n]
  (cond (= n 0)
    acc

    (spaces-acc (to-str [acc " "]) (- n 1))))

;; spaces [n]: a string of n spaces.
(defn spaces [n]
  (spaces-acc "" n))

;; closes-acc [acc n]: a string of n closing parens.
(defn closes-acc [acc n]
  (cond (= n 0)
    acc

    (closes-acc (to-str [acc ")"]) (- n 1))))

;; closes [n]: a string of n closing parens.
(defn closes [n]
  (closes-acc "" n))

;; prefix-name [prefix]: the helper name from its prefix (the prefix
;; is the name + "-").
(defn prefix-name [prefix]
  (subs prefix 0 (- (count prefix) 1)))

;; string-body-lines [lit sv]: the let-free bare-String body (ctor
;; table) over the state variable sv, unindented — the caller places
;; the lines.
;; The continuation lines carry their own 6-column prefix — the
;; caller aligns line 1's cond under the ref, and the template wants
;; lines 2-3 six columns right of the cond.
(defn string-body-lines [lit sv]
  [(to-str ["(cond (str-prefix? " lit " (.input " sv "))"])
   (to-str ["      (rdr/ParserMatch " lit " (rdr/take-char " sv "))"])
   (to-str ["      (rdr/ParserError \"expected " (escape-str lit) "\" " sv "))"])])

;; child-ref [pc i sv ctx]: the lines of the call expression for the
;; child combinator at index i under the current node (ctx's prefix
;; is the node name + "-"); sv is the state variable the call is
;; made over (All/Ignore thread s<i>; Any calls every alt over the
;; defn's `state` param). String -> the let-free body inlined
;; (let-free, inlinable everywhere); Rule -> the single (name sv)
;; line; the default (every anonymous combinator) -> the single
;; (prefix+i sv) line. The helper NAME still uses i.
;; -> [String]
(defp child-ref [pc i sv ctx]
  [(to-str ["(" (to-str [(.prefix ctx) (number-str i)]) " " sv ")"])])

(extend-type String (child-ref [v i sv ctx]
  (string-body-lines (render-literal v) sv)))

(extend-type grammar/Rule (child-ref [v i sv ctx]
  [(to-str ["(" (.name v) " " sv ")"])]))

;; ref-cont-acc [acc lines b]: the ref's continuation lines, each
;; prefixed with the alignment indent b.
(defn ref-cont-acc [acc lines b]
  (cond (= (count lines) 0)
    acc

    (ref-cont-acc (vect-conj acc (to-str [b (extract (first lines))]))
                  (rest lines)
                  b)))

;; append-acc [acc xs]: the lines of xs appended after acc's lines
;; (explicit acc recursion — the generic Vector comp path is broken
;; under new-toc: comp-vect's (reduce (cons v vs) ...) passes a raw
;; Term as the collection, crashing the reduce dispatch).
(defn append-acc [acc xs]
  (cond (= (count xs) 0)
    acc

    (append-acc (vect-conj acc (extract (first xs))) (rest xs))))

;; but-last [lines]: the lines with the last dropped (explicit acc
;; recursion).
(defn but-last [lines]
  (cond (= (count lines) 0)
    []

    (let [r (rest lines)]
      (cond (= (count r) 0)
        []

        (append-acc [(extract (first lines))] (but-last r))))))

;; last-line [lines]: the last line, alone.
(defn last-line [lines]
  (cond (= (count lines) 0)
    []

    (let [r (rest lines)]
      (cond (= (count r) 0)
        lines

        (last-line r)))))

;; all-body-acc [acc ps i vs ctx]: the nested parse-then chain
;; (site-(c) template) rendered outside-in. At child i the step
;; emits the (parse-then line, the ref's continuation lines aligned
;; 12 columns in, the (fn [vi s(i+1)] line, and descends 14 columns;
;; vs is the value variables joined so far. The last step emits the
;; ParserMatch value line with the 2-per-level closing parens.
(defn all-body-acc [acc ps i vs ctx]
  (cond (= i (count ps))
    (vect-conj acc
               (to-str [(spaces (* 14 (count ps)))
                        "(rdr/ParserMatch [" vs "] "
                        (state-var (count ps))
                        ;; 2 per level (fn + parse-then) + 1 for the
                        ;; outermost parse-then; wrap-defn adds the
                        ;; defn's own close.
                        (closes (+ 1 (* 2 (count ps))))]))

    (let [ref (child-ref (extract (get ps i)) i (state-var i) ctx)
          b (spaces (* 14 i))
          b12 (spaces (+ (* 14 i) 12))]
      (all-body-acc
       (conj
        (append-acc
         (conj acc (to-str [b "(parse-then " (extract (first ref))]))
         (ref-cont-acc [] (rest ref) b12))
        (to-str [b12 "(fn [v" (number-str i) " " (state-var (+ i 1)) "]"]))
        ps
        (+ i 1)
        (cond (str= vs "")
          (to-str ["v" (number-str i)])
          (to-str [vs " v" (number-str i)]))
        ctx))))

;; all-body [ps ctx]: the All body — the nested parse-then over the
;; children's call expressions (site-(c) template).
(defn all-body [ps ctx]
  (all-body-acc [] ps 0 "" ctx))

(extend-type grammar/All (emit-body [v ctx]
  (all-body (.parsers v) ctx)))

;; ignore-body [p ctx]: the Ignore body (site-(c) shape) — parse-or
;; over parse-then with identity as the else-fn; the fn captures
;; nothing.
(defn ignore-body [p ctx]
  (let [ref (child-ref p 0 "state" ctx)]
    (conj
     (append-acc
      (append-acc
       [(to-str ["(parse-or (parse-then " (extract (first ref))])]
        (ref-cont-acc [] (rest ref) (spaces 22)))
      [(to-str [(spaces 22) "(fn [v s2]"])
        (to-str [(spaces 24) "(rdr/ParserIgnore s2)))"])])
     (to-str [(spaces 10) "identity)"]))))

(extend-type grammar/Ignore (emit-body [v ctx]
  (ignore-body (.parser v) ctx)))

;; walk-children [pc]: the child parsers of pc that may need lifting —
;; All -> its parsers; Ignore -> its single child; Rule, String, and
;; the leaf ctors -> [].
(defp walk-children [pc]
  [])

(extend-type grammar/All (walk-children [v] (.parsers v)))

(extend-type grammar/Ignore (walk-children [v] [(.parser v)]))

(extend-type grammar/Any (walk-children [v] (.parsers v)))

(extend-type grammar/Many (walk-children [v] [(.parser v)]))

;; child-lifted? [pc]: Some iff the child gets a lifted helper defn
;; (every anonymous combinator); Rule -> None (referenced by name;
;; its defn is emitted with the rule list); bare String -> None
;; (inlined let-free).
(defp child-lifted? [pc]
  (Some pc))

(extend-type grammar/Rule (child-lifted? [v] None))

(extend-type String (child-lifted? [v] None))

;; many-loop-step [acc name ref i]: the lines added at step i of the
;; loop body (i = 0..4): the (parse-then line + the ref's
;; continuation lines aligned 22 columns in, the (fn [v s2] line, the
;; acc-recursion line, the (fn [e] line, the ParserMatch line. (The
;; append-acc construction lives here, not in the recursion - a
;; nested append-acc as a direct call argument is the any-body-step
;; codegen hazard.)
(defn many-loop-step [acc name ref i]
  (cond (= i 0)
    (append-acc
     acc
     (append-acc
      (conj [] (to-str ["(parse-or (parse-then " (extract (first ref))]))
      (ref-cont-acc [] (rest ref) (spaces 22))))

    (= i 1)
    (append-acc acc [(to-str [(spaces 22) "(fn [v s2]"])])

    (= i 2)
    (append-acc acc
                [(to-str [(spaces 24) (to-str ["(" name " s2 (vect-conj acc v))))"])])])

    (= i 3)
    (append-acc acc [(to-str [(spaces 10) "(fn [e]"])])

    (append-acc acc [(to-str [(spaces 12) "(rdr/ParserMatch acc state)))"])])))

;; many-loop-lines-acc [acc name ref i]: the loop body's lines, one
;; step per recursive call (i = 0..4; the first argument is the
;; step helper's result, not an inline append-acc).
(defn many-loop-lines-acc [acc name ref i]
  (cond (= i 5)
    acc

    (many-loop-lines-acc (many-loop-step acc name ref i) name ref (+ i 1))))

;; many-loop-lines [name ref]: the loop body's lines.
(defn many-loop-lines [name ref]
  (many-loop-lines-acc [] name ref 0))

;; many-loop-defn [name child ctx]: the site-(b) acc-recursion loop
;; defn for the Many named name (ctx's prefix is name + "-"): parse-
;; or over parse-then - a child match recurses with the extended
;; acc, a child error returns the acc. The child is referenced at
;; index 0 over `state` (child-ref: Rule -> name, bare String -> the
;; inlined let-free body, anonymous -> the lifted helper name). The
;; body lines come from many-loop-lines (a let-bound value - the
;; nested append-acc built inline here was miscompiled by new-toc:
;; wrap-defn-acc's second argument arrived as a raw Term).
(defn many-loop-defn [name child ctx]
  (let [ref (child-ref child 0 "state" ctx)
        body (many-loop-lines name ref)]
    (wrap-defn-acc
     [(to-str ["(defn " name " [state acc]"])]
     body)))

;; many-child-defns [child name ctx]: the lifted child helper defn
;; lines for the Many named name (the child, at index 0 under it) —
;; [] when the child is not lifted (Rule: the loop defn references
;; it by name; bare String: inlined let-free).
(defn many-child-defns [child name ctx]
  (cond (child-lifted? child)
    (lifted-child-block child (to-str [name "-0"]) ctx)

    []))

;; alt-char-level? [pc]: Some iff pc classifies a single character
;; (CharRange, NotChar, bare String, Any of all-char-level alts, and
;; Rule/Many delegating to their child per the ctor table); None
;; otherwise. A plain defn over type-name (the same dispatch style as
;; lifted-child-block's Many check): the flipped-receiver emit-many
;; protocol is the Many fast/slow classification (impls ARE the
;; branches); this is the alt-level query the Any impl needs to
;; classify its alts, and the Many child-ref impl needs to pick the
;; call shape (item 7b).
(defn alt-char-level? [pc]
  (cond (str= (type-name pc) "CharRange")
    (Some pc)

    (str= (type-name pc) "NotChar")
    (Some pc)

    (str= (type-name pc) "String")
    (Some pc)

    (str= (type-name pc) "Any")
    (all-alts-char-level? (.parsers pc))

    (str= (type-name pc) "Rule")
    (alt-char-level? (.parser pc))

    (str= (type-name pc) "Many")
    (alt-char-level? (.parser pc))

    None))

;; all-alts-char-level? [alts]: Some iff every alt is char-level
;; (acc recursion — the reduce-capture leak). Forward-declared at the
;; top of the file: it and alt-char-level? are mutually recursive.
(defn all-alts-char-level? [alts]
  (cond (= (count alts) 0)
    (Some alts)

    (let [r (alt-char-level? (extract (first alts)))]
      (cond r
        (all-alts-char-level? (rest alts))

        None))))

;; many-run-defn [name pred-line]: the fast-path defns (ctor table)
;; for a Many named name over a char-level child: the set-predicate
;; defn <name>-char over char string c, and the read-run wrapper
;; (the Token -> ParserMatch wrap — the run's text is ONE string,
;; the settled maximal-run convention).
(defn many-run-defn [name pred-line]
  (append-acc
   [(to-str ["(defn " name "-char [c] " pred-line ")"])]
   (wrap-defn
    name
    [(to-str ["(let [t (rdr/read-run state " name "-char)]"])
     ;; the let close goes on the last line; wrap-defn adds the
     ;; defn's own close (4 closes after the final t, ctor table).
     (to-str ["  (rdr/ParserMatch (.text t) (.state t)))"])])))

;; many-run-path [child name ctx]: the emit-many run path (item 7b):
;; the fast-path defns from the child's emit-pred + the call
;; expression (the last line — emit-body / lifted-child-block /
;; emit-rule-block take or drop it as they do for the loop path).
(defn many-run-path [child name ctx]
  (append-acc
   (many-run-defn name (emit-pred child ctx))
   (conj [] (to-str ["(" name " state)"]))))

;; many-loop-path [child name ctx]: the emit-many loop path (the
;; default body, item 7a): the lifted child helpers (if the child is
;; anonymous), the site-(b) acc-recursion loop defn (acc-recursion,
;; not a reduce), and the call expression.
(defn many-loop-path [child name ctx]
  (append-acc
   (append-acc (many-child-defns child name ctx)
               (many-loop-defn name child ctx))
   (conj [] (to-str ["(" name " state empty-vector)"]))))

;; emit-many: Many helper emission by FLIPPED RECEIVER (task-1
;; ruling — no yes/no tag protocol; the impl IS the path): the
;; receiver is the CHILD combinator. The char-level ctors get the
;; run path (item 7b): the <name>-char set-predicate defn from the
;; child's emit-pred + the read-run wrapper, and the call expression
;; (<name> state). Any classifies its alts: ALL char-level -> the
;; run path over the combined (or ...) pred; a mixed Any -> the loop
;; path (no abort at a legitimate mixed site — the emit-pred default
;; abort stays the emitter-bug signal at the other sites). Rule and
;; Many delegate to their child (ctor table). The DEFAULT body is
;; the loop path. ctx's prefix is the Many's own prefix (the helper
;; name + "-"). -> [String]
(defp emit-many [child ctx]
  (many-loop-path child (prefix-name (.prefix ctx)) ctx))

(extend-type grammar/CharRange (emit-many [v ctx]
  (many-run-path v (prefix-name (.prefix ctx)) ctx)))

(extend-type grammar/NotChar (emit-many [v ctx]
  (many-run-path v (prefix-name (.prefix ctx)) ctx)))

(extend-type String (emit-many [v ctx]
  (many-run-path v (prefix-name (.prefix ctx)) ctx)))

(extend-type grammar/Any (emit-many [v ctx]
  (cond (all-alts-char-level? (.parsers v))
    (many-run-path v (prefix-name (.prefix ctx)) ctx)

    (many-loop-path v (prefix-name (.prefix ctx)) ctx))))

;; Rule and Many delegate to their child (ctor table).
(extend-type grammar/Rule (emit-many [v ctx]
  (emit-many (.parser v) ctx)))

(extend-type grammar/Many (emit-many [v ctx]
  (emit-many (.parser v) ctx)))

;; Many child-ref (item 7b, moved here from the item-5 section — it
;; needs alt-char-level?): the call expression for the Many at index
;; i under the current node (the helper at prefix+i, emitted by
;; emit-many): fast path -> (name sv); loop path -> (name sv
;; empty-vector).
(extend-type grammar/Many (child-ref [v i sv ctx]
  (cond (alt-char-level? (.parser v))
    [(to-str ["(" (to-str [(.prefix ctx) (number-str i)]) " " sv ")"])]

    [(to-str ["(" (to-str [(.prefix ctx) (number-str i)]) " " sv
              " empty-vector)"])])))

(extend-type grammar/Many (emit-body [v ctx]
  (last-line
   (emit-many (.parser v)
              (EmitCtx (.rule ctx) (to-str [(.prefix ctx) "0-"]))))))

;; emit-helpers [acc ps i prefix ctx]: the lifted helper defn blocks
;; for the children ps[i..] (sub-helpers first, post-order): each
;; lifted child gets its defn block (lifted-child-block, name =
;; prefix + i, its prefix = name + "-"); the use-after-definition
;; order (a defn body referencing a later top-level symbol fails
;; Undefined symbol) is what puts the sub-helpers first.
(defn emit-helpers [acc ps i prefix ctx]
  (cond (= i (count ps))
    acc

    (let [c (extract (get ps i))]
      (cond (child-lifted? c)
        (let [name (to-str [prefix (number-str i)])]
          (emit-helpers
           (append-acc acc (lifted-child-block c name ctx))
           ps (+ i 1) prefix ctx))

        (emit-helpers acc ps (+ i 1) prefix ctx)))))

;; lifted-child-block [c name ctx]: the defn block lines for the
;; lifted child combinator c named name (sub-helpers first, use-
;; after-definition): a Many is its emit-many defn block (the
;; fast-path defns or the site-(b) loop defn, by the child's
;; classification — the call expression dropped, it goes in the
;; parent body via child-ref / emit-body); every other anonymous
;; combinator is the sub-helpers + the plain defn (emit-fn).
;;
;; Forward-declared at the top of the file: it and emit-helpers are
;; mutually recursive (the sub-helpers of a non-Many lifted child
;; are emitted by emit-helpers).
(defn lifted-child-block [c name ctx]
  (cond (str= (type-name c) "Many")
    (but-last
     (emit-many (.parser c)
                (EmitCtx (.rule ctx) (to-str [name "-"]))))

    (append-acc
     (emit-helpers [] (walk-children c) 0 (to-str [name "-"]) ctx)
     (emit-fn c name ctx))))

;; append-to-last [lines suffix]: the lines with suffix appended to
;; the last line (explicit acc recursion; the recursive result is
;; FLATTENED in with append-acc — vect-conj would nest it as one
;; element, and to-str renders a nested vector with brackets).
(defn append-to-last [lines suffix]
  (cond (= (count lines) 0)
    lines

    (let [l (extract (first lines))]
      (cond (= (count (rest lines)) 0)
        [(to-str [l suffix])]

        (append-acc [l] (append-to-last (rest lines) suffix))))))

;; any-body-last [acc ps i ctx]: the LAST alt — its call + continuation
;; lines, then the closes for every parse-or level. (A let in a
;; non-else cond clause is a malformed-cond hazard — the branches are
;; helper defns so the cond clauses are plain calls.)
(defn any-body-last [acc ps i ctx]
  (let [ref (child-ref (extract (get ps i)) i "state" ctx)
        b (spaces (* 12 i))]
    (append-acc
     acc
     (append-to-last
      (append-acc
       (conj [] (to-str [b (extract (first ref))]))
       (ref-cont-acc [] (rest ref) b))
      (closes (* 2 (- (count ps) 1)))))))

;; step-newacc [acc ps i ctx]: the acc lines after emitting alt i —
;; the parse-or line, the ref's continuation lines, the else-fn open
;; line. (Lives in its own defn — inlined in any-body-step, new-toc's
;; codegen drops the else-fn line: the 2nd arg of the outer
;; append-acc is emitted 1-arg, deterministic, 2026-09-09, item 6.)
(defn step-newacc [acc ps i ctx]
  (let [ref (child-ref (extract (get ps i)) i "state" ctx)
        b (spaces (* 12 i))
        b10 (spaces (+ (* 12 i) 10))]
    (append-acc
     (append-acc
      (conj acc (to-str [b "(parse-or " (extract (first ref))]))
      (ref-cont-acc [] (rest ref) b10))
     (conj [] (to-str [b10 "(fn [e" (number-str (+ i 1)) "]"])))))

;; any-body-step [acc ps i ctx]: a non-last alt — the parse-or +
;; else-fn open, then the recursive step.
(defn any-body-step [acc ps i ctx]
  (any-body-acc (step-newacc acc ps i ctx) ps (+ i 1) ctx))

;; any-body-acc [acc ps i ctx]: the nested parse-or chain (site-(a)
;; template) rendered outside-in. Every alt is called over the
;; defn's `state` param (no threading). At alt i (i < N-1) the step
;; emits the (parse-or line, the ref's continuation lines aligned 10
;; columns in, the (fn [e(i+1)] line, and descends 12 columns. The
;; last alt is emitted BARE (the last Error falls out for free); its
;; last line gains the 2-per-level closing parens (fn + parse-or).
;; (count ps) is inlined at both use sites — a let wrapping this cond
;; (both clauses lets) is a new-toc hazard: it loads clean but
;; miscompiles and crashes at runtime (bad incRef value: (nil),
;; 2026-09-09, item 6). The branches are helper defns (any-body-last
;; / any-body-step) — a let directly in a non-else cond clause is
;; rejected as a malformed cond.
(defn any-body-acc [acc ps i ctx]
  (cond (= i (- (count ps) 1))
    (any-body-last acc ps i ctx)

    (any-body-step acc ps i ctx)))

;; any-body [ps ctx]: the Any body — the nested parse-or over the
;; alts' call expressions (site-(a) template).
(defn any-body [ps ctx]
  (any-body-acc [] ps 0 ctx))

(extend-type grammar/Any (emit-body [v ctx]
  (any-body (.parsers v) ctx)))

;; emit-header: module header lines — the add-ns of the helper layer,
;; the parse-then/parse-or kit (Result discrimination, settled in
;; task 1), the ParserError field-access protocols (bare .field on
;; the union is unsafe — new-toc resolves getters by name lookup),
;; and the parse-error-line def (out = the accumulated result lines
;; of the expressions parsed before the error — spliced into the
;; exit message so they are printed before the error line).
(defn emit-header []
  [";; gen-rdr.toc - GENERATED by interpreter/intrp-emit.toc (do not edit)."
   ""
   "(add-ns rdr (module \"intrp-rdr.toc\"))"
   ""
   "(defp parse-then [r f])"
   "(extend-type rdr/ParserMatch (parse-then [r f] (f (.value r) (.state r))))"
   "(extend-type rdr/ParserIgnore (parse-then [r f] r))"
   "(extend-type rdr/ParserError (parse-then [r f] r))"
   ""
   "(defp parse-or [r else-f])"
   "(extend-type rdr/ParserMatch (parse-or [r e] r))"
   "(extend-type rdr/ParserIgnore (parse-or [r e] r))"
   "(extend-type rdr/ParserError (parse-or [r e] (e r)))"
   ""
   "(defp parse-error-msg [r])"
   "(extend-type rdr/ParserError (parse-error-msg [v] (.msg v)))"
   ""
   "(defp parse-error-state [r])"
   "(extend-type rdr/ParserError (parse-error-state [v] (.state v)))"
   ""
   ""
   "(defn parse-error-line [file out line msg]"
   "  (exit 1 (to-str [out file \":\" (number-str line) \":\" msg])))"])

;; emit-rule-block [r]: the emitted lines for one Rule — the lifted
;; helper defn blocks (sub-helpers first, use-after-definition),
;; then the parser defn. A Many parser is the exception to the
;; inlining: its body is a call to the module-level helper defn, so
;; the Many gets its emit-many defn block named <rule>-0 (the
;; fast-path defns or the loop defn, by the child's classification —
;; the rule's parser position is index 0) and the rule defn is the
;; one-arg wrapper.
(defn emit-rule-block [r]
  (let [p (.parser r)
        ctx (EmitCtx (.name r)
                     (to-str [(.name r) "-"]))]
    (cond (str= (type-name p) "Many")
          (append-acc
           (but-last
            (emit-many (.parser p)
                       (EmitCtx (.name r) (to-str [(.name r) "-0-"]))))
           (wrap-defn (.name r) (emit-body p ctx)))

          (append-acc
           (emit-helpers [] (walk-children p) 0
                         (to-str [(.name r) "-"]) ctx)
           (wrap-defn (.name r) (emit-body p ctx))))))

;; emit-rules-acc [acc rules]: one block per Rule (emit-rule-block).
(defn emit-rules-acc [acc rules]
  (cond (= (count rules) 0)
    acc

    (let [d (emit-rule-block (extract (first rules)))]
      (cond (empty? acc)
            (emit-rules-acc d (rest rules))

            (emit-rules-acc (append-acc acc d) (rest rules))))))

;; emit-main: the parse-seq loop + main template lines. parse-seq
;; skips whitespace, runs the entry rule, and accumulates one result
;; line per match in the acc STRING (pure dataflow — a per-line pr*
;; count threaded through + was skipped by the lazy machine on the
;; error path: exit cut the result chain before the + was forced,
;; dropping the earlier prints). On a ParserError it splices the
;; accumulated lines into the exit message (file:line: msg) and exits
;; non-zero; main prints the accumulated lines on success.
(defn emit-main [entry]
  ["(defn parse-seq [file state acc]"
   "  (let [s (rdr/skip-whitespace state)]"
   "    (cond (str= (.input s) \"\")"
   "      (rdr/ParserMatch acc s)"
   (to-str ["      (parse-or (parse-then (" entry " s)"])
   "                            (fn [v s2]"
   "                              (parse-seq file (rdr/skip-whitespace s2)"
   "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
   "                (fn [e] (parse-error-line file acc"
   "                                          (rdr/state-line (parse-error-state e))"
   "                                          (parse-error-msg e)))))))"
   ""
   "(main [argv]"
   "  (let [file (extract (get argv 1))]"
   "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
   "                (fn [out s] (pr* out)))))"])

;; emit-module: the full generated module — header, one parser defn
;; per Rule, the parse-seq loop + main template (the entry rule name
;; spliced into the loop). -> [String]
;;
;; Forward-declared: emit-module is the file's LAST defn, and
;; new-toc's symbol-loss race drops a module's last defn from the
;; symbol table (the importer then fails Undefined symbol). The bare
;; (def) keeps the symbol registered (the parse-program /
;; parse-program-acc pattern).
(defn emit-module [rules entry]
  (append-acc
   (-> (emit-header)
       (emit-rules-acc rules))
   (emit-main entry)))
