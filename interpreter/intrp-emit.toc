;; interpreter/intrp-emit.toc - the parser emitter (library, no main).
;;
;; Takes the parser-combinator grammar data (intrp-grammar.toc) and
;; emits a recursive-descent parser module in Toccata source for it
;; (docs/parser-generator-plan.md).
;;
;; No intermediate IR: the emit protocol (render-child) is extended
;; directly onto the ParserCombinator ctor types (and String, for the
;; bare-literal leaf) - the v1 EBNF emitter's pattern (intrp-ebnf.toc).
;; The render phase recurses over the grammar tree via render-child;
;; there is no separate analyze/fold pass. Bare String literals are
;; first-class grammar leaves (mixed in among the ctor values in
;; Any / All), so String carries the literal impls.
;;
;; The grammar's field names are shared across ctors (.parsers on
;; All / Any / Concat, .name on Rule / Ref / Node, .parser on
;; Ignore / Many) - that is fine here because field getters are
;; protocols, so each dispatches on the value's ctor.

(add-ns grammar (module "intrp-grammar.toc"))

;; render-child [ir sv]: the render dispatch - the source lines for ir
;; over the state variable sv. A protocol (defp + one extend-type impl
;; per rendered ctor - the protocol pattern); the defp's body is the
;; abort for the unrendered ctors. The leaf ctors (4b.1) and the
;; wrapper ctors (4b.2) have impls; the remaining ctors (Any / All /
;; Many / Rule) are the later items (4b.3-4b.7).
(defp render-child [n sv]
  (abort (str "render-child: not yet implemented: " (type-name n))))

;; not-ignore? [v]: truthy (Some v) for a non-Ignore child, None for
;; an Ignore wrapper. Used with filter to count the non-ignored All
;; children. A protocol with a default so only Ignore needs an impl.
(defp not-ignore? [v]
  (Some v))

;; render-constant [v sv]: the source for an AlwaysSucceed constant
;; value over the state variable sv - a String literal or the empty
;; vector, as a ParserMatch. A protocol; the defp's body is the abort
;; for unsupported value types.
(defp render-constant [v sv]
  (abort (str "render-constant: unsupported value type: " (type-name v))))

;; node-value-args [child-ir v]: the ctor arg expressions (no auto-loc)
;; for a Node whose child is child-ir and whose value is bound to
;; variable v. A protocol (defp + one extend-type impl per supported
;; ctor - the protocol pattern); the defp's body is the abort for
;; the unsupported kinds. A "string"-shaped child contributes one arg
;; (v); a "vector"-shaped child contributes its arity many args
;; (extracted elements) - except Many, whose whole vector is the
;; single arg.
(defp node-value-args [n v]
  (abort (str "node-value-args: unsupported kind: " (type-name n))))

;; =====================================================================
;; Phase 2 - render (item 4b.1): the leaf ctors.
;;
;; Each render function returns the source LINES for its grammar node:
;; zero or more lifted helper defn lines, then ONE final line - a
;; single Toccata expression that, with the state variable sv in
;; scope, evaluates to a ParserResults. The leaf ctors lift nothing:
;; each returns a one-line vector. Every rendered entry skips
;; whitespace+comments first (skip-at-entry) - the kit's
;; state/skip-whitespace skips both (intrp-state.toc).
;;
;; The generated module's kit is namespaced: state/... (intrp-
;; state.toc); core calls (str-prefix?, subs, char-code, count,
;; vector, ...) are bare. new-toc is single-pass: a defn body may
;; not reference a LATER top-level symbol, so the defns below are
;; ordered callee-first.

;; --- source-literal helpers ------------------------------------------

;; escape-char: one char -> its escaped form inside a Toccata string
;; literal (the generated source must re-parse to the same text).
(defn escape-char [c]
  (cond (str= c "\\")
    "\\\\"

    (str= c "\"")
    "\\\""

    (str= c "\n")
    "\\n"

    (str= c "\r")
    "\\r"

    (str= c "\t")
    "\\t"

    c))

;; render-literal [s]: s as a Toccata string literal (quotes included).
(defn render-literal [s]
  (str "\"" (-> (vec s) (map escape-char) to-str) "\""))

;; --- the entry-skip ----------------------------

;; skip-expr [sv]: the entry-skip expression over state variable sv.
(defn skip-expr [sv]
  (str "(state/skip-whitespace " sv ")"))

;; --- leaf render helpers (used by the inlined leaf render-child impls) --

;; one-char-test [c]: the empty-input guard over one-char string c
;; (char-code of the empty subs reads the NUL terminator, 0 - the
;; guard keeps a range containing code 0 from matching empty input).
(defn one-char-test [c]
  (str "(not (str= " c " \"\"))"))

;; =====================================================================
;; Phase 2 - render (item 4b.2): the wrapper ctors.
;;
;; The wrappers render the child(ren) first, then wrap the result. Each
;; returns source LINES (a Vector of Strings): zero or more lifted
;; helper defn lines (none yet - lifting is 4b.4/4b.5), then ONE final
;; line - a single Toccata expression that, with the state variable sv
;; in scope, evaluates to a ParserResults.
;;
;;   Ignore [p]  - parse-and-discard: parse the child, discard its
;;                 value, thread the state. Standalone value is the unit
;;                 (empty-vector); the enclosing All (4b.3) excludes it
;;                 from the value vector. The discard fn binds _ (the
;;                 child's value) and threads s2.
;;   Concat [ps] - parse the children in sequence (nested parse-then),
;;                 flatten-join their string values into ONE string.
;;   Node [n p]  - the child's value becomes the raw-AST ctor call
;;                 (raw/<n> <args...> <auto-loc>); the auto-loc is the
;;                 line where the form started (the entry state sv,
;;                 whitespace-skipped).
;;
;; The wrapper render-child impls are inlined in the extend-type
;; blocks below; this section holds their helper defns.

(extend-type grammar/All
  (node-value-args [n v]
    (map (range (-> (.parsers n) (filter not-ignore?) count))
         (fn [i] (str "(extract (get " v " " i ")")))))

(extend-type grammar/Any
  (node-value-args [n v]
    (either (map (first (.parsers n))
             (fn [p] (node-value-args p v)))
        (abort "node-value-args: empty Any"))))

(extend-type grammar/Rule
  (node-value-args [n v]
    (node-value-args (.parser n) v)))

;; Many: vector-shaped, but the whole vector of parsed values is the
;; single arg (a Node over a Many receives the vector, not its
;; elements - contrast All's one-arg-per-element spread).
(extend-type grammar/Many
  (node-value-args [n v]
    (vector v)))

(extend-type grammar/CharRange
  (render-child [n sv]
    (let [lo (.lower n)
          hi (.upper n)
          SV (skip-expr sv)
          C (str "(subs " SV " 0 1)")
          msg (render-literal (str "expected a character in the range " lo "-" hi))]
      (vector (str "(cond (and " (one-char-test C)
                    " (and (<= (char-code " (render-literal lo) ") (char-code " C "))"
                    " (<= (char-code " C ") (char-code " (render-literal hi) ")))"
                    ")"
                    " (state/ParserMatch " C " (state/take-char " SV "))"
                    " (state/ParserError " msg " " SV "))"))))
  (node-value-args [n v]
    (vector v)))

(extend-type grammar/NotChar
  (render-child [n sv]
    (let [ch (.char n)
          SV (skip-expr sv)
          C (str "(subs " SV " 0 1)")
          msg (render-literal (str "expected a character other than " ch))]
      (vector (str "(cond (and " (one-char-test C) " (not (str= " C " " (render-literal ch) "))"
                        ")"
                        " (state/ParserMatch " C " (state/take-char " SV "))"
                        " (state/ParserError " msg " " SV "))"))))
  (node-value-args [n v]
    (vector v)))

;; the bare-String literal leaf (mixed in among the ctor values in
;; Any / All).
(extend-type String
  (render-child [n sv]
    (let [SV (skip-expr sv)
          L (render-literal n)
          msg (render-literal (str "expected " n))]
      (vector (str "(cond (str-prefix? " L " (.input " SV "))"
                        " (state/ParserMatch " L " (state/take-chars " SV " " (count n) "))"
                        " (state/ParserError " msg " " SV "))"))))
  (render-constant [n sv]
    (str "(state/ParserMatch " (render-literal n) " " sv ")"))
  (node-value-args [n v]
    (vector v)))

(extend-type grammar/Ref
  (render-child [n sv]
    (vector (str "(" (.name n) " " sv ")"))))

(extend-type grammar/AlwaysSucceed
  (render-child [n sv]
    (vector (render-constant (.value n) sv))))

(extend-type grammar/Error
  (render-child [n sv]
    (vector (str "(state/ParserError " (render-literal (.msg n)) " " sv ")"))))

(extend-type grammar/Ignore
  (render-child [n sv]
    (let [res (render-child (.parser n) sv)]
      (comp (butlast res)
            (vector (str "(parse-then " (either (last res) (abort "render: Ignore: child rendered no lines")) " (fn [_ s2] (state/ParserMatch empty-vector s2))))")))))
  (not-ignore? [n]
    None))

;; concat-tail [cs i sv vnames join]: the source lines for Concat
;; children i..n-1, threading the state. Returns a Vector of Strings:
;; the children's helper lines, then ONE final line - the nested
;; parse-then over sv (the base case is the final ParserMatch).
(defn concat-tail [cs i sv vnames join]
  (either (map (first cs)
               (fn [c]
                 (let [res (render-child c sv)
                       snext (str "s" (+ i 1))
                       inner (concat-tail (rest cs) (+ i 1) snext (rest vnames) join)]
                   (comp (comp (butlast res) (butlast inner))
                         (vector (str "(parse-then " (either (last res) (abort "concat-tail: render-child returned no lines"))
                                      " (fn [" (either (first vnames) (abort "concat-tail: vnames out of step with cs")) " " snext "] "
                                      (either (last inner) (abort "concat-tail: recursive render returned no lines")) ")"))))))
               (vector (str "(state/ParserMatch " join " " sv ")"))))

(extend-type grammar/Concat
  (render-child [n sv]
    (let [cs (.parsers n)
          vnames (map (range (count cs)) (fn [x] (str "v" x)))
          join (either (map (first vnames)
                            (fn [vname]
                              (cond (empty? (rest vnames))
                                    vname
                                    (str "(str " (to-str (interpose vnames " ")) ")"))))
                       "\"\"")]
      (concat-tail cs 0 sv vnames join)))
  (node-value-args [n v]
    (vector v)))

(extend-type grammar/Node
  (render-child [n sv]
    (let [child (.parser n)
          res (render-child child sv)
          args (to-str (interpose (conj (node-value-args child "v")
                                        (str "(state/state-line " (skip-expr sv) ")")) " "))
          match (str "(raw/" (.name n) " " args ")")]
      (comp (butlast res)
            (vector (str "(parse-then " (either (last res) (abort "render: Node: child rendered no lines"))
                         " (fn [v s2] (state/ParserMatch " match " s2)))"))))))

