;; interpreter/intrp-emit.toc — the parser emitter (library, no main).
;;
;; Takes the parser-combinator grammar data (intrp-grammar.toc) and
;; emits a recursive-descent parser module in Toccata source for it
;; (docs/parser-generator-plan.md).
;;
;; Item 3: skeleton + char-level emission — EmitCtx, the emit-pred
;; protocol (char-level ctors only; the default body aborts, and the
;; abort IS the char-level classification).
;;
;; Item 4: leaf body ctors + end-to-end pipeline — emit-body (the
;; leaf ctors), emit-ref, emit-fn, and emit-module (the full
;; generated module: header + kit + one parser defn per Rule + the
;; parse-seq loop + main template).
;;
;; Item 5: All + Ignore — the emit-body impls (the site-(c)
;; templates), the child-ref protocol (call-position expressions:
;; Rule -> name, bare String -> inlined let-free body, anonymous ->
;; the lifted helper name), and the lifted helper emission (walk-
;; children / child-lifted? / emit-helpers: each anonymous child
;; combinator gets a defn, sub-helpers first).

(add-ns grammar (module "intrp-grammar.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; Context threaded through every emit call:
;;   rule   — name of the rule currently being emitted ("" at top
;;            level); a Recur node renders as a call to this name.
;;   prefix — name prefix for generated helpers (the enclosing rule
;;            or helper name + "-").
(deftype EmitCtx [rule prefix])

;; escape-char: one char string -> its escaped 1- or 2-char form
;; (quote, backslash, and the control chars).
(defn escape-char [c]
  (cond (str= c "\\")
    "\\\\"

    (str= c "\"")
    "\\\""

    (str= c "\n")
    "\\n"

    (str= c "\r")
    "\\r"

    (str= c "\t")
    "\\t"

    (str= c "\f")
    "\\f"

    (str= c "\b")
    "\\b"

    c))

;; escape-str-acc: the escaped form of each char, collected in order
;; (explicit acc recursion, not a reduce — the reduce-capture leak).
(defn escape-str-acc [acc s]
  (cond (= (count s) 0)
    acc

    (escape-str-acc (vect-conj acc (escape-char (extract (first s))))
                    (rest s))))

;; escape-str: a string's body as the contents of a Toccata string
;; literal (quote, backslash, and the control chars escaped).
(defn escape-str [s]
  (to-str (escape-str-acc [] s)))

;; render-literal: a string as a Toccata string literal.
(defn render-literal [s]
  (to-str ["\"" (escape-str s) "\""]))

;; emit-pred: source of a single-char predicate expression over char
;; string `c`. Implemented ONLY for char-level ctors (CharRange,
;; NotChar, bare String, char-level Any, and Rule/Many delegating per
;; the ctor table); the default body aborts with a message naming the
;; ctor — calling it on a general parser is an emitter bug, and the
;; abort IS the char-level classification (no yes/no tag needed).
(defp emit-pred [pc ctx]
  (abort (to-str ["emit-pred: not char-level: " (type-name pc)])))

;; pred-alts: the emit-pred of each alt, joined with single spaces
;; (no trailing space). Explicit acc recursion — a reduce whose
;; closure captured ctx would hit the reduce-capture leak.
(defn pred-alts-acc [acc alts ctx]
  (cond (= (count alts) 0)
    acc
    (pred-alts-acc (to-str [acc " " (emit-pred (extract (first alts)) ctx)])
                   (rest alts) ctx)))

(defn pred-alts [alts ctx]
  (cond (= (count alts) 0)
    ""
    (pred-alts-acc (emit-pred (extract (first alts)) ctx) (rest alts) ctx)))

(extend-type grammar/CharRange (emit-pred [v ctx]
  (to-str ["(and (<= " (number-str (char-code (.lower v)))
         " (char-code c)) (<= (char-code c) "
         (number-str (char-code (.upper v))) "))"])))

(extend-type grammar/NotChar (emit-pred [v ctx]
  (to-str ["(not (str= c " (render-literal (.char v)) "))"])))

(extend-type String (emit-pred [v ctx]
  (to-str ["(str= c " (render-literal v) ")"])))

(extend-type grammar/Any (emit-pred [v ctx]
  (to-str ["(or " (pred-alts (.parsers v) ctx) ")"])))

;; Rule and Many delegate to their child (ctor table).
(extend-type grammar/Rule (emit-pred [v ctx]
  (emit-pred (.parser v) ctx)))

(extend-type grammar/Many (emit-pred [v ctx]
  (emit-pred (.parser v) ctx)))

;; --- Item 4: leaf body ctors + end-to-end pipeline ------------------
;;
;; Generated code references the helper layer with the rdr/ prefix —
;; a bare name resolving through an imported namespace crashes
;; new-toc's codegen (verified 2026-09-04, item 4).

;; emit-body: source lines for an expression which, given the
;; let-bound symbol `state`, yields a ParserResults. Item 4: the leaf
;; ctors (CharRange, NotChar, bare String, AlwaysSucceed, Error); the
;; default body aborts with a message naming the ctor. -> [String]
(defp emit-body [pc ctx]
  (abort (to-str ["emit-body: not implemented for: " (type-name pc)])))

;; one-char-body [pred-line]: the one-char parser body (ctor table):
;; let over input/c, cond over end-of-input / pred / unexpected char.
;; The defn's closing paren is appended by wrap-defn.
(defn one-char-body [pred-line]
  ["(let [input (.input state)"
   "      c (subs input 0 1)]"
   "  (cond (str= c \"\")"
   "    (rdr/ParserError \"unexpected end of input\" state)"
   pred-line
   "    (rdr/ParserMatch c (rdr/take-char state))"
   "    (rdr/ParserError \"unexpected character\" state)))"])

(extend-type grammar/CharRange (emit-body [v ctx]
  (one-char-body (to-str ["    " (emit-pred v ctx)]))))

(extend-type grammar/NotChar (emit-body [v ctx]
  (one-char-body (to-str ["    " (emit-pred v ctx)]))))

;; bare String: let-free (inlinable in a cond clause) — the ctor
;; table's str-prefix? shape.
(extend-type String (emit-body [v ctx]
  ["(cond (str-prefix? " (render-literal v) " (.input state))"
   "  (rdr/ParserMatch " (render-literal v) " (rdr/take-char state))"
   (to-str ["  (rdr/ParserError \"expected " (escape-str (render-literal v)) "\" state))"])]))

;; render-value: a grammar value as generated source — Strings as
;; escaped literals, everything else via to-str.
(defn render-value [v]
  (cond (str= (type-name v) "String")
    (render-literal v)

    (to-str [v])))

(extend-type grammar/AlwaysSucceed (emit-body [v ctx]
  [(to-str ["(rdr/ParserMatch " (render-value (.value v)) " state)"])]))

(extend-type grammar/Error (emit-body [v ctx]
  [(to-str ["(rdr/ParserError " (render-literal (.msg v)) " state)"])]))

;; emit-ref: how to reference this parser in call position. Rule ->
;; its name (the Rule's defn is emitted at module level); anonymous
;; combinators are never referenced directly (the parent lifts them
;; via emit-fn first) — the default aborts. -> String
(defp emit-ref [pc ctx]
  (abort (to-str ["emit-ref: not a Rule: " (type-name pc)])))

(extend-type grammar/Rule (emit-ref [v ctx]
  (.name v)))

;; wrap-defn-acc: indent the body lines two spaces under the defn
;; line; the last line gains the defn's closing paren.
(defn wrap-defn-acc [acc lines]
  (cond (= (count lines) 0)
    acc

    (let [l (extract (first lines))]
      (cond (= (count (rest lines)) 0)
        (vect-conj acc (to-str ["  " l ")"]))

        (wrap-defn-acc (vect-conj acc (to-str ["  " l])) (rest lines))))))

;; defn-line [name]: the defn's opening line. Built in its own defn —
;; the str* inline in a vector argument crashes new-toc's parser
;; (verified 2026-09-04, item 4 — see Inherited verified facts).
(defn defn-line [name]
  (to-str ["(defn " name " [state]"]))

;; wrap-defn [name lines]: (defn <name> [state] <indented body>).
(defn wrap-defn [name lines]
  (wrap-defn-acc [(defn-line name)] lines))

;; emit-fn: lift any combinator to a named parser fn (plain defn, no
;; protocol); the helper's prefix is its name + "-". -> [String]
(defn emit-fn [pc name ctx]
  (wrap-defn name
             (emit-body pc (EmitCtx (.rule ctx) (to-str [name "-"])))))

;; --- Item 5: All + Ignore -------------------------------------------

;; state-var [i]: the state variable for child i of an All / Ignore
;; body — "state" (the defn's param) for the first child, "s<i>"
;; thereafter.
(defn state-var [i]
  (cond (= i 0)
    "state"

    (to-str ["s" (number-str i)])))

;; spaces-acc [acc n]: a string of n spaces.
(defn spaces-acc [acc n]
  (cond (= n 0)
    acc

    (spaces-acc (to-str [acc " "]) (- n 1))))

;; spaces [n]: a string of n spaces.
(defn spaces [n]
  (spaces-acc "" n))

;; closes-acc [acc n]: a string of n closing parens.
(defn closes-acc [acc n]
  (cond (= n 0)
    acc

    (closes-acc (to-str [acc ")"]) (- n 1))))

;; closes [n]: a string of n closing parens.
(defn closes [n]
  (closes-acc "" n))

;; string-body-lines [lit sv]: the let-free bare-String body (ctor
;; table) over the state variable sv, unindented — the caller places
;; the lines.
;; The continuation lines carry their own 6-column prefix — the
;; caller aligns line 1's cond under the ref, and the template wants
;; lines 2-3 six columns right of the cond.
(defn string-body-lines [lit sv]
  [(to-str ["(cond (str-prefix? " lit " (.input " sv "))"])
   (to-str ["      (rdr/ParserMatch " lit " (rdr/take-char " sv "))"])
   (to-str ["      (rdr/ParserError \"expected " (escape-str lit) "\" " sv "))"])])

;; child-ref [pc i ctx]: the lines of the call expression for the
;; child combinator at index i under the current node (ctx's prefix
;; is the node name + "-"). String -> the let-free body inlined
;; (let-free, inlinable everywhere); Rule -> the single (name sv)
;; line; the default (every anonymous combinator) -> the single
;; (prefix+i sv) line.
;; -> [String]
(defp child-ref [pc i ctx]
  [(to-str ["(" (to-str [(.prefix ctx) (number-str i)]) " "
     (state-var i) ")"])])

(extend-type String (child-ref [v i ctx]
  (string-body-lines (render-literal v) (state-var i))))

(extend-type grammar/Rule (child-ref [v i ctx]
  [(to-str ["(" (.name v) " " (state-var i) ")"])]))

;; ref-cont-acc [acc lines b]: the ref's continuation lines, each
;; prefixed with the alignment indent b.
(defn ref-cont-acc [acc lines b]
  (cond (= (count lines) 0)
    acc

    (ref-cont-acc (vect-conj acc (to-str [b (extract (first lines))]))
                  (rest lines)
                  b)))

;; append-acc [acc xs]: the lines of xs appended after acc's lines
;; (explicit acc recursion — the generic Vector comp path is broken
;; under new-toc: comp-vect's (reduce (cons v vs) ...) passes a raw
;; Term as the collection, crashing the reduce dispatch).
(defn append-acc [acc xs]
  (cond (= (count xs) 0)
    acc

    (append-acc (vect-conj acc (extract (first xs))) (rest xs))))

;; all-body-acc [acc ps i vs ctx]: the nested parse-then chain
;; (site-(c) template) rendered outside-in. At child i the step
;; emits the (parse-then line, the ref's continuation lines aligned
;; 12 columns in, the (fn [vi s(i+1)] line, and descends 14 columns;
;; vs is the value variables joined so far. The last step emits the
;; ParserMatch value line with the 2-per-level closing parens.
(defn all-body-acc [acc ps i vs ctx]
  (cond (= i (count ps))
    (vect-conj acc
               (to-str [(spaces (* 14 (count ps)))
                        "(rdr/ParserMatch [" vs "] "
                        (state-var (count ps))
                        ;; 2 per level (fn + parse-then) + 1 for the
                        ;; outermost parse-then; wrap-defn adds the
                        ;; defn's own close.
                        (closes (+ 1 (* 2 (count ps))))]))

    (let [ref (child-ref (extract (get ps i)) i ctx)
          b (spaces (* 14 i))
          b12 (spaces (+ (* 14 i) 12))]
      (all-body-acc
       (conj
        (append-acc
         (conj acc (to-str [b "(parse-then " (extract (first ref))]))
         (ref-cont-acc [] (rest ref) b12))
        (to-str [b12 "(fn [v" (number-str i) " " (state-var (+ i 1)) "]"]))
        ps
        (+ i 1)
        (cond (str= vs "")
          (to-str ["v" (number-str i)])
          (to-str [vs " v" (number-str i)]))
        ctx))))

;; all-body [ps ctx]: the All body — the nested parse-then over the
;; children's call expressions (site-(c) template).
(defn all-body [ps ctx]
  (all-body-acc [] ps 0 "" ctx))

(extend-type grammar/All (emit-body [v ctx]
  (all-body (.parsers v) ctx)))

;; ignore-body [p ctx]: the Ignore body (site-(c) shape) — parse-or
;; over parse-then with identity as the else-fn; the fn captures
;; nothing.
(defn ignore-body [p ctx]
  (let [ref (child-ref p 0 ctx)]
    (conj
     (append-acc
      (append-acc
       [(to-str ["(parse-or (parse-then " (extract (first ref))])]
        (ref-cont-acc [] (rest ref) (spaces 22)))
      [(to-str [(spaces 22) "(fn [v s2]"])
        (to-str [(spaces 24) "(rdr/ParserIgnore s2)))"])])
     (to-str [(spaces 10) "identity)"]))))

(extend-type grammar/Ignore (emit-body [v ctx]
  (ignore-body (.parser v) ctx)))

;; walk-children [pc]: the child parsers of pc that may need lifting —
;; All -> its parsers; Ignore -> its single child; Rule, String, and
;; the leaf ctors -> [].
(defp walk-children [pc]
  [])

(extend-type grammar/All (walk-children [v] (.parsers v)))

(extend-type grammar/Ignore (walk-children [v] [(.parser v)]))

;; child-lifted? [pc]: Some iff the child gets a lifted helper defn
;; (every anonymous combinator); Rule -> None (referenced by name;
;; its defn is emitted with the rule list); bare String -> None
;; (inlined let-free).
(defp child-lifted? [pc]
  (Some pc))

(extend-type grammar/Rule (child-lifted? [v] None))

(extend-type String (child-lifted? [v] None))

;; emit-helpers [acc ps i prefix ctx]: the lifted helper defn blocks
;; for the children ps[i..] (sub-helpers first, post-order): each
;; lifted child gets the helpers of its own children, then its defn
;; (emit-fn, name = prefix + i, its prefix = name + "-"); the
;; use-after-definition order (a defn body referencing a later
;; top-level symbol fails Undefined symbol) is what puts the
;; sub-helpers first.
(defn emit-helpers [acc ps i prefix ctx]
  (cond (= i (count ps))
    acc

    (let [c (extract (get ps i))]
      (cond (child-lifted? c)
        (let [name (to-str [prefix (number-str i)])]
          (emit-helpers
           (append-acc
            (append-acc acc
                        (emit-helpers [] (walk-children c) 0
                                      (to-str [name "-"]) ctx))
            (emit-fn c name ctx))
           ps (+ i 1) prefix ctx))

        (emit-helpers acc ps (+ i 1) prefix ctx)))))

;; emit-header: module header lines — the add-ns of the helper layer,
;; the parse-then/parse-or kit (Result discrimination, settled in
;; task 1), the ParserError field-access protocols (bare .field on
;; the union is unsafe — new-toc resolves getters by name lookup),
;; and the parse-error-line def.
(defn emit-header []
  [";; gen-rdr.toc - GENERATED by interpreter/intrp-emit.toc (do not edit)."
   ""
   "(add-ns rdr (module \"intrp-rdr.toc\"))"
   ""
   "(defp parse-then [r f])"
   "(extend-type rdr/ParserMatch (parse-then [r f] (f (.value r) (.state r))))"
   "(extend-type rdr/ParserIgnore (parse-then [r f] r))"
   "(extend-type rdr/ParserError (parse-then [r f] r))"
   ""
   "(defp parse-or [r else-f])"
   "(extend-type rdr/ParserMatch (parse-or [r e] r))"
   "(extend-type rdr/ParserIgnore (parse-or [r e] r))"
   "(extend-type rdr/ParserError (parse-or [r e] (e r)))"
   ""
   "(defp parse-error-msg [r])"
   "(extend-type rdr/ParserError (parse-error-msg [v] (.msg v)))"
   ""
   "(defp parse-error-state [r])"
   "(extend-type rdr/ParserError (parse-error-state [v] (.state v)))"
   ""
   ""
   "(defn parse-error-line [file line msg]"
   "  (exit 1 (to-str [file \":\" (number-str line) \":\" msg])))"])

;; emit-rules-acc [acc rules]: one block per Rule — the lifted
;; helpers (sub-helpers first), a blank line, then the parser defn
;; (use-after-definition: a defn body referencing a later top-level
;; symbol fails Undefined symbol); blocks separated by blank lines.
(defn emit-rules-acc [acc rules]
  (cond (= (count rules) 0)
    acc

    (let [r (extract (first rules))
          ctx (EmitCtx (.name r)
                       (to-str [(.name r) "-"]))
          d (append-acc
             (emit-helpers [] (walk-children (.parser r)) 0
                           (to-str [(.name r) "-"]) ctx)
             (wrap-defn (.name r) (emit-body (.parser r) ctx)))]
      (cond (empty? acc)
            (emit-rules-acc d (rest rules))

            (emit-rules-acc (append-acc acc d) (rest rules))))))

;; emit-main: the parse-seq loop + main template lines. parse-seq
;; skips whitespace, runs the entry rule, prints one result line per
;; match (the pr* count threaded through + keeps every print), and on
;; a ParserError prints file:line: msg and exits non-zero.
(defn emit-main [entry]
  ["(defn parse-seq [file state acc]"
   "  (let [s (rdr/skip-whitespace state)]"
   "    (cond (str= (.input s) \"\")"
   "      (rdr/ParserMatch acc s)"
   (to-str ["      (parse-or (parse-then (" entry " s)"])
   "                            (fn [v s2]"
   "                              (parse-seq file (rdr/skip-whitespace s2)"
   "                                          (+ acc (pr* (to-str [v \"\\n\"]))))))"
   "                (fn [e] (parse-error-line file"
   "                                          (rdr/state-line (parse-error-state e))"
   "                                          (parse-error-msg e)))))))"
   ""
   "(main [argv]"
   "  (let [file (extract (get argv 1))]"
   "    (parse-seq file (rdr/make-state (slurp file) file 1) 0)))"])

;; emit-module: the full generated module — header, one parser defn
;; per Rule, the parse-seq loop + main template (the entry rule name
;; spliced into the loop). -> [String]
(defn emit-module [rules entry]
  (append-acc
   (-> (emit-header)
       (emit-rules-acc rules))
   (emit-main entry)))
