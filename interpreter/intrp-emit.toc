;; interpreter/intrp-emit.toc - the parser emitter (library, no main).
;;
;; Takes the parser-combinator grammar data (intrp-grammar.toc) and
;; emits a recursive-descent parser module in Toccata source for it
;; (docs/parser-generator-plan.md).
;;
;; Item 4a (emitter v3, clean slate): phase 1 - analyze. The grammar
;; combinator is analyzed into a NodeIR by ONE fold over the core
;; recursion scheme (hvm-core.toc fold, over the ParserCombinator
;; recurse impls - no new walker). Ref and String are leaves, so the
;; fold terminates structurally even though the generated reader is
;; recursive. The IR carries the classification (char-level?) plus
;; the structure the render phase (items 4b/4c) needs: raw fields on
;; leaves, child IRs on containers. No generated source is built in
;; this phase - the fold's clauses do no to-str over fold-internal
;; (superposed) values (the v2 to-str hazard).
;;
;; DEVIATION from the plan's Settled design (reported 2026-09-27,
;; item 4a as-built): the plan specifies `h` as ONE defn dispatching
;; on type-name ((defn h [v] (h-dispatch (type-name v) v)) with a
;; flat cond). That shape DETERMINISTICALLY MISCOMPILES under
;; new-toc: any fold whose handler is a defn crashes with
;; "Compiler screwed up. Incomplete result" (runtime3.c Tag SUB
;; check) as soon as the fold reaches a ctor whose recurse maps over
;; a vector (Any / All / Concat) - even a plain handler with no cond
;; at all. The protocol shape (defp + one extend-type impl per ctor
;; type, the v1 EBNF emitter's pattern, intrp-ebnf.toc) works: the
;; same fold over the same Any value runs clean. So the handler is
;; the `analyze-node` protocol; `analyze [pc]` = `(fold pc
;; analyze-node)` keeps the plan's entry point.

(add-ns grammar (module "intrp-grammar.toc"))

;; IRNode: the shape of an analyzed node (NodeIR redesign; the
;; multi-ctor replacement for the old NodeIR's positional data
;; vector). No ! annotations (new-toc hazard on multi-field ctors).
;; The field names are unique across every type in the build (grammar
;; and state included), so the render phase can use direct .field
;; getters.
(deftype IRNode
  (CharRange [lo hi])
  (NotChar [ch])
  (Str [lit])
  (Any [any-alts])
  (All [all-parsers])
  (Many [many-child])
  (Rule [rule-name rule-child])
  (Ref [ref-name])
  (Node [node-name node-child])
  (Concat [concat-parsers])
  (Ignore [ignore-child])
  (AlwaysSucceed [as-value])
  (Error [error-msg]))

;; NodeIR: the wrapper - the analyzed node. No ! annotations (new-toc
;; hazard on multi-field ctors).
;;   node        - the IRNode (the shape)
;;   char-level? - Some None iff this node classifies a single char:
;;                 CharRange / NotChar / one-char Str; Any iff ALL
;;                 alts are char-level; Rule / Many iff the child is;
;;                 Ref / Node / Concat / All / Ignore never (Ref is a
;;                 leaf - no force-time global resolution)
(deftype NodeIR [node char-level?])

;; all-ir-char-level? [irs]: Some None iff every IR in irs is
;; char-level (a reduce over the flags - the v1 pre-pass, bottom-up
;; on the IR instead of the combinator).
(defn all-ir-char-level? [irs]
  (reduce irs (Some None)
          (fn [acc ir]
            (and acc (.char-level? ir)))))


;; ir-char-range / ir-not-char: the leaf ctors - recurse leaves them
;; raw, so the fields are the grammar's raw values.
(defn ir-char-range [v]
  (NodeIR (CharRange (.lower v) (.upper v))
          (Some None)))


(defn ir-not-char [v]
  (NodeIR (NotChar (.char v))
          (Some None)))


;; One-char String: char-level (the Ctor table's bare-String pred);
;; a longer literal is not char-level (no grammar node is one).
(defn ir-string [v]
  (cond (= (count v) 1)
    (NodeIR (Str v)
            (Some None))

    (NodeIR (Str v)
            None)))


;; ir-any-dispatch / ir-any: the parameter split (per the plan's
;; Settled design) - the alts vector is computed once and passed as
;; a parameter, so the dispatch cond is flat over a named value.
(defn ir-any-dispatch [cs]
  (cond (all-ir-char-level? cs)
    (NodeIR (Any cs)
            (Some None))

    (NodeIR (Any cs)
            None)))


(defn ir-any [v]
  (ir-any-dispatch (.parsers v)))

;; The container ctors - recurse reassembled them, so the fields
;; hold the children's NodeIRs (the impl knows its ctor). Rule /
;; Many delegate the flag to their child (ctor table); All / Ignore /
;; Node / Concat are never char-level.
(defn ir-all [v]
  (NodeIR (All (.parsers v))
          None))


(defn ir-many [v]
  (let [c (.parser v)]
    (NodeIR (Many c)
            (.char-level? c))))


(defn ir-rule [v]
  (let [c (.parser v)]
    (NodeIR (Rule (.name v) c)
            (.char-level? c))))


;; Ref: a leaf (the fold stops here - the named rule's IR is the
;; driver's to supply at render time; no force-time global
;; resolution). Never char-level for the same reason.
(defn ir-ref [v]
  (NodeIR (Ref (.name v))
          None))


(defn ir-node [v]
  (NodeIR (Node (.name v) (.parser v))
          None))


(defn ir-concat [v]
  (NodeIR (Concat (.parsers v))
          None))


(defn ir-ignore [v]
  (NodeIR (Ignore (.parser v))
          None))


(defn ir-always-succeed [v]
  (NodeIR (AlwaysSucceed (.value v))
          None))


(defn ir-error [v]
  (NodeIR (Error (.msg v))
          None))


;; analyze-node: the fold's handler as a PROTOCOL (one extend-type
;; impl per ctor type - the v1 EBNF pattern). NOT a defn dispatching
;; on type-name: that shape deterministically miscompiles under
;; new-toc for any fold reaching a map-recurse ctor (Any / All /
;; Concat) - "Compiler screwed up. Incomplete result" (Tag SUB),
;; even with a plain no-cond handler. The protocol dispatch is the
;; shape that runs clean (verified 2026-09-27, item 4a).
(defp analyze-node [v]
  ! v grammar/ParserCombinator
  ! -> NodeIR
)


(extend-type grammar/CharRange
  (analyze-node [v]
    (ir-char-range v)))

(extend-type grammar/NotChar
  (analyze-node [v]
    (ir-not-char v)))

(extend-type String
  (analyze-node [v]
    (ir-string v)))

(extend-type grammar/Any
  (analyze-node [v]
    (ir-any v)))

(extend-type grammar/All
  (analyze-node [v]
    (ir-all v)))

(extend-type grammar/Many
  (analyze-node [v]
    (ir-many v)))

(extend-type grammar/Rule
  (analyze-node [v]
    (ir-rule v)))

(extend-type grammar/Ref
  (analyze-node [v]
    (ir-ref v)))

(extend-type grammar/Node
  (analyze-node [v]
    (ir-node v)))

(extend-type grammar/Concat
  (analyze-node [v]
    (ir-concat v)))

(extend-type grammar/Ignore
  (analyze-node [v]
    (ir-ignore v)))

(extend-type grammar/AlwaysSucceed
  (analyze-node [v]
    (ir-always-succeed v)))

(extend-type grammar/Error
  (analyze-node [v]
    (ir-error v)))

;; analyze [pc]: the phase-1 catamorphism - the core fold over the
;; combinator's recurse impls (hvm-core.toc:587). -> NodeIR
(defn analyze [pc]
  (fold pc analyze-node))

;; =====================================================================
;; Phase 2 - render (item 4b.1): the leaf ctors.
;;
;; Each render function returns the source LINES for its IR node:
;; zero or more lifted helper defn lines, then ONE final line - a
;; single Toccata expression that, with the state variable sv in
;; scope, evaluates to a ParserResults. The leaf ctors lift nothing:
;; each returns a one-line vector. Every rendered entry skips
;; whitespace+comments first (skip-at-entry) - the kit's
;; state/skip-whitespace skips both (intrp-state.toc).
;;
;; The generated module's kit is namespaced: state/... (intrp-
;; state.toc); core calls (str-prefix?, subs, char-code, count,
;; vector, ...) are bare. new-toc is single-pass: a defn body may
;; not reference a LATER top-level symbol, so the defns below are
;; ordered callee-first.

;; --- source-literal helpers ------------------------------------------

;; escape-char: one char -> its escaped form inside a Toccata string
;; literal (the generated source must re-parse to the same text).
(defn escape-char [c]
  (cond (str= c "\\")
    "\\\\"

    (str= c "\"")
    "\\\""

    (str= c "\n")
    "\\n"

    (str= c "\r")
    "\\r"

    (str= c "\t")
    "\\t"

    c))

;; escape-str: s's body as the contents of a Toccata string literal.
;; (reduce has no String impl - the walk is a plain recursion.)
(defn escape-str [s]
  (cond (= (count s) 0)
    ""

    (str (escape-char (subs s 0 1))
             (escape-str (subs s 1 (count s))))))

;; render-literal [s]: s as a Toccata string literal (quotes included).
(defn render-literal [s]
  (str "\"" (escape-str s) "\""))

;; --- the entry-skip and the take-char depth ----------------------------

;; skip-expr [sv]: the entry-skip expression over state variable sv.
(defn skip-expr [sv]
  (str "(state/skip-whitespace " sv ")"))

;; take-chars [n sv]: n nested (state/take-char ...) over sv (n >= 1)
;; - the multi-char literal's consumption, let-free.
(defn take-chars [n sv]
  (cond (= n 1)
    (str "(state/take-char " sv ")")

    (str "(state/take-char " (take-chars (- n 1) sv) ")")))

;; --- leaf renders (let-free, inlined at use sites) --------------------

;; one-char-test [c]: the empty-input guard over one-char string c
;; (char-code of the empty subs reads the NUL terminator, 0 - the
;; guard keeps a range containing code 0 from matching empty input).
(defn one-char-test [c]
  (str "(not (str= " c " \"\"))"))

;; char-range-test [lo hi c]: the range pred over one-char string c.
(defn char-range-test [lo hi c]
  (str "(and (<= (char-code " (render-literal lo) ") (char-code " c "))"
            " (<= (char-code " c ") (char-code " (render-literal hi) ")))" ))

;; render-char-range [ir sv]: the one-char parser (ctor table) - skip
;; first, then the range pred; the value the char consumed.
(defn render-char-range [ir sv]
  (let [lo (.lo ir)
        hi (.hi ir)
        SV (skip-expr sv)
        C (str "(subs " SV " 0 1)")
        msg (render-literal (str "expected a character in the range " lo "-" hi))]
    (vector (str "(cond (and " (one-char-test C) " " (char-range-test lo hi C) ")"
                      " (state/ParserMatch " C " (state/take-char " SV "))"
                      " (state/ParserError " msg " " SV "))"))))

;; render-not-char [ir sv]: the one-char parser (ctor table) - skip
;; first, then the not-equal pred.
(defn render-not-char [ir sv]
  (let [ch (.ch ir)
        SV (skip-expr sv)
        C (str "(subs " SV " 0 1)")
        msg (render-literal (str "expected a character other than " ch))]
    (vector (str "(cond (and " (one-char-test C) " (not (str= " C " " (render-literal ch) "))"
                      ")"
                      " (state/ParserMatch " C " (state/take-char " SV "))"
                      " (state/ParserError " msg " " SV "))"))))

;; render-string [ir sv]: the bare-String literal match (ctor table) -
;; (str-prefix? S input) + N take-chars (N = the literal's length, 1
;; for one char); let-free.
(defn render-string [ir sv]
  (let [lit (.lit ir)
        SV (skip-expr sv)
        L (render-literal lit)
        msg (render-literal (str "expected " lit))]
    (vector (str "(cond (str-prefix? " L " (.input " SV "))"
                      " (state/ParserMatch " L " " (take-chars (count lit) SV) ")"
                      " (state/ParserError " msg " " SV "))"))))

;; render-ref [ir sv]: a call to the named rule over the threaded
;; state (ctor table) - self or mutual, uniformly.
(defn render-ref [ir sv]
  (vector (str "(" (.ref-name ir) " " sv ")")))

;; always-value-dispatch: the AlwaysSucceed constant's source form -
;; a String literal or the empty vector (the deftype-ctor empty field
;; list). The parameter split (the type name passed as a parameter -
;; the proven-safe dispatch shape).
(defn always-value-dispatch [k v sv]
  (cond (str= k "String")
    (str "(state/ParserMatch " (render-literal v) " " sv ")")

    (str= k "Vector")
    (cond (= (count v) 0)
      (str "(state/ParserMatch empty-vector " sv ")")

      (abort "render-always: unsupported vector value"))

    (abort (str "render-always: unsupported value type: " k))))

;; render-always [ir sv]: (state/ParserMatch <v> sv) (ctor table).
(defn render-always [ir sv]
  (let [v (.as-value ir)]
    (vector (always-value-dispatch (type-name v) v sv))))

;; render-error [ir sv]: (state/ParserError MSG sv) (ctor table).
(defn render-error [ir sv]
  (vector (str "(state/ParserError " (render-literal (.error-msg ir)) " " sv ")")))

;; =====================================================================
;; Phase 2 - render (item 4b.2): the wrapper ctors.
;;
;; The wrappers render the child(ren) first, then wrap the result. Each
;; returns source LINES (a Vector of Strings): zero or more lifted
;; helper defn lines (none yet - lifting is 4b.4/4b.5), then ONE final
;; line - a single Toccata expression that, with the state variable sv
;; in scope, evaluates to a ParserResults.
;;
;;   Ignore [p]  - parse-and-discard: parse the child, discard its
;;                 value, thread the state. Standalone value is the unit
;;                 (empty-vector); the enclosing All (4b.3) excludes it
;;                 from the value vector. The discard fn binds _ (the
;;                 child's value) and threads s2.
;;   Concat [ps] - parse the children in sequence (nested parse-then),
;;                 flatten-join their string values into ONE string.
;;   Node [n p]  - the child's value becomes the raw-AST ctor call
;;                 (raw/<n> <args...> <auto-loc>); the auto-loc is the
;;                 line where the form started (the entry state sv,
;;                 whitespace-skipped).
;;
;; The render dispatch (render-child) and the wrapper renders are
;; mutually recursive (the wrappers render their children via the
;; dispatch). new-toc is single-pass (a defn body may not reference a
;; LATER top-level symbol), so the dispatch is crutch-declared
;; ((def render-child)) before the wrappers, and its defn comes after
;; the wrappers it calls.

;; --- value-shape helpers (for Concat's join and Node's spread) -------

;; char-level [ir]: true iff the IR node classifies a single char
;; (the NodeIR wrapper's char-level? is Some).
(defn char-level [ir]
  (str= (type-name (.char-level? ir)) "Some"))


;; ir-value-shape [ir]: "string" iff the position's value is a single
;; String; "vector" iff it is a Vector of strings. Structural (the IR),
;; per the value-shape discipline (every alt of an Any feeding a shared
;; position yields the same shape).
;;   - char-level leaves (CharRange / NotChar / Str) and Concat
;;     -> "string"
;;   - Many -> "string" iff char-level (fast path, one run string),
;;     else "vector" (slow path, vector of child values)
;;   - All -> "vector" (vector of non-Ignore sub-values)
;;   - Any / Rule -> the first-alt / child's shape
;;   - AlwaysSucceed -> the constant's type (String -> "string",
;;     Vector -> "vector")
;;   - Ref / Node / Ignore / Error -> abort (Ref needs the rule set,
;;     supplied at module assembly 4c.2; the rest are not value sources
;;     in scope (a))
(defn ir-value-shape [ir]
  (let [n (.node ir)]
    (cond (str= (type-name n) "CharRange")
      "string"

      (str= (type-name n) "NotChar")
      "string"

      (str= (type-name n) "Str")
      "string"

      (str= (type-name n) "Concat")
      "string"

      (str= (type-name n) "All")
      "vector"

      (str= (type-name n) "Any")
      (ir-value-shape (extract (get (.any-alts n) 0)))

      (str= (type-name n) "Rule")
      (ir-value-shape (.rule-child n))

      (str= (type-name n) "Many")
      (cond (char-level (.many-child n))
        "string"

        "vector")

      (str= (type-name n) "AlwaysSucceed")
      (let [v (.as-value n)]
        (cond (str= (type-name v) "String")
          "string"

          (str= (type-name v) "Vector")
          "vector"

          (abort (str "ir-value-shape: unsupported AlwaysSucceed value: " (type-name v)))))

      (abort (str "ir-value-shape: unsupported kind: " (type-name n))))))

;; ir-value-arity [ir]: the static arity of a "vector"-shaped value (the
;; number of ctor args a Node spreads it into). Only meaningful when
;; ir-value-shape is "vector".
;;   - All -> the count of non-Ignore children
;;   - Any / Rule -> the first-alt / child's arity
;;   - Many (slow) -> abort (dynamic arity - not spreadable; not in
;;     scope (a))
(defn ir-value-arity [ir]
  (let [n (.node ir)]
    (cond (str= (type-name n) "All")
      (let [cs (.all-parsers n)]
        (reduce cs 0
                (fn [acc c]
                  (cond (str= (type-name (.node c)) "Ignore")
                    acc

                    (+ acc 1)))))

      (str= (type-name n) "Any")
      (ir-value-arity (extract (get (.any-alts n) 0)))

      (str= (type-name n) "Rule")
      (ir-value-arity (.rule-child n))

      (abort (str "ir-value-arity: unsupported kind: " (type-name n))))))

;; vec-arg-exprs [v n]: n arg expressions extracting elements 0..n-1
;; of the value vector bound to variable v: (extract (get v i)).
(defn vec-arg-exprs [v n]
  (cond (= n 0)
    (vector)

    (conj (vec-arg-exprs v (- n 1))
          (str "(extract (get " v " " (- n 1) ")"))))

;; node-value-args [child-ir v]: the ctor arg expressions (no auto-loc)
;; for a Node whose child has IR child-ir and whose value is bound to
;; variable v. A "string"-shaped child contributes one arg (v); a
;; "vector"-shaped child contributes its arity many args (extracted
;; elements).
(defn node-value-args [child-ir v]
  (let [shape (ir-value-shape child-ir)]
    (cond (str= shape "string")
      (vector v)

      (str= shape "vector")
      (vec-arg-exprs v (ir-value-arity child-ir))

      (abort (str "node-value-args: bad shape: " shape)))))

;; concat-fragment [child-ir vi]: the string fragment for a Concat child
;; whose value is bound to variable vi. A "string" value is used as-is;
;; a "vector" value is flatten-joined to one string.
(defn concat-fragment [child-ir vi]
  (let [shape (ir-value-shape child-ir)]
    (cond (str= shape "string")
      vi

      (str= shape "vector")
      (str "(reduce " vi " \"\" (fn [acc s] (str acc s)))")

      (abort (str "concat-fragment: bad shape: " shape)))))

;; concat-fragments [cs vnames i]: the string fragments for children
;; 0..i-1 (a Vector of String, in child order). Recurses i down to 0
;; (conj appends to the end, so the forward 0->n order is preserved).
(defn concat-fragments [cs vnames i]
  (cond (= i 0)
    (vector)

    (conj (concat-fragments cs vnames (- i 1))
          (concat-fragment (extract (get cs (- i 1))) (extract (get vnames (- i 1)))))))

;; join-strings [sep vs]: vs joined with sep (a String).
(defn join-strings [sep vs]
  (cond (= (count vs) 0)
    ""

    (= (count vs) 1)
    (extract (first vs))

    (str (join-strings sep (butlast vs)) sep (extract (last vs)))))

;; build-join [cs vnames]: the Toccata source of the Concat join over the
;; value variables. Each child's value is a string fragment (the value
;; var for string-shaped children, a flatten for vector-shaped children);
;; the fragments are joined with (str ...).
(defn build-join [cs vnames]
  (let [n (count cs)]
    (cond (= n 0)
      "\"\""

      (= n 1)
      (concat-fragment (extract (get cs 0)) (extract (get vnames 0)))

      (str "(str " (join-strings " " (concat-fragments cs vnames (count cs))) ")"))))

;; gen-vnames [n]: n value variable names ["v0" ... "v(n-1)"].
(defn gen-vnames [n]
  (cond (= n 0)
    (vector)

    (conj (gen-vnames (- n 1)) (str "v" (- n 1)))))

;; --- the render dispatch (crutch-declared; the wrappers call it) -----

(def render-child)

;; concat-tail [cs i sv vnames join]: the source lines for Concat
;; children i..n-1, threading the state. Returns a Vector of Strings:
;; the children's helper lines, then ONE final line - the nested
;; parse-then over sv (the base case is the final ParserMatch).
(defn concat-tail [cs i sv vnames join]
  (cond (= i (count cs))
    (vector (str "(state/ParserMatch " join " " sv ")"))

    (let [res (render-child (extract (get cs i)) sv)
          snext (str "s" (+ i 1))
          inner (concat-tail cs (+ i 1) snext vnames join)]
      (comp (comp (butlast res) (butlast inner))
            (vector (str "(parse-then " (extract (last res)) " (fn [" (extract (get vnames i)) " " snext "] " (extract (last inner)) ")"))))))

;; render-ignore [ir sv]: the Ignore wrapper (ctor table) - parse the
;; child, discard the value (the fn binds _), thread the state; the
;; standalone value is the unit (empty-vector).
(defn render-ignore [ir sv]
  (let [res (render-child (.ignore-child ir) sv)]
    (comp (butlast res)
          (vector (str "(parse-then " (extract (last res)) " (fn [_ s2] (state/ParserMatch empty-vector s2))))")))))

;; render-concat [ir sv]: the Concat wrapper (ctor table) - parse the
;; children in sequence (nested parse-then), flatten-join their string
;; values into ONE string.
(defn render-concat [ir sv]
  (let [cs (.concat-parsers ir)
        vnames (gen-vnames (count cs))]
    (concat-tail cs 0 sv vnames (build-join cs vnames))))

;; render-node [ir sv]: the Node wrapper (ctor table) - the child's value
;; becomes the raw-AST ctor call (raw/<name> <args...> <auto-loc>); the
;; auto-loc is the line where the form started (the entry state sv,
;; whitespace-skipped).
(defn render-node [ir sv]
  (let [child (.node-child ir)
        res (render-child child sv)]
    (comp (butlast res)
          (vector (str "(parse-then " (extract (last res)) " (fn [v s2] (state/ParserMatch (raw/" (.node-name ir) " " (join-strings " " (comp (node-value-args child "v") (vector (str "(state/state-line (state/skip-whitespace " sv "))")))) ") s2))))")))))

;; render-child [ir sv]: the render dispatch - the source lines for ir
;; over the state variable sv. The leaf ctors (4b.1) and the wrapper
;; ctors (4b.2); the remaining ctors (Any / All / Many / Rule) are the
;; later items (4b.3-4b.7).
(defn render-child [ir sv]
  (let [k (type-name (.node ir))]
    (cond (str= k "CharRange")
      (render-char-range (.node ir) sv)

      (str= k "NotChar")
      (render-not-char (.node ir) sv)

      (str= k "Str")
      (render-string (.node ir) sv)

      (str= k "Ref")
      (render-ref (.node ir) sv)

      (str= k "AlwaysSucceed")
      (render-always (.node ir) sv)

      (str= k "Error")
      (render-error (.node ir) sv)

      (str= k "Ignore")
      (render-ignore (.node ir) sv)

      (str= k "Concat")
      (render-concat (.node ir) sv)

      (str= k "Node")
      (render-node (.node ir) sv)

      (abort (str "render-child: not yet implemented: " k)))))
