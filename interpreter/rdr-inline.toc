;; interpreter/rdr-inline.toc — item-6f verification driver.
;;
;; Parses top-level and expression-level `inline` forms through
;; intrp-rdr.toc's parse-program and checks each yields the settled
;; Inline shape (ast/Inline [type-expr c-code loc], type-expr None or
;; Some of one ordinary expression):
;;   1. top-level, no type:    (inline "int x;")
;;   2. top-level, with type:  (inline Integer "int y;")
;;   3. expression, no type:   (def a (inline "int z;"))
;;   4. expression, with type: (def b (inline String "int w;"))
;;   5. source order:          def, inline, defn -> [Definition Inline
;;                             Definition]
;;
;; Expected output: 5 "OK" lines (one per sample). Any "FAIL" line
;; indicates a problem. Run from the repo root: ./rdr-inline
;;
;; The driver is interpreter-side tooling; interpreted programs may not
;; use these constructs.

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; inline-*: extract an Inline's fields (receiver statically Inline).
(defp inline-te [v])
(extend-type ast/Inline (inline-te [v] (.type-expr v)))

(defp inline-code [v])
(extend-type ast/Inline (inline-code [v] (.c-code v)))

;; def-value: a Definition's value (receiver statically Definition).
(defp def-value [v])
(extend-type ast/Definition (def-value [v] (.value v)))

;; sym-name: a Symbol's name (receiver statically Symbol).
(defp sym-name [e])
(extend-type ast/Symbol (sym-name [e] (.sym-name e)))

;; te-fp-of: a type-expr payload (Expression) -> "sym <name>" for a
;; Symbol, else "?".
(defp te-fp-of [e] "?")
(extend-type ast/Symbol (te-fp-of [e] (str* ["sym " (sym-name e)])))

;; te-fingerprint: an Inline's type-expr -> "None" or "sym <name>".
(defn te-fingerprint [te]
  (cond te
    (te-fp-of (extract te))

    "None"))

;; inline-fingerprint: an Inline node -> "inline <te> <c-code>".
(defn inline-fingerprint [v]
  (str* ["inline " (te-fingerprint (inline-te v)) " " (inline-code v)]))

;; node-fp: one TopLevel node -> a fingerprint string.
;;   Inline     -> "inline <te> <c-code>"
;;   Definition -> "def inline ..." if the value is an Inline, else
;;                 "def v"
;;   other      -> "k"
(defp node-fp [v] "k")
(extend-type ast/Inline (node-fp [v] (inline-fingerprint v)))
;; def-value-fp: a Definition's value -> "def <inline-fp>" if the value
;; is an Inline, else "def v".
(defp def-value-fp [val] "def v")
(extend-type ast/Inline (def-value-fp [val] (str* ["def " (inline-fingerprint val)])))

(extend-type ast/Definition
  (node-fp [v]
    (def-value-fp (def-value v))))

;; node-fingerprint: plain-function wrapper around node-fp so map can
;; take it as its function value.
(defn node-fingerprint [v]
  (node-fp v))

;; vec-fingerprint: the [TopLevel] vector -> one fingerprint string
;; (nodes in source order, no separators).
(defn vec-fingerprint [v]
  (str* (map v node-fingerprint)))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side
;; effect (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (let [s (extract (first strs))]
      (print-all-acc (+ acc (pr* s)) (rest strs)))))

;; check: parse one source; verify the vector's fingerprint matches the
;; expected one. Prints one status line. Returns the threaded acc.
(defn check [acc src expected]
  (let [r (rdr/parse-program (rdr/make-state src "inline-test.toc" 1))]
    (rdr/check-error r
                     (let [st (.state r)
                           line (rdr/state-line st)
                           msg (.msg r)]
                       (print-all-acc acc
                                      ["FAIL(parse) line " (number-str line) ": " msg "\n"]))

                     (let [v (.value r)
                           fp (vec-fingerprint v)]
                       (cond (str= fp expected)
                         (print-all-acc acc ["OK " fp "\n"])

                         (print-all-acc acc
                                        ["FAIL got: " fp " want: " expected "\n"]))))))

(main [_]
  (let [r1 (check 0
            "(inline \"int x;\")"
            "inline None int x;")
        r2 (check r1
            "(inline Integer \"int y;\")"
            "inline sym Integer int y;")
        r3 (check r2
            "(def a (inline \"int z;\"))"
            "def inline None int z;")
        r4 (check r3
            "(def b (inline String \"int w;\"))"
            "def inline sym String int w;")
        r5 (check r4
            "(def a 1)\n(inline \"int q;\")\n(defn f [x]\n  x)\n"
            "def vinline None int q;def v")]
    r5))
