;; intrp-grammar.toc - parser-combinator grammar data (v3).
;;
;; Two deftypes of combinator. ParserCombinator - the input-matching
;; combinators (v3 ctor set: CharRange, NotChar, All, Any, Many, Rule,
;; Ref, Ignore, AlwaysSucceed, Error, plus bare String literals).
;; ValueProducers - the value-producing combinators (Node, Concat): the
;; two whose render consumes a child's value to build the output value
;; (Node spreads it into a raw ctor, Concat joins it into one string).
;; Plus the token and literal rules of the scope-(a) grammar, as purely
;; acyclic data. Every reference from one rule to another is a Ref - no
;; Rule value ever appears inside another rule, so the rules carry no
;; ordering constraints. Whitespace and comments are helper-layer
;; (intrp-state.toc), never grammar.
;;
;; No `!` annotations on the multi-field ParserCombinator ctors
;; (new-toc hazard).
;;
;; This file is a LIBRARY (no main).
(deftype ParserCombinator
  (Ignore [parser]
    (recurse [v f]
      (Ignore (f (.parser v))))
    (str-vect [x]
      (flat-map ["(Ignore " (.parser x) ")"] str-vect)))
  (CharRange [lower upper]
    (recurse [v f]
      v)
    (str-vect [x]
      (flat-map ["(CharRange " (.lower x) " " (.upper x) ")"] str-vect)))
  (AlwaysSucceed [value]
    (recurse [v f]
      v)
    (str-vect [x]
      (flat-map ["(AlwaysSucceed " (.value x) ")"] str-vect)))
  (NotChar [char]
    (recurse [v f]
      v)
    (str-vect [x]
      (flat-map ["(NotChar " (.char x) ")"] str-vect)))
  (Error [msg]
    (recurse [v f]
      v)
    (str-vect [x]
      (flat-map ["(Error " (.msg x) ")"] str-vect)))
  (All [parsers]
    (recurse [v f]
      (All (map (.parsers v) f)))
    (str-vect [x]
      (flat-map ["(All " (flat-map (.parsers x) str-vect) ")"] str-vect)))
  (Any [parsers]
    (recurse [v f]
      (Any (map (.parsers v) f)))
    (str-vect [x]
      (flat-map ["(Any " (flat-map (.parsers x) str-vect) ")"] str-vect)))
  (Many [parser]
    (recurse [v f]
      (Many (f (.parser v))))
    (str-vect [x]
      (flat-map ["(Many " (.parser x) ")"] str-vect)))
  (Rule [name parser]
    (recurse [v f]
      (Rule (.name v) (f (.parser v))))
    (str-vect [x]
      (flat-map ["(Rule " (.name x) " " (.parser x) ")"] str-vect)))
  (Ref [name]
    (recurse [v f]
      v)
    (str-vect [x]
      ["(Ref " (.name x) ")"])))

(deftype ValueProducers
    (Node [name parser]
      (recurse [v f]
               (Node (.name v) (f (.parser v))))
      (str-vect [x]
                (flat-map ["(Node " (.name x) " " (.parser x) ")"] str-vect)))
  (Concat [parsers]
    (recurse [v f]
             (Concat (map (.parsers v) f)))
    (str-vect [x]
              (flat-map ["(Concat " (flat-map (.parsers x) str-vect) ")"] str-vect))))

(def digits (Rule "digits" (CharRange "0" "9")))

(def upper-case (CharRange "A" "Z"))

(def lower-case (CharRange "a" "z"))

; Parser Rules for Toccata Constructs
(def alpha (Rule "alpha" (Any [lower-case upper-case])))
(def symbol-start
  (Rule "symbol-start"
        (Any [(Ref "alpha") "." "_" "<" ">" "=" "+" "-" "*" "/"])))
(def rest-of-symbol
  (Rule "rest-of-symbol"
        (Any [(Ref "alpha") (Ref "digits") "." "_" "<" ">" "=" "+" "-" "*" "?" "!"])))

(def symbol
  (Rule "symbol"
        (Node "Symbol"
              (Concat [(Ref "symbol-start") (Many (Ref "rest-of-symbol"))]))))

; Number Literals
(def int-literal
  (Rule "int-literal"
        (Node "IntegerLit"
              (Concat [(Ref "digits") (Many (Ref "digits"))]))))

; String Literals
(def escaped-char (Rule "escaped-char" (All ["\\" (Any ["\\" "\"" "n" "r" "t"])])))
(def string
  (Rule "string"
        (Node "StringLit"
              (All [(Ignore "\"")
                    (Concat [(Many (Any [(NotChar "\"") (Ref "escaped-char")]))])
                    (Ignore "\"")]))))

; Expressions
(def expression
  (Rule "expression"
        (Any [(Ref "int-literal")
              (Ref "string")
              (Ref "symbol")
              (All ["(" (Ref "expression") (Many (Ref "expression")) ")"])])))
