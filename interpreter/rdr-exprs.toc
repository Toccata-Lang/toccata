;; interpreter/rdr-exprs.toc — item-5 verification driver.
;;
;; Parses sample expressions through intrp-rdr.toc's unfold-expr (ana),
;; desugars them with intrp-ast.toc's desugar (transCata), and prints,
;; per sample: the result kind (0 = success) and the Call operator's
;; name (the desugaring fingerprint).
;;
;; Expected:
;;   kind 0 op=lit :: 42
;;   kind 0 op=lit :: "hi"
;;   kind 0 op=lit :: 'sym
;;   kind 0 op=lit :: foo
;;   kind 0 op=vect-conj :: [1 2]
;;   kind 0 op=assoc :: {k 1}
;;   kind 0 op=? :: (let [x 1] x)
;;   kind 0 op=cond :: (cond a b c)
;;   kind 0 op=and :: (and a b c)
;;   kind 0 op=str* :: (str a b)
;;   kind 0 op=println* :: (println a)
;;   kind 0 op=g :: (-> x .f g)
;;   kind 0 op=lit :: (fn [a] a)
;;   kind 0 op=f :: (f a b)
;; ("lit" = a non-Call value; "?" = a Call whose operator is neither a
;; Symbol nor a FieldGetter — e.g. the let desugar's anonymous Fn.)

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; val-kind: tag the top-level desugared value (local protocol).
(defp val-kind [v])
(extend-type ast/Call (val-kind [_] 0))
(extend-type ast/IntegerLit (val-kind [_] 1))
(extend-type ast/StringLit (val-kind [_] 2))
(extend-type ast/Symbol (val-kind [_] 3))
(extend-type ast/Fn (val-kind [_] 4))

;; op-kind: tag a Call's operator.
(defp op-kind [o])
(extend-type ast/Symbol (op-kind [_] 1))
(extend-type ast/FieldGetter (op-kind [_] 2))
(extend-type ast/Fn (op-kind [_] 3))

;; op-name: the operator's name for a parsed Call.
(defn op-name [v]
  (let [op (.operator v)
        k (op-kind op)]
    (cond
      (= k 1) (.name op)
      (= k 2) (.field-name op)
      "?")))

;; show: parse + desugar one sample; print "kind 0 op=<name> :: <sample>".
(defn show [s]
  (let [tree (rdr/unfold-expr (rdr/make-state s "sample.toc" 1))
        ;; expr (ast/desugar tree)
        ;; k (val-kind expr)
        ;; op (cond (= k 0)
        ;;          (op-name expr)
        ;;          "lit")
        ;; a (pr* "kind 0")
        ;; b (pr* " op=")
        ;; c (pr* op)
        ;; d (pr* " :: ")
        ;; e (pr* s)
        ;; f (pr* "\n")
        ]
    ;; (+ acc (+ a (+ b (+ c (+ d (+ e f))))))

    ;; (println "kind 0 op=" op " :: " s)
    (println "tree" tree)
    ))

(main [_]
      [(show "42")
       (show "sym")
       (show "\"hi\"")
       (show "'sym")
       (show "foo")
       (show "(println a)")
       (show "(fn [a] a)")]

      ;; Expressions that return a SUP
      ;; (show "{k 1}")
      ;; (show "(let [x 1] x)")

      ;; Expressions that return a SUB
      ;; (show "[1 2]")
      ;; (show "(cond a b c)")
      ;; (show "(and a b c)")
      ;; (show "(str a b)")
      ;; (show "(-> x .f g)")
      ;; (show "(f a b)")
      )
