;; interpreter/rdr-exprs.toc — item-5 verification driver.
;;
;; Parses sample expressions through intrp-rdr.toc's parse-expr
;; (single-pass recursive descent; the tree comes back already
;; desugared) and prints, per sample: the result kind (0 = success)
;; and the Call operator's name (the desugaring fingerprint).
;;
;; The lazy machine only runs side effects the final result depends
;; on, so each show threads its pr* counts into its return value and
;; main's result is a vector of the show results — a strict
;; combination that forces every print.
;;
;; Expected (sorted):
;;   kind 0 op=lit :: "hi"
;;   kind 0 op=lit :: 'sym
;;   kind 0 op=lit :: 42
;;   kind 0 op=lit :: (fn [a] a)
;;   kind 0 op=lit :: foo
;;   kind 0 op=lit :: sym
;;   kind 0 op=? :: (let [x 1] x)
;;   kind 0 op=and :: (and a b c)
;;   kind 0 op=assoc :: {k 1}
;;   kind 0 op=cond :: (cond a b c)
;;   kind 0 op=f :: (f a b)
;;   kind 0 op=g :: (-> x .f g)
;;   kind 0 op=println* :: (println zaz)
;;   kind 0 op=str* :: (str a b)
;;   kind 0 op=vect-conj :: [1 2]
;; ("lit" = a non-Call value; "?" = a Call whose operator is neither a
;; Symbol nor a FieldGetter — e.g. the let desugar's anonymous Fn.)

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; val-kind: tag the top-level desugared value (local protocol).
(defp val-kind [v])
(extend-type ast/Call (val-kind [_] 0))
(extend-type ast/IntegerLit (val-kind [_] 1))
(extend-type ast/StringLit (val-kind [_] 2))
(extend-type ast/Symbol (val-kind [_] 3))
(extend-type ast/Fn (val-kind [_] 4))

;; op-kind: tag a Call's operator.
(defp op-kind [o])
(extend-type ast/Symbol (op-kind [_] 1))
(extend-type ast/FieldGetter (op-kind [_] 2))
(extend-type ast/Fn (op-kind [_] 3))

;; op-name: the operator's name for a parsed Call.
(defn op-name [v]
  (let [op (.operator v)
        k (op-kind op)]
    (cond
      (= k 1) (.sym-name op)
      (= k 2) (.field-name op)
      "?")))

;; show: parse one sample; print "op=<name> :: <sample>";
;; return the threaded print counts.
(defn show [s]
  (let [p (rdr/parse-expr (rdr/make-state s "sample.toc" 1))
        expr (.value p)
        k (val-kind expr)
        op (cond (= k 0)
                 (op-name expr)
                 "lit")]
    (println "op=" op " :: " s)))

(main [_]
  (show "42")
  (show "sym")
  (show "\"hi\"")
  (show "'sym")
  (show "foo")
  (show "(println zaz)")
  (show "(fn [a] a)")
  (show "{k 1}")
  (show "(let [x 1] x)")
  (show "[1 2]")
  (show "(cond a b c)")
  (show "(and a b c)")
  (show "(or a b c)")
  (show "(str a b)")
  (show "(f a b)")
  (show "(-> x .f g)"))
