;; interpreter/rdr-hvmcore.toc — item-6g acceptance driver.
;;
;; Runs intrp-rdr.toc's parse-program over hvm-core.toc (the phase-1
;; acceptance target) and checks:
;;   1. the result is a ParserMatch (not a ParserError)
;;   2. the [TopLevel] vector has exactly 194 nodes
;;   3. the per-form counts: 108 defn, 5 def, 58 defp, 5 deftype,
;;      16 extend-type, 2 top-level inline, 0 other
;;   4. a spot-check of one defp (type-name), one deftype (Maybe),
;;      one extend-type (None), and one top-level inline (first node)
;;
;; Expected output: a "count ..." line, 4 spot-check lines, and a final
;; "OK"/"FAIL" line. Any "FAIL" indicates a problem. Run from the repo
;; root: ./rdr-hvmcore
;;
;; The driver is interpreter-side tooling, so it may use inline C (the
;; slurp whole-file read). Interpreted programs may not.

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; slurp: whole-file read -> String (inline C).
(defn slurp [path]
  ! path String
  (inline String "
    String *p = (String *)path_1;
    FILE *fd = fopen(p->buffer, \"rb\");
    dec_and_free((Term)p, 1);
    if (fd == NULL) {
      fprintf(stderr, \"slurp: cannot open file\\n\");
      abort();
    }
    fseek(fd, 0, SEEK_END);
    long len = ftell(fd);
    fseek(fd, 0, SEEK_SET);
    String *s = malloc_string(len + 1);
    if (len > 0) fread(s->buffer, 1, len, fd);
    s->len = len;
    s->buffer[len] = 0;
    fclose(fd);
    result = termVal((Term)s);
  "))

;; maybe-kind: tag a Maybe (instance? is unsupported under new-toc).
(defp maybe-kind [m])
(extend-type None (maybe-kind [_] 0))
(extend-type Some (maybe-kind [_] 1))

;; top-kind: tag a TopLevel value (the vector's elements are the
;; TopLevel union; field getters need a concrete ctor, so the per-ctor
;; extraction protocols below are guarded by this tag).
(defp top-kind [v])
(extend-type ast/Definition (top-kind [_] 0))
(extend-type ast/Defp (top-kind [_] 1))
(extend-type ast/Main (top-kind [_] 2))
(extend-type ast/DefType (top-kind [_] 3))
(extend-type ast/ExtendType (top-kind [_] 4))
(extend-type ast/AddNs (top-kind [_] 5))
(extend-type ast/Inline (top-kind [_] 6))

;; top-name: the name of a TopLevel node (Main is nameless — its name is
;; the implicit "main"; AddNs uses its namespace; Inline is nameless).
;; Used by find-by-name.
(defp top-name [v])
(extend-type ast/Definition (top-name [v] (.name v)))
(extend-type ast/Defp (top-name [v] (.name v)))
(extend-type ast/Main (top-name [_] "main"))
(extend-type ast/DefType (top-name [v] (.type-name v)))
(extend-type ast/ExtendType (top-name [v] (.type-name v)))
(extend-type ast/AddNs (top-name [v] (.namespace v)))
(extend-type ast/Inline (top-name [_] ""))

;; find-by-name: the first node in the [TopLevel] vector whose name
;; matches, or None. Self-recursive.
(defn find-by-name-acc [v name]
  (cond (= (count v) 0)
    None
    (let [e (extract (first v))
          match (maybe-kind (str= (top-name e) name))]
      (cond (= match 1)
        (Some e)
        (find-by-name-acc (rest v) name)))))

(defn find-by-name [v name]
  (find-by-name-acc v name))

;; expr-kind: tag an Expression (a Definition's value) — distinguishes
;; defn (Fn value) from def (Inline value) from other.
(defp expr-kind [e])
(extend-type ast/Inline (expr-kind [_] 0))
(extend-type ast/Fn (expr-kind [_] 1))

;; def-value: a Definition's value (receiver statically Definition).
(defp def-value [v])
(extend-type ast/Definition (def-value [v] (.value v)))

;; def-value-class: a Definition's value -> 0 (Fn: defn), 1 (Inline:
;; def), 6 (other).
(defn def-value-class [val]
  (let [ek (expr-kind val)]
    (cond (= ek 1)
      0
      (= ek 0)
      1
      6)))

;; node-class: a TopLevel node -> a form tag:
;;   0 defn (Definition, Fn value)
;;   1 def  (Definition, Inline value)
;;   2 defp
;;   3 deftype
;;   4 extend-type
;;   5 top-level inline
;;   6 other (Main, AddNs, Definition with another value)
(defn node-class [v]
  (let [k (top-kind v)]
    (cond (= k 0)
      (def-value-class (def-value v))

      (= k 1)
      2

      (= k 3)
      3

      (= k 4)
      4

      (= k 6)
      5

      6)))

;; count-class-acc: how many nodes in the vector carry the given form
;; tag. Explicit recursion, NOT reduce: a reduce closure capturing the
;; free variable `cls` leaks term pairs on the lazy machine (buffer
;; exhaustion over hvm-core.toc — verified with a probe); `cls` is
;; threaded as a plain parameter instead (the same workaround as
;; intrp-rdr.toc's threading-acc).
(defn count-class-acc [v cls acc]
  (cond (= (count v) 0)
    acc
    (let [e (extract (first v))]
      (cond (= (node-class e) cls)
        (count-class-acc (rest v) cls (+ acc 1))
        (count-class-acc (rest v) cls acc)))))

(defn count-class [v cls]
  (count-class-acc v cls 0))

;; counts-fingerprint: the per-form tallies -> one fingerprint string.
(defn counts-fingerprint [vc c-defn c-def c-defp c-deftype c-ext c-inline c-other]
  (str* ["total=" (number-str vc)
         " defn=" (number-str c-defn)
         " def=" (number-str c-def)
         " defp=" (number-str c-defp)
         " deftype=" (number-str c-deftype)
         " extend-type=" (number-str c-ext)
         " inline=" (number-str c-inline)
         " other=" (number-str c-other)]))

;; --- Spot-check field extraction (receiver statically the concrete
;; --- ctor, guarded by the top-kind tag at the call site).

;; defp-*: a Defp's fields.
(defp defp-name [v])
(extend-type ast/Defp (defp-name [v] (.name v)))

(defp defp-params [v])
(extend-type ast/Defp (defp-params [v] (.parameter-list v)))

;; deftype-*: a DefType's fields.
(defp deftype-name [v])
(extend-type ast/DefType (deftype-name [v] (.type-name v)))

(defp deftype-ctors [v])
(extend-type ast/DefType (deftype-ctors [v] (.constructors v)))

;; ctor-*: a Constructor's fields.
(defp ctor-name [v])
(extend-type ast/Constructor (ctor-name [v] (.name v)))

(defp ctor-fields [v])
(extend-type ast/Constructor (ctor-fields [v] (.field-list v)))

;; ext-*: an ExtendType's fields.
(defp ext-name [v])
(extend-type ast/ExtendType (ext-name [v] (.type-name v)))

(defp ext-methods [v])
(extend-type ast/ExtendType (ext-methods [v] (.methods v)))

;; fn-name / fn-params: an Fn's name / parameter list (a method).
(defp fn-name [f])
(extend-type ast/Fn (fn-name [f] (.name f)))

(defp fn-params [f])
(extend-type ast/Fn (fn-params [f] (.parameter-list f)))

;; inline-code: an Inline's c-code (receiver statically Inline).
(defp inline-code [v])
(extend-type ast/Inline (inline-code [v] (.c-code v)))

;; --- Spot-check fingerprints.

;; defp-fingerprint: a Defp -> "defp <name> [<params>]".
(defn defp-fingerprint [v]
  (str* ["defp " (defp-name v) " " (str* (str-vect (defp-params v)))]))

;; ctor-fingerprint: a Constructor -> "ctor <name> [<fields>]".
(defn ctor-fingerprint [c]
  (str* ["ctor " (ctor-name c) " " (str* (str-vect (ctor-fields c)))]))

;; deftype-fingerprint: a DefType -> "deftype <name> <ctor-fp>...".
(defn deftype-fingerprint [v]
  (str* ["deftype " (deftype-name v) " "
         (str* (map (deftype-ctors v) ctor-fingerprint))]))

;; method-fingerprint: a method Fn -> "<name>(<param-count>)".
(defn method-fingerprint [f]
  (str* [(fn-name f) "(" (number-str (count (fn-params f))) ")"]))

;; ext-fingerprint: an ExtendType ->
;; "extend-type <name> <method-count> <method-fp>...".
(defn ext-fingerprint [v]
  (str* ["extend-type " (ext-name v) " "
         (number-str (count (ext-methods v))) " "
         (str* (map (ext-methods v) method-fingerprint))]))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side
;; effect (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (let [s (extract (first strs))]
      (print-all-acc (+ acc (pr* s)) (rest strs)))))

;; --- Spot-check status lines (each prints one line, threads the acc).

;; defp-status: n is known to be a Defp; print a status line.
(defn defp-status [acc n]
  (let [fp (defp-fingerprint n)]
    (cond (str= fp "defp type-name [x]")
      (print-all-acc acc ["OK spot-defp: defp type-name [x]\n"])
      (print-all-acc acc ["FAIL spot-defp: got " fp "\n"]))))

;; check-defp: spot-check the defp named "type-name" -> threaded acc.
(defn check-defp [acc v]
  (let [m (find-by-name v "type-name")
        mk (maybe-kind m)]
    (cond (= mk 0)
      (print-all-acc acc ["FAIL spot-defp: type-name not found\n"])
      (let [n (extract m)
            k (top-kind n)]
        (cond (= k 1)
          (defp-status acc n)
          (print-all-acc acc
                         ["FAIL spot-defp: kind=" (number-str k) "\n"]))))))

;; deftype-status: n is known to be a DefType; print a status line.
(defn deftype-status [acc n]
  (let [fp (deftype-fingerprint n)]
    (cond (str= fp "deftype Maybe ctor None []ctor Some [x]")
      (print-all-acc acc ["OK spot-deftype: deftype Maybe (None, Some [x])\n"])
      (print-all-acc acc ["FAIL spot-deftype: got " fp "\n"]))))

;; check-deftype: spot-check the deftype named "Maybe" -> threaded acc.
(defn check-deftype [acc v]
  (let [m (find-by-name v "Maybe")
        mk (maybe-kind m)]
    (cond (= mk 0)
      (print-all-acc acc ["FAIL spot-deftype: Maybe not found\n"])
      (let [n (extract m)
            k (top-kind n)]
        (cond (= k 3)
          (deftype-status acc n)
          (print-all-acc acc
                         ["FAIL spot-deftype: kind=" (number-str k) "\n"]))))))

;; ext-status: n is known to be an ExtendType; print a status line.
(defn ext-status [acc n]
  (let [fp (ext-fingerprint n)]
    (cond (str= fp "extend-type None 8 str-vect(1)=(2)recurse(2)either(2)cond(3)and(2)or(2)map(2)")
      (print-all-acc acc ["OK spot-extend-type: extend-type None (8 methods)\n"])
      (print-all-acc acc ["FAIL spot-extend-type: got " fp "\n"]))))

;; check-extend-type: spot-check the extend-type named "None" ->
;; threaded acc.
(defn check-extend-type [acc v]
  (let [m (find-by-name v "None")
        mk (maybe-kind m)]
    (cond (= mk 0)
      (print-all-acc acc ["FAIL spot-extend-type: None not found\n"])
      (let [n (extract m)
            k (top-kind n)]
        (cond (= k 4)
          (ext-status acc n)
          (print-all-acc acc
                         ["FAIL spot-extend-type: kind=" (number-str k) "\n"]))))))

;; inline-status: n is known to be an Inline; print a status line.
(defn inline-status [acc n]
  (let [code (inline-code n)
        pk (maybe-kind (str-prefix? "\n#define _XOPEN_SOURCE 600" code))]
    (cond (= pk 1)
      (print-all-acc acc ["OK spot-inline: first node is Inline (c-code prefix matches)\n"])
      (print-all-acc acc ["FAIL spot-inline: c-code prefix mismatch\n"]))))

;; check-inline: spot-check the first node is a top-level inline ->
;; threaded acc.
(defn check-inline [acc v]
  (let [n (extract (first v))
        k (top-kind n)]
    (cond (= k 6)
      (inline-status acc n)
      (print-all-acc acc
                     ["FAIL spot-inline: first node kind=" (number-str k) "\n"]))))

;; final-status: the overall verdict from the counts fingerprint.
(defn final-status [fp]
  (cond (str= fp "total=194 defn=108 def=5 defp=58 deftype=5 extend-type=16 inline=2 other=0")
    "OK hvm-core.toc: 194 nodes, all per-form counts match\n"
    (str* ["FAIL hvm-core.toc: " fp "\n"])))

;; run-success: r is a ParserMatch; print the count line, run the four
;; spot-checks, and print the final verdict. Returns the threaded acc.
(defn run-success [acc r]
  (let [v (.value r)
        vc (count v)
        c-defn (count-class v 0)
        c-def (count-class v 1)
        c-defp (count-class v 2)
        c-deftype (count-class v 3)
        c-ext (count-class v 4)
        c-inline (count-class v 5)
        c-other (count-class v 6)
        fp (counts-fingerprint vc c-defn c-def c-defp c-deftype c-ext
                               c-inline c-other)
        a1 (print-all-acc acc ["count " fp "\n"])
        a2 (check-defp a1 v)
        a3 (check-deftype a2 v)
        a4 (check-extend-type a3 v)
        a5 (check-inline a4 v)
        a6 (print-all-acc a5 [(final-status fp)])]
    a6))

;; parse-error-line: r is a ParserError -> the "FAIL(parse) ..." string.
(defn parse-error-line [r]
  (let [st (.state r)
        line (rdr/state-line st)
        msg (.msg r)]
    (str* ["FAIL(parse) hvm-core.toc:" (number-str line) ": " msg "\n"])))

;; run-parse: parse src; on a ParserError print the file:line message,
;; on a ParserMatch run the checks. Returns the threaded acc.
(defn run-parse [acc src]
  (let [r (rdr/parse-program (rdr/make-state src "hvm-core.toc" 1))
        k (rdr/result-kind r)]
    (cond (= k 2)
      (print-all-acc acc [(parse-error-line r)])

      (run-success acc r))))

(main [_]
  (let [src (slurp "hvm-core.toc")]
    (run-parse 0 src))))
