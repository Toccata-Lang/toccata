;; interpreter/rdr-top.toc — item-6 verification driver.
;;
;; Parses the 19 suitable regression tests (item 3) through
;; intrp-rdr.toc's parse-program and checks each yields a name -> TopLevel
;; map with EXACTLY the expected entries (entry count matches AND every
;; expected name is present). Also checks that a top-level `inline` is a
;; parse error carrying a file:line message.
;;
;; Expected output: 19 "OK" lines (one per test) + 1 "OK inline-error"
;; line. Any "FAIL" line indicates a problem. Run from the repo root:
;;   ./rdr-top
;;
;; The driver is interpreter-side tooling, so it may use inline C (the
;; slurp whole-file read). Interpreted programs may not.

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; slurp: whole-file read -> String (inline C).
(defn slurp [path]
  ! path String
  (inline String "
    String *p = (String *)path_1;
    FILE *fd = fopen(p->buffer, \"rb\");
    dec_and_free((Term)p, 1);
    if (fd == NULL) {
      fprintf(stderr, \"slurp: cannot open file\\n\");
      abort();
    }
    fseek(fd, 0, SEEK_END);
    long len = ftell(fd);
    fseek(fd, 0, SEEK_SET);
    String *s = malloc_string(len + 1);
    if (len > 0) fread(s->buffer, 1, len, fd);
    s->len = len;
    s->buffer[len] = 0;
    fclose(fd);
    result = termVal((Term)s);
  "))

;; maybe-kind: tag a Maybe (instance? is unsupported under new-toc).
(defp maybe-kind [m])
(extend-type None (maybe-kind [_] 0))
(extend-type Some (maybe-kind [_] 1))

;; map-count: number of entries in a hash map (count is implemented for the
;; map node types; keys is NOT — verified probe).
(defn map-count [m]
  (count m))

;; count-present-acc: how many names in the vector are present in the map.
;; Self-recursive. The parse keys the map by full Strings (see sub-to-str in
;; intrp-rdr.toc), so the String-literal expected names are used directly.
(defn count-present-acc [names m acc]
  (cond (= (count names) 0)
    acc
    (let [nm (extract (first names))
          mk (maybe-kind (get m nm))]
      (cond (= mk 1)
        (count-present-acc (rest names) m (+ acc 1))
        (count-present-acc (rest names) m acc)))))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side effect
;; (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (let [s (extract (first strs))]
      (print-all-acc (+ acc (pr* s)) (rest strs)))))

;; check-test: slurp + parse one test file; verify the map has exactly the
;; expected entries. Prints one status line. Returns the threaded acc.
(defn check-test [acc file expected-count expected-names]
  (let [src (slurp file)
        r (rdr/parse-program (rdr/make-state src file 1))
        k (rdr/result-kind r)]
    (cond (= k 2)
      (let [st (.state r)
            line (rdr/state-line st)
            msg (.msg r)]
        (print-all-acc acc
                       ["FAIL(parse) " file ":" (number-str line) ": " msg "\n"]))

      (let [m (.value r)
            mc (map-count m)
            pc (count-present-acc expected-names m 0)
            total (count expected-names)
            ok (maybe-kind (and (= mc expected-count) (= pc total)))]
        (cond (= ok 1)
          (print-all-acc acc ["OK " file " entries=" (number-str mc) "\n"])
          (print-all-acc acc
                         ["FAIL " file " entries=" (number-str mc)
                          " expected=" (number-str expected-count)
                          " present=" (number-str pc) "/" (number-str total) "\n"]))))))

;; check-inline: a program with a top-level `inline` must be a parse error
;; whose file:line:msg is exactly the inline line. Returns the threaded acc.
(defn check-inline [acc]
  (let [src "(def a 1)\n(inline \"int x;\")\n(main [_] (pr* \"hi\"))\n"
        r (rdr/parse-program (rdr/make-state src "inline-test.toc" 1))
        k (rdr/result-kind r)]
    (cond (= k 2)
      (let [st (.state r)
            line (rdr/state-line st)
            msg (.msg r)
            fs (extract (get (.values st) "file"))
            ok (maybe-kind (and (str= fs "inline-test.toc")
                                (= line 2)
                                (str= msg "top-level inline is not supported in phase 1")))]
        (cond (= ok 1)
          (print-all-acc acc ["OK inline-error: " fs ":" (number-str line) ": " msg "\n"])
          (print-all-acc acc ["FAIL inline-error got: " fs ":" (number-str line) ": " msg "\n"])))
      (print-all-acc acc
                     ["FAIL inline-error: expected parse error, got kind " (number-str k) "\n"]))))

;; check-oos: each out-of-scope top-level form must be a parse error with the
;; expected message. Self-recursive over [form source expected-msg] triples.
(defn check-oos-acc [acc cases]
  (cond (= (count cases) 0)
    acc
    (let [c (extract (first cases))
          src (rdr/elt0 c)
          msg (rdr/elt1 c)
          r (rdr/parse-program (rdr/make-state src "oos.toc" 1))
          k (rdr/result-kind r)]
      (cond (= k 2)
        (let [got (.msg r)
              ok (maybe-kind (str= got msg))]
          (cond (= ok 1)
            (check-oos-acc (print-all-acc acc ["OK oos: " msg "\n"]) (rest cases))
            (check-oos-acc (print-all-acc acc ["FAIL oos got: " got " want: " msg "\n"]) (rest cases))))
        (check-oos-acc (print-all-acc acc ["FAIL oos: not a parse error (kind " (number-str k) ")\n"]) (rest cases))))))

(defn check-oos [acc]
  (check-oos-acc acc
                 [["(deftype Foo [])" "deftype is not supported in phase 1"]
                  ["(defp foo [x] x)" "defp is not supported in phase 1"]
                  ["(extend-type Integer (foo [_] 1))" "extend-type is not supported in phase 1"]
                  ["(add-ns bar (module \"baz.toc\"))" "add-ns is not supported in phase 1"]
                  ["(match x)" "match is not supported in phase 1"]
                  ["(defmacro foo [])" "defmacro is not supported in phase 1"]
                  ["|" "superposition (|) is not supported in phase 1"]]))

(main [_]
  (let [r1 (check-test 0 "regression-tests/test8.toc" 6
                       ["msg1" "msg2" "int1" "int2" "int3" "main"])
        r2 (check-test r1 "regression-tests/test9.toc" 5
                       ["msg1" "msg2" "int1" "int2" "main"])
        r3 (check-test r2 "regression-tests/test13.toc" 1 ["main"])
        r4 (check-test r3 "regression-tests/test15.toc" 1 ["main"])
        r5 (check-test r4 "regression-tests/test16.toc" 1 ["main"])
        r6 (check-test r5 "regression-tests/test17.toc" 2 ["f" "main"])
        r7 (check-test r6 "regression-tests/test-global-empty-list.toc" 2
                       ["el" "main"])
        r8 (check-test r7 "regression-tests/cond-expr-1.toc" 1 ["main"])
        r9 (check-test r8 "regression-tests/cond-expr-2.toc" 1 ["main"])
        r10 (check-test r9 "regression-tests/cond-expr-3.toc" 1 ["main"])
        r11 (check-test r10 "regression-tests/cond-expr-4.toc" 1 ["main"])
        r12 (check-test r11 "regression-tests/tail-cond-1.toc" 2 ["g" "main"])
        r13 (check-test r12 "regression-tests/test-inlined-result-constraint.toc" 2
                        ["test-h" "main"])
        r14 (check-test r13 "regression-tests/test-recursive-map-fn.toc" 2
                        ["some-fn" "main"])
        r15 (check-test r14 "regression-tests/test-tail-recur-1.toc" 2
                        ["loop" "main"])
        r16 (check-test r15 "regression-tests/test-tail-recur-2.toc" 2
                        ["loop" "main"])
        r17 (check-test r16 "regression-tests/test-tail-recur-3.toc" 2
                        ["loop" "main"])
        r18 (check-test r17 "regression-tests/test-trailing-comment.toc" 2
                        ["f" "main"])
        r19 (check-test r18 "regression-tests/test-or-comment.toc" 3
                        ["f1" "f2" "main"])
        r20 (check-inline r19)
        r21 (check-oos r20)]
    r21))
