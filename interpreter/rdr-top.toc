;; interpreter/rdr-top.toc — item-6 verification driver.
;;
;; Parses the 19 suitable regression tests (item 3) through
;; intrp-rdr.toc's parse-program and checks each yields a [TopLevel]
;; vector with EXACTLY the expected entries (entry count matches AND
;; every expected name is present). Top-level `inline` is now parsed
;; (item 6f) — its shape checks live in interpreter/rdr-inline.toc.
;;
;; Expected output: 19 "OK" lines (one per test). Any "FAIL" line
;; indicates a problem. Run from the repo root: ./rdr-top
;;
;; The driver is interpreter-side tooling, so it may use inline C (the
;; slurp whole-file read). Interpreted programs may not.

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; slurp: whole-file read -> String (inline C).
(defn slurp [path]
  ! path String
  (inline String "
    String *p = (String *)path_1;
    FILE *fd = fopen(p->buffer, \"rb\");
    dec_and_free((Term)p, 1);
    if (fd == NULL) {
      fprintf(stderr, \"slurp: cannot open file\\n\");
      abort();
    }
    fseek(fd, 0, SEEK_END);
    long len = ftell(fd);
    fseek(fd, 0, SEEK_SET);
    String *s = malloc_string(len + 1);
    if (len > 0) fread(s->buffer, 1, len, fd);
    s->len = len;
    s->buffer[len] = 0;
    fclose(fd);
    result = termVal((Term)s);
  "))

;; maybe-kind: tag a Maybe (instance? is unsupported under new-toc).
(defp maybe-kind [m])
(extend-type None (maybe-kind [_] 0))
(extend-type Some (maybe-kind [_] 1))

;; OosCase: one out-of-scope-form check case (source + expected error msg).
;; Item 6b: the positional [source msg] pairs became a named-field grouping
;; ctor with map / flat-map per docs/toccata-style.md.
(deftype OosCase [source msg]
  (map [v f]
    (OosCase (f (.source v)) (f (.msg v))))
  (flat-map [v f]
    (ast/vect-concat (f (.source v)) (f (.msg v)))))

;; top-name: the name of a TopLevel node (Main is nameless — its name is
;; the implicit "main"; AddNs uses its namespace; Inline is nameless).
;; The parse records names as SubString views of the source; str= compares
;; by content, so the String-literal expected names match directly.
(defp top-name [v])
(extend-type ast/Definition (top-name [v] (.name v)))
(extend-type ast/Defp (top-name [v] (.name v)))
(extend-type ast/Main (top-name [_] "main"))
(extend-type ast/DefType (top-name [v] (.type-name v)))
(extend-type ast/ExtendType (top-name [v] (.type-name v)))
(extend-type ast/AddNs (top-name [v] (.namespace v)))
(extend-type ast/Inline (top-name [_] ""))

;; find-by-name: the first node in the [TopLevel] vector whose name
;; matches, or None. Self-recursive.
(defn find-by-name-acc [v name]
  (cond (= (count v) 0)
    None
    (let [e (extract (first v))
          match (maybe-kind (str= (top-name e) name))]
      (cond (= match 1)
        (Some e)
        (find-by-name-acc (rest v) name)))))

(defn find-by-name [v name]
  (find-by-name-acc v name))

;; count-found-acc: how many names in the vector are present in the
;; parsed [TopLevel] vector. Self-recursive.
(defn count-found-acc [names v acc]
  (cond (= (count names) 0)
    acc
    (let [nm (extract (first names))
          mk (maybe-kind (find-by-name v nm))]
      (cond (= mk 1)
        (count-found-acc (rest names) v (+ acc 1))
        (count-found-acc (rest names) v acc)))))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side effect
;; (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (let [s (extract (first strs))]
      (print-all-acc (+ acc (pr* s)) (rest strs)))))

;; check-test: slurp + parse one test file; verify the vector has exactly
;; the expected entries. Prints one status line. Returns the threaded acc.
(defn check-test [acc file expected-count expected-names]
  (let [src (slurp file)
        r (rdr/parse-program (rdr/make-state src file 1))
        k (rdr/result-kind r)]
    (cond (= k 2)
      (let [st (.state r)
            line (rdr/state-line st)
            msg (.msg r)]
        (print-all-acc acc
                       ["FAIL(parse) " file ":" (number-str line) ": " msg "\n"]))

      (let [v (.value r)
            vc (count v)
            fc (count-found-acc expected-names v 0)
            total (count expected-names)
            ok (maybe-kind (and (= vc expected-count) (= fc total)))]
        (cond (= ok 1)
          (print-all-acc acc ["OK " file " entries=" (number-str vc) "\n"])
          (print-all-acc acc
                         ["FAIL " file " entries=" (number-str vc)
                          " expected=" (number-str expected-count)
                          " found=" (number-str fc) "/" (number-str total) "\n"]))))))

;; check-oos: each out-of-scope top-level form must be a parse error with the
;; expected message. Self-recursive over a vector of OosCase.
(defn check-oos-acc [acc cases]
  (cond (= (count cases) 0)
    acc
    (let [c (extract (first cases))
          src (.source c)
          r (rdr/parse-program (rdr/make-state src "oos.toc" 1))
          k (rdr/result-kind r)]
      (cond (= k 2)
        (let [got (.msg r)
              ok (maybe-kind (str= got (.msg c)))]
          (cond (= ok 1)
            (check-oos-acc (print-all-acc acc ["OK oos: " (.msg c) "\n"]) (rest cases))
            (check-oos-acc (print-all-acc acc ["FAIL oos got: " got " want: " (.msg c) "\n"]) (rest cases))))
        (check-oos-acc (print-all-acc acc ["FAIL oos: not a parse error (kind " (number-str k) ")\n"]) (rest cases))))))

(defn check-oos [acc]
  (check-oos-acc acc
                 [(OosCase "(add-ns bar (module \"baz.toc\"))" "add-ns is not supported in phase 1")
                  (OosCase "(match x)" "match is not supported in phase 1")
                  (OosCase "(defmacro foo [])" "defmacro is not supported in phase 1")
                  (OosCase "|" "superposition (|) is not supported in phase 1")]))

(main [_]
  (let [r1 (check-test 0 "regression-tests/test8.toc" 6
                       ["msg1" "msg2" "int1" "int2" "int3" "main"])
        r2 (check-test r1 "regression-tests/test9.toc" 5
                       ["msg1" "msg2" "int1" "int2" "main"])
        r3 (check-test r2 "regression-tests/test13.toc" 1 ["main"])
        r4 (check-test r3 "regression-tests/test15.toc" 1 ["main"])
        r5 (check-test r4 "regression-tests/test16.toc" 1 ["main"])
        r6 (check-test r5 "regression-tests/test17.toc" 2 ["f" "main"])
        r7 (check-test r6 "regression-tests/test-global-empty-list.toc" 2
                       ["el" "main"])
        r8 (check-test r7 "regression-tests/cond-expr-1.toc" 1 ["main"])
        r9 (check-test r8 "regression-tests/cond-expr-2.toc" 1 ["main"])
        r10 (check-test r9 "regression-tests/cond-expr-3.toc" 1 ["main"])
        r11 (check-test r10 "regression-tests/cond-expr-4.toc" 1 ["main"])
        r12 (check-test r11 "regression-tests/tail-cond-1.toc" 2 ["g" "main"])
        r13 (check-test r12 "regression-tests/test-inlined-result-constraint.toc" 2
                        ["test-h" "main"])
        r14 (check-test r13 "regression-tests/test-recursive-map-fn.toc" 2
                        ["some-fn" "main"])
        r15 (check-test r14 "regression-tests/test-tail-recur-1.toc" 2
                        ["loop" "main"])
        r16 (check-test r15 "regression-tests/test-tail-recur-2.toc" 2
                        ["loop" "main"])
        r17 (check-test r16 "regression-tests/test-tail-recur-3.toc" 2
                        ["loop" "main"])
        r18 (check-test r17 "regression-tests/test-trailing-comment.toc" 2
                        ["f" "main"])
        r19 (check-test r18 "regression-tests/test-or-comment.toc" 3
                        ["f1" "f2" "main"])
        r20 (check-oos r19)]
    r20))
