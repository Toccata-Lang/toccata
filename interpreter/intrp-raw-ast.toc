;; intrp-raw-ast.toc — raw AST shapes for the generated reader.
;;
;; One ctor per source form; NO desugared shapes (desugaring is a
;; later phase over these trees — the compiler plan's desugared AST
;; lives in intrp-ast.toc, which is untouched by this project).
;;
;; Every ctor's FINAL field is `loc` (a Location): the generated
;; reader's `Node` combinator always appends the auto-loc (the line
;; where the form started), so any ctor it targets must end in `loc`
;; or the call is wrong-arity. Bodies are vectors that may mix
;; TypeConstraint nodes and Expression nodes (the `!` body elements).
;;
;; Every ctor gets a str-vect impl (printing + acceptance output).
;; No `!` annotations on multi-field ctors (new-toc hazard,
;; inherited fact).
;;
;; This file is a LIBRARY (no main). The generated module
;; (interpreter/gen-rdr.toc) imports this file with
;; (add-ns raw (module "intrp-raw-ast.toc")) and prefixes every use
;; as raw/... — the types are namespaced by the importing module,
;; not by this file.

;; --- Location --------------------------------------------------------

(deftype Location [file line]
  (str-vect [v]
    (flat-map ["(Location " file " " (str line) ")"]
              str-vect)))

;; --- Expression ------------------------------------------------------

;; Defined before TopLevel: TopLevel's bare `Inline` entry references
;; this fielded ctor (bare names in a multi-ctor list reference an
;; existing ctor — order-dependent, cf. intrp-ast.toc).

(deftype Expression
  (Symbol [text loc]
    (str-vect [v]
      (flat-map ["(Symbol " text " " loc ")"]
                str-vect)))
  (IntegerLit [value loc]
    (str-vect [v]
      (flat-map ["(IntegerLit " value " " loc ")"]
                str-vect)))
  (StringLit [value loc]
    (str-vect [v]
      (flat-map ["(StringLit \"" value "\" " loc ")"]
                str-vect)))
  (Call [operator operands loc]
    (str-vect [v]
      (flat-map ["(Call " operator " " operands " " loc ")"]
                str-vect)))
  (Let [bindings body loc]
    (str-vect [v]
      (flat-map ["(Let " bindings " " body " " loc ")"]
                str-vect)))
  (Cond [clauses loc]
    (str-vect [v]
      (flat-map ["(Cond " clauses " " loc ")"]
                str-vect)))
  (Fn [param-list body loc]
    (str-vect [v]
      (flat-map ["(Fn " param-list " " body " " loc ")"]
                str-vect)))
  (Thread [expr steps loc]
    (str-vect [v]
      (flat-map ["(Thread " expr " " steps " " loc ")"]
                str-vect)))
  (FieldGetter [field-name loc]
    (str-vect [v]
      (flat-map ["(FieldGetter " field-name " " loc ")"]
                str-vect)))
  (VectorLit [exprs loc]
    (str-vect [v]
      (flat-map ["(VectorLit " exprs " " loc ")"]
                str-vect)))
  (HashLit [pairs loc]
    (str-vect [v]
      (flat-map ["(HashLit " pairs " " loc ")"]
                str-vect)))
  (Inline [type-expr c-code loc]
    (str-vect [v]
      (flat-map ["(Inline " type-expr " " c-code " " loc ")"]
                str-vect))))

;; --- TopLevel --------------------------------------------------------

;; `Inline` is the bare reference to Expression's
;; `(Inline [type-expr c-code loc])` — a top-level inline form parses
;; to that same ctor, added to the TopLevel type.

(deftype TopLevel
  (Defn [name param-list body loc]
    (str-vect [v]
      (flat-map ["(Defn " name " " param-list " " body " " loc ")"]
                str-vect)))
  (Def [name value loc]
    (str-vect [v]
      (flat-map ["(Def " name " " value " " loc ")"]
                str-vect)))
  (Defp [name param-list body loc]
    (str-vect [v]
      (flat-map ["(Defp " name " " param-list " " body " " loc ")"]
                str-vect)))
  (DefType [type-name ctors loc]
    (str-vect [v]
      (flat-map ["(DefType " type-name " " ctors " " loc ")"]
                str-vect)))
  (ExtendType [type-name methods loc]
    (str-vect [v]
      (flat-map ["(ExtendType " type-name " " methods " " loc ")"]
                str-vect)))
  Inline
  (Main [param-list body loc]
    (str-vect [v]
      (flat-map ["(Main " param-list " " body " " loc ")"]
                str-vect))))

;; --- Auxiliaries -----------------------------------------------------

(deftype TypeConstraint [symbol type-expr loc]
  (str-vect [v]
    (flat-map ["(TypeConstraint " symbol " " type-expr " " loc ")"]
              str-vect)))

(deftype LetBinding [name expr loc]
  (str-vect [v]
    (flat-map ["(LetBinding " name " " expr " " loc ")"]
              str-vect)))

(deftype Clause [test value loc]
  (str-vect [v]
    (flat-map ["(Clause " test " " value " " loc ")"]
              str-vect)))

(deftype HashPair [key value loc]
  (str-vect [v]
    (flat-map ["(HashPair " key " " value " " loc ")"]
              str-vect)))

(deftype DefTypeCtor [name fields impls loc]
  (str-vect [v]
    (flat-map ["(DefTypeCtor " name " " fields " " impls " " loc ")"]
              str-vect)))

(deftype Method [name param-list body loc]
  (str-vect [v]
    (flat-map ["(Method " name " " param-list " " body " " loc ")"]
              str-vect)))
