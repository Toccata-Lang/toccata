;; interpreter/emit-pred.toc — parser-generator verification driver.
;;
;; Emits, via intrp-emit.toc, and writes each result to a file:
;;  - the char-level predicates for six grammar combinators
;;    (digits, upper-case, lower-case, alpha, symbol-start,
;;    rest-of-symbol) -> scratch/emit-got/<name>.txt
;;  - the full generated module for six synthetic grammars (the
;;    one-rule digit, the item-5 ig All/Ignore, the item-6 an Any,
;;    the item-7a mn Many-slow, the item-7b fn Many-fast, and the
;;    item-7c rc Recur grammars below) -> scratch/emit-got/module-
;;    <suffix>.txt
;;  - the full generated module for the REAL grammar (the rules
;;    reachable from expression in interpreter/intrp-grammar.toc)
;;    -> interpreter/gen-rdr.toc (a build artifact — never committed;
;;    built by `make gen-rdr`)
;;
;; Verification is by diff, not in-Toccata string comparison:
;; `make emit-pred` diffs every got file against its committed
;; expected file in interpreter/emit-want/ (module-real against
;; interpreter/gen-rdr.toc). The item-8 corpus (the committed
;; interpreter/gen-corpus*.toc files) is run over the built parser
;; and diffed by `make gen-corpus`.
;;
;; The driver is interpreter-side tooling; interpreted programs may
;; not use these constructs.

(add-ns grammar (module "intrp-grammar.toc"))
(add-ns emit (module "intrp-emit.toc"))

;; --- Synthetic grammars ---------------------------------------------
;;
;; ig (item 5): ig-all is an All of a named Rule child (ig-alpha), a
;; bare String child ("x"), and an anonymous All child (lifted to
;; ig-all-2, its CharRange child lifted to ig-all-2-0); ig-ignore is
;; an Ignore of an anonymous All (lifted to ig-ignore-0, its
;; CharRange child to ig-ignore-0-0). The lifted helpers are emitted
;; BEFORE the Rule defn that calls them (use-after-definition).

(def ig-lower (grammar/CharRange "a" "f"))
(def ig-alpha (grammar/Rule "ig-alpha" (grammar/CharRange "a" "z")))
(def ig-all
  (grammar/Rule "ig-all"
                (grammar/All [ig-alpha "x" (grammar/All [ig-lower "y"])])))
(def ig-ignore
  (grammar/Rule "ig-ignore"
                (grammar/Ignore (grammar/All [ig-lower "z"]))))

;; an (item 6): an-any is an Any of a named Rule alt (an-alpha), an
;; anonymous All alt (lifted to an-any-1, its two CharRange children
;; to an-any-1-0 / an-any-1-1), and a bare String alt ("!") grouped
;; into the single inlined cond (the item-8 grouped-literal site-(a)
;; form). The alt literal is a SINGLE char outside a-z0-9: alts are
;; tried in order over the defn's `state`, so a literal starting with
;; an a-z/digit char would be eaten char-by-char by the earlier alts,
;; and take-char consumes exactly one char, so a longer literal would
;; leave a re-parsed remainder. The literal is "!", NOT "-" or "+":
;; those two literals in this position crash new-toc's codegen
;; (deterministic silent abort — see the plan's Inherited verified
;; facts).

(def an-alpha (grammar/Rule "an-alpha" (grammar/CharRange "a" "z")))
(def an-any
  (grammar/Rule "an-any"
                (grammar/Any [an-alpha
                              (grammar/All [(grammar/CharRange "0" "9")
                                            (grammar/CharRange "0" "9")])
                              "!"])))

;; mn (item 7a): mn-entry is an All of a Many of the named Rule
;; mn-alpha (char-level via the Rule delegation -> FAST path: the
;; set-predicate defn mn-entry-0-char + the read-run wrapper
;; mn-entry-0), a Many of the anonymous All mn-pair (loop defn
;; mn-entry-1, its child lifted to mn-entry-1-0, its two CharRange
;; children to mn-entry-1-0-0 / mn-entry-1-0-1), and a bare String
;; ("!"); mn-run is a Rule whose parser is a Many of mn-alpha (fast
;; path: mn-run-0-char + mn-run-0, the rule defn the one-arg
;; wrapper; not called by the entry).

(def mn-alpha (grammar/Rule "mn-alpha" (grammar/CharRange "a" "z")))
(def mn-run
  (grammar/Rule "mn-run" (grammar/Many mn-alpha)))
(def mn-pair
  (grammar/All [(grammar/CharRange "0" "9") (grammar/CharRange "a" "z")]))
(def mn-entry
  (grammar/Rule "mn-entry"
                (grammar/All [(grammar/Many mn-alpha)
                              (grammar/Many mn-pair)
                              "!"])))

;; fn (item 7b): fn-digits is a Rule over a Many of a CharRange (fast
;; path: the set-predicate defn fn-digits-0-char + the read-run
;; wrapper fn-digits-0, the rule defn the one-arg wrapper); fn-word
;; is a Rule over a Many of the char-level Rule fn-alpha (fast path
;; via the Rule delegation); fn-entry is an All of fn-digits,
;; fn-word, a Many of the mixed Any fn-mix (fn-alpha alt + anonymous
;; All alt — parser-level, so the SLOW path: the Any lifted to
;; fn-entry-2-0, the All to fn-entry-2-0-1, its CharRange to
;; fn-entry-2-0-1-0, the loop defn fn-entry-2), and a bare String
;; ("!").

(def fn-alpha (grammar/Rule "fn-alpha" (grammar/CharRange "a" "z")))
(def fn-digits
  (grammar/Rule "fn-digits" (grammar/Many (grammar/CharRange "0" "9"))))
(def fn-word (grammar/Rule "fn-word" (grammar/Many fn-alpha)))
(def fn-mix
  (grammar/Any [fn-alpha
                (grammar/All [(grammar/CharRange "0" "9")])]))
(def fn-entry
  (grammar/Rule "fn-entry"
                (grammar/All [fn-digits
                              fn-word
                              (grammar/Many fn-mix)
                              "!"])))

;; rc (item 7c): the mini S-expression grammar. rc-entry is an Any of
;; rc-symbol-ish (a single a-z char) and an anonymous All (lifted to
;; rc-entry-1) of "(", a Many of (Recur rc-entry) (parser-level
;; child -> SLOW path: the loop defn rc-entry-1-1; the Recur is
;; referenced by the enclosing rule name — never lifted), and ")".
;; The Recur's f field is grammar/sub-expression (data the emitter
;; ignores). rc-symbol-ish is a SINGLE-char rule (non-empty): the
;; entry and the Many (Recur) loop child must never match
;; zero-length, or the loop spins on the unconsumed state until the
;; term buffer exhausts (the hand-written rdr's parse-expr is total
;; for the same reason — its last clause takes a char and retries;
;; the real grammar's symbol rule is non-empty too: symbol-start +
;; rest). The module carries a (def rc-entry) forward declaration
;; after the header (emit-module emits one for every rule whose
;; subtree contains a Recur): the loop helper rc-entry-1-1 (emitted
;; before the rule defn) calls rc-entry, and a defn body referencing
;; a later top-level symbol fails Undefined symbol.

(def rc-symbol-ish
  (grammar/Rule "rc-symbol-ish" (grammar/CharRange "a" "z")))
(def rc-entry
  (grammar/Rule "rc-entry"
                (grammar/Any [rc-symbol-ish
                              (grammar/All ["("
                                            (grammar/Many
                                             (grammar/Recur
                                              grammar/sub-expression))
                                            ")"])])))

;; write-file [path content]: write the string to the file (inline
;; C), appending one trailing newline. The driver runs from the repo
;; root; the got files land in scratch/emit-got/ (created by the
;; Makefile) and the generated module in interpreter/.
(defn write-file [path content]
  (inline "
    String *p = (String *)path_1;
    String *c = (String *)content_2;
    FILE *fd = fopen(p->buffer, \"wb\");
    if (fd == NULL) {
      fprintf(stderr, \"write-file: cannot open file\\n\");
      abort();
    }
    fwrite(c->buffer, 1, c->len, fd);
    fputc('\\n', fd);
    fclose(fd);
    dec_and_free((Term)p, 1);
    dec_and_free((Term)c, 1);
    result = newI60(0);
  "))

(main [_]
  (let [ctx (emit/EmitCtx "" "")
        r1 (write-file "scratch/emit-got/digits.txt"
                       (emit/emit-pred grammar/digits ctx))
        r2 (+ r1 (write-file "scratch/emit-got/upper-case.txt"
                             (emit/emit-pred grammar/upper-case ctx)))
        r3 (+ r2 (write-file "scratch/emit-got/lower-case.txt"
                             (emit/emit-pred grammar/lower-case ctx)))
        r4 (+ r3 (write-file "scratch/emit-got/alpha.txt"
                             (emit/emit-pred grammar/alpha ctx)))
        r5 (+ r4 (write-file "scratch/emit-got/symbol-start.txt"
                             (emit/emit-pred grammar/symbol-start ctx)))
        r6 (+ r5 (write-file "scratch/emit-got/rest-of-symbol.txt"
                             (emit/emit-pred grammar/rest-of-symbol ctx)))
        digit-lines (emit/emit-module
                     [(grammar/Rule "digit" (grammar/CharRange "0" "9"))]
                     "digit")
        r7 (+ r6 (write-file "scratch/emit-got/module.txt"
                             (to-str (interpose digit-lines "\n"))))
        ig-lines (emit/emit-module [ig-alpha ig-all ig-ignore] "ig-all")
        r8 (+ r7 (write-file "scratch/emit-got/module-ig.txt"
                             (to-str (interpose ig-lines "\n"))))
        an-lines (emit/emit-module [an-alpha an-any] "an-any")
        r9 (+ r8 (write-file "scratch/emit-got/module-an.txt"
                             (to-str (interpose an-lines "\n"))))
        mn-lines (emit/emit-module [mn-alpha mn-run mn-entry] "mn-entry")
        r10 (+ r9 (write-file "scratch/emit-got/module-mn.txt"
                              (to-str (interpose mn-lines "\n"))))
        fn-lines (emit/emit-module [fn-alpha fn-digits fn-word fn-entry]
                                   "fn-entry")
        r11 (+ r10 (write-file "scratch/emit-got/module-fn.txt"
                               (to-str (interpose fn-lines "\n"))))
        rc-lines (emit/emit-module [rc-symbol-ish rc-entry] "rc-entry")
        r12 (+ r11 (write-file "scratch/emit-got/module-rc.txt"
                               (to-str (interpose rc-lines "\n"))))
        real-lines (emit/emit-module [grammar/symbol
                                      grammar/symbol-start
                                      grammar/rest-of-symbol
                                      grammar/alpha
                                      grammar/digits
                                      grammar/int-literal
                                      grammar/double-quoted-string
                                      grammar/escaped-char
                                      grammar/expression]
                                     "expression")
        r13 (+ r12 (write-file "interpreter/gen-rdr.toc"
                               (to-str (interpose real-lines "\n"))))]
    r13))
