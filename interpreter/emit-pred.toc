;; interpreter/emit-pred.toc — item-3/4/5/6/7a/7b verification driver.
;;
;; Emits the char-level predicates for six grammar combinators via
;; intrp-emit.toc's emit-pred and asserts the EXACT expected source
;; lines (fingerprint via to-str over the emitted vector, the
;; body-fingerprint convention from rdr-defp.toc). Then emits the
;; full generated module for a synthetic one-rule grammar
;; ((Rule "digit" (CharRange "0" "9"))) via emit-module, asserts its
;; exact fingerprint, then emits the full generated module for the
;; item-5 synthetic All/Ignore grammar (ig-all / ig-ignore), asserts
;; its exact fingerprint, then emits the full generated module for
;; the item-6 synthetic Any grammar (an-any), asserts its exact
;; fingerprint, then emits the full generated module for the item-7a
;; synthetic Many grammar (mn-alpha / mn-run / mn-entry), asserts its
;; exact fingerprint, then emits the full generated module for the
;; item-7b synthetic Many fast-path grammar (fn-alpha / fn-digits /
;; fn-word / fn-entry), asserts its exact fingerprint, and writes it
;; to interpreter/gen-rdr.toc (a build artifact — never committed;
;; built by `make gen-rdr`) plus the sample inputs to
;; interpreter/gen-sample.toc (the failure case; run: ./gen-rdr
;; interpreter/gen-sample.toc) and interpreter/gen-sample-ok.toc (the
;; success case; run: ./gen-rdr interpreter/gen-sample-ok.toc).
;;
;; Expected output: 11 "OK" lines (one per check). Any "FAIL" line
;; indicates a problem. Run from the repo root: ./emit-pred
;;
;; The driver is interpreter-side tooling; interpreted programs may
;; not use these constructs.

(add-ns grammar (module "intrp-grammar.toc"))
(add-ns emit (module "intrp-emit.toc"))

;; The exact expected predicate source lines (ctor-table shapes).
;; Rule alts delegate, so symbol-start / rest-of-symbol embed the
;; alpha predicate as a nested (or ...).
(def want-digits
  "(and (<= 48 (char-code c)) (<= (char-code c) 57))")
(def want-upper-case
  "(and (<= 65 (char-code c)) (<= (char-code c) 90))")
(def want-lower-case
  "(and (<= 97 (char-code c)) (<= (char-code c) 122))")
(def want-alpha
  (to-str ["(or " want-lower-case " " want-upper-case ")"]))
(def want-symbol-start
  (to-str ["(or " want-alpha
         " (str= c \".\") (str= c \"_\") (str= c \"<\") (str= c \">\")"
         " (str= c \"=\") (str= c \"+\") (str= c \"-\") (str= c \"*\")"
         " (str= c \"/\"))"]))
(def want-rest-of-symbol
  (to-str ["(or " want-alpha " " want-digits
         " (str= c \".\") (str= c \"_\") (str= c \"<\") (str= c \">\")"
         " (str= c \"=\") (str= c \"+\") (str= c \"-\") (str= c \"*\")"
         " (str= c \"?\") (str= c \"!\"))"]))

;; The exact expected generated module for the synthetic one-rule
;; grammar: header (add-ns + parse-then/parse-or kit + the
;; ParserError field-access protocols + parse-error-line), the digit
;; defn, the parse-seq loop, and main. Fingerprint via to-str over the
;; emitted vector (no separators). The module is inline-free: slurp
;; and exit come from the core.
(def want-digit-defn
  (to-str ["(defn digit [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      " want-digits
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-header
  (to-str [";; gen-rdr.toc - GENERATED by interpreter/intrp-emit.toc (do not edit)."
         ""
         "(add-ns rdr (module \"intrp-rdr.toc\"))"
         ""
         "(defp parse-then [r f])"
         "(extend-type rdr/ParserMatch (parse-then [r f] (f (.value r) (.state r))))"
         "(extend-type rdr/ParserIgnore (parse-then [r f] r))"
         "(extend-type rdr/ParserError (parse-then [r f] r))"
         ""
         "(defp parse-or [r else-f])"
         "(extend-type rdr/ParserMatch (parse-or [r e] r))"
         "(extend-type rdr/ParserIgnore (parse-or [r e] r))"
         "(extend-type rdr/ParserError (parse-or [r e] (e r)))"
         ""
         "(defp parse-error-msg [r])"
         "(extend-type rdr/ParserError (parse-error-msg [v] (.msg v)))"
         ""
         "(defp parse-error-state [r])"
         "(extend-type rdr/ParserError (parse-error-state [v] (.state v)))"
         ""
         "(defn parse-error-line [file out line msg]"
         "  (exit 1 (to-str [out file \":\" (number-str line) \":\" msg])))"]))

(def want-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (digit s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-module
  (to-str [want-header "" want-digit-defn "" want-main]))

;; --- Item 5: All + Ignore -------------------------------------------
;;
;; The synthetic grammar: ig-all is an All of a named Rule child
;; (ig-alpha), a bare String child ("x"), and an anonymous All child
;; (lifted to ig-all-2, its CharRange child lifted to ig-all-2-0);
;; ig-ignore is an Ignore of an anonymous All (lifted to ig-ignore-0,
;; its CharRange child to ig-ignore-0-0). The lifted helpers are
;; emitted BEFORE the Rule defn that calls them (use-after-
;; definition).

(def ig-lower (grammar/CharRange "a" "f"))
(def ig-alpha (grammar/Rule "ig-alpha" (grammar/CharRange "a" "z")))
(def ig-all
  (grammar/Rule "ig-all"
                (grammar/All [ig-alpha "x" (grammar/All [ig-lower "y"])])))
(def ig-ignore
  (grammar/Rule "ig-ignore"
                (grammar/Ignore (grammar/All [ig-lower "z"]))))

(def want-ig-alpha-defn
  (to-str ["(defn ig-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-all-2-0-defn
  (to-str ["(defn ig-all-2-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 102))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-all-2-defn
  (to-str ["(defn ig-all-2 [state]"
         "  (parse-then (ig-all-2-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"y\" (.input s1))"
         "                                  (rdr/ParserMatch \"y\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"y\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-ig-all-defn
  (to-str ["(defn ig-all [state]"
         "  (parse-then (ig-alpha state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"x\" (.input s1))"
         "                                  (rdr/ParserMatch \"x\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"x\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (parse-then (ig-all-2 s2)"
         "                                          (fn [v2 s3]"
         "                                            (rdr/ParserMatch [v0 v1 v2] s3))))))))"]))

(def want-ig-ignore-0-0-defn
  (to-str ["(defn ig-ignore-0-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 102))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-ignore-0-defn
  (to-str ["(defn ig-ignore-0 [state]"
         "  (parse-then (ig-ignore-0-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"z\" (.input s1))"
         "                                  (rdr/ParserMatch \"z\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"z\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-ig-ignore-defn
  (to-str ["(defn ig-ignore [state]"
         "  (parse-or (parse-then (ig-ignore-0 state)"
         "                        (fn [v s2]"
         "                          (rdr/ParserIgnore s2)))"
         "            identity))"]))

(def want-ig-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (ig-all s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-ig-module
  (to-str [want-header ""
           want-ig-alpha-defn ""
           want-ig-all-2-0-defn ""
           want-ig-all-2-defn ""
           want-ig-all-defn ""
           want-ig-ignore-0-0-defn ""
           want-ig-ignore-0-defn ""
           want-ig-ignore-defn ""
           want-ig-main]))

;; --- Item 6: Any (parser-level) -------------------------------------
;;
;; The synthetic grammar: an-any is an Any of a named Rule alt
;; (an-alpha), an anonymous All alt (lifted to an-any-1, its two
;; CharRange children to an-any-1-0 / an-any-1-1), and a bare String
;; alt ("!" — inlined let-free as the LAST alt, so the last Error
;; falls out for free). The alt literal is a SINGLE char outside
;; a-z0-9: alts are tried in order over the defn's `state`, so a
;; literal starting with an a-z/digit char would be eaten
;; char-by-char by the earlier alts (the original "xy" sample
;; printed x and y — an-alpha won both — and the String alt never
;; fired), and take-char consumes exactly one char, so a longer
;; literal would leave a re-parsed remainder. The literal is "!",
;; NOT "-" or "+": those two literals in this position crash
;; new-toc's codegen (deterministic silent abort, 13/13 and 8/8;
;; every other single char tested builds — see the plan's
;; Inherited verified facts). The sample file (a / 42 / ! / 5)
;; has each alt win once, then a failure line: "5" defeats
;; an-alpha (not a-z), an-any-1 (one digit, then EOF), and "!"
;; (no prefix) — the error is the last alt's `expected "!"`
;; at line 4.

(def an-alpha (grammar/Rule "an-alpha" (grammar/CharRange "a" "z")))
(def an-any
  (grammar/Rule "an-any"
                (grammar/Any [an-alpha
                              (grammar/All [(grammar/CharRange "0" "9")
                                            (grammar/CharRange "0" "9")])
                              "!"])))

(def want-an-alpha-defn
  (to-str ["(defn an-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-0-defn
  (to-str ["(defn an-any-1-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 48 (char-code c)) (<= (char-code c) 57))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-1-defn
  (to-str ["(defn an-any-1-1 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 48 (char-code c)) (<= (char-code c) 57))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-defn
  (to-str ["(defn an-any-1 [state]"
         "  (parse-then (an-any-1-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (an-any-1-1 s1)"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-an-any-defn
  (to-str ["(defn an-any [state]"
         "  (parse-or (an-alpha state)"
         "            (fn [e1]"
         "              (parse-or (an-any-1 state)"
         "                        (fn [e2]"
         "                          (cond (str-prefix? \"!\" (.input state))"
         "                                (rdr/ParserMatch \"!\" (rdr/take-char state))"
         "                                (rdr/ParserError \"expected \\\"!\\\"\" state)))))))"]))

(def want-an-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (an-any s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-an-module
  (to-str [want-header ""
           want-an-alpha-defn ""
           want-an-any-1-0-defn ""
           want-an-any-1-1-defn ""
           want-an-any-1-defn ""
           want-an-any-defn ""
           want-an-main]))

;; --- Item 7a: Many slow path ---------------------------------------
;;
;; The synthetic grammar: mn-entry is an All of a Many of the named
;; Rule mn-alpha (char-level via the Rule delegation -> FAST path:
;; the set-predicate defn mn-entry-0-char + the read-run wrapper
;; mn-entry-0), a Many of the anonymous All mn-pair (loop defn
;; mn-entry-1, its child lifted to mn-entry-1-0, its two CharRange
;; children to mn-entry-1-0-0 / mn-entry-1-0-1), and a bare String
;; ("!"); mn-run is a Rule whose parser is a Many of mn-alpha (fast
;; path: mn-run-char + mn-run-0, the rule defn the one-arg wrapper;
;; not called by the entry). Every sample line ends with "!": a Many
;; matches zero or more, so a top-level Many would win with an empty
;; vector on the failure line and the parse-seq loop would spin on
;; the unconsumed input. The loop terminates on the non-matching
;; input: mn-entry-1 stops at "!".
;;
;; (The mn module is the fingerprint check only — the module written
;; to gen-rdr.toc is the item-7b fn module below.)

(def mn-alpha (grammar/Rule "mn-alpha" (grammar/CharRange "a" "z")))
(def mn-run
  (grammar/Rule "mn-run" (grammar/Many mn-alpha)))
(def mn-pair
  (grammar/All [(grammar/CharRange "0" "9") (grammar/CharRange "a" "z")]))
(def mn-entry
  (grammar/Rule "mn-entry"
                (grammar/All [(grammar/Many mn-alpha)
                              (grammar/Many mn-pair)
                              "!"])))

(def want-mn-alpha-defn
  (to-str ["(defn mn-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-mn-run-0-char-defn
  (to-str ["(defn mn-run-0-char [c] " want-lower-case ")"]))

(def want-mn-run-0-defn
  (to-str ["(defn mn-run-0 [state]"
         "  (let [t (rdr/read-run state mn-run-0-char)]"
         "    (rdr/ParserMatch (.text t) (.state t))))"]))

(def want-mn-run-defn
  (to-str ["(defn mn-run [state]"
         "  (mn-run-0 state))"]))

(def want-mn-entry-0-char-defn
  (to-str ["(defn mn-entry-0-char [c] " want-lower-case ")"]))

(def want-mn-entry-0-defn
  (to-str ["(defn mn-entry-0 [state]"
         "  (let [t (rdr/read-run state mn-entry-0-char)]"
         "    (rdr/ParserMatch (.text t) (.state t))))"]))

(def want-mn-entry-1-0-0-defn
  (to-str ["(defn mn-entry-1-0-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 48 (char-code c)) (<= (char-code c) 57))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-mn-entry-1-0-1-defn
  (to-str ["(defn mn-entry-1-0-1 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-mn-entry-1-0-defn
  (to-str ["(defn mn-entry-1-0 [state]"
         "  (parse-then (mn-entry-1-0-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (mn-entry-1-0-1 s1)"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-mn-entry-1-defn
  (to-str ["(defn mn-entry-1 [state acc]"
         "  (parse-or (parse-then (mn-entry-1-0 state)"
         "                        (fn [v s2]"
         "                          (mn-entry-1 s2 (vect-conj acc v))))"
         "            (fn [e]"
         "              (rdr/ParserMatch acc state))))"]))

(def want-mn-entry-defn
  (to-str ["(defn mn-entry [state]"
         "  (parse-then (mn-entry-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (mn-entry-1 s1 empty-vector)"
         "                            (fn [v1 s2]"
         "                              (parse-then (cond (str-prefix? \"!\" (.input s2))"
         "                                                (rdr/ParserMatch \"!\" (rdr/take-char s2))"
         "                                                (rdr/ParserError \"expected \\\"!\\\"\" s2))"
         "                                          (fn [v2 s3]"
         "                                            (rdr/ParserMatch [v0 v1 v2] s3))))))))"]))

(def want-mn-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (mn-entry s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-mn-module
  (to-str [want-header ""
           want-mn-alpha-defn ""
           want-mn-run-0-char-defn ""
           want-mn-run-0-defn ""
           want-mn-run-defn ""
           want-mn-entry-0-char-defn ""
           want-mn-entry-0-defn ""
           want-mn-entry-1-0-0-defn ""
           want-mn-entry-1-0-1-defn ""
           want-mn-entry-1-0-defn ""
           want-mn-entry-1-defn ""
           want-mn-entry-defn ""
           want-mn-main]))

;; --- Item 7b: Many fast path ---------------------------------------
;;
;; The synthetic grammar: fn-digits is a Rule over a Many of a
;; CharRange (fast path: the set-predicate defn fn-digits-char + the
;; read-run wrapper fn-digits-0, the rule defn the one-arg wrapper);
;; fn-word is a Rule over a Many of the char-level Rule fn-alpha
;; (fast path via the Rule delegation); fn-entry is an All of
;; fn-digits, fn-word, a Many of the mixed Any fn-mix (fn-alpha alt
;; + anonymous All alt — parser-level, so the SLOW path: the Any
;; lifted to fn-entry-2-0, the All to fn-entry-2-0-1, its CharRange
;; to fn-entry-2-0-1-0, the loop defn fn-entry-2), and a bare String
;; ("!").
;;
;; gen-sample.toc (123abc45! / *): the first line parses to the
;; vector of child values — the two fast runs are ONE string each
;; ("123", "abc") and the slow loop yields a vector of child values
;; ([4 5]); the second defeats the "!" literal -> file:line:
;; expected "!", exit 1. gen-sample-ok.toc (123abc45! / !): every
;; line parses (the second exercises the zero-length fast runs and
;; the zero-length loop) -> exit 0.

(def fn-alpha (grammar/Rule "fn-alpha" (grammar/CharRange "a" "z")))
(def fn-digits
  (grammar/Rule "fn-digits" (grammar/Many (grammar/CharRange "0" "9"))))
(def fn-word (grammar/Rule "fn-word" (grammar/Many fn-alpha)))
(def fn-mix
  (grammar/Any [fn-alpha
                (grammar/All [(grammar/CharRange "0" "9")])]))
(def fn-entry
  (grammar/Rule "fn-entry"
                (grammar/All [fn-digits
                              fn-word
                              (grammar/Many fn-mix)
                              "!"])))

(def want-fn-alpha-defn
  (to-str ["(defn fn-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      " want-lower-case
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-fn-digits-char-defn
  (to-str ["(defn fn-digits-0-char [c] " want-digits ")"]))

(def want-fn-digits-0-defn
  (to-str ["(defn fn-digits-0 [state]"
         "  (let [t (rdr/read-run state fn-digits-0-char)]"
         "    (rdr/ParserMatch (.text t) (.state t))))"]))

(def want-fn-digits-defn
  (to-str ["(defn fn-digits [state]"
         "  (fn-digits-0 state))"]))

(def want-fn-word-char-defn
  (to-str ["(defn fn-word-0-char [c] " want-lower-case ")"]))

(def want-fn-word-0-defn
  (to-str ["(defn fn-word-0 [state]"
         "  (let [t (rdr/read-run state fn-word-0-char)]"
         "    (rdr/ParserMatch (.text t) (.state t))))"]))

(def want-fn-word-defn
  (to-str ["(defn fn-word [state]"
         "  (fn-word-0 state))"]))

(def want-fn-entry-2-0-1-0-defn
  (to-str ["(defn fn-entry-2-0-1-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      " want-digits
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-fn-entry-2-0-1-defn
  (to-str ["(defn fn-entry-2-0-1 [state]"
         "  (parse-then (fn-entry-2-0-1-0 state)"
         "              (fn [v0 s1]"
         "                (rdr/ParserMatch [v0] s1))))"]))

(def want-fn-entry-2-0-defn
  (to-str ["(defn fn-entry-2-0 [state]"
         "  (parse-or (fn-alpha state)"
         "            (fn [e1]"
         "              (fn-entry-2-0-1 state))))"]))

(def want-fn-entry-2-defn
  (to-str ["(defn fn-entry-2 [state acc]"
         "  (parse-or (parse-then (fn-entry-2-0 state)"
         "                        (fn [v s2]"
         "                          (fn-entry-2 s2 (vect-conj acc v))))"
         "            (fn [e]"
         "              (rdr/ParserMatch acc state))))"]))

(def want-fn-entry-defn
  (to-str ["(defn fn-entry [state]"
         "  (parse-then (fn-digits state)"
         "              (fn [v0 s1]"
         "                (parse-then (fn-word s1)"
         "                            (fn [v1 s2]"
         "                              (parse-then (fn-entry-2 s2 empty-vector)"
         "                                          (fn [v2 s3]"
         "                                            (parse-then (cond (str-prefix? \"!\" (.input s3))"
         "                                                              (rdr/ParserMatch \"!\" (rdr/take-char s3))"
         "                                                              (rdr/ParserError \"expected \\\"!\\\"\" s3))"
         "                                                        (fn [v3 s4]"
         "                                                          (rdr/ParserMatch [v0 v1 v2 v3] s4))))))))))"]))

(def want-fn-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (fn-entry s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-fn-module
  (to-str [want-header ""
           want-fn-alpha-defn ""
           want-fn-digits-char-defn ""
           want-fn-digits-0-defn ""
           want-fn-digits-defn ""
           want-fn-word-char-defn ""
           want-fn-word-0-defn ""
           want-fn-word-defn ""
           want-fn-entry-2-0-1-0-defn ""
           want-fn-entry-2-0-1-defn ""
           want-fn-entry-2-0-defn ""
           want-fn-entry-2-defn ""
           want-fn-entry-defn ""
           want-fn-main]))

;; write-file [path content]: write the string to the file (inline
;; C). The driver runs from the repo root; gen-rdr.toc is a build
;; artifact written by this driver.
(defn write-file [path content]
  (inline "
    String *p = (String *)path_1;
    String *c = (String *)content_2;
    FILE *fd = fopen(p->buffer, \"wb\");
    if (fd == NULL) {
      fprintf(stderr, \"write-file: cannot open file\\n\");
      abort();
    }
    fwrite(c->buffer, 1, c->len, fd);
    fputc('\\n', fd);
    fclose(fd);
    dec_and_free((Term)p, 1);
    dec_and_free((Term)c, 1);
    result = newI60(0);
  "))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side
;; effect (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (print-all-acc (+ acc (pr* (extract (first strs)))) (rest strs))))

;; check: compare a got string with its expected source; print one
;; status line. Returns the threaded acc.
(defn check [acc name got want]
  (cond (str= got want)
    (print-all-acc acc ["OK " name "\n"])
    (print-all-acc acc ["FAIL " name "\ngot:  " got "\nwant: " want "\n"])))

(main [_]
  (let [ctx (emit/EmitCtx "" "")
        r1 (check 0 "digits" (emit/emit-pred grammar/digits ctx) want-digits)
        r2 (check r1 "upper-case" (emit/emit-pred grammar/upper-case ctx) want-upper-case)
        r3 (check r2 "lower-case" (emit/emit-pred grammar/lower-case ctx) want-lower-case)
        r4 (check r3 "alpha" (emit/emit-pred grammar/alpha ctx) want-alpha)
        r5 (check r4 "symbol-start" (emit/emit-pred grammar/symbol-start ctx) want-symbol-start)
        r6 (check r5 "rest-of-symbol" (emit/emit-pred grammar/rest-of-symbol ctx) want-rest-of-symbol)
        rule (grammar/Rule "digit" (grammar/CharRange "0" "9"))
        lines (emit/emit-module [rule] "digit")
        got (to-str lines)
        r7 (check r6 "emit-module" got want-module)
        ig-lines (emit/emit-module [ig-alpha ig-all ig-ignore] "ig-all")
        ig-got (to-str ig-lines)
        r8 (check r7 "emit-module-ig" ig-got want-ig-module)
        an-lines (emit/emit-module [an-alpha an-any] "an-any")
        an-got (to-str an-lines)
        r9 (check r8 "emit-module-an" an-got want-an-module)
        mn-lines (emit/emit-module [mn-alpha mn-run mn-entry] "mn-entry")
        mn-got (to-str mn-lines)
        r10 (check r9 "emit-module-mn" mn-got want-mn-module)
        fn-lines (emit/emit-module [fn-alpha fn-digits fn-word fn-entry] "fn-entry")
        fn-got (to-str fn-lines)
        r11 (check r10 "emit-module-fn" fn-got want-fn-module)
        r12 (cond (str= fn-got want-fn-module)
               (+ r11 (write-file "interpreter/gen-rdr.toc"
                                  (to-str (interpose fn-lines "\n"))))

               r11)
        r13 (cond (str= fn-got want-fn-module)
               (+ r12 (write-file "interpreter/gen-sample.toc" "123abc45!\n*"))

               r12)
        r14 (cond (str= fn-got want-fn-module)
               (+ r13 (write-file "interpreter/gen-sample-ok.toc" "123abc45!\n!"))

               r13)]
    r14))
