;; interpreter/emit-pred.toc — item-3/4/6 verification driver.
;;
;; Emits the char-level predicates for six grammar combinators via
;; intrp-emit.toc's emit-pred and asserts the EXACT expected source
;; lines (fingerprint via to-str over the emitted vector, the
;; body-fingerprint convention from rdr-defp.toc). Then emits the
;; full generated module for a synthetic one-rule grammar
;; ((Rule "digit" (CharRange "0" "9"))) via emit-module, asserts its
;; exact fingerprint, then emits the full generated module for the
;; item-5 synthetic All/Ignore grammar (ig-all / ig-ignore), asserts
;; its exact fingerprint, then emits the full generated module for
;; the item-6 synthetic Any grammar (an-any), asserts its exact
;; fingerprint, and writes it to interpreter/gen-rdr.toc (a build
;; artifact — never committed; built by `make gen-rdr`) plus the
;; sample input to interpreter/gen-sample.toc (also a build artifact;
;; run: ./gen-rdr interpreter/gen-sample.toc).
;;
;; Expected output: 9 "OK" lines (one per check). Any "FAIL" line
;; indicates a problem. Run from the repo root: ./emit-pred
;;
;; The driver is interpreter-side tooling; interpreted programs may
;; not use these constructs.

(add-ns grammar (module "intrp-grammar.toc"))
(add-ns emit (module "intrp-emit.toc"))

;; The exact expected predicate source lines (ctor-table shapes).
;; Rule alts delegate, so symbol-start / rest-of-symbol embed the
;; alpha predicate as a nested (or ...).
(def want-digits
  "(and (<= 48 (char-code c)) (<= (char-code c) 57))")
(def want-upper-case
  "(and (<= 65 (char-code c)) (<= (char-code c) 90))")
(def want-lower-case
  "(and (<= 97 (char-code c)) (<= (char-code c) 122))")
(def want-alpha
  (to-str ["(or " want-lower-case " " want-upper-case ")"]))
(def want-symbol-start
  (to-str ["(or " want-alpha
         " (str= c \".\") (str= c \"_\") (str= c \"<\") (str= c \">\")"
         " (str= c \"=\") (str= c \"+\") (str= c \"-\") (str= c \"*\")"
         " (str= c \"/\"))"]))
(def want-rest-of-symbol
  (to-str ["(or " want-alpha " " want-digits
         " (str= c \".\") (str= c \"_\") (str= c \"<\") (str= c \">\")"
         " (str= c \"=\") (str= c \"+\") (str= c \"-\") (str= c \"*\")"
         " (str= c \"?\") (str= c \"!\"))"]))

;; The exact expected generated module for the synthetic one-rule
;; grammar: header (add-ns + parse-then/parse-or kit + the
;; ParserError field-access protocols + parse-error-line), the digit
;; defn, the parse-seq loop, and main. Fingerprint via to-str over the
;; emitted vector (no separators). The module is inline-free: slurp
;; and exit come from the core.
(def want-digit-defn
  (to-str ["(defn digit [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      " want-digits
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-header
  (to-str [";; gen-rdr.toc - GENERATED by interpreter/intrp-emit.toc (do not edit)."
         ""
         "(add-ns rdr (module \"intrp-rdr.toc\"))"
         ""
         "(defp parse-then [r f])"
         "(extend-type rdr/ParserMatch (parse-then [r f] (f (.value r) (.state r))))"
         "(extend-type rdr/ParserIgnore (parse-then [r f] r))"
         "(extend-type rdr/ParserError (parse-then [r f] r))"
         ""
         "(defp parse-or [r else-f])"
         "(extend-type rdr/ParserMatch (parse-or [r e] r))"
         "(extend-type rdr/ParserIgnore (parse-or [r e] r))"
         "(extend-type rdr/ParserError (parse-or [r e] (e r)))"
         ""
         "(defp parse-error-msg [r])"
         "(extend-type rdr/ParserError (parse-error-msg [v] (.msg v)))"
         ""
         "(defp parse-error-state [r])"
         "(extend-type rdr/ParserError (parse-error-state [v] (.state v)))"
         ""
         "(defn parse-error-line [file out line msg]"
         "  (exit 1 (to-str [out file \":\" (number-str line) \":\" msg])))"]))

(def want-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (digit s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-module
  (to-str [want-header "" want-digit-defn "" want-main]))

;; --- Item 5: All + Ignore -------------------------------------------
;;
;; The synthetic grammar: ig-all is an All of a named Rule child
;; (ig-alpha), a bare String child ("x"), and an anonymous All child
;; (lifted to ig-all-2, its CharRange child lifted to ig-all-2-0);
;; ig-ignore is an Ignore of an anonymous All (lifted to ig-ignore-0,
;; its CharRange child to ig-ignore-0-0). The lifted helpers are
;; emitted BEFORE the Rule defn that calls them (use-after-
;; definition).

(def ig-lower (grammar/CharRange "a" "f"))
(def ig-alpha (grammar/Rule "ig-alpha" (grammar/CharRange "a" "z")))
(def ig-all
  (grammar/Rule "ig-all"
                (grammar/All [ig-alpha "x" (grammar/All [ig-lower "y"])])))
(def ig-ignore
  (grammar/Rule "ig-ignore"
                (grammar/Ignore (grammar/All [ig-lower "z"]))))

(def want-ig-alpha-defn
  (to-str ["(defn ig-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-all-2-0-defn
  (to-str ["(defn ig-all-2-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 102))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-all-2-defn
  (to-str ["(defn ig-all-2 [state]"
         "  (parse-then (ig-all-2-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"y\" (.input s1))"
         "                                  (rdr/ParserMatch \"y\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"y\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-ig-all-defn
  (to-str ["(defn ig-all [state]"
         "  (parse-then (ig-alpha state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"x\" (.input s1))"
         "                                  (rdr/ParserMatch \"x\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"x\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (parse-then (ig-all-2 s2)"
         "                                          (fn [v2 s3]"
         "                                            (rdr/ParserMatch [v0 v1 v2] s3))))))))"]))

(def want-ig-ignore-0-0-defn
  (to-str ["(defn ig-ignore-0-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 102))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-ig-ignore-0-defn
  (to-str ["(defn ig-ignore-0 [state]"
         "  (parse-then (ig-ignore-0-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (cond (str-prefix? \"z\" (.input s1))"
         "                                  (rdr/ParserMatch \"z\" (rdr/take-char s1))"
         "                                  (rdr/ParserError \"expected \\\"z\\\"\" s1))"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-ig-ignore-defn
  (to-str ["(defn ig-ignore [state]"
         "  (parse-or (parse-then (ig-ignore-0 state)"
         "                        (fn [v s2]"
         "                          (rdr/ParserIgnore s2)))"
         "            identity))"]))

(def want-ig-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (ig-all s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-ig-module
  (to-str [want-header ""
           want-ig-alpha-defn ""
           want-ig-all-2-0-defn ""
           want-ig-all-2-defn ""
           want-ig-all-defn ""
           want-ig-ignore-0-0-defn ""
           want-ig-ignore-0-defn ""
           want-ig-ignore-defn ""
           want-ig-main]))

;; --- Item 6: Any (parser-level) -------------------------------------
;;
;; The synthetic grammar: an-any is an Any of a named Rule alt
;; (an-alpha), an anonymous All alt (lifted to an-any-1, its two
;; CharRange children to an-any-1-0 / an-any-1-1), and a bare String
;; alt ("xy" — inlined let-free as the LAST alt, so the last Error
;; falls out for free). The sample file (a / 42 / xy / 5) has each
;; alt win once, then a failure line: "5" defeats an-alpha (not
;; a-z), an-any-1 (one digit, then EOF), and "xy" (no prefix) — the
;; error is the last alt's `expected "xy"` at line 4.

(def an-alpha (grammar/Rule "an-alpha" (grammar/CharRange "a" "z")))
(def an-any
  (grammar/Rule "an-any"
                (grammar/Any [an-alpha
                              (grammar/All [(grammar/CharRange "0" "9")
                                            (grammar/CharRange "0" "9")])
                              "xy"])))

(def want-an-alpha-defn
  (to-str ["(defn an-alpha [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 97 (char-code c)) (<= (char-code c) 122))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-0-defn
  (to-str ["(defn an-any-1-0 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 48 (char-code c)) (<= (char-code c) 57))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-1-defn
  (to-str ["(defn an-any-1-1 [state]"
         "  (let [input (.input state)"
         "        c (subs input 0 1)]"
         "    (cond (str= c \"\")"
         "      (rdr/ParserError \"unexpected end of input\" state)"
         "      (and (<= 48 (char-code c)) (<= (char-code c) 57))"
         "      (rdr/ParserMatch c (rdr/take-char state))"
         "      (rdr/ParserError \"unexpected character\" state))))"]))

(def want-an-any-1-defn
  (to-str ["(defn an-any-1 [state]"
         "  (parse-then (an-any-1-0 state)"
         "              (fn [v0 s1]"
         "                (parse-then (an-any-1-1 s1)"
         "                            (fn [v1 s2]"
         "                              (rdr/ParserMatch [v0 v1] s2))))))"]))

(def want-an-any-defn
  (to-str ["(defn an-any [state]"
         "  (parse-or (an-alpha state)"
         "            (fn [e1]"
         "              (parse-or (an-any-1 state)"
         "                        (fn [e2]"
         "                          (cond (str-prefix? \"xy\" (.input state))"
         "                                (rdr/ParserMatch \"xy\" (rdr/take-char state))"
         "                                (rdr/ParserError \"expected \\\"xy\\\"\" state))))))"]))

(def want-an-main
  (to-str ["(defn parse-seq [file state acc]"
         "  (let [s (rdr/skip-whitespace state)]"
         "    (cond (str= (.input s) \"\")"
         "      (rdr/ParserMatch acc s)"
         "      (parse-or (parse-then (an-any s)"
         "                            (fn [v s2]"
         "                              (parse-seq file (rdr/skip-whitespace s2)"
         "                                          (to-str [acc (to-str [v \"\\n\"])]))))"
         "                (fn [e] (parse-error-line file acc"
         "                                          (rdr/state-line (parse-error-state e))"
         "                                          (parse-error-msg e)))))))"
         ""
         "(main [argv]"
         "  (let [file (extract (get argv 1))]"
         "    (parse-then (parse-seq file (rdr/make-state (slurp file) file 1) \"\")"
         "                (fn [out s] (pr* out)))))"]))

(def want-an-module
  (to-str [want-header ""
           want-an-alpha-defn ""
           want-an-any-1-0-defn ""
           want-an-any-1-1-defn ""
           want-an-any-1-defn ""
           want-an-any-defn ""
           want-an-main]))

;; write-file [path content]: write the string to the file (inline
;; C). The driver runs from the repo root; gen-rdr.toc is a build
;; artifact written by this driver.
(defn write-file [path content]
  (inline "
    String *p = (String *)path_1;
    String *c = (String *)content_2;
    FILE *fd = fopen(p->buffer, \"wb\");
    if (fd == NULL) {
      fprintf(stderr, \"write-file: cannot open file\\n\");
      abort();
    }
    fwrite(c->buffer, 1, c->len, fd);
    fputc('\\n', fd);
    fclose(fd);
    dec_and_free((Term)p, 1);
    dec_and_free((Term)c, 1);
    result = newI60(0);
  "))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side
;; effect (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (print-all-acc (+ acc (pr* (extract (first strs)))) (rest strs))))

;; check: compare a got string with its expected source; print one
;; status line. Returns the threaded acc.
(defn check [acc name got want]
  (cond (str= got want)
    (print-all-acc acc ["OK " name "\n"])
    (print-all-acc acc ["FAIL " name "\ngot:  " got "\nwant: " want "\n"])))

(main [_]
  (let [ctx (emit/EmitCtx "" "")
        r1 (check 0 "digits" (emit/emit-pred grammar/digits ctx) want-digits)
        r2 (check r1 "upper-case" (emit/emit-pred grammar/upper-case ctx) want-upper-case)
        r3 (check r2 "lower-case" (emit/emit-pred grammar/lower-case ctx) want-lower-case)
        r4 (check r3 "alpha" (emit/emit-pred grammar/alpha ctx) want-alpha)
        r5 (check r4 "symbol-start" (emit/emit-pred grammar/symbol-start ctx) want-symbol-start)
        r6 (check r5 "rest-of-symbol" (emit/emit-pred grammar/rest-of-symbol ctx) want-rest-of-symbol)
        rule (grammar/Rule "digit" (grammar/CharRange "0" "9"))
        lines (emit/emit-module [rule] "digit")
        got (to-str lines)
        r7 (check r6 "emit-module" got want-module)
        ig-lines (emit/emit-module [ig-alpha ig-all ig-ignore] "ig-all")
        ig-got (to-str ig-lines)
        r8 (check r7 "emit-module-ig" ig-got want-ig-module)
        an-lines (emit/emit-module [an-alpha an-any] "an-any")
        an-got (to-str an-lines)
        r9 (check r8 "emit-module-an" an-got want-an-module)
        r10 (cond (str= an-got want-an-module)
               (+ r9 (write-file "interpreter/gen-rdr.toc"
                                 (to-str (interpose an-lines "\n"))))

               r9)
        r11 (cond (str= an-got want-an-module)
               (+ r10 (write-file "interpreter/gen-sample.toc" "a\n42\nxy\n5"))

               r10)]
    r11))
