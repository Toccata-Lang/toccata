;; intrp-ast.toc — AST shapes.
;;
;; The Expression deftype holds the 8 shared ctors (Symbol, IntegerLit,
;; FloatLit, StringLit, Call, Fn, FieldGetter, TypeConstraint) plus the
;; eval-only ctors (Superposition, Match, BlockComment, Inline).
;;
;; The parser (intrp-rdr.toc) is a single-pass recursive descent that
;; produces desugared Expression trees directly — there is no Syntax
;; tree and no separate desugar pass.
;;
;; This file is a LIBRARY (no main).

;; --- Locations + module types ----------------------------------------

(deftype Location [file line]
  (str-vect [l]
    [file ": " (str line)]))

(deftype Module [path]
  ! path String
  )

(deftype Constructor [name field-list implementations]
  ! name String
  ! field-list [String]
  ! implementations [Fn]
  )

;; --- Shared helpers ---------------------------------------------------

;; vect-concat: a ++ b (append every element of b to a).
(defn vect-concat [a b]
  (reduce b a vect-conj))

;; --- body-elem protocol (mixed body vectors) -------------------------
;;
;; Fn/Main body vectors hold a mix of TypeConstraint nodes and expression
;; nodes. The recurse impls use body-elem to apply g to expressions but
;; leave TypeConstraint nodes unchanged. The defp must precede the
;; Expression deftype (the Fn ctor's recurse impl references it); the
;; TypeConstraint impl is inline in the deftype.

(defp body-elem [e g] (g e))

;; --- Expression deftype ----------------------------------------------
;;
;; No `!` annotations (item 5): new-toc mis-applies them on multi-field
;; ctors during value construction.

(deftype Expression
    (Symbol [ns sym-name loc]
      (str-vect [v]
                (flat-map ["(Symbol " ns "/" sym-name " " loc ")"]
                          str-vect))
      (recurse [v g]
        v))
    (IntegerLit [value loc]
      (str-vect [v]
                (flat-map ["(IntegerLit " value " " loc ")"]
                          str-vect))
      (recurse [v g]
        v))
    (FloatLit [value loc]
      (str-vect [v]
                (flat-map ["(FloatLit " value " " loc ")"]
                          str-vect))
      (recurse [v g]
        v))
    (StringLit [value loc]
      (str-vect [v]
                (flat-map ["(StringLit \"" value "\" " loc ")" ]
                          str-vect))
      (recurse [v g]
        v))
    (Call [operator operands loc]
      (str-vect [v]
                (flat-map ["(Call " operator "\n" operands " " loc ")"]
                          str-vect))
      (recurse [v g]
        (Call (g (.operator v))
              (vect-map (.operands v) g)
              (.loc v))))
    (Fn [name parameter-list body loc]
      (str-vect [v]
                (flat-map ["(Fn " name " " parameter-list " " body " " loc ")"]
                          str-vect))
      (recurse [v g]
        (Fn (.name v)
            (.parameter-list v)
            (vect-map (.body v) (fn [e]
                                  (body-elem e g)))
            (.loc v))))
    (Superposition [alternatives]
      (str-vect [v]
                (flat-map ["(Superposition " alternatives ")"]
                          str-vect)))
    (TypeConstraint [symbol type-expr]
      (str-vect [v]
                (flat-map ["(TypeConstraint " symbol " " type-expr ")"]
                          str-vect))
      (recurse [v g]
        v)
      (body-elem [e g]
        e))
    (FieldGetter [field-name loc]
      (str-vect [v]
                (flat-map ["(FieldGetter " field-name " " loc ")"]
                          str-vect))
      (recurse [v g]
        v))
    (Match [expr cases default-case]
      (str-vect [v]
                (flat-map ["(Match " expr " " cases " " default-case ")"]
                          str-vect)))
    (BlockComment [lines]
      (str-vect [v]
                (flat-map ["(BlockComment " lines ")"]
                          str-vect))
      (recurse [v g]
        v))
    (Inline [type-expr c-code loc]
      (str-vect [v]
                (flat-map ["(Inline " type-expr " " c-code " " loc ")"]
                          str-vect))))

;; --- TopLevel deftype -------------------------------------------------

(deftype TopLevel
    (Definition [name value loc]
      (recurse [v g]
        (Definition (.name v) (g (.value v)) (.loc v))))
    (DefType [type-name constructors])
    (Defp [name parameter-list body])
    (ExtendType [type-name methods])
    (AddNs [namespace module-path])
    Inline
    BlockComment
    (Main [parameter-list body loc]
      (recurse [v g]
        (Main (.parameter-list v)
              (vect-map (.body v) (fn [e] (body-elem e g)))
              (.loc v))))
    )

(deftype returns [])
