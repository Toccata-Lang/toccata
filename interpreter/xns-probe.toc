(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; val-kind: tag the top-level parsed value (local protocol — instance? is
;; unsupported under new-toc).
(defp val-kind [v])
(extend-type ast/IntegerLit (val-kind [_] 44))

(main [_]
      (println "vk:" (val-kind (ast/IntegerLit 77 (ast/Location _FILE_ _LINE_))))
      (-> (rdr/make-state "72" "sample.toc" 1)
          (rdr/parse-expr)
          (.value )
          (val-kind)))
