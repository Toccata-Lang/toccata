;; intrp-rdr.toc — phase-1 parser: state + tokens + ana/unfold + top-level.
;;
;; Three-pass nanopass structure:
;;   1. Parse (ana/unfold): unfold state parse-node -> Syntax tree.
;;      parse-node reads ONE level of an expression, emitting a Syntax node
;;      with child states. The unfold machinery recurses into the child
;;      states via the recurse protocol.
;;   2. Desugar (transCata/fold): fold tree desugar-node -> Expression tree.
;;      (In intrp-ast.toc.)
;;   3. Eval: settled protocol over the 8 Expression ctors.
;;
;; This file is a LIBRARY (no main). The verification drivers are
;; interpreter/rdr-exprs.toc (expressions) and interpreter/rdr-top.toc
;; (top-level + program map).
;;
;; Model (settled):
;;   * ParserState [input values] — `input` is the unconsumed suffix of
;;     the source; `values` is a bookkeeping map {"file" String, "line"
;;     Integer}. `subs` returns O(1) SubString views.
;;   * Maximal-run reads scan for a length, then extract with ONE subs.
;;   * The line counter is bumped by take-char when it consumes "\n".
;;   * NO local symbol may shadow a symbol from the core namespace.
;;
;; new-toc crutches used here (build crutch, not design constraints):
;;   * ONE forward declaration for genuine mutual recursion: parse-node
;;     and skip-expr are mutually recursive (parse-node calls skip-expr
;;     to advance past child expressions; skip-expr calls parse-node for
;;     nested structures). parse-node is forward-declared.
;;   * A cond branch that is a BARE CALL to a token reader is wrapped in a
;;     let (the read-run let-wrap crutch).

(add-ns ast (module "intrp-ast.toc"))

;; --- ParserState -----------------------------------------------------

(deftype ParserState [input values]
  ! input String
  (str-vect [v]
    (flat-map ["(ParserState " input " " values ")"]
              str-vect)))

;; --- ParserResults ---------------------------------------------------

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

;; --- Token groupings -------------------------------------------------
;;
;; Each implements map / flat-map per docs/toccata-style.md. No `!`
;; annotations (new-toc mis-applies them on multi-field ctors).

(deftype Token [text state]
  (map [v f]
    (Token (f (.text v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (f (.text v)) (f (.state v)))))

(deftype FullSymbol [ns nom state]
  (str-vect [v]
    (flat-map ["(FullSymbol " ns "/" nom " " state ")"]
              str-vect))
  (map [v f]
    (FullSymbol (f (.ns v)) (f (.nom v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (ast/vect-concat (f (.ns v)) (f (.nom v)))
                     (f (.state v)))))

(deftype TypeExpr [text state]
  (map [v f]
    (TypeExpr (f (.text v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (f (.text v)) (f (.state v)))))

(deftype ParamList [params state]
  (map [v f]
    (ParamList (map (.params v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.params v) f) (f (.state v)))))

(deftype TypeConstraintPair [tc state]
  (map [v f]
    (TypeConstraintPair (f (.tc v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (f (.tc v)) (f (.state v)))))

(deftype TopLevelEntry [name value]
  (map [v f]
    (TopLevelEntry (f (.name v)) (f (.value v))))
  (flat-map [v f]
    (ast/vect-concat (f (.name v)) (f (.value v)))))

;; Collection result groupings: the collected child states/nodes + the
;; state after the closing delimiter.

(deftype CollectResult [states state]
  (map [v f]
    (CollectResult (map (.states v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.states v) f) (f (.state v)))))

(deftype BodyResult [states state]
  (map [v f]
    (BodyResult (map (.states v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.states v) f) (f (.state v)))))

(deftype LetBindingsResult [bindings state]
  (map [v f]
    (LetBindingsResult (map (.bindings v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.bindings v) f) (f (.state v)))))

(deftype HashPairsResult [pairs state]
  (map [v f]
    (HashPairsResult (map (.pairs v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.pairs v) f) (f (.state v)))))

;; --- State helpers ---------------------------------------------------

(defn make-state [input file line]
  (ParserState input {"file" file, "line" line}))

(defn state-line [state]
  (extract (get (.values state) "line")))

;; --- Character predicates --------------------------------------------

(defn is-digit [c]
  (let [n (char-code c)]
    (and (<= 48 n)
         (<= n 57))))

(defn is-alpha [c]
  (let [n (char-code c)]
    (or (and (<= 65 n)
             (<= n 90))
        (and (<= 97 n)
             (<= n 122)))))

;; symbol-start?: true iff the string STARTS with a symbol-start char.
;; Takes a full string (is-alpha/char-code read the first char; the
;; special chars are prefix-checked).
(defn symbol-start? [s]
  (or (is-alpha s)
      (str-prefix? "." s)
      (str-prefix? "_" s)
      (str-prefix? "<" s)
      (str-prefix? ">" s)
      (str-prefix? "=" s)
      (str-prefix? "+" s)
      (str-prefix? "-" s)
      (str-prefix? "*" s)
      (str-prefix? "/" s)))

(defn symbol-continue? [c]
  (or (is-alpha c)
      (is-digit c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "?")
      (str= c "!")))

(defn float-char? [c]
  (or (is-digit c)
      (str= c ".")))

;; --- Token helpers ---------------------------------------------------

(defn take-char [state]
  (let [input (.input state)
        c (subs input 0 1)
        rest-input (subs input 1 (count input))
        line (state-line state)
        new-line (cond (str= c "\n")
                       (+ line 1)
                       line)]
    (ParserState rest-input
                 (assoc (.values state) "line" new-line))))

(defn skip-comment [state]
  (let [input (.input state)]
    (cond (str= input "")
          state
          (str-prefix? "\n" input)
          state
          (skip-comment (take-char state)))))

(defn skip-whitespace [state]
  (let [input (.input state)]
    (cond (str= input "")
          state
          (str-prefix? ";" input)
          (skip-whitespace (skip-comment (take-char state)))
          (str-prefix? " " input)
          (skip-whitespace (take-char state))
          (str-prefix? "\t" input)
          (skip-whitespace (take-char state))
          (str-prefix? "\n" input)
          (skip-whitespace (take-char state))
          (str-prefix? "\r" input)
          (skip-whitespace (take-char state))
          state)))

(defn run-length [s pred]
  (let [c (subs s 0 1)]
    (cond (str= c "")
          0
          (pred c)
          (+ 1 (run-length (subs s 1 (count s)) pred))
          0)))

(defn read-run [state pred]
  (let [input (.input state)
        len (run-length input pred)
        run (subs input 0 len)
        rest-input (subs input len (count input))]
    (Token run (ParserState rest-input (.values state)))))

;; --- Token readers ---------------------------------------------------

(defn read-string-content [state]
  (let [input (.input state)]
    (cond (str= input "")
          state
          (str-prefix? "\\" input)
          (read-string-content (take-char (take-char state)))
          (str-prefix? "\"" input)
          state
          (read-string-content (take-char state)))))

(defn read-string [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (str-prefix? "\"" input)
          (let [after-open (take-char state)
                at-close (read-string-content after-open)
                content-len (- (count (.input after-open))
                               (count (.input at-close)))
                content (subs (.input after-open) 0 content-len)
                end-state (take-char at-close)]
            (Token content end-state))
          (Token "" state))))

;; (cond-branch let-wrap crutch: see original read-symbol)
(defn read-symbol [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (symbol-start? input)
          (let [tok (read-run state symbol-continue?)]
            tok)
          (Token "" state))))

(defn read-int [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (is-digit input)
          (let [tok (read-run state is-digit)]
            tok)
          (Token "" state))))

(defn read-float [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (is-digit input)
          (let [tok (read-run state float-char?)]
            tok)
          (Token "" state))))

;; --- Helpers ---------------------------------------------------------

(defp result-kind [r])
(extend-type ParserMatch (result-kind [_] 0))
(extend-type ParserIgnore (result-kind [_] 1))
(extend-type ParserError (result-kind [_] 2))
(extend-type ParserFail (result-kind [_] 3))

(defn make-loc [state]
  (let [file (extract (get (.values state) "file"))]
    (ast/Location file (state-line state))))

;; sub-to-str: copy a SubString (or String) to a fresh full String.
(defn sub-to-str [s]
  (inline String "
    char *buf;
    int64_t len;
    if (((Value *)s_1)->type == SubStringType) {
      ReifiedVal *ss = (ReifiedVal *)s_1;
      String *parent = (String *)ss->impls[0];
      long start = getI60(ss->impls[1]);
      buf = &parent->buffer[start];
      len = getI60(ss->impls[2]);
    } else {
      String *strVal = (String *)s_1;
      buf = strVal->buffer;
      len = strVal->len;
    }
    String *out = malloc_string(len + 1);
    memcpy(out->buffer, buf, len);
    out->len = len;
    out->buffer[len] = 0;
    dec_and_free((Term)s_1, 1);
    result = termVal((Term)out);
  "))

(defn read-full-symbol [state]
  (let [tok (read-symbol state)
        fst (.text tok)
        s2 (.state tok)
        input (.input s2)]
    (cond (str= input "")
          (FullSymbol "" fst s2)

          (str-prefix? "/" input)
          (let [after-slash (take-char s2)
                name-tok (read-symbol after-slash)]
            (FullSymbol fst (.text name-tok) (.state name-tok)))

          (FullSymbol "" fst s2))))

(defn read-type-expr [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [s2 (skip-whitespace (take-char s))
                inner (read-symbol s2)
                s3 (skip-whitespace (.state inner))
                s4 (take-char s3)]
            (TypeExpr (.text inner) s4))
          (let [nm (read-symbol s)]
            (TypeExpr (.text nm) (.state nm))))))

(defn contains-dot [s]
  (cond
    (str= s "")
    None
    (str= (subs s 0 1) ".")
    (Some 1)
    (contains-dot (subs s 1 (count s)))))

(defn text-to-int-acc [s acc]
  (cond
    (str= s "")
    acc
    (let [d (- (char-code (subs s 0 1)) 48)]
      (text-to-int-acc (subs s 1 (count s))
                       (+ (* 10 acc) d)))))

(defn text-to-int [s]
  (text-to-int-acc s 0))

;; --- Skip functions (advance state past an expression) ---------------
;;
;; skip-expr consumes one expression without building an AST node. It is
;; used by parse-node to advance past child expressions and note their
;; start states. Mutually recursive with parse-node (forward-declared).

(def parse-node)
(def skip-expr)

;; skip-until: skip expressions until `delim` (consumed). Returns the
;; state after the delimiter. Self-recursive.
(defn skip-until [state delim]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          s
          (str-prefix? delim input)
          (take-char s)
          (let [s2 (skip-expr s)]
            (skip-until s2 delim)))))

;; skip-tc: skip a `!` type constraint. state is at the `!`.
(defn skip-tc [state]
  (let [s (skip-whitespace (take-char state))
        nm (read-symbol s)
        s2 (skip-whitespace (.state nm))]
    (let [te (read-type-expr s2)]
      (.state te))))

;; skip-body: skip a fn/defn/main body (leading `!` markers + expressions)
;; until `)` (consumed). Returns the state after `)`.
(defn skip-body [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? ")" input)
          (take-char s)
          (str-prefix? "!" input)
          (let [s2 (skip-tc s)]
            (skip-body s2))
          (let [s2 (skip-expr s)]
            (skip-body s2)))))

;; skip-let-bindings: skip let bindings `[ b1 e1 ... ]` (consumed).
;; state is just after the `[`. Returns the state after `]`.
(defn skip-let-bindings [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "]" input)
          (take-char s)
          (let [nm (read-symbol s)
                s2 (skip-expr (skip-whitespace (.state nm)))]
            (skip-let-bindings s2)))))

;; skip-hash-pairs: skip hash pairs `{ k1 v1 ... }` (consumed).
;; state is just after the `{`. Returns the state after `}`.
(defn skip-hash-pairs [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "}" input)
          (take-char s)
          (let [s2 (skip-expr s)
                s3 (skip-expr s2)]
            (skip-hash-pairs s3)))))

;; skip-expr: consume one expression without building an AST node.
;; Returns the state after the expression.
(defn skip-expr [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          s
          (str-prefix? "(" input)
          (let [s2 (skip-whitespace (take-char s))
                in2 (.input s2)]
            (cond (str-prefix? ")" in2)
                  (take-char s2)
                  (str= in2 "")
                  s2
                  (let [s3 (skip-expr s2)]
                    (skip-until s3 ")"))))
          (str-prefix? "[" input)
          (let [s2 (skip-whitespace (take-char s))
                in2 (.input s2)]
            (cond (str-prefix? "]" in2)
                  (take-char s2)
                  (str= in2 "")
                  s2
                  (let [s3 (skip-expr s2)]
                    (skip-until s3 "]"))))
          (str-prefix? "{" input)
          (let [s2 (skip-whitespace (take-char s))
                in2 (.input s2)]
            (cond (str-prefix? "}" in2)
                  (take-char s2)
                  (str= in2 "")
                  s2
                  (let [s3 (skip-expr s2)
                        s4 (skip-expr s3)]
                    (skip-hash-pairs s4))))
          (str-prefix? "\"" input)
          (.state (read-string s))
          (str-prefix? "'" input)
          (.state (read-symbol (take-char s)))
          (is-digit input)
          (.state (read-float s))
          (symbol-start? input)
          (.state (read-full-symbol s))
          ;; invalid char: consume it and retry (total, never fails)
          (skip-expr (take-char s)))))

;; parse-type-constraint: state at `!`. Returns a
;; TypeConstraintPair [TypeConstraint new-state].
(defn parse-type-constraint [state]
  (let [s (skip-whitespace (take-char state))
        nm (read-symbol s)
        sym (.text nm)
        te (read-type-expr (skip-whitespace (.state nm)))]
    (TypeConstraintPair (ast/TypeConstraint sym (.text te)) (.state te))))

;; --- Collection helpers ----------------------------------------------
;;
;; Collect child states (and type-constraint nodes) until a delimiter.
;; Return a result grouping with the collected states + the state after
;; the delimiter.

;; collect-until: collect expression states until `delim` (consumed).
(defn collect-until-acc [state delim acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (CollectResult acc s)

          (str-prefix? delim input)
          (CollectResult acc (take-char s))

          (let [child-state s
                s2 (skip-expr s)]
            (collect-until-acc s2 delim (vect-conj acc child-state))))))

(defn collect-until [state delim]
  (collect-until-acc state delim empty-vector))

;; collect-body-states: collect body states (expr states + TC nodes)
;; until `)` (consumed). Returns a BodyResult.
(defn collect-body-states-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? ")" input)
          (BodyResult acc (take-char s))
          (str-prefix? "!" input)
          (let [tc-pair (parse-type-constraint s)]
            (collect-body-states-acc (.state tc-pair)
                                     (vect-conj acc (.tc tc-pair))))
          (str= input "")
          (BodyResult acc s)
          (let [child-state s
                s2 (skip-expr s)]
            (collect-body-states-acc s2 (vect-conj acc child-state))))))

(defn collect-body-states [state]
  (collect-body-states-acc state empty-vector))

;; collect-let-bindings: collect let bindings until `]` (consumed).
;; Returns a LetBindingsResult.
(defn collect-let-bindings-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "]" input)
          (LetBindingsResult acc (take-char s))
          (str= input "")
          (LetBindingsResult acc s)
          (let [nm (read-symbol s)
                name (.text nm)
                s2 (skip-whitespace (.state nm))
                child-state s2
                s3 (skip-expr s2)]
            (collect-let-bindings-acc s3
                                      (vect-conj acc
                                                 (ast/LetBinding name child-state)))))))

(defn collect-let-bindings [state]
  (collect-let-bindings-acc state empty-vector))

;; collect-hash-pairs: collect hash pairs until `}` (consumed).
;; Returns a HashPairsResult.
(defn collect-hash-pairs-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "}" input)
          (HashPairsResult acc (take-char s))
          (str= input "")
          (HashPairsResult acc s)
          (let [key-state s
                s2 (skip-expr s)
                val-state (skip-whitespace s2)
                s3 (skip-expr val-state)]
            (collect-hash-pairs-acc s3
                                    (vect-conj acc
                                               (ast/HashPair key-state val-state)))))))

(defn collect-hash-pairs [state]
  (collect-hash-pairs-acc state empty-vector))

;; --- Leaf expression parsers (return a node, no child states) --------

(defn parse-string-lit-node [state]
  (let [r (read-string state)
        content (.text r)
        s2 (.state r)]
    (ast/StringLit content (make-loc s2))))

(defn parse-quoted-sym-node [state]
  (let [r (read-symbol (take-char state))
        text (.text r)
        s2 (.state r)]
    (ast/StringLit text (make-loc s2))))

(defn parse-number-node [state]
  (let [r (read-float state)
        text (.text r)
        s2 (.state r)
        loc (make-loc s2)]
    (cond (contains-dot text)
          (ast/FloatLit text loc)
          (let [n (text-to-int text)]
            (ast/IntegerLit n loc)))))

(defn parse-symbol-node [state]
  (let [r (read-full-symbol state)]
    (ast/Symbol (.ns r) (.nom r) (make-loc (.state r)))))

;; read-param-list: a `[ p1 p2 ... ]` parameter list. state is just after
;; the `[`. Returns a ParamList [params new-state].
(defn read-param-list-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "]" input)
          (ParamList acc (take-char s))
          (let [nm (read-symbol s)]
            (read-param-list-acc (.state nm) (vect-conj acc (.text nm)))))))

(defn read-param-list [state]
  (read-param-list-acc state empty-vector))

;; --- Special form parsers (return a Syntax node with child states) ---
;;
;; Each reads the form's structure (delimiters, names) and notes the
;; child states (positions of sub-expressions). The unfold machinery
;; later unfolds the child states into sub-expression nodes.

;; parse-fn-node: state after `fn`. Named or anonymous.
;; Returns an Expression/Fn node with body states.
(defn parse-fn-node [state name]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [s2 (skip-whitespace (take-char s))
                params (read-param-list s2)
                s3 (.state params)
                body-res (collect-body-states s3)
                s4 (.state body-res)]
            (ast/Fn name (.params params) (.states body-res) (make-loc s4)))
          (let [nm (read-symbol s)
                fn-name (.text nm)
                s2 (skip-whitespace (.state nm))]
            (let [s3 (skip-whitespace (take-char s2))
                  params (read-param-list s3)
                  s4 (.state params)
                  body-res (collect-body-states s4)
                  s5 (.state body-res)]
              (ast/Fn fn-name (.params params) (.states body-res) (make-loc s5)))))))

;; parse-let-node: state after `let`.
;; Returns a Syntax/Let node with binding expr states + body states.
(defn parse-let-node [state]
  (let [s (skip-whitespace state)
        s2 (skip-whitespace (take-char s))
        bindings-res (collect-let-bindings s2)
        s3 (.state bindings-res)
        body-res (collect-body-states s3)
        s4 (.state body-res)]
    (ast/Let (.bindings bindings-res) (.states body-res) (make-loc s4))))

;; cond-pair-acc: pair a flat [t1 v1 ... tN vN e] state vector into
;; [Clause t1 v1 ... Clause tN vN], stopping when the trailing else
;; state is the only one left.
(defn cond-pair-acc [states acc]
  (cond (= (count states) 1)
        acc
        (let [t (extract (first states))
              r1 (rest states)
              v (extract (first r1))]
          (cond-pair-acc (rest r1)
                         (vect-conj acc (ast/Clause t v))))))

;; parse-cond-node: state after `cond`.
;; Returns a Syntax/Cond node with clause states + the else state.
(defn parse-cond-node [state]
  (let [res (collect-until state ")")
        states (.states res)
        clauses (cond-pair-acc states empty-vector)
        else (extract (last states))]
    (ast/Cond clauses else (make-loc (.state res)))))

;; parse-and-node / parse-or-node: state after `and`/`or`.
;; Returns a Syntax/And or Syntax/Or node with expr states.
(defn parse-and-node [state]
  (let [res (collect-until state ")")]
    (ast/And (.states res) (make-loc (.state res)))))

(defn parse-or-node [state]
  (let [res (collect-until state ")")]
    (ast/Or (.states res) (make-loc (.state res)))))

;; parse-str-node / parse-println-node: state after `str`/`println`.
;; Returns a Syntax/Str or Syntax/Println node with expr states.
(defn parse-str-node [state]
  (let [res (collect-until state ")")]
    (ast/Str (.states res) (make-loc (.state res)))))

(defn parse-println-node [state]
  (let [res (collect-until state ")")]
    (ast/Println (.states res) (make-loc (.state res)))))

;; parse-threading-node: state after `->`.
;; Returns a Syntax/Threading node with initial state + step states.
(defn parse-threading-node [state]
  (let [s (skip-whitespace state)
        initial-state s
        s2 (skip-expr s)
        steps-res (collect-until s2 ")")]
    (ast/Threading initial-state (.states steps-res) (make-loc (.state steps-res)))))

;; parse-vector-node: state at `[`.
;; Returns a Syntax/VectorLit node with element states.
(defn parse-vector-node [state]
  (let [s (skip-whitespace (take-char state))
        res (collect-until s "]")]
    (ast/VectorLit (.states res) (make-loc (.state res)))))

;; parse-hash-node: state at `{`.
;; Returns a Syntax/HashLit node with pair states.
(defn parse-hash-node [state]
  (let [s (skip-whitespace (take-char state))
        res (collect-hash-pairs s)]
    (ast/HashLit (.pairs res) (make-loc (.state res)))))

;; --- parse-node (the ana) --------------------------------------------
;;
;; parse-node reads ONE level of an expression, emitting a Syntax node
;; with child states. The unfold machinery recurses into the child states
;; via the recurse protocol.
;;
;; For leaf expressions (symbol, number, string), parse-node returns the
;; Expression ctor directly (no child states).
;;
;; For compound expressions (call, vector, hash, special forms), parse-node
;; notes the child states and returns the appropriate Syntax/Expression
;; node. The child states are unfolded by the recurse protocol.

(defn dispatch-special-node [ns name op-state s2]
  (cond (str= name "fn") (parse-fn-node s2 name)
        (str= name "let") (parse-let-node s2)
        (str= name "cond") (parse-cond-node s2)
        (str= name "and") (parse-and-node s2)
        (str= name "or") (parse-or-node s2)
        (str= name "str") (parse-str-node s2)
        (str= name "println") (parse-println-node s2)
        (str= name "->") (parse-threading-node s2)
        (let [res (collect-until s2 ")")]
          (ast/Call op-state (.states res)))))

(defn parse-call-node [state]
  (let [s (skip-whitespace (take-char state))
        input (.input s)]
    (cond (str= input "")
          (ast/Symbol "" "" (make-loc s))

          (str-prefix? ")" input)
          (ast/Symbol "" "" (make-loc s))

          (symbol-start? input)
          (let [op-state s
                sym (read-full-symbol s)
                ns (.ns sym)
                name (.nom sym)
                s2 (.state sym)]
            (dispatch-special-node ns name op-state s2))

          (let [op-state s
                s2 (skip-expr s)
                res (collect-until s2 ")")]
            (ast/Call op-state (.states res))))))

(defn parse-node [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (ast/Symbol "" "" (make-loc s))

          (str-prefix? "(" input)
          (parse-call-node s)

          (str-prefix? "[" input)
          (parse-vector-node s)

          (str-prefix? "{" input)
          (parse-hash-node s)

          (str-prefix? "\"" input)
          (parse-string-lit-node s)

          (str-prefix? "'" input)
          (parse-quoted-sym-node s)

          (is-digit input)
          (parse-number-node s)

          (symbol-start? input)
          (parse-symbol-node s)

          (ast/Symbol "" "" (make-loc s)))))

;; --- unfold-expr ------------------------------------------------------
;;
;; The ana: unfold a state into a Syntax tree using parse-node.

(defn unfold-expr [state]
  (unfold state parse-node))

;; --- Top-level forms + program map -----------------------------------
;;
;; parse-top-level dispatches on the first token of a top-level form and
;; builds the settled TopLevel node. parse-program loops until EOF,
;; accumulating the name -> TopLevel map.
;;
;; The top-level parser is NOT part of the unfold machinery. It reads the
;; form keyword and name, notes the value/body states, skips the form,
;; and tracks the state after the form. The value/body is parsed by
;; unfolding the noted states.

;; parse-top-def-value-expr: state at the value (a non-`)` position).
;; Notes the value state, skips the value, consumes `)`. Returns
;; ParserMatch [TopLevelEntry state-after-`)`] or ParserError.
(defn parse-top-def-value-expr [name name-loc state]
  (let [s (skip-whitespace state)
        val-state s
        s2 (skip-expr s)
        s3 (skip-whitespace s2)
        in3 (.input s3)]
    (cond (str-prefix? ")" in3)
          (let [val (unfold-expr val-state)]
            (ParserMatch (TopLevelEntry name
                                        (ast/Definition name val name-loc))
                         (take-char s3)))
          (ParserError "expected ) after def value" s3))))

;; parse-top-def-value: state at the value position (or at `)` for a bare
;; def). Builds the Definition, or ignores a bare `(def name)`.
(defn parse-top-def-value [name name-loc state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? ")" input)
          (ParserIgnore (take-char s))
          (parse-top-def-value-expr name name-loc s))))

;; parse-top-def: state just after `def`.
(defn parse-top-def [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (sub-to-str (.text nm))]
            (parse-top-def-value name (make-loc (.state nm)) (.state nm)))
          (ParserError "expected a name after def" s))))

;; parse-top-defn: state just after `defn`.
(defn parse-top-defn [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (sub-to-str (.text nm))
                s2 (skip-whitespace (.state nm))]
            (cond (str-prefix? "[" (.input s2))
                  (let [s3 (skip-whitespace (take-char s2))
                        params (read-param-list s3)
                        s4 (.state params)
                        body-res (collect-body-states s4)
                        s5 (.state body-res)
                        body (vect-map (.states body-res) unfold-expr)]
                    (ParserMatch (TopLevelEntry name
                                                (ast/Definition name
                                                                (ast/Fn name
                                                                         (.params params)
                                                                         body
                                                                         (make-loc s5))
                                                                (make-loc (.state nm))))
                                 s5))
                  (ParserError "expected a parameter list after defn name" s2)))
          (ParserError "expected a name after defn" s))))

;; parse-top-main: state just after `main`.
(defn parse-top-main [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [params (read-param-list (take-char s))
                p-vec (.params params)
                s2 (.state params)
                body-res (collect-body-states s2)
                s3 (.state body-res)
                body (vect-map (.states body-res) unfold-expr)]
            (ParserMatch (TopLevelEntry "main"
                                        (ast/Main p-vec body (make-loc s3)))
                         s3))
          (ParserError "expected a parameter list after main" s))))

;; parse-top-level-args: dispatch on the keyword.
(defn parse-top-level-args [name s2]
  (cond (str= name "def") (parse-top-def s2)
        (str= name "defn") (parse-top-defn s2)
        (str= name "main") (parse-top-main s2)
        (str= name "inline")
        (ParserError "top-level inline is not supported in phase 1" s2)
        (str= name "deftype")
        (ParserError "deftype is not supported in phase 1" s2)
        (str= name "defp")
        (ParserError "defp is not supported in phase 1" s2)
        (str= name "extend-type")
        (ParserError "extend-type is not supported in phase 1" s2)
        (str= name "add-ns")
        (ParserError "add-ns is not supported in phase 1" s2)
        (str= name "match")
        (ParserError "match is not supported in phase 1" s2)
        (str= name "defmacro")
        (ParserError "defmacro is not supported in phase 1" s2)
        (ParserError "unexpected top-level form" s2)))

;; parse-top-level-form: state just after the `(` of a top-level form.
(defn parse-top-level-form [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (.text nm)
                s2 (skip-whitespace (.state nm))]
            (parse-top-level-args name s2))
          (ParserError "unexpected top-level form" s))))

;; parse-top-level: parse one top-level form.
(defn parse-top-level [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "(" input)
          (parse-top-level-form (take-char s))
          (str-prefix? "|" input)
          (ParserError "superposition (|) is not supported in phase 1" s)
          (ParserError "unexpected character at top level" s))))

;; parse-program-acc: parse top-level forms until EOF.
(defn parse-program-acc [state m]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (ParserMatch m s)
          (let [r (parse-top-level s)
                k (result-kind r)]
            (cond (= k 2)
                  r
                  (= k 1)
                  (parse-program-acc (.state r) m)
                  (let [entry (.value r)]
                    (parse-program-acc (.state r)
                                       (assoc m (.name entry) (.value entry)))))))))

;; parse-program: parse a whole file into the name -> TopLevel map.
(defn parse-program [state]
  (parse-program-acc state emptyBMI))
