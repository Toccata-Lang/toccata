;; intrp-rdr.toc - superposition-based reader.
;;
;; Parse alternatives are superpositions. A parser is
;; fn [state] -> sup of ParserResults. The monad is the machine:
;;   unit = a bare (ParserMatch v s)
;;   bind = the flat-map protocol (the machine duplicates the call
;;          per sup leaf)
;;   alt  = the | literal
;;   fail = (|) - bare NUL; propagates through flat-map and | to the
;;          top-level collapse, which returns the seed
;;
;; A single collapse at the top of the parser folds the sup with the
;; pick-result protocol: a ParserMatch truncates the fold; ParserError
;; leaves merge, keeping the larger line (a tie keeps the left leaf -
;; see the pick-result note below). ParserError is produced
;; only when there is a real error to report.
;;
;; This file is a LIBRARY (no main). The verification driver is
;; interpreter/rdr-sup.toc.

(add-ns ast (module "intrp-ast.toc"))

;; --- ParserState -----------------------------------------------------

(deftype ParserState [input values]
  ! input String
  (str-vect [v]
    (flat-map ["(ParserState " input " " values ")"]
              str-vect)))

(defn make-state [input file line]
  (ParserState input {'file file, 'line line}))

(defn state-line [state]
  (either (get (.values state) 'line)
          0))

;; take-char: consume one character; bump the line counter on "\n".
(defn take-char [state]
  (let [input (.input state)
        line (state-line state)
        new-line (cond (flat-map (first input)
                                 (fn [c]
                                   (str= "\n" c)))
                       (+ line 1)

                       line)]
    (ParserState (rest input)
                 (assoc (.values state)  'line new-line))))

(defn drop-char [state]
  (let [input (.input state)]
    (ParserState (rest input)
                 (.values state))))

;; skip-comment: state is just after the ";" - skip to end of line
;; (the newline itself is not consumed).
(defn skip-comment [state]
  (let [input (.input state)]
    (cond (or (str= input "")
              (str-prefix? "\n" input))
          state

          (skip-comment (drop-char state)))))

;; skip-whitespace: spaces, tabs, newlines, carriage returns, and
;; comments.
(defn skip-whitespace [state]
  (let [input (.input state)]
    (cond (str= input "")
          state

          (str-prefix? ";" input)
          (skip-whitespace (skip-comment (drop-char state)))

          (or (str-prefix? " " input)
              (str-prefix? "\t" input)
              (str-prefix? "\r" input))
          (skip-whitespace (drop-char state))

          (str-prefix? "\n" input)
          (let [line (state-line state)
                new-state (ParserState (rest input)
                                       (assoc (.values state) 'line (+ line 1)))]
            (skip-whitespace new-state))

          state)))

;; pick-result: the fold of the single top-level collapse. A match
;; truncates the fold; errors merge, keeping the error with the
;; larger line. The
;; collapse fold runs the right leaf first and then the left leaf
;; against the accumulator, so a line tie keeps the left leaf.
(defp pick-result [r acc])

;; --- ParserResults ---------------------------------------------------
;;
;; Leaves of a parse superposition. The flat-map impls ARE the monad:
;; ParserMatch threads the continuation (a value -> parser function)
;; over the value and the state; ParserError short-circuits (the
;; continuation never runs on it). No `!` annotations (new-toc
;; mis-applies them on multi-field ctors).

(defp next-step [r f])
(defp parser-fn [p])
(deftype ParserResults
  (ParserMatch [value state]
    (str-vect [_]
              (flat-map ["(ParserMatch " value " " state ")"]
                        str-vect))

    (map [v f]
         (ParserMatch (f value) state))

    (next-step [m next]
               ((parser-fn (next value)) state))

    (pick-result [m acc]
                 m))

  (ParserError [msg state]
    (str-vect [_]
              (flat-map ["(ParserError " msg " " state ")"]
                        str-vect))
    (map [e f]
         e)

    (next-step [e _]
               e)

    (pick-result [err1 err2]
                 (let [l1 (state-line (.state err1))
                       l2 (state-line (.state err2))]
                   (cond (<= l2 l1)
                         err1

                         err2)))))

;; --- Character predicates ---------------------------------------------

(defn is-alpha [c]
  (let [n (char-code c)]
    (or (and (<= 65 n)
             (<= n 90))
        (and (<= 97 n)
             (<= n 122)))))

(defn is-digit [c]
  (let [n (char-code c)]
    (and (<= 48 n)
         (<= n 57))))

;; symbol-start?: true iff the string STARTS with a symbol-start char
;; (is-alpha/char-code read the first char; the specials are
;; prefix-checked).
(defn symbol-start? [s]
  (or (is-alpha s)
      (str-prefix? "." s)
      (str-prefix? "_" s)
      (str-prefix? "<" s)
      (str-prefix? ">" s)
      (str-prefix? "=" s)
      (str-prefix? "+" s)
      (str-prefix? "-" s)
      (str-prefix? "*" s)
      (str-prefix? "/" s)))

(defn symbol-continue? [c]
  (or (is-alpha c)
      (is-digit c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "?")
      (str= c "!")))

;; run-length: how many chars from the front satisfy pred. Self-
;; recursive over a strictly shorter string each step - a scan of
;; data, not a parse, so no fix.
(defn run-length [s pred]
  (cond (flat-map (first s) pred)
        (+ 1 (run-length (rest s) pred))

        0))

;; --- Parsers -----------------------------------------------------------

(deftype Parser [f]
  (str-vect [_]
    ["(Parser ...)"])
  ;; 'f' is a function that takes a state value and returns a ParserMatch value

  (parser-fn [_]
    f)

  (map [p m-f]
    (Parser (fn [s]
              (map (f s) m-f))))
  (flat-map [p m-f]
    (Parser (fn [s]
              (next-step (f s) m-f)))))

(defn error [msg]
  (Parser (fn [state]
            (ParserError msg state))))

(defn always [v]
  (Parser (fn [state]
            (ParserMatch v state))))

(defn optional [p]
  (| p (always "")))

;; many: zero or more applications of p. Value: a vector of the
;; results. One-or-more is the LEFT branch (the collapse fold is
;; left-first, so a match wins over the empty); comp (not conj)
;; concatenates the tail.
(defn many-step [p]
  (| (for [x p
           xs (many-step p)]
       (conj xs x))
     (always [])))

(defn many [p]
  (Parser (fn [s]
            (map ((.f (many-step p)) s) reverse))))

;; TODO: this version leaks nodes. Fix eventually
;; (defn many [p]
;;   (fix (fn [self]
;;          (| (for [x p
;;                   xs self]
;;               (comp (vector x) xs))
;;             (always (vector))))))

(def comment
  (Parser (fn [state]
            (let [old-input (.input state)
                  new-state (skip-comment state)]
              (ParserMatch (subs old-input 0 (- (count old-input)
                                                (count (.input new-state))))
                           new-state)))))

(def whitespace
  (Parser (fn [state]
            (ParserMatch "" (skip-whitespace state)))))

;; literal: match the input against an exact string prefix. Value:
;; the literal. State: just past it. No match -> (|).
(defn literal [text]
  (Parser (fn [state]
            (let [input (.input state)]
              (cond (str-prefix? text input)
                    (ParserMatch text
                                 (ParserState (subs input (count text) (count input))
                                              (.values state)))

                    (|))))))

;; location: the ast/Location for the state's file and line.
(def location
  (Parser (fn [state]
            (either (map (get (.values state) 'file)
                         (fn [f]
                           (ParserMatch (ast/Location f (state-line state))
                                        state)))
                    (abort "location: state has no file")))))

;; symbol: skip whitespace, then consume a run of symbol chars.
;; Value: the raw text. State: at the first non-symbol char.
(def symbol
  (Parser (fn [state]
            (let [input (.input state)]
              (cond (and (first input)
                         (symbol-start? input))
                    (let [len (run-length input symbol-continue?)]
                      (cond (< 0 len)
                            (ParserMatch (subs input 0 len)
                                         (ParserState (subs input len (count input))
                                                      (.values state)))
                            (|)))

                    (|))))))

;; full-symbol: a symbol run, then an optional "/name" side. Value:
;; the ast/Symbol node [ns name loc]. State: at the first char past
;; the name (or past the ns when there is no slash). A slash with no
;; name side fails (NUL). The ns/bare branch is a p-branch, not a
;; p-alt - the bare form is a prefix of the ns form, and the
;; match-truncating fold would let the shorter match win.
(def full-symbol
  (for [_ whitespace
        loc location
        fst symbol
        sym (| (for [_ (literal "/")
                     name (| symbol
                             (error (str "Invalid symbol: '" fst "/' at " loc)))]
                 (ast/Symbol fst name loc))
               (always (ast/Symbol ast/no-symbol fst loc)))]
    sym))

;; text-to-int: the integer value of a string of digits (no sign).
(defn text-to-int [s]
  (reduce (vec s) 0
          (fn [acc c]
            (+ (* 10 acc) (- (char-code c) 48)))))

;; digit-run: consume a run of digits. Value: the raw text.
;; State: at the first non-digit char. No leading digit -> (|).
(def digit-run
  (Parser (fn [state]
            (let [input (.input state)
                  len (run-length input is-digit)]
              (cond (= 0 len)
                    (|)
                    (ParserMatch (subs input 0 len)
                                 (ParserState (subs input len (count input))
                                              (.values state))))))))

;; int-lit: an optional "-", then a run of digits. Value: the
;; ast/IntegerLit node. State: at the first non-digit char. A "-"
;; with no digits is a NUL (falls through to the symbol parser -
;; "-foo" is a symbol, not a number).
(def int-lit
  (for [_ whitespace
        loc location
        sign (optional (literal "-"))
        text digit-run]
    (ast/IntegerLit (cond (str= sign "-")
                          (- 0 (text-to-int text))
                          (text-to-int text))
                    loc)))

;; string-end: state is just past the opening quote. Scan to the
;; closing quote and return Some of the state just past it. A
;; backslash escapes the following char (kept as-is; an escaped
;; quote does not close the string). A newline or end of input
;; before the closing quote -> None. Self-recursive scan of data,
;; not a parse, so no fix.
(defn string-end [state]
  (let [input (.input state)]
    (cond (str= input "")
          None

          (str-prefix? "\n" input)
          None

          (str-prefix? "\"" input)
          (Some (drop-char state))

          (str-prefix? "\\" input)
          (cond (str= "\n" (subs input 1 1))
                None

                (string-end (drop-char (drop-char state))))

          (string-end (drop-char state)))))

;; string-body: state is just past the opening quote. Value: the
;; raw text up to the closing quote (backslash escapes kept as-is).
;; State: just past the closing quote. A newline or end of input
;; before the closing quote is a ParserError.
(defn string-body [loc]
  (Parser (fn [state]
            (let [input (.input state)]
              (either (map (string-end state)
                           (fn [end-state]
                             (ParserMatch (subs input 0
                                                (- (- (count input)
                                                      (count (.input end-state)))
                                                   1))
                                          end-state)))
                      (ParserError (str "unterminated string at " loc)
                                   state))))))


;; string-lit: a double-quoted string literal. Value: the
;; ast/StringLit node; the text keeps backslash escapes as-is.
(def string-lit
  (for [_ whitespace
        loc location
        _ (literal "\"")
        text (string-body loc)]
    (ast/StringLit text loc)))


