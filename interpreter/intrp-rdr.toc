;; intrp-rdr.toc — phase-1 parser: single-pass recursive descent.
;;
;; parse-expr parses one expression and returns its desugared Expression
;; tree (intrp-ast.toc) together with the state after it. Every
;; sub-expression is parsed exactly once, in the same pass that builds
;; the tree — there is no skip pass, no child-state collection, and no
;; unfold.
;;
;; Desugarings happen at parse time (settled shapes, cf. the plan's
;; Parser-owned desugarings):
;;   [a b c]        -> left-fold vect-conj over empty-vector
;;   {k v ...}      -> left-fold assoc over emptyBMI
;;   (let ...)      -> nested immediate anonymous-fn applications
;;   (cond ...)     -> right-nested ternary core cond calls
;;   (and/or ...)   -> right-nested binary core calls
;;   (str/println)  -> str*/println* over a folded vector
;;   (-> ...)       -> nested calls
;;   'sym           -> StringLit
;;
;; This file is a LIBRARY (no main). The verification drivers are
;; interpreter/rdr-exprs.toc (expressions) and interpreter/rdr-top.toc
;; (top-level + program map).
;;
;; Model (settled):
;;   * ParserState [input values] — `input` is the unconsumed suffix of
;;     the source; `values` is a bookkeeping map {"file" String, "line"
;;     Integer}. `subs` returns O(1) SubString views.
;;   * Maximal-run reads scan for a length, then extract with ONE subs.
;;   * The line counter is bumped by take-char when it consumes "\n".
;;   * NO local symbol may shadow a symbol from the core namespace.
;;
;; Expression parsing is total: malformed input yields a placeholder
;; (Symbol "" "") rather than an error. Definitive errors (ParserError)
;; are produced by the top-level parsers only.

(add-ns ast (module "intrp-ast.toc"))

;; --- ParserState -----------------------------------------------------

(deftype ParserState [input values]
  ! input String
  (str-vect [v]
    (flat-map ["(ParserState " input " " values ")"]
              str-vect)))

;; --- ParserResults ---------------------------------------------------

(deftype ParserResults
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

;; --- Grouping types --------------------------------------------------
;;
;; Multi-value returns, each with named fields, accessed via getters.
;; Each implements map / flat-map per docs/toccata-style.md. No `!`
;; annotations (new-toc mis-applies them on multi-field ctors).

;; ParsedList: a vector of parsed expressions + the state after the
;; closing delimiter (or EOF).
(deftype ParsedList [exprs state]
  (map [v f]
    (ParsedList (map (.exprs v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.exprs v) f) (f (.state v)))))

(deftype Token [text state]
  (map [v f]
    (Token (f (.text v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (f (.text v)) (f (.state v)))))

(deftype FullSymbol [ns nom state]
  (str-vect [v]
    (flat-map ["(FullSymbol " ns "/" nom " " state ")"]
              str-vect))
  (map [v f]
    (FullSymbol (f (.ns v)) (f (.nom v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (ast/vect-concat (f (.ns v)) (f (.nom v)))
                     (f (.state v)))))

(deftype TypeExpr [text state]
  (map [v f]
    (TypeExpr (f (.text v)) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (f (.text v)) (f (.state v)))))

(deftype ParamList [params state]
  (map [v f]
    (ParamList (map (.params v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.params v) f) (f (.state v)))))

;; Parse-time desugaring groupings.

(deftype LetBinding [name expr]
  (str-vect [v]
            (flat-map ["(LetBinding " name " " expr ")"]
                      str-vect))
  (map [v f]
    (LetBinding (f (.name v)) (f (.expr v))))
  (flat-map [v f]
    (ast/vect-concat (f (.name v)) (f (.expr v)))))

(deftype LetBindings [bindings state]
  (map [v f]
    (LetBindings (map (.bindings v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.bindings v) f) (f (.state v)))))

(deftype HashPair [key value]
  (str-vect [v]
            (flat-map ["(HashPair " key " " value ")"]
                      str-vect))
  (map [v f]
    (HashPair (f (.key v)) (f (.value v))))
  (flat-map [v f]
    (ast/vect-concat (f (.key v)) (f (.value v)))))

(deftype HashPairs [pairs state]
  (map [v f]
    (HashPairs (map (.pairs v) f) (f (.state v))))
  (flat-map [v f]
    (ast/vect-concat (flat-map (.pairs v) f) (f (.state v)))))

(deftype Clause [test value]
  (str-vect [v]
            (flat-map ["(Clause " test " " value ")"]
                      str-vect))
  (map [v f]
    (Clause (f (.test v)) (f (.value v))))
  (flat-map [v f]
    (ast/vect-concat (f (.test v)) (f (.value v)))))

(deftype TopLevelEntry [name value]
  (map [v f]
    (TopLevelEntry (f (.name v)) (f (.value v))))
  (flat-map [v f]
    (ast/vect-concat (f (.name v)) (f (.value v)))))

;; --- State helpers ---------------------------------------------------

(defn make-state [input file line]
  (ParserState input {"file" file, "line" line}))

(defn state-line [state]
  (extract (get (.values state) "line")))

;; --- Character predicates --------------------------------------------

(defn is-digit [c]
  (let [n (char-code c)]
    (and (<= 48 n)
         (<= n 57))))

(defn is-alpha [c]
  (let [n (char-code c)]
    (or (and (<= 65 n)
             (<= n 90))
        (and (<= 97 n)
             (<= n 122)))))

;; symbol-start?: true iff the string STARTS with a symbol-start char.
;; Takes a full string (is-alpha/char-code read the first char; the
;; special chars are prefix-checked).
(defn symbol-start? [s]
  (or (is-alpha s)
      (str-prefix? "." s)
      (str-prefix? "_" s)
      (str-prefix? "<" s)
      (str-prefix? ">" s)
      (str-prefix? "=" s)
      (str-prefix? "+" s)
      (str-prefix? "-" s)
      (str-prefix? "/" s)))

(defn symbol-continue? [c]
  (or (is-alpha c)
      (is-digit c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "?")
      (str= c "!")))

(defn float-char? [c]
  (or (is-digit c)
      (str= c ".")))

;; --- Token helpers ---------------------------------------------------

(defn take-char [state]
  (let [input (.input state)
        c (subs input 0 1)
        rest-input (subs input 1 (count input))
        line (state-line state)
        new-line (cond (str= c "\n")
                       (+ line 1)
                       line)]
    (ParserState rest-input
                 (assoc (.values state) "line" new-line))))

(defn skip-comment [state]
  (let [input (.input state)]
    (cond (or (str= input "")
              (str-prefix? "\n" input))
          state

          (skip-comment (take-char state)))))

(defn skip-whitespace [state]
  (let [input (.input state)]
    (cond (str= input "")
          state

          (str-prefix? ";" input)
          (skip-whitespace (skip-comment (take-char state)))

          (or (str-prefix? " " input)
              (str-prefix? "\t" input)
              (str-prefix? "\n" input)
              (str-prefix? "\r" input))
          (skip-whitespace (take-char state))

          state)))

(defn run-length [s pred]
  (let [c (subs s 0 1)]
    (cond (str= c "")
          0
          (pred c)
          (+ 1 (run-length (subs s 1 (count s)) pred))
          0)))

(defn read-run [state pred]
  (let [input (.input state)
        len (run-length input pred)
        run (subs input 0 len)
        rest-input (subs input len (count input))]
    (Token run (ParserState rest-input (.values state)))))

;; --- Token readers ---------------------------------------------------

(defn read-string-content [state]
  (let [input (.input state)]
    (cond (str= input "")
          state

          (str-prefix? "\\" input)
          (read-string-content (take-char (take-char state)))

          (str-prefix? "\"" input)
          state

          (read-string-content (take-char state)))))

(defn read-string [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)

          (str-prefix? "\"" input)
          (let [after-open (take-char state)
                at-close (read-string-content after-open)
                content-len (- (count (.input after-open))
                               (count (.input at-close)))
                content (subs (.input after-open) 0 content-len)
                end-state (take-char at-close)]
            (Token content end-state))

          (Token "" state))))

(defn read-symbol [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)

          (symbol-start? input)
          (let [tok (read-run state symbol-continue?)]
            tok)

          (Token "" state))))

(defn read-int [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (is-digit input)
          (let [tok (read-run state is-digit)]
            tok)
          (Token "" state))))

(defn read-float [state]
  (let [input (.input state)]
    (cond (str= input "")
          (Token "" state)
          (is-digit input)
          (let [tok (read-run state float-char?)]
            tok)
          (Token "" state))))

;; --- Helpers ---------------------------------------------------------

(defp result-kind [r])
(extend-type ParserMatch (result-kind [_] 0))
(extend-type ParserIgnore (result-kind [_] 1))
(extend-type ParserError (result-kind [_] 2))

(defn make-loc [state]
  (let [file (extract (get (.values state) "file"))]
    (ast/Location file (state-line state))))

;; sub-to-str: copy a SubString (or String) to a fresh full String.
;; CONSUMING: it frees its input; the caller must hold a separate
;; reference (elt0/first create one).
(defn sub-to-str [s]
  (inline String "
    char *buf;
    int64_t len;
    if (((Value *)s_1)->type == SubStringType) {
      ReifiedVal *ss = (ReifiedVal *)s_1;
      String *parent = (String *)ss->impls[0];
      long start = getI60(ss->impls[1]);
      buf = &parent->buffer[start];
      len = getI60(ss->impls[2]);
    } else {
      String *strVal = (String *)s_1;
      buf = strVal->buffer;
      len = strVal->len;
    }
    String *out = malloc_string(len + 1);
    memcpy(out->buffer, buf, len);
    out->len = len;
    out->buffer[len] = 0;
    dec_and_free((Term)s_1, 1);
    result = termVal((Term)out);
  "))

(defn read-full-symbol [state]
  (let [tok (read-symbol state)
        fst (.text tok)
        s2 (.state tok)
        input (.input s2)]
    (cond (str= input "")
          (FullSymbol "" fst s2)

          (str-prefix? "/" input)
          (let [after-slash (take-char s2)
                name-tok (read-symbol after-slash)]
            (FullSymbol fst (.text name-tok) (.state name-tok)))

          (FullSymbol "" fst s2))))

(defn read-type-expr [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [s2 (skip-whitespace (take-char s))
                inner (read-symbol s2)
                s3 (skip-whitespace (.state inner))
                s4 (take-char s3)]
            (TypeExpr (.text inner) s4))
          (let [nm (read-symbol s)]
            (TypeExpr (.text nm) (.state nm))))))

(defn contains-dot [s]
  (cond
    (str= s "")
    None
    (str= (subs s 0 1) ".")
    (Some 1)
    (contains-dot (subs s 1 (count s)))))

(defn text-to-int-acc [s acc]
  (cond
    (str= s "")
    acc
    (let [d (- (char-code (subs s 0 1)) 48)]
      (text-to-int-acc (subs s 1 (count s))
                       (+ (* 10 acc) d)))))

(defn text-to-int [s]
  (text-to-int-acc s 0))

;; --- Parse-time desugar helpers --------------------------------------
;;
;; Build the settled desugared Expression shapes from parsed parts.

;; fold-vec: [e1 e2 ...] ->
;;   (vect-conj (vect-conj (vect-conj empty-vector e1) e2) ...)
(defn fold-vec [exprs loc]
  (reduce exprs (ast/Symbol "" "empty-vector" loc)
          (fn [acc e]
            (ast/Call (ast/Symbol "" "vect-conj" loc) [acc e]))))

;; hash-fold: [HashPair ...] -> (assoc (assoc emptyBMI k1 v1) ...)
(defn hash-fold [pairs loc]
  (reduce pairs (ast/Symbol "" "emptyBMI" loc)
          (fn [acc kv]
            (ast/Call (ast/Symbol "" "assoc" loc)
                      [acc (.key kv) (.value kv)]))))

;; cond-desugar: [Clause t1 v1 ... Clause tN vN] + e ->
;;   (cond t1 v1 (cond t2 v2 (... (cond tN vN e))))
(defn cond-desugar [clauses else loc]
  (reduce (reverse clauses) else
          (fn [acc c]
            (ast/Call (ast/Symbol "" "cond" loc)
                      [(.test c) (.value c) acc]))))

;; and-or-desugar: [a1 ... aN] -> (and a1 (and a2 ... aN)); single -> the
;; arg.
(defn and-or-desugar [exprs loc op-name]
  (reduce (reverse (butlast exprs)) (extract (last exprs))
          (fn [acc x]
            (ast/Call (ast/Symbol "" op-name loc) [x acc]))))

;; str-println-desugar: [e1 ...] -> (str* (vect-conj ... e1 ...))
(defn str-println-desugar [exprs loc fn-name]
  (ast/Call (ast/Symbol "" fn-name loc) [(fold-vec exprs loc)]))

;; expr-kind: tag a parsed expression for threading-step dispatch.
(defp expr-kind [e])
(extend-type ast/Call (expr-kind [_] 0))
(extend-type ast/Symbol (expr-kind [_] 1))
(extend-type ast/FieldGetter (expr-kind [_] 2))

;; thread-step: apply one threading step to the threaded value.
;;   Call (f a b)  -> (f <threaded> a b)
;;   Symbol g      -> (g <threaded>)
;;   Symbol .f     -> (.f <threaded>)  (FieldGetter operator)
;;   other         -> (<step> <threaded>)
(defn thread-step [step threaded loc]
  (let [k (expr-kind step)]
    (cond
      (= k 0)
      (ast/Call (.operator step)
                (ast/vect-concat [threaded] (.operands step)))

      (= k 1)
      (let [nm (.sym-name step)]
        (ast/Call (cond (str= (subs nm 0 1) ".")
                        (ast/FieldGetter (subs nm 1 (count nm)) loc)
                        step)
                  [threaded]))
      (ast/Call step [threaded]))))

;; threading-acc: fold the steps left-to-right, threading `loc` as a
;; plain parameter (not a closure capture).
(defn threading-acc [steps loc acc]
  (cond (= (count steps) 0)
        acc
        (let [stp (extract (first steps))]
          (threading-acc (rest steps) loc
                         (thread-step stp acc loc)))))

;; threading: (-> x s1 ... sN) -> (sN (... (s1 x)))
;;
;; Explicit recursion, NOT reduce: thread-step resolves `loc` only in its
;; dot-branch and erases it in the others, so a reduce closure capturing
;; `loc` would resolve it on some iterations and erase it on others — a
;; pattern the lazy machine mishandles, leaving a SUP in the result (see
;; regression-tests/closure-capture-sup.toc). Passing `loc` as a plain
;; parameter through the recursion avoids the closure capture entirely.
(defn threading [initial steps loc]
  (threading-acc steps loc initial))

;; let-desugar: [LetBinding ...] + body-vec ->
;;   (Call (Fn "" [b1] [rest1]) e1) where the innermost Fn body is
;;   body-vec.
(defn let-desugar [pairs body-vec loc]
  (let [ln (extract (last pairs))
        innermost (ast/Call (ast/Fn "" [(.name ln)] body-vec loc)
                            [(.expr ln)])]
    (reduce (reverse (butlast pairs)) innermost
            (fn [acc pair]
              (ast/Call (ast/Fn "" [(.name pair)] [acc] loc)
                        [(.expr pair)])))))

;; --- Leaf expression parsers -----------------------------------------
;;
;; Each returns ParserMatch [Expression state-after].

(defn parse-string-lit [state]
  (let [r (read-string state)
        content (.text r)
        s2 (.state r)]
    (ParserMatch (ast/StringLit content (make-loc s2)) s2)))

(defn parse-quoted-sym [state]
  (let [r (read-symbol (take-char state))
        text (.text r)
        s2 (.state r)]
    (ParserMatch (ast/StringLit text (make-loc s2)) s2)))

(defn parse-number [state]
  (let [r (read-float state)
        text (.text r)
        s2 (.state r)
        loc (make-loc s2)]
    (cond (contains-dot text)
          (ParserMatch (ast/FloatLit text loc) s2)
          (let [n (text-to-int text)]
            (ParserMatch (ast/IntegerLit n loc) s2)))))

(defn parse-symbol [state]
  (let [r (read-full-symbol state)]
    (ParserMatch (ast/Symbol (.ns r) (.nom r) (make-loc (.state r)))
            (.state r))))

;; read-param-list: a `[ p1 p2 ... ]` parameter list. state is just
;; after the `[`. Returns a ParamList [params new-state].
(defn read-param-list-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "]" input)
          (ParamList acc (take-char s))
          (let [nm (read-symbol s)]
            (read-param-list-acc (.state nm)
                                 (vect-conj acc (.text nm)))))))

(defn read-param-list [state]
  (read-param-list-acc state empty-vector))

;; parse-type-constraint: state at `!`. Returns ParserMatch [TypeConstraint
;; state-after].
(defn parse-type-constraint [state]
  (let [s (skip-whitespace (take-char state))
        nm (read-symbol s)
        sym (.text nm)
        te (read-type-expr (skip-whitespace (.state nm)))]
    (ParserMatch (ast/TypeConstraint sym (.text te)) (.state te))))

;; --- Collection helpers ----------------------------------------------
;;
;; Collect parsed expressions (and binding/pair groupings) until a
;; delimiter. Each child is parsed exactly once, here.
;;
;; parse-expr is forward-declared: it is mutually recursive with the
;; collection helpers and the form parsers (build crutch — the new
;; compiler will resolve mutual recursion itself).

(def parse-expr)

;; collect-until: parse expressions until `delim` (consumed). Returns
;; ParsedList [exprs state-after-delimiter].
(defn collect-until-acc [state delim acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (ParsedList acc s)

          (str-prefix? delim input)
          (ParsedList acc (take-char s))

          (let [p (parse-expr s)]
            (collect-until-acc (.state p) delim
                               (vect-conj acc (.value p)))))))

(defn collect-until [state delim]
  (collect-until-acc state delim empty-vector))

;; parse-body: parse body elements (leading `!` type constraints +
;; expressions) until `)` (consumed). Returns ParsedList [exprs
;; state-after-`)`].
(defn parse-body-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? ")" input)
          (ParsedList acc (take-char s))

          (str-prefix? "!" input)
          (let [tc (parse-type-constraint s)]
            (parse-body-acc (.state tc)
                            (vect-conj acc (.value tc))))

          (str= input "")
          (ParsedList acc s)

          (let [p (parse-expr s)]
            (parse-body-acc (.state p)
                            (vect-conj acc (.value p)))))))

(defn parse-body [state]
  (parse-body-acc state empty-vector))

;; collect-let-bindings: parse let bindings until `]` (consumed).
;; state is just after the `[`. Returns LetBindings [bindings
;; state-after-`]`].
(defn collect-let-bindings-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "]" input)
          (LetBindings acc (take-char s))

          (str= input "")
          (LetBindings acc s)

          (let [nm (read-symbol s)
                name (.text nm)
                s2 (skip-whitespace (.state nm))
                p (parse-expr s2)]
            (collect-let-bindings-acc (.state p)
                                      (vect-conj acc
                                                 (LetBinding name
                                                             (.value p))))))))

(defn collect-let-bindings [state]
  (collect-let-bindings-acc state empty-vector))

;; collect-hash-pairs: parse hash pairs until `}` (consumed). state is
;; just after the `{`. Returns HashPairs [pairs state-after-`}`].
(defn collect-hash-pairs-acc [state acc]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "}" input)
          (HashPairs acc (take-char s))

          (str= input "")
          (HashPairs acc s)

          (let [pk (parse-expr s)
                pv (parse-expr (.state pk))]
            (collect-hash-pairs-acc (.state pv)
                                    (vect-conj acc
                                               (HashPair (.value pk)
                                                         (.value pv))))))))

(defn collect-hash-pairs [state]
  (collect-hash-pairs-acc state empty-vector))

;; --- Special form parsers --------------------------------------------
;;
;; Each takes the state just after the form keyword and returns ParserMatch
;; [desugared-Expression state-after].

;; parse-fn-params: state at the `[` of a fn parameter list.
(defn parse-fn-params [name state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [s2 (skip-whitespace (take-char s))
                params (read-param-list s2)
                s3 (.state params)
                body (parse-body s3)
                s4 (.state body)]
            (ParserMatch (ast/Fn name (.params params) (.exprs body)
                            (make-loc s4))
                    s4))
          (ParserMatch (ast/Symbol "" "" (make-loc s)) s))))

;; parse-fn: state just after `fn`. Named or anonymous.
(defn parse-fn [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (parse-fn-params "" s)

          (symbol-start? input)
          (let [nm (read-symbol s)
                fn-name (.text nm)]
            (parse-fn-params fn-name (skip-whitespace (.state nm))))

          (ParserMatch (ast/Symbol "" "" (make-loc s)) s))))

;; parse-let: state just after `let`.
(defn parse-let [state]
  (let [s (skip-whitespace state)
        s2 (skip-whitespace (take-char s))
        bindings (collect-let-bindings s2)
        body (parse-body (.state bindings))
        s4 (.state body)]
    (ParserMatch (let-desugar (.bindings bindings) (.exprs body)
                        (make-loc s4))
            s4)))

;; cond-pair-acc: pair a flat [t1 v1 ... tN vN e] expression vector
;; into [Clause t1 v1 ... Clause tN vN], stopping when the trailing
;; else is the only element left.
(defn cond-pair-acc [exprs acc]
  (cond (= (count exprs) 1)
        acc
        (let [t (extract (first exprs))
              r1 (rest exprs)
              v (extract (first r1))]
          (cond-pair-acc (rest r1)
                         (vect-conj acc (Clause t v))))))

;; parse-cond: state just after `cond`.
(defn parse-cond [state]
  (let [res (collect-until state ")")
        exprs (.exprs res)
        loc (make-loc (.state res))
        clauses (cond-pair-acc exprs empty-vector)
        else (extract (last exprs))]
    (ParserMatch (cond-desugar clauses else loc) (.state res))))

;; parse-and / parse-or: state just after `and`/`or`.
(defn parse-and [state]
  (let [res (collect-until state ")")]
    (ParserMatch (and-or-desugar (.exprs res) (make-loc (.state res)) "and")
            (.state res))))

(defn parse-or [state]
  (let [res (collect-until state ")")]
    (ParserMatch (and-or-desugar (.exprs res) (make-loc (.state res)) "or")
            (.state res))))

;; parse-str / parse-println: state just after `str`/`println`.
(defn parse-str [state]
  (let [res (collect-until state ")")]
    (ParserMatch (str-println-desugar (.exprs res) (make-loc (.state res))
                                 "str*")
            (.state res))))

(defn parse-println [state]
  (let [res (collect-until state ")")]
    (ParserMatch (str-println-desugar (.exprs res) (make-loc (.state res))
                                    "println*")
            (.state res))))

;; parse-threading: state just after `->`.
(defn parse-threading [state]
  (let [s (skip-whitespace state)
        p (parse-expr s)
        steps (collect-until (.state p) ")")]
    (ParserMatch (threading (.value p) (.exprs steps)
                       (make-loc (.state steps)))
            (.state steps))))

;; parse-vector: state at the `[`.
(defn parse-vector [state]
  (let [s (skip-whitespace (take-char state))
        res (collect-until s "]")]
    (ParserMatch (fold-vec (.exprs res) (make-loc (.state res)))
            (.state res))))

;; parse-hash: state at the `{`.
(defn parse-hash [state]
  (let [s (skip-whitespace (take-char state))
        res (collect-hash-pairs s)]
    (ParserMatch (hash-fold (.pairs res) (make-loc (.state res)))
            (.state res))))

;; dispatch-special: state just after a special-form keyword.
(defn dispatch-special [ns name state]
  (cond (str= name "fn") (parse-fn state)
        (str= name "let") (parse-let state)
        (str= name "cond") (parse-cond state)
        (str= name "and") (parse-and state)
        (str= name "or") (parse-or state)
        (str= name "str") (parse-str state)
        (str= name "println") (parse-println state)
        (str= name "->") (parse-threading state)
        (let [res (collect-until state ")")]
          (ParserMatch (ast/Call (ast/Symbol ns name (make-loc state))
                            (.exprs res))
                  (.state res)))))

;; parse-call: state at the `(`.
(defn parse-call [state]
  (let [s (skip-whitespace (take-char state))
        input (.input s)]
    (cond (str= input "")
          (ParserMatch (ast/Symbol "" "" (make-loc s)) s)

          (str-prefix? ")" input)
          (ParserMatch (ast/Symbol "" "" (make-loc s)) (take-char s))

          (symbol-start? input)
          (let [sym (read-full-symbol s)
                ns (.ns sym)
                name (.nom sym)
                s2 (.state sym)]
            (dispatch-special ns name s2))

          (let [op (parse-expr s)
                res (collect-until (.state op) ")")]
            (ParserMatch (ast/Call (.value op) (.exprs res))
                    (.state res))))))

;; parse-expr: parse one expression. Returns ParserMatch [Expression
;; state-after]. Total: malformed input yields a placeholder Symbol.
(defn parse-expr [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (ParserMatch (ast/Symbol "" "" (make-loc s)) s)

          (str-prefix? "(" input)
          (parse-call s)

          (str-prefix? "[" input)
          (parse-vector s)

          (str-prefix? "{" input)
          (parse-hash s)

          (str-prefix? "\"" input)
          (parse-string-lit s)

          (str-prefix? "'" input)
          (parse-quoted-sym s)

          (is-digit input)
          (parse-number s)

          (symbol-start? input)
          (parse-symbol s)

          (parse-expr (take-char s)))))

;; --- Top-level forms + program map -----------------------------------
;;
;; parse-top-level dispatches on the first token of a top-level form
;; and builds the settled TopLevel node. parse-program loops until EOF,
;; accumulating the name -> TopLevel map.

;; parse-top-def-value-expr: state at the value (a non-`)` position).
;; Returns ParserMatch [TopLevelEntry state-after-`)`] or ParserError.
(defn parse-top-def-value-expr [name name-loc state]
  (let [p (parse-expr state)
        s3 (skip-whitespace (.state p))
        in3 (.input s3)]
    (cond (str-prefix? ")" in3)
          (let [val (.value p)]
            (ParserMatch (TopLevelEntry name
                                        (ast/Definition name val name-loc))
                         (take-char s3)))
          (ParserError "expected ) after def value" s3))))

;; parse-top-def-value: state at the value position (or at `)` for a
;; bare def). Builds the Definition, or ignores a bare `(def name)`.
(defn parse-top-def-value [name name-loc state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? ")" input)
          (ParserIgnore (take-char s))
          (parse-top-def-value-expr name name-loc s))))

;; parse-top-def: state just after `def`.
(defn parse-top-def [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (sub-to-str (.text nm))]
            (parse-top-def-value name (make-loc (.state nm))
                                 (.state nm)))
          (ParserError "expected a name after def" s))))

;; parse-top-defn: state just after `defn`.
(defn parse-top-defn [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (sub-to-str (.text nm))
                s2 (skip-whitespace (.state nm))]
            (cond (str-prefix? "[" (.input s2))
                  (let [s3 (skip-whitespace (take-char s2))
                        params (read-param-list s3)
                        s4 (.state params)
                        body (parse-body s4)
                        s5 (.state body)
                        fn-val (ast/Fn name (.params params)
                                       (.exprs body) (make-loc s5))]
                    (ParserMatch
                     (TopLevelEntry name
                                    (ast/Definition name fn-val
                                                    (make-loc (.state nm))))
                     s5))
                  (ParserError "expected a parameter list after defn name"
                               s2)))
          (ParserError "expected a name after defn" s))))

;; parse-top-main: state just after `main`.
(defn parse-top-main [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "[" input)
          (let [params (read-param-list (take-char s))
                p-vec (.params params)
                s2 (.state params)
                body (parse-body s2)
                s3 (.state body)]
            (ParserMatch (TopLevelEntry "main"
                                        (ast/Main p-vec (.exprs body)
                                                  (make-loc s3)))
                         s3))
          (ParserError "expected a parameter list after main" s))))

;; parse-top-level-args: dispatch on the keyword.
(defn parse-top-level-args [name s2]
  (cond (str= name "def") (parse-top-def s2)
        (str= name "defn") (parse-top-defn s2)
        (str= name "main") (parse-top-main s2)
        (str= name "inline")
        (ParserError "top-level inline is not supported in phase 1" s2)
        (str= name "deftype")
        (ParserError "deftype is not supported in phase 1" s2)
        (str= name "defp")
        (ParserError "defp is not supported in phase 1" s2)
        (str= name "extend-type")
        (ParserError "extend-type is not supported in phase 1" s2)
        (str= name "add-ns")
        (ParserError "add-ns is not supported in phase 1" s2)
        (str= name "match")
        (ParserError "match is not supported in phase 1" s2)
        (str= name "defmacro")
        (ParserError "defmacro is not supported in phase 1" s2)
        (ParserError "unexpected top-level form" s2)))

;; parse-top-level-form: state just after the `(` of a top-level form.
(defn parse-top-level-form [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (symbol-start? input)
          (let [nm (read-symbol s)
                name (.text nm)
                s2 (skip-whitespace (.state nm))]
            (parse-top-level-args name s2))
          (ParserError "unexpected top-level form" s))))

;; parse-top-level: parse one top-level form.
(defn parse-top-level [state]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str-prefix? "(" input)
          (parse-top-level-form (take-char s))
          (str-prefix? "|" input)
          (ParserError "superposition (|) is not supported in phase 1" s)
          (ParserError "unexpected character at top level" s))))

;; parse-program-acc: parse top-level forms until EOF.
(defn parse-program-acc [state m]
  (let [s (skip-whitespace state)
        input (.input s)]
    (cond (str= input "")
          (ParserMatch m s)
          (let [r (parse-top-level s)
                k (result-kind r)]
            (cond (= k 2)
                  r
                  (= k 1)
                  (parse-program-acc (.state r) m)
                  (let [entry (.value r)]
                    (parse-program-acc (.state r)
                                       (assoc m (.name entry)
                                              (.value entry)))))))))

;; parse-program: parse a whole file into the name -> TopLevel map.
(defn parse-program [state]
  (parse-program-acc state emptyBMI))
