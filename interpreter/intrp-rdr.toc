;; intrp-rdr.toc - superposition-based reader.
;;
;; Parse alternatives are superpositions. A parser is
;; fn [state] -> sup of ParserResults. The monad is the machine:
;;   unit = a bare (ParserMatch v s)
;;   bind = the flat-map protocol (the machine duplicates the call
;;          per sup leaf)
;;   alt  = the | literal
;;   fail = (|) - bare NUL; propagates through flat-map and | to the
;;          top-level collapse, which returns the seed
;;
;; A single collapse at the top of the parser folds the sup with the
;; pick-result protocol: a ParserMatch truncates the fold; ParserError
;; leaves merge, keeping the larger line (a tie keeps the left leaf -
;; see the pick-result note below). ParserError is produced
;; only when there is a real error to report.
;;
;; This file is a LIBRARY (no main). The verification driver is
;; interpreter/rdr-sup.toc.

(add-ns ast (module "intrp-ast.toc"))

;; --- ParserState -----------------------------------------------------

(deftype ParserState [input values]
  ! input String
  (str-vect [v]
    (flat-map ["(ParserState " input " " values ")"]
              str-vect)))

(defn make-state [input file line]
  (ParserState input {'file file, 'line line}))

(defn state-line [state]
  (either (get (.values state) 'line)
          0))

;; take-char: consume one character; bump the line counter on "\n".
(defn take-char [state]
  (let [input (.input state)
        line (state-line state)
        new-line (cond (flat-map (first input)
                                 (fn [c]
                                   (str= "\n" c)))
                       (+ line 1)

                       line)]
    (ParserState (rest input)
                 (assoc (.values state)  'line new-line))))

(defn drop-char [state]
  (let [input (.input state)]
    (ParserState (rest input)
                 (.values state))))

;; skip-comment: state is just after the ";" - skip to end of line
;; (the newline itself is not consumed).
(defn skip-comment [state]
  (let [input (.input state)]
    (cond (or (str= input "")
              (str-prefix? "\n" input))
          state

          (skip-comment (drop-char state)))))

;; kip-whitespace: spaces, tabs, newlines, carriage returns, and
;; comments.
(defn skip-whitespace [state]
  (let [input (.input state)]
    (cond (str= input "")
          state

          (str-prefix? ";" input)
          (skip-whitespace (skip-comment (drop-char state)))

          (or (str-prefix? " " input)
              (str-prefix? "\t" input)
              (str-prefix? "\r" input))
          (skip-whitespace (drop-char state))

          (str-prefix? "\n" input)
          (let [line (state-line state)
                new-state (ParserState (rest input)
                                       (assoc (.values state) 'line (+ line 1)))]
            (skip-whitespace new-state))

          state)))

;; pick-result: the fold of the single top-level collapse. A match
;; truncates the fold; errors merge, keeping the error with the
;; larger line. The
;; collapse fold runs the right leaf first and then the left leaf
;; against the accumulator, so a line tie keeps the left leaf.
(defp pick-result [r acc])

;; --- ParserResults ---------------------------------------------------
;;
;; Leaves of a parse superposition. The flat-map impls ARE the monad:
;; ParserMatch threads the continuation (a value -> parser function)
;; over the value and the state; ParserError short-circuits (the
;; continuation never runs on it). No `!` annotations (new-toc
;; mis-applies them on multi-field ctors).

(deftype ParserResults
  (ParserMatch [value state]
    (flat-map [v f]
              ((f (.value v)) (.state v)))

    (map [v f]
         (ParserMatch (f (.value v))
                      (.state v)))

    (pick-result [m acc]
                 m))

  (ParserError [msg state]
    (flat-map [r f]
              r)

    (map [e f]
         e)

    (pick-result [err1 err2]
                 (let [l1 (state-line (.state err1))
                       l2 (state-line (.state err2))]
                   (cond (<= l2 l1)
                         err1

                         err2)))))

;; --- Character predicates ---------------------------------------------

(defn is-alpha [c]
  (let [n (char-code c)]
    (or (and (<= 65 n)
             (<= n 90))
        (and (<= 97 n)
             (<= n 122)))))

(defn is-digit [c]
  (let [n (char-code c)]
    (and (<= 48 n)
         (<= n 57))))

;; symbol-start?: true iff the string STARTS with a symbol-start char
;; (is-alpha/char-code read the first char; the specials are
;; prefix-checked).
(defn symbol-start? [s]
  (or (is-alpha s)
      (str-prefix? "." s)
      (str-prefix? "_" s)
      (str-prefix? "<" s)
      (str-prefix? ">" s)
      (str-prefix? "=" s)
      (str-prefix? "+" s)
      (str-prefix? "-" s)
      (str-prefix? "*" s)
      (str-prefix? "/" s)))

(defn symbol-continue? [c]
  (or (is-alpha c)
      (is-digit c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "?")
      (str= c "!")))

;; run-length: how many chars from the front satisfy pred. Self-
;; recursive over a strictly shorter string each step - a scan of
;; data, not a parse, so no fix.
(defn run-length [s pred]
  (cond (flat-map (first s) pred)
        (+ 1 (run-length (rest s) pred))

        0))

;; --- Parsers -----------------------------------------------------------

(deftype Parser [f]
  ;; 'f' is a function that takes a state value and returns a ParserMatch value
  (map [p m-f]
    (Parser (fn [s]
              (map (f s) m-f))))
  (flat-map [p m-f]
    (Parser (fn [s0]
              (flat-map (f s0)
                        (fn [v]
                          (fn [s1]
                            ((.f (m-f v)) s1))))))))

(def comment
  (Parser (fn [state]
            (let [old-input (.input state)
                  new-state (skip-comment state)]
              (ParserMatch (subs old-input 0 (- (count old-input)
                                                (count (.input new-state))))
                           new-state)))))

(def whitespace
  (Parser (fn [state]
            (ParserMatch "" (skip-whitespace state)))))

;; literal: match the input against an exact string prefix. Value:
;; the literal. State: just past it. No match -> (|).
(defn literal [text]
  (Parser (fn [state]
            (let [input (.input state)]
              (cond (str-prefix? text input)
                    (ParserMatch text
                                 (ParserState (subs input (count text) (count input))
                                              (.values state)))

                    (|))))))

;; location: the ast/Location for the state's file and line.
(def location
  (Parser (fn [state]
            (either (map (get (.values state) 'file)
                         (fn [f]
                           (ParserMatch (ast/Location f (state-line state))
                                        state)))
                    (abort "make-loc: state has no file")))))

;; symbol: skip whitespace, then consume a run of symbol chars.
;; Value: the raw text. State: at the first non-symbol char.
(def symbol
  (Parser (fn [state]
            (let [input (.input state)]
              (cond (and (first input)
                         (symbol-start? input))
                    (let [len (run-length input symbol-continue?)]
                      (cond (< 0 len)
                            (ParserMatch (subs input 0 len)
                                         (ParserState (subs input len (count input))
                                                      (.values state)))
                            (|)))

                    (|))))))

;; full-symbol: a symbol run, then an optional "/name" side. Value:
;; the ast/Symbol node [ns name loc]. State: at the first char past
;; the name (or past the ns when there is no slash). A slash with no
;; name side fails (NUL). The ns/bare branch is a p-branch, not a
;; p-alt - the bare form is a prefix of the ns form, and the
;; match-truncating fold would let the shorter match win.
(def full-symbol
  (flat-map whitespace
            (fn [_]
              (flat-map location
                        (fn [loc]
                          (flat-map symbol
                                    (fn [fst]
                                      (| (flat-map (literal "/")
                                                   (fn [_]
                                                     (map symbol
                                                          (fn [name]
                                                            (ast/Symbol fst name loc)))))
                                         (ParserMatch (ast/Symbol ast/no-symbol name loc))))))))))

