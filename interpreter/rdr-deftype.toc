;; interpreter/rdr-deftype.toc — item-6d verification driver.
;;
;; Parses the 5 hvm-core.toc deftypes (Maybe, Leaf, GetSentinelVal,
;; String, List — verbatim source) through intrp-rdr.toc's
;; parse-program and checks each yields a [TopLevel] vector with
;; exactly one entry — a TopLevel.DefType whose Constructor list
;; matches the expected fingerprint (ctor names, field lists, impl
;; names/params, body shapes).
;;
;; Expected output: 5 "OK" lines (one per deftype). Any "FAIL" line
;; indicates a problem. Run from the repo root: ./rdr-deftype
;;
;; The driver is interpreter-side tooling; interpreted programs may not
;; use these constructs.

(add-ns ast (module "intrp-ast.toc"))
(add-ns rdr (module "intrp-rdr.toc"))

;; top-name: the name of a TopLevel node (Main is nameless — its name is
;; the implicit "main"; AddNs uses its namespace; Inline is nameless).
;; Used by find-by-name.
(defp top-name [v])
(extend-type ast/Definition (top-name [v] (.name v)))
(extend-type ast/Defp (top-name [v] (.name v)))
(extend-type ast/Main (top-name [_] "main"))
(extend-type ast/DefType (top-name [v] (.type-name v)))
(extend-type ast/ExtendType (top-name [v] (.type-name v)))
(extend-type ast/AddNs (top-name [v] (.namespace v)))
(extend-type ast/Inline (top-name [_] ""))

;; find-by-name: the first node in the [TopLevel] vector whose name
;; matches, or None. Self-recursive.
(defn find-by-name-acc [v name]
  (cond (= (count v) 0)
    None
    (let [e (extract (first v))]
      (cond (str= (top-name e) name)
        (Some e)
        (find-by-name-acc (rest v) name)))))

(defn find-by-name [v name]
  (find-by-name-acc v name))

;; deftype-*: extract a DefType's fields (receiver statically DefType).
(defp deftype-name [v])
(extend-type ast/DefType (deftype-name [v] (.type-name v)))

(defp deftype-ctors [v])
(extend-type ast/DefType (deftype-ctors [v] (.constructors v)))

;; ctor-*: extract a Constructor's fields.
(defp ctor-name [v])
(extend-type ast/Constructor (ctor-name [v] (.name v)))

(defp ctor-fields [v])
(extend-type ast/Constructor (ctor-fields [v] (.field-list v)))

(defp ctor-impls [v])
(extend-type ast/Constructor (ctor-impls [v] (.implementations v)))

;; tc-*: extract a TypeConstraint's fields.
(defp tc-symbol [e])
(extend-type ast/TypeConstraint (tc-symbol [e] (.symbol e)))

(defp tc-type [e])
(extend-type ast/TypeConstraint (tc-type [e] (.type-expr e)))

;; sym-nom / get-name: a Symbol's name / a FieldGetter's field name.
(defp sym-nom [e])
(extend-type ast/Symbol (sym-nom [e] (.sym-name e)))

(defp get-name [e])
(extend-type ast/FieldGetter (get-name [e] (.field-name e)))

;; op-name: a Call operator's printable name.
;;   Symbol      -> its name
;;   FieldGetter -> "." + field name
;;   Fn          -> "fn"
(defp op-name [op] "fn")
(extend-type ast/Symbol (op-name [op] (sym-nom op)))
(extend-type ast/FieldGetter (op-name [op] (str* ["." (get-name op)])))

;; elem-fingerprint: one body element -> a fingerprint string.
;;   TypeConstraint -> "tc <symbol> <type-expr>"
;;   Call           -> "call <op> (<operand-count>)"
;;   Symbol         -> "sym <name>"
;;   IntegerLit     -> "int <value>"
;;   FloatLit       -> "flt <text>"
;;   StringLit      -> "str <value>"
;;   FieldGetter    -> "get .<name>"
;;   Fn             -> "fn"
(defp elem-fp [e] "fn")
(extend-type ast/TypeConstraint
  (elem-fp [e]
    (str* ["tc " (tc-symbol e) " " (tc-type e)])))
(extend-type ast/Call
  (elem-fp [e]
    (str* ["call " (op-name (.operator e)) " ("
           (number-str (count (.operands e))) ")"])))
(extend-type ast/Symbol (elem-fp [e] (str* ["sym " (sym-nom e)])))
(extend-type ast/IntegerLit (elem-fp [e] (str* ["int " (number-str (.value e))])))
(extend-type ast/FloatLit (elem-fp [e] (str* ["flt " (.value e)])))
(extend-type ast/StringLit (elem-fp [e] (str* ["str " (.value e)])))
(extend-type ast/FieldGetter (elem-fp [e] (str* ["get ." (get-name e)])))

;; elem-fingerprint: plain-function wrapper around elem-fp so map can
;; take it as its function value.
(defn elem-fingerprint [e]
  (elem-fp e))

;; body-fingerprint: a body vector -> one fingerprint string (elements
;; in order, no separators).
(defn body-fingerprint [body]
  (str* (map body elem-fingerprint)))

;; impl-fingerprint: one impl Fn -> "<name> [<params>] <body-fp>".
;; (str* (str-vect v)) prints the vector with its own brackets.
(defn impl-fingerprint [f]
  (str* [(.name f) " " (str* (str-vect (.parameter-list f))) " "
         (body-fingerprint (.body f))]))

;; ctor-fingerprint: one Constructor ->
;; "ctor <name> [<fields>] (<impl-fp> ...)".
(defn ctor-fingerprint [c]
  (str* ["ctor " (ctor-name c) " "
         (str* (str-vect (ctor-fields c)))
         " (" (str* (map (ctor-impls c) impl-fingerprint)) ")"]))

;; deftype-fingerprint: a DefType -> its ctors' fingerprints.
(defn deftype-fingerprint [v]
  (str* (map (deftype-ctors v) ctor-fingerprint)))

;; print-all-acc: print every string in the vector, threading the pr*
;; counts into the accumulator so the lazy machine keeps every side
;; effect (a dropped count would skip earlier prints). Self-recursive.
(defn print-all-acc [acc strs]
  (cond (= (count strs) 0)
    acc
    (let [s (extract (first strs))]
      (print-all-acc (+ acc (pr* s)) (rest strs)))))

;; check-deftype-entry: entry is a TopLevel found by name; the DefType
;; impl verifies the fingerprint, the default impl prints FAIL.
;; Threaded acc.
(defp check-deftype-entry [entry v name expected acc]
  (print-all-acc acc ["FAIL " name ": entry is not a DefType\n"]))
(extend-type ast/DefType
  (check-deftype-entry [entry v name expected acc]
    (let [nm (deftype-name entry)
          fp (deftype-fingerprint entry)]
      (cond (and (= (count v) 1)
                 (str= nm name)
                 (str= fp expected))
        (print-all-acc acc ["OK " name " " fp "\n"])
        (print-all-acc acc
                       ["FAIL " name " entries=" (number-str (count v))
                        " got: " fp " want: " expected "\n"])))))

;; check-deftype: parse one deftype source; verify the vector has
;; exactly one entry — a DefType with the expected name and ctor
;; fingerprint. Prints one status line. Returns the threaded acc.
(defn check-deftype [acc src name expected]
  (let [r (rdr/parse-program (rdr/make-state src "deftype-test.toc" 1))]
    (rdr/check-error r
                     (let [st (.state r)
                           line (rdr/state-line st)
                           msg (.msg r)]
                       (print-all-acc acc
                                      ["FAIL(parse) " name ":" (number-str line) ": " msg "\n"]))

                     (let [v (.value r)
                           e (find-by-name v name)]
                       (cond e
                         (check-deftype-entry (extract e) v name expected acc)

                         (print-all-acc acc ["FAIL " name ": no entry\n"]))))))

(main [_]
  (let [r1 (check-deftype 0
             "(deftype Maybe\n  (None)\n  (Some [x]))"
             "Maybe" "ctor None [] ()ctor Some [x] ()")
        r2 (check-deftype r1
             "(deftype Leaf [])"
             "Leaf" "ctor Leaf [] ()")
        r3 (check-deftype r2
             "(deftype String\n    StringBuffer\n    (SubString [s start len]\n      ;; ! start WholeInt\n      ;; ! len WholeInt\n\n      (str-vect [s] [s])\n      (count [_] len)\n\n      (subs [s new-start new-len]\n            (let [final-len (min new-len (- len new-start))]\n              (cond (<= final-len 0)\n                    \"\"\n                    (SubString s (+ start new-start) final-len)))))"
             "String" "ctor StringBuffer [] ()ctor SubString [s start len] (str-vect [s] call vect-conj (2)count [_] sym lensubs [s new-start new-len] call fn (1))")
        r4 (check-deftype r3
             "(deftype GetSentinelVal []\n    (= [x y] (= (type-num x) (type-num y))))"
             "GetSentinelVal" "ctor GetSentinelVal [] (= [x y] call = (2))")
        r5 (check-deftype r4
             "(deftype List\n    (EndOfList\n      (recurse [l f]\n               l)\n      ;; (first [l]\n      ;;        nothing)\n      ;; (rest [l]\n      ;;       l)\n      (count [l]\n             0))\n\n    (Cons [head tail len]\n      ;; ! tail (any-of Cons EndOfList)\n      ;; ! len Integer\n\n      (recurse [_ f]\n               (Cons head (f tail) len))\n      ;; (first [l]\n      ;;        (Some (.head l)))\n      ;; (rest [l]\n      ;;       (.tail l))\n      (count [l]\n             (.len l))))"
             "List" "ctor EndOfList [] (recurse [l f] sym lcount [l] int 0)ctor Cons [head tail len] (recurse [_ f] call Cons (3)count [l] call .len (1))")]
    r5))
