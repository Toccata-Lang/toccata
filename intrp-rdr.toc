;; intrp-rdr.toc — phase-1 parser: state + tokens (checklist item 4).
;;
;; Direct recursive-descent token helpers over a remaining-string
;; ParserState. The old combinator machinery (ParserCombinator and the
;; (def ...) grammar rules) is gone; items 5-6 will add the expression
;; and top-level parse functions on top of these helpers.
;;
;; This file is a LIBRARY (no main). The item-4 verification driver is
;; scratch/rdr-tokens.toc.
;;
;; Model (settled):
;;   * ParserState [input values] — `input` is the unconsumed suffix of
;;     the source; `values` is a bookkeeping map {"file" String, "line"
;;     Integer}. `subs` returns O(1) SubString views, so per-character
;;     cost is a small pooled allocation.
;;   * Maximal-run reads scan for a length, then extract with ONE subs —
;;     never repeated `str` concatenation (O(n^2)).
;;   * The line counter is bumped by take-char when it consumes "\n".

(add-ns ast (module "intrp-ast.toc"))

(deftype ParserState [input values]
  ! input String
  )

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

;; --- State helpers ---------------------------------------------------

;; make-state: build a ParserState with the given input, file name, and
;; starting line number.
(defn make-state [input file line]
  (ParserState input (assoc (assoc emptyBMI "file" file) "line" line)))

;; state-line: the current line number from the state's values map.
(defn state-line [state]
  (extract (get (.values state) "line")))

;; --- Character predicates --------------------------------------------
;; Each returns Some (truthy) if the one-char string matches, None
;; otherwise. char-code maps the first char to its integer code (0-255).

(defn is-digit [c]
  (let [n (char-code c)]
    (and (<= 48 n) (<= n 57))))

(defn is-alpha [c]
  (let [n (char-code c)]
    (or (and (<= 65 n) (<= n 90))
        (and (<= 97 n) (<= n 122)))))

;; A symbol starts with an alpha or one of . _ < > = + - * /
(defn symbol-start? [c]
  (or (is-alpha c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "/")))

;; A symbol continues with an alpha, a digit, or one of . _ < > = + - * ? !
(defn symbol-continue? [c]
  (or (is-alpha c)
      (is-digit c)
      (str= c ".")
      (str= c "_")
      (str= c "<")
      (str= c ">")
      (str= c "=")
      (str= c "+")
      (str= c "-")
      (str= c "*")
      (str= c "?")
      (str= c "!")))

;; A number token is a run of digits and dots (token-level; full numeric
;; validation is deferred to the AST-building pass in item 5).
(defn float-char? [c]
  (or (is-digit c)
      (str= c ".")))

;; --- Token helpers ---------------------------------------------------

;; peek-char: the first character of the input as a one-char string, or
;; "" if the input is exhausted. Does not consume.
(defn peek-char [state]
  (let [input (.input state)]
    (cond (str= input "")
          ""
          (subs input 0 1))))

;; take-char: consume one character, returning the new state. Bumps the
;; line counter when the consumed char is a newline. A no-op on empty
;; input.
(defn take-char [state]
  (let [input (.input state)]
    (let [c (subs input 0 1)]
      (let [rest-input (subs input 1 (count input))]
        (let [line (state-line state)]
          (let [new-line (cond (str= c "\n")
                               (+ line 1)
                               line)]
            (ParserState rest-input
                         (assoc (.values state) "line" new-line))))))))

;; skip-comment: state is positioned just after a ';'. Consume through
;; the end of the line, stopping at (but not consuming) the newline or
;; end of input. Self-recursive.
(defn skip-comment [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          state
          (str= c "\n")
          state
          (skip-comment (take-char state)))))

;; skip-whitespace: consume runs of whitespace (space, tab, newline, CR)
;; and ';' comments, returning the new state. Self-recursive.
(defn skip-whitespace [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          state
          (str= c ";")
          (skip-whitespace (skip-comment (take-char state)))
          (str= c " ")
          (skip-whitespace (take-char state))
          (str= c "\t")
          (skip-whitespace (take-char state))
          (str= c "\n")
          (skip-whitespace (take-char state))
          (str= c "\r")
          (skip-whitespace (take-char state))
          state)))

;; run-length: the number of leading characters of s that satisfy pred.
;; Each step is an O(1) subs view, so the scan is O(n). Self-recursive.
(defn run-length [s pred]
  (let [c (subs s 0 1)]
    (cond (str= c "")
          0
          (pred c)
          (+ 1 (run-length (subs s 1 (count s)) pred))
          0)))

;; read-run: read the maximal run of characters (from the state's input)
;; that satisfy pred. Returns [run-text new-state]. The run never spans a
;; newline for the token types used here, so the line is unchanged.
(defn read-run [state pred]
  (let [input (.input state)]
    (let [len (run-length input pred)]
      (let [run (subs input 0 len)]
        (let [rest-input (subs input len (count input))]
          [run (ParserState rest-input (.values state))])))))

;; --- Element accessors for [value state] pairs -----------------------

(defn elt0 [v]
  (extract (first v)))

(defn elt1 [v]
  (extract (first (rest v))))

;; --- Token readers (return [token-text new-state]) -------------------

;; read-string-content: state is just after the opening quote. Consume
;; until an unescaped closing quote, stopping AT the quote (not
;; consuming it) or at end of input. A backslash skips the next char so
;; an escaped quote does not end the string. Self-recursive.
(defn read-string-content [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          state
          (str= c "\\")
          (read-string-content (take-char (take-char state)))
          (str= c "\"")
          state
          (read-string-content (take-char state)))))

;; read-string: a double-quoted string. Returns [content new-state] where
;; content is the raw text between the quotes (escape *processing* is
;; deferred to the AST-building pass). new-state is positioned just after
;; the closing quote.
(defn read-string [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          [""]
          (str= c "\"")
          (let [after-open (take-char state)]
            (let [at-close (read-string-content after-open)]
              (let [content-len
                    (- (count (.input after-open))
                       (count (.input at-close)))]
                (let [content (subs (.input after-open) 0 content-len)]
                  (let [end-state (take-char at-close)]
                    [content end-state])))))
          [""])))

;; read-symbol: a symbol whose first char satisfies symbol-start?.
(defn read-symbol [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          [""]
          (symbol-start? c)
          (read-run state symbol-continue?)
          [""])))

;; read-int: a run of digits.
(defn read-int [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          [""]
          (is-digit c)
          (read-run state is-digit)
          [""])))

;; read-float: a run of digits and dots (token-level; see float-char?).
(defn read-float [state]
  (let [c (peek-char state)]
    (cond (str= c "")
          [""]
          (is-digit c)
          (read-run state float-char?)
          [""])))
