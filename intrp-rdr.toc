(add-ns ast (module "intrp-ast.toc"))

(deftype ParserState [input values]
  ! input String
  ! values {String, Any}
)

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

(deftype ParserCombinator
  (CharRange [lower upper]
    ! lower String
    ! upper String
    (recurse [v f]
             v)
    (str-vect [x]
              ["CharRange" (.lower x) (.upper x)]))
  (AlwaysSucceed [value]
                  (recurse [v f]
                           v)
                  (str-vect [x]
                            ["AlwaysSucceed" (.value x)]))
  (StringMatch [strng]
    ! strng String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(StringMatch" (.strng x) ")"]))
  (NotChar [char]
    ! char String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(NotChar" (.char x) ")"]))
  (Error [msg]
    ! msg String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(Error" (.msg x) ")"]))
  (All [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (map parsers f))
    (str-vect [x]
              ["(All" (flat-map (.parsers x) str-vect) ")"]))
  (Any [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (map parsers f))
    (str-vect [x]
              ["(Any" (flat-map (.parsers x) str-vect) ")"]))
  (Many [parser]
    ! parser ParserCombinator
    (recurse [v f]
             (Many (f parser)))
    (str-vect [x]
              ["(Many" (first (str-vect (.parser x))) ")"]))
  (Rule [name parser]
    ! name String
    ! parser ParserCombinator
    (recurse [v f]
             (Rule name (f parser)))
    (str-vect [x]
              ["(Rule" (.name x) (first (str-vect (.parser x))) ")"])))

(def digits (CharRange "0" "9"))

(def upper-case (CharRange "A" "Z"))

(def lower-case (CharRange "a" "z"))

(def linear-whitespace (Any [
    (StringMatch ",")
    (StringMatch " ")
    (StringMatch "\t")]))

; Keywords and Special Forms
(def def-keyword (StringMatch "def"))
(def defmacro-keyword (StringMatch "defmacro"))
(def defn-keyword (StringMatch "defn"))
(def deftype-keyword (StringMatch "deftype"))
(def defp-keyword (StringMatch "defp"))
(def extend-type-keyword (StringMatch "extend-type"))
(def add-ns-keyword (StringMatch "add-ns"))
(def inline-keyword (StringMatch "inline"))
(def main-keyword (StringMatch "main"))

; Sub-Expression Special Forms
(def fn-keyword (StringMatch "fn"))
(def let-keyword (StringMatch "let"))
(def do-keyword (StringMatch "do"))
(def superposition-keyword (StringMatch "|"))
(def threading-keyword (StringMatch "->"))
(def match-keyword (StringMatch "match"))

; Type Constraints
(def type-constraint-prefix (StringMatch "!"))

; Special Symbols
(def file-symbol (StringMatch "_FILE_"))
(def line-symbol (StringMatch "_LINE_"))

; Delimiters
(def open-paren (StringMatch "("))
(def close-paren (StringMatch ")"))
(def open-bracket (StringMatch "["))
(def close-bracket (StringMatch "]"))
(def open-brace (StringMatch "{"))
(def close-brace (StringMatch "}"))

; Comments
(def comment-start (StringMatch ";"))

; Literals
(def single-quote (StringMatch "'"))
(def double-quote (StringMatch "\""))

; Parser Rules for Toccata Constructs
(def int-literal (Rule "integer" (Many digits)))
(def alpha (Rule "alpha" (Any [lower-case upper-case])))
(def symbol-start
  (Rule "symbol-start"
        (Any [alpha
              (StringMatch ".")
              (StringMatch "_")
              (StringMatch "<")
              (StringMatch ">")
              (StringMatch "=")
              (StringMatch "+")
              (StringMatch "-")
              (StringMatch "*")
              (StringMatch "/")])))
(def rest-of-symbol (Rule "rest-of-symbol" (Any [alpha digits
    (StringMatch ".")
    (StringMatch "_")
    (StringMatch "<")
    (StringMatch ">")
    (StringMatch "=")
    (StringMatch "+")
    (StringMatch "-")
    (StringMatch "*")
    (StringMatch "?")
    (StringMatch "!")])))

(def symbol (Rule "symbol" (All [symbol-start rest-of-symbol])))

; Number Literals
(def float-literal (Rule "float" (All [(Many digits) (StringMatch ".") (Many digits)])))

; String Literals
(def escaped-char (Rule "escaped-char" (All [(StringMatch "\\") (Any [
    (StringMatch "\\")
    (StringMatch "\"")
    (StringMatch "n")
    (StringMatch "r")
    (StringMatch "t")
])])))
(def double-quoted-string (Rule "double-quoted-string" (All [
    (StringMatch "\"")
    (Many (Any [(NotChar "\"") escaped-char]))
    (StringMatch "\"")
])))

;; ; Expressions
;; (def expression (Rule "expression" (Any [
;;     int-literal
;;     float-literal
;;     double-quoted-string
;;     symbol
;;     (All [(StringMatch "(") expression (Many expression) (StringMatch ")")])
;; ])))

; Type Constraints
(def min-constraint (Rule "min-constraint" (All [(StringMatch "(min") int-literal (StringMatch ")")])))
(def max-constraint (Rule "max-constraint" (All [(StringMatch "(max") int-literal (StringMatch ")")])))
(def min-length-constraint (Rule "min-length-constraint" (All [(StringMatch "(min-length") int-literal (StringMatch ")")])))
(def max-length-constraint (Rule "max-length-constraint" (All [(StringMatch "(max-length") int-literal (StringMatch ")")])))
(def length-constraint (Rule "length-constraint" (All [(StringMatch "(length") int-literal (StringMatch ")")])))

