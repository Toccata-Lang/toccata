(add-ns ast (module "intrp-ast.toc"))

(deftype ParserState [input values]
  ! input String
  ! values {String, _}
)

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

(deftype ParserCombinator
  (Ignore [parser]
    ! parser ParserCombinator
    (recurse [v f]
             (Ignore (f parser)))
    (str-vect [x]
              ["(Ignore " (str (.parser x)) ")"]))
  (CharRange [lower upper]
    ! lower String
    ! upper String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(CharRange " (.lower x) " " (.upper x) ")"]))
  (AlwaysSucceed [value]
                  (recurse [v f]
                           v)
                  (str-vect [x]
                            ["(AlwaysSucceed" (.value x) ")"]))
  (NotChar [char]
    ! char String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(NotChar " (.char x) ")"]))
  (Error [msg]
    ! msg String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(Error " (.msg x) ")"]))
  (All [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (All (map parsers f)))
    (str-vect [x]
              ["(All " (to-str (flat-map (.parsers x) str-vect)) ")"]))
  (Any [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (Any (map parsers f)))
    (str-vect [x]
              ["(Any " (to-str (flat-map (.parsers x) str-vect)) ")"]))
  (Many [parser]
    ! parser ParserCombinator
    (recurse [v f]
             (Many (f parser)))
    (str-vect [x]
              ["(Many " (first (str-vect (.parser x))) ")"]))
  (Rule [name parser]
    ! name String
    ! parser ParserCombinator
    (recurse [v f]
             (Rule name (f parser)))
    (str-vect [x]
              ["(Rule " name " " (first (str-vect parser)) ")"]))
  (Recur [f]
    ! f (-> [] Rule)
    (recurse [v rec-f]
             ;; (Recur (fn []
             ;;          (rec-f (f))))
             v)
    (str-vect [x]
              ["(Recur " (.name (f)) ")"])))

(def digits (Rule "digits" (CharRange "0" "9")))

(def upper-case (CharRange "A" "Z"))

(def lower-case (CharRange "a" "z"))

(def linear-whitespace (Any ["," " " "\t"]))
(def whitespace (Rule "whitespace" (Many (Any [linear-whitespace "\n" "\r"]))))
(def skip-ws (Ignore whitespace))

; Keywords and Special Forms
(def def-keyword (All [skip-ws "def"]))
(def defmacro-keyword (All [skip-ws "defmacro"]))
(def defn-keyword (All [skip-ws "defn"]))
(def deftype-keyword (All [skip-ws "deftype"]))
(def defp-keyword (All [skip-ws "defp"]))
(def extend-type-keyword (All [skip-ws "extend-type"]))
(def add-ns-keyword (All [skip-ws "add-ns"]))
(def inline-keyword (All [skip-ws "inline"]))
(def main-keyword (All [skip-ws "main"]))

; Sub-Expression Special Forms
(def fn-keyword (All [skip-ws "fn"]))
(def let-keyword (All [skip-ws "let"]))
(def do-keyword (All [skip-ws "do"]))
(def superposition-keyword (All [skip-ws "|"]))
(def threading-keyword (All [skip-ws "->"]))
(def match-keyword (All [skip-ws "match"]))

; Type Constraints
(def type-constraint-prefix (All [skip-ws "!"]))

; Special Symbols
(def file-symbol (All [skip-ws "_FILE_"]))
(def line-symbol (All [skip-ws "_LINE_"]))

; Delimiters
(def open-paren (All [skip-ws "("]))
(def close-paren (All [skip-ws ")"]))
(def open-bracket (All [skip-ws "["]))
(def close-bracket (All [skip-ws "]"]))
(def open-brace (All [skip-ws "{"]))
(def close-brace (All [skip-ws "}"]))

; Comments
(def comment-start (All [skip-ws ";"]))

; Literals
(def single-quote (All [skip-ws "'"]))
(def double-quote "\"")

; Parser Rules for Toccata Constructs
(def int-literal (Rule "integer" (All [skip-ws (Many digits)])))
(def alpha (Rule "alpha" (Any [lower-case upper-case])))
(def symbol-start
  (Rule "symbol-start"
        (All [skip-ws (Any [alpha "." "_" "<" ">" "=" "+" "-" "*" "/"])])))
(def rest-of-symbol
  (Rule "rest-of-symbol"
        (Any [alpha digits "." "_" "<" ">" "=" "+" "-" "*" "?" "!"])))

(def symbol (Rule "symbol" (All [symbol-start (Many rest-of-symbol)])))

; Number Literals
(def float-literal (Rule "float" (All [(All [skip-ws (Many digits)]) "." (Many digits)])))

; String Literals
(def escaped-char (Rule "escaped-char" (All ["\\" (Any ["\\" "\"" "n" "r" "t"])])))
(def double-quoted-string (Rule "double-quoted-string" (All [skip-ws
                                                             double-quote
                                                             (Many (Any [(NotChar "\"") escaped-char]))
                                                             double-quote])))

(def sub-expression)

; Vector and Hash Map Expressions
(def vector-expression (Rule "vector-expression" (All [open-bracket (Many sub-expression) close-bracket])))
(def hash-map-expression (Rule "hash-map-expression" (All [open-brace (Many (All [sub-expression sub-expression])) close-brace])))

; Expressions
(def expression
  (Rule "expression"
        (Any [int-literal
              float-literal
              double-quoted-string
              symbol
              (All [open-paren
                    (Recur sub-expression)
                    (Many (Recur sub-expression))
                    close-paren])
              ;; vector-expression
              ;; hash-map-expression
              ])))
(defn sub-expression []
  expression)

; Type Constraints
(def min-constraint (Rule "min-constraint" (All [open-paren skip-ws "min" int-literal close-paren])))
(def max-constraint (Rule "max-constraint" (All [open-paren skip-ws "max" int-literal close-paren])))
(def min-length-constraint (Rule "min-length-constraint" (All [open-paren skip-ws "min-length" int-literal close-paren])))
(def max-length-constraint (Rule "max-length-constraint" (All [open-paren skip-ws "max-length" int-literal close-paren])))
(def length-constraint (Rule "length-constraint" (All [open-paren skip-ws "length" int-literal close-paren])))

(main [_]
  (println expression)
  0)
