(add-ns ast (module "intrp-ast.toc"))

(deftype ParserState [input values]
  ! input String
  ! values {String, _}
)

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

(deftype ParserCombinator
  (CharRange [lower upper]
    ! lower String
    ! upper String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(CharRange " (.lower x) " " (.upper x) ")"]))
  (AlwaysSucceed [value]
                  (recurse [v f]
                           v)
                  (str-vect [x]
                            ["(AlwaysSucceed" (.value x) ")"]))
  (StringMatch [strng]
    ! strng String
    (recurse [v f]
             v)
    (str-vect [x]
              ["" (.strng x) ""]))
  (NotChar [char]
    ! char String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(NotChar " (.char x) ")"]))
  (Error [msg]
    ! msg String
    (recurse [v f]
             v)
    (str-vect [x]
              ["(Error " (.msg x) ")"]))
  (All [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (All (map parsers f)))
    (str-vect [x]
              ["(All " (to-str (flat-map (.parsers x) str-vect)) ")"]))
  (Any [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (Any (map parsers f)))
    (str-vect [x]
              ["(Any " (to-str (flat-map (.parsers x) str-vect)) ")"]))
  (Many [parser]
    ! parser ParserCombinator
    (recurse [v f]
             (Many (f parser)))
    (str-vect [x]
              ["(Many " (first (str-vect (.parser x))) ")"]))
  (Rule [name parser]
    ! name String
    ! parser ParserCombinator
    (recurse [v f]
             (Rule name (f parser)))
    (str-vect [x]
              ["(Rule " name " " (first (str-vect parser)) ")"]))
  (Recur [f]
    ! f (-> [] Rule)
    (recurse [v rec-f]
             (Recur (fn []
                      (rec-f f))))
    (str-vect [x]
              ["(Recur " (.name (f)) ")"])))

(def digits (CharRange "0" "9"))

(def upper-case (CharRange "A" "Z"))

(def lower-case (CharRange "a" "z"))

(def linear-whitespace (Any [
    ","
    " "
    "\t"]))

; Keywords and Special Forms
(def def-keyword "def")
(def defmacro-keyword "defmacro")
(def defn-keyword "defn")
(def deftype-keyword "deftype")
(def defp-keyword "defp")
(def extend-type-keyword "extend-type")
(def add-ns-keyword "add-ns")
(def inline-keyword "inline")
(def main-keyword "main")

; Sub-Expression Special Forms
(def fn-keyword "fn")
(def let-keyword "let")
(def do-keyword "do")
(def superposition-keyword "|")
(def threading-keyword "->")
(def match-keyword "match")

; Type Constraints
(def type-constraint-prefix "!")

; Special Symbols
(def file-symbol "_FILE_")
(def line-symbol "_LINE_")

; Delimiters
(def open-paren "(")
(def close-paren ")")
(def open-bracket "[")
(def close-bracket "]")
(def open-brace "{")
(def close-brace "}")

; Comments
(def comment-start ";")

; Literals
(def single-quote "'")
(def double-quote (StringMatch "\""))

; Parser Rules for Toccata Constructs
(def int-literal (Rule "integer" (Many digits)))
(def alpha (Rule "alpha" (Any [lower-case upper-case])))
(def symbol-start
  (Rule "symbol-start"
        (Any [alpha
              "."
              "_"
              "<"
              ">"
              "="
              "+"
              "-"
              "*"
              "/"])))
(def rest-of-symbol (Rule "rest-of-symbol" (Any [alpha digits
    "."
    "_"
    "<"
    ">"
    "="
    "+"
    "-"
    "*"
    "?"
    "!"])))

(def symbol (Rule "symbol" (All [symbol-start (Many rest-of-symbol)])))

; Number Literals
(def float-literal (Rule "float" (All [(Many digits) "." (Many digits)])))

; String Literals
(def escaped-char (Rule "escaped-char" (All ["\\" (Any [
    "\\"
    (StringMatch "\"")
    "n"
    "r"
    "t"
])])))
(def double-quoted-string (Rule "double-quoted-string" (All [
    (StringMatch "\"")
    (Many (Any [(NotChar "\"") escaped-char]))
    (StringMatch "\"")
])))

(def sub-expression)

; Expressions
(def expression
  (Rule "expression"
        (Any [int-literal
              float-literal
              double-quoted-string
              symbol
              (All ["("
                    (Recur sub-expression)
                    (Many (Recur sub-expression))
                    ")"])])))
(defn sub-expression []
  (Rule "expression" expression))

; Type Constraints
(def min-constraint (Rule "min-constraint" (All ["(min" int-literal ")"])))
(def max-constraint (Rule "max-constraint" (All ["(max" int-literal ")"])))
(def min-length-constraint (Rule "min-length-constraint" (All ["(min-length" int-literal ")"])))
(def max-length-constraint (Rule "max-length-constraint" (All ["(max-length" int-literal ")"])))
(def length-constraint (Rule "length-constraint" (All ["(length" int-literal ")"])))

; Vector and Hash Map Expressions
(def vector-expression (Rule "vector-expression" (All [
    "["
    (Many expression)
    "]"
])))
(def hash-map-expression (Rule "hash-map-expression" (All [
    "{"
    (Many (All [expression expression]))
    "}"
])))

(main [_]
  (println symbol)
  0)
