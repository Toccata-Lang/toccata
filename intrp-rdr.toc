(add-ns ast (module "intrp-ast.toc"))

(deftype ParserState [input values]
  ! input String
  ! values {String, Any}
)

(deftype ParserResults
  (ParserFail [])
  (ParserMatch [value state])
  (ParserIgnore [state])
  (ParserError [msg state]))

(deftype ParserCombinator
  (CharRange [lower upper]
    ! lower String
    ! upper String
    (recurse [v f]
             v))
  (AlwaysSucceed [value]
                  (recurse [v f]
                           v))
  (StringMatch [strng]
    ! strng String)
  (NotChar [char]
    ! char String
    (recurse [v f]
             v))
  (Error [msg]
    ! msg String
    (recurse [v f]
             v))
  (All [parsers]
    ! parsers [ParserCombinator]
    (recurse [v f]
             (map parsers f)))
  (Many [parser]
    ! parser ParserCombinator
    (recurse [v f]
             (Many (f parser)))))

(def digits (CharRange "0" "9"))

(def upper-case (CharRange "A" "Z"))

(def lower-case (CharRange "a" "z"))

(def linear-whitespace (StringMatch (| "," " " "\t")))

(main [_]
  (println "Digits value:" digits)
  0)
